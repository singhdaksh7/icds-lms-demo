# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# MySQL connection string used by Prisma.
# Format: mysql://USERNAME:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE"

# Port the Node.js server listens on.
# Hostinger Node.js hosting injects its own PORT at runtime — this value is only
# used as a local-development fallback (see src/config/env.js).
PORT=3000

# development | production
NODE_ENV=development

# Session/cookie signing secret. REQUIRED in production — the app refuses to
# start without a real one (see src/config/env.js). Must be a random string
# of at least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me"

# Name of the session cookie (optional — defaults to icds.sid).
SESSION_COOKIE_NAME=icds.sid

# Optional: only read by prisma/seed.js when NODE_ENV !== production.
# Both must be set together to create/update a dev admin user; leave unset
# to skip dev admin creation entirely.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=

# Optional: absolute base URL of this deployment (e.g. https://example.com).
# Not required — the app builds redirect URLs from the current request when
# this is unset. Useful if you ever need to construct an absolute URL
# outside a request context.
APP_BASE_URL=

# Public brand/contact settings. Replace before production; no placeholder
# values are hard-coded in views.
SITE_NAME="Institute of Cosmetology & Dental Sciences"
SUPPORT_EMAIL=support@example.com
CONTACT_EMAIL=info@example.com
CONTACT_PHONE=
WHATSAPP_NUMBER=

# Razorpay (Phase 5 — checkout/payments). Use TEST MODE keys in development,
# never live/production keys. Get these from the Razorpay Dashboard.
# RAZORPAY_KEY_ID is the only one of these ever sent to the browser (the
# Razorpay Checkout script needs it) — the other two must stay server-side.
# Checkout/webhook routes fail with a clear 503 if these are unset; nothing
# else in the app depends on them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Dashboard > Settings > Webhooks when you create the webhook pointing
# at /webhooks/razorpay — this is a separate secret from RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=

# Absolute filesystem path where LOCAL lesson videos are stored, outside the
# Express static root. Optional locally (defaults to ./storage/videos).
# REQUIRED in production on Hostinger: must point OUTSIDE the app's
# deployment directory (hbuilds/current/nodejs), which is replaced on every
# redeploy — see README "Production Operations: Video Storage".
VIDEO_STORAGE_ROOT=
