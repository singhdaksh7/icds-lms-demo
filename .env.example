# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# MySQL connection string used by Prisma.
# Format: mysql://USERNAME:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE"

# Port the Node.js server listens on.
# Hostinger Node.js hosting injects its own PORT at runtime — this value is only
# used as a local-development fallback (see src/config/env.js).
PORT=3000

# development | production
NODE_ENV=development

# Session/cookie signing secret. REQUIRED in production — the app refuses to
# start without a real one (see src/config/env.js). Must be a random string
# of at least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me"

# Name of the session cookie (optional — defaults to icds.sid).
SESSION_COOKIE_NAME=icds.sid

# Optional: only read by prisma/seed.js when NODE_ENV !== production.
# Both must be set together to create/update a dev admin user; leave unset
# to skip dev admin creation entirely.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=

# Absolute base URL of this deployment (e.g. https://example.com), no
# trailing slash. Optional locally — the app derives an origin from the
# current request when this is unset (see src/lib/seo.js), so canonical
# URLs, sitemap.xml, robots.txt, Open Graph tags, and email links all still
# work in development without it. STRONGLY RECOMMENDED in production: it's
# the only correct source for links generated outside a request (e.g.
# certificate-issued emails), and is more reliable than request-derived
# URLs behind a proxy/CDN.
APP_BASE_URL=

# Public brand/contact settings. Replace before production; no placeholder
# values are hard-coded in views.
SITE_NAME="Institute of Cosmetology & Dental Sciences"
# Optional: name shown in the footer copyright line, if different from SITE_NAME.
COPYRIGHT_NAME=
SUPPORT_EMAIL=support@example.com
CONTACT_EMAIL=info@example.com
CONTACT_PHONE=
WHATSAPP_NUMBER=
# Optional: physical address shown in the footer. Leave unset to hide it.
SITE_ADDRESS=
# Optional: social profile URLs. Each icon only renders in the footer when its
# URL is set — leave unset rather than linking to a placeholder "#".
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_YOUTUBE_URL=
SOCIAL_LINKEDIN_URL=

# Razorpay (Phase 5 — checkout/payments). Use TEST MODE keys in development,
# never live/production keys. Get these from the Razorpay Dashboard.
# RAZORPAY_KEY_ID is the only one of these ever sent to the browser (the
# Razorpay Checkout script needs it) — the other two must stay server-side.
# Checkout/webhook routes fail with a clear 503 if these are unset; nothing
# else in the app depends on them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Dashboard > Settings > Webhooks when you create the webhook pointing
# at /webhooks/razorpay — this is a separate secret from RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=

# Absolute filesystem path where LOCAL lesson videos are stored, outside the
# Express static root. Optional locally (defaults to ./storage/videos).
# REQUIRED in production on Hostinger: must point OUTSIDE the app's
# deployment directory (hbuilds/current/nodejs), which is replaced on every
# redeploy — see README "Production Operations: Video Storage".
VIDEO_STORAGE_ROOT=

# Absolute filesystem path where course/instructor thumbnail images are
# stored. Optional locally (defaults to ./public/uploads/thumbnails).
# In production, point this OUTSIDE the app's deployment directory for the
# same reason as VIDEO_STORAGE_ROOT above — served via the dedicated
# /uploads/thumbnails route regardless of where it points.
THUMBNAIL_STORAGE_ROOT=

# --- SMTP (Phase 9 — email notifications) -----------------------------------
# Optional and provider-agnostic: any standard SMTP service works (Hostinger
# email, Google Workspace, Zoho, Brevo, SendGrid SMTP, Amazon SES SMTP, ...).
# Without these set, the app runs a safe no-op transport — password reset,
# enrollment, certificate, and contact emails are logged in development
# (never sent) and silently skipped in production; nothing that depends on
# email (signup, enrollment, certificate issuance, contact form) is blocked
# by SMTP being unconfigured. See README "SMTP / Email".
SMTP_HOST=
SMTP_PORT=587
# 1/true for implicit TLS (typically port 465); leave unset/false for STARTTLS (587).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Required (with SMTP_HOST) for email sending to actually activate.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# --- SEO / analytics (Phase 9, all optional) --------------------------------
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). When set, the GA
# tag is rendered on every page; when unset, nothing is added — never invent
# a placeholder ID here.
GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (Settings > Ownership
# verification > HTML tag > just the content="..." value). Rendered as a
# <meta name="google-site-verification"> tag when set.
GOOGLE_SITE_VERIFICATION=
