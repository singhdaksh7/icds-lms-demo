// Prisma schema for the ICDS LMS platform.
// Target database: MySQL (Hostinger-hosted). No Postgres-only features used.

// driverAdapters lets PrismaClient be constructed with an external adapter
// (see src/config/db.js) — required to run Prisma queries over TiDB Cloud's
// HTTPS serverless driver instead of a raw MySQL TCP connection, which the
// Hostinger Node.js Web App runtime cannot reach. Prisma Migrate is
// unaffected by this and continues to use a normal TCP connection (must be
// run from a machine/CI environment that can reach the database directly —
// see README "Production Operations").
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

enum VideoType {
  EXTERNAL
  LOCAL
  R2
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum ContactMessageStatus {
  NEW
  READ
  RESOLVED
}

enum EnrollmentRequestStatus {
  PENDING
  CONTACTED
  ENROLLED
  DECLINED
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  enrollments         Enrollment[]
  orders              Order[]
  wishlistItems       WishlistItem[]
  reviews             Review[]
  lessonProgress      LessonProgress[]
  certificates        Certificate[]        @relation("CertificateOwner")
  issuedCertificates  Certificate[]        @relation("CertificateIssuer")
  passwordResetTokens PasswordResetToken[]
  enrollmentRequests  EnrollmentRequest[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  description String?      @db.Text
  imageUrl    String?      @db.VarChar(500)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  courses Course[]

  @@map("categories")
}

model Instructor {
  id                   Int                    @id @default(autoincrement())
  name                 String
  slug                 String                 @unique
  title                String?
  designation          String?                @db.VarChar(255)
  organization         String?                @db.VarChar(255)
  experienceLabel      String?                @db.VarChar(100)
  shortBio             String?                @db.Text
  bio                  String?                @db.Text
  qualificationSummary String?                @db.Text
  practiceName         String?                @db.VarChar(255)
  practiceLocation     String?                @db.VarChar(255)
  mentorQuote          String?                @db.Text
  photoUrl             String?                @db.VarChar(500)
  email                String?
  linkedinUrl          String?                @db.VarChar(500)
  instagramUrl         String?                @db.VarChar(500)
  status               EntityStatus           @default(ACTIVE)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  courses     Course[]
  credentials InstructorCredential[]

  @@map("instructors")
}

model InstructorCredential {
  id           Int        @id @default(autoincrement())
  instructorId Int
  title        String     @db.VarChar(300)
  description  String?    @db.Text
  icon         String?    @db.VarChar(50)
  sortOrder    Int        @default(0)
  isPublished  Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId, sortOrder])
  @@map("instructor_credentials")
}

model Course {
  id               Int          @id @default(autoincrement())
  title            String
  slug             String       @unique
  shortDescription String?      @db.Text
  description      String?      @db.Text
  thumbnailUrl     String?      @db.VarChar(500)
  categoryId       Int?
  instructorId     Int?
  price            Decimal      @db.Decimal(10, 2)
  salePrice        Decimal?     @db.Decimal(10, 2)
  // GST rate (%) for this course. NULL = use the site-wide default from
  // Admin > Tax & Invoice; 0 = GST-exempt.
  gstRate          Decimal?     @db.Decimal(5, 2)
  currency         String       @default("INR")
  level            CourseLevel  @default(BEGINNER)
  status           CourseStatus @default(DRAFT)
  featured         Boolean      @default(false)
  duration         String?
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  instructor Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  lessons            Lesson[]
  modules            CourseModule[]
  resources          CourseResource[]
  enrollments        Enrollment[]
  orderItems         OrderItem[]
  wishlistItems      WishlistItem[]
  reviews            Review[]
  certificates       Certificate[]
  enrollmentRequests EnrollmentRequest[]
  landingContent     CourseLandingContent?
  heroChips          CourseHeroChip[]
  takeaways          CourseTakeaway[]
  questions          CourseQuestion[]
  audienceItems      CourseAudienceItem[]
  faqs               CourseFaq[]
  whyRegisterItems   CourseWhyRegisterItem[]
  courseHighlights   CourseHighlight[]
  testimonials       CourseTestimonial[]
  accessPlans        CourseAccessPlan[]
  courseStats        CourseStat[]
  comparisonColumns  CourseComparisonColumn[]
  accessSteps        CourseAccessStep[]
  landingSections    CourseLandingSection[]

  @@index([categoryId])
  @@index([instructorId])
  @@index([status])
  @@map("courses")
}

model Lesson {
  id              Int          @id @default(autoincrement())
  courseId        Int
  topicId         Int?
  title           String
  slug            String
  description     String?      @db.Text
  videoType       VideoType    @default(EXTERNAL)
  videoUrl        String?      @db.VarChar(500)
  externalVideoId String?
  // Server-side-only relative path under storage/videos/ for LOCAL videos
  // (e.g. "course-slug/<uuid>.mp4"). Never rendered to the client directly —
  // only used server-side to stream via the protected /media route. Not an
  // absolute filesystem path, so it carries no meaningful info if leaked.
  videoPath       String?      @db.VarChar(500)
  // Cloudflare R2 videos (videoType = R2): only the server-generated object
  // key is stored (courses/<courseId>/lessons/<lessonId>/<uuid>.mp4), never a
  // URL. Playback uses short-lived presigned URLs minted after authorization.
  videoObjectKey  String?      @db.VarChar(500)
  videoDurationSeconds Int?
  videoSizeBytes  BigInt?
  videoMimeType   String?      @db.VarChar(100)
  duration        String?
  sortOrder       Int          @default(0)
  preview         Boolean      @default(false)
  status          LessonStatus @default(DRAFT)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic          CourseTopic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  lessonProgress LessonProgress[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([topicId])
  @@map("lessons")
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

model Enrollment {
  id              Int              @id @default(autoincrement())
  userId          Int
  courseId        Int
  orderId         Int?
  status          EnrollmentStatus @default(ACTIVE)
  progressPercent Int              @default(0)
  enrolledAt      DateTime         @default(now())
  accessExpiresAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

// Orders are financial records: never cascade-delete them when a user or
// course row disappears. Restrict instead, and let the app layer handle
// soft-deletes / anonymization if that's ever required.
model Order {
  id                Int         @id @default(autoincrement())
  userId            Int
  amount            Decimal     @db.Decimal(10, 2)
  currency          String      @default("INR")
  status            OrderStatus @default(PENDING)
  paymentProvider   String?
  // Unique so webhook/verify handlers can reliably map a Razorpay order
  // back to exactly one local Order (findUnique) — required for safe,
  // idempotent payment finalization independent of any in-memory state.
  // Tax breakdown captured at purchase time. `amount` is always the TOTAL
  // charged (what Razorpay is asked for); subtotal + tax == amount.
  subtotalAmount    Decimal?    @db.Decimal(10, 2)
  taxAmount         Decimal     @default(0) @db.Decimal(10, 2)
  taxRate           Decimal     @default(0) @db.Decimal(5, 2)
  taxInclusive      Boolean     @default(true)
  // When the payment was confirmed (invoice date). NULL on older orders.
  paidAt            DateTime?
  providerOrderId   String?     @unique
  // Unique: one Razorpay payment can settle at most one local order, so a
  // replayed/reused payment id can never be attached to a second order.
  providerPaymentId String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  enrollments Enrollment[]

  @@index([userId])
  @@map("orders")
}

// An order can contain one or more courses (bundle/cart-friendly), so course
// pricing is captured at purchase time rather than only referencing Course.
model OrderItem {
  id       Int     @id @default(autoincrement())
  orderId  Int
  courseId Int
  price    Decimal @db.Decimal(10, 2)

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([courseId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Student engagement
// ---------------------------------------------------------------------------

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("wishlist_items")
}

model Review {
  id        Int          @id @default(autoincrement())
  userId    Int
  courseId  Int
  rating    Int
  comment   String?      @db.Text
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("reviews")
}

// Lesson-level completion is the source of truth; course-level progress
// percentage (Enrollment.progressPercent) is a derived/cached value updated
// whenever a LessonProgress row changes.
model LessonProgress {
  id                  Int       @id @default(autoincrement())
  userId              Int
  lessonId            Int
  completed           Boolean   @default(false)
  // Legitimate ACCUMULATED watched time, in seconds — never set directly
  // from currentTime/position. Only incremented server-side by small,
  // playback-verified deltas the client reports while the video is
  // genuinely playing (not seeking, not paused, not an implausible jump).
  // This is the value completion and progress-percent are computed from.
  watchedSeconds      Int       @default(0)
  // Last playback position, in seconds — resume-only. Set directly from
  // currentTime on every save, completely independent of watchedSeconds,
  // so seeking to the end of a video does NOT by itself mark it watched.
  lastPositionSeconds Int       @default(0)
  // Video duration, in seconds, as reported by the client at save time.
  // Needed (alongside watchedSeconds) to compute an in-progress percentage
  // before completion — Lesson.duration is a display string, not seconds.
  durationSeconds     Int       @default(0)
  // Server-side credit clock for watched-time validation: watchedSeconds can
  // only grow by as much real server time as has elapsed past this timestamp
  // (see computeCreditedDelta in progress.service.js). Never client-supplied.
  lastCreditAt        DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// A certificate is either earned through course completion (COMPLETION) or
// issued by an administrator as an explicit override (ADMIN_ISSUED). Admin
// issuance records who issued it and why (adminNote - internal only, never
// shown to students or on the public verification page). `fileUrl` holds the
// generated-name of an admin-uploaded PDF inside the persistent certificate
// storage root (never a path or URL); when null the PDF is generated on demand.
enum CertificateSource {
  COMPLETION
  ADMIN_ISSUED
}

enum CertificateStatus {
  ACTIVE
  REVOKED
}

model Certificate {
  id                Int               @id @default(autoincrement())
  userId            Int
  courseId          Int
  certificateNumber String            @unique @db.VarChar(100)
  issuedAt          DateTime          @default(now())
  fileUrl           String?           @db.VarChar(500)
  source            CertificateSource @default(COMPLETION)
  status            CertificateStatus @default(ACTIVE)
  issuedByUserId    Int?
  adminNote         String?           @db.Text
  revokedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user     User   @relation("CertificateOwner", fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedBy User?  @relation("CertificateIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([issuedByUserId])
  @@map("certificates")
}

// ---------------------------------------------------------------------------
// Marketing / support
// ---------------------------------------------------------------------------

// Generic admin-editable site content: one row per setting key. Kept as a
// single key/value table (not a bespoke model per homepage section) so this
// stays a small, reusable "Site Settings" mechanism rather than a large CMS
// framework. Missing keys fall back to the hard-coded defaults in
// src/services/settings.service.js, so partial/empty configuration is
// always safe.
model SiteSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Admin-managed homepage FAQ entries. Public site loads only isActive rows,
// ordered by sortOrder.
model Faq {
  id        Int      @id @default(autoincrement())
  question  String   @db.VarChar(300)
  answer    String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("faqs")
}

model NewsletterSubscriber {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  subscribedAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        Int                  @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())

  @@map("contact_messages")
}

// A student-initiated "I want this course" signal, distinct from a generic
// ContactMessage: it's tied to a specific user+course so the admin manual-
// enrollment queue (see src/services/enrollmentRequest.service.js) can act
// on it directly instead of parsing free-text messages. Never implies
// payment — enrollment here always goes through the same orderId=null
// manual-enrollment path as any other admin enrollment.
model EnrollmentRequest {
  id        Int                     @id @default(autoincrement())
  userId    Int
  courseId  Int
  status    EnrollmentRequestStatus @default(PENDING)
  message   String?                 @db.Text
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([status])
  @@map("enrollment_requests")
}

// Express-session storage, backed by Prisma/TiDB instead of
// express-mysql-session (which used a raw MySQL TCP connection the
// Hostinger Node.js runtime cannot reach) — see src/lib/prismaSessionStore.js.
// `userId` is a denormalized copy of the value inside the serialized
// `data` payload (set once a user logs in), purely so password-reset
// invalidation can target a user's sessions with an indexed query instead
// of loading and JSON-parsing every row.
model Session {
  id        String   @id @db.VarChar(191)
  userId    Int?
  data      String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Admin-managed SMTP configuration (single row, id = 1). The password is
// stored encrypted (AES-256-GCM, see src/lib/secretBox.js) and is never
// rendered back to any page. Environment SMTP_* values remain the fallback
// when no row exists. Razorpay credentials are deliberately NOT here —
// they stay server-managed in the environment.
model SmtpSetting {
  id          Int      @id
  host        String   @db.VarChar(255)
  port        Int      @default(587)
  secure      Boolean  @default(false)
  username    String?  @db.VarChar(255)
  passwordEnc String?  @db.Text
  fromEmail   String   @db.VarChar(255)
  fromName    String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt

  @@map("smtp_settings")
}

// Admin-managed Razorpay configuration (single row, id = 1). Key secret and
// webhook secret are stored encrypted (AES-256-GCM, src/lib/secretBox.js) and
// are never rendered back to any page. Environment RAZORPAY_* values remain
// the fallback when no row exists.
model RazorpaySetting {
  id               Int      @id
  enabled          Boolean  @default(false)
  keyId            String   @db.VarChar(100)
  keySecretEnc     String   @db.Text
  webhookSecretEnc String?  @db.Text
  updatedAt        DateTime @updatedAt

  @@map("razorpay_settings")
}

// ---------------------------------------------------------------------------
// Course Curriculum Hierarchy (Modules & Topics)
// ---------------------------------------------------------------------------

model CourseModule {
  id          Int           @id @default(autoincrement())
  courseId    Int
  title       String
  description String?       @db.Text
  sortOrder   Int           @default(0)
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  course Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics CourseTopic[]

  @@index([courseId])
  @@map("course_modules")
}

model CourseTopic {
  id          Int              @id @default(autoincrement())
  moduleId    Int
  title       String
  description String?          @db.Text
  sortOrder   Int              @default(0)
  isPublished Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  module    CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  resources CourseResource[]

  @@index([moduleId])
  @@map("course_topics")
}

// ---------------------------------------------------------------------------
// Course Resources
// ---------------------------------------------------------------------------

model CourseResource {
  id          Int          @id @default(autoincrement())
  courseId    Int
  topicId     Int?
  title       String
  objectKey   String       @db.VarChar(500)
  contentType String       @default("application/pdf")
  sizeBytes   BigInt?
  sortOrder   Int          @default(0)
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic  CourseTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([topicId])
  @@map("course_resources")
}

// ---------------------------------------------------------------------------
// Course Landing Page CMS & Dynamic Marketing Content
// ---------------------------------------------------------------------------

model CourseLandingContent {
  id                         Int      @id @default(autoincrement())
  courseId                   Int      @unique
  
  // Hero settings
  heroEnabled                Boolean  @default(true)
  heroEyebrow                String?  @db.VarChar(255)
  heroTitleOverride          String?  @db.VarChar(255)
  heroAccentText             String?  @db.VarChar(255)
  heroDescription            String?  @db.Text
  heroMediaType              String?  @default("THUMBNAIL") @db.VarChar(50)
  heroMediaUrl               String?  @db.VarChar(500)
  heroMediaCaption           String?  @db.VarChar(255)
  heroPrimaryCtaLabel        String?  @db.VarChar(100)
  secondaryCtaLabel          String?  @default("Explore Curriculum") @db.VarChar(100)
  secondaryCtaTarget         String?  @default("#curriculum") @db.VarChar(255)
  priceSubtitle              String?  @db.VarChar(100)

  // About / Context section
  aboutEnabled               Boolean  @default(true)
  aboutEyebrow               String?  @db.VarChar(100)
  aboutHeading               String?  @db.VarChar(255)
  aboutBody                  String?  @db.Text

  // Takeaways section
  takeawaysEnabled           Boolean  @default(true)
  takeawaysEyebrow           String?  @db.VarChar(100)
  takeawaysHeading           String?  @db.VarChar(255)
  takeawaysDescription       String?  @db.Text

  // Sneak Peek dark band
  sneakPeekEnabled           Boolean  @default(true)
  sneakPeekEyebrow           String?  @db.VarChar(100)
  sneakPeekHeading           String?  @db.VarChar(255)
  sneakPeekDescription       String?  @db.Text
  sneakPeekMediaUrl           String?  @db.VarChar(500)

  // Clinical Questions
  questionsEnabled           Boolean  @default(true)
  questionsEyebrow           String?  @db.VarChar(100)
  questionsHeading           String?  @db.VarChar(255)

  // Curriculum display settings
  curriculumEnabled          Boolean  @default(true)
  curriculumEyebrow          String?  @db.VarChar(100)
  curriculumHeading          String?  @db.VarChar(255)
  curriculumIntro            String?  @db.Text
  curriculumDefaultExpanded  Boolean  @default(true)
  showLessonDuration         Boolean  @default(true)
  showLockIcon               Boolean  @default(true)
  showPreviewBadge           Boolean  @default(true)
  curriculumShowSessionCount Boolean  @default(true)
  curriculumShowTotalDuration Boolean @default(true)
  curriculumShowResourceCount Boolean @default(true)

  // Certificate section (OFF by default!)
  certificateSectionEnabled  Boolean  @default(false)
  certificateEyebrow         String?  @default("E-Certificate") @db.VarChar(100)
  certificateHeading         String?  @db.VarChar(255)
  certificateBody            String?  @db.Text
  certificateNote            String?  @db.VarChar(255)

  // Target audience section
  audienceEnabled            Boolean  @default(true)
  audienceEyebrow            String?  @db.VarChar(100)
  audienceHeading            String?  @db.VarChar(255)
  audienceForHeading         String?  @default("Good fit for") @db.VarChar(100)
  audienceNotForHeading      String?  @default("Probably not for") @db.VarChar(100)

  // FAQ section
  faqEnabled                 Boolean  @default(true)
  faqEyebrow                 String?  @default("Questions & Answers") @db.VarChar(100)
  faqHeading                 String?  @default("Frequently asked course questions") @db.VarChar(255)

  // Final CTA card
  finalCtaEnabled            Boolean  @default(true)
  finalCtaEyebrow            String?  @default("Start Learning Today") @db.VarChar(100)
  finalCtaHeading            String?  @db.VarChar(255)
  finalCtaBody               String?  @db.Text
  finalCtaButtonLabel        String?  @db.VarChar(100)
  finalCtaBadgeText          String?  @db.VarChar(255)
  finalCtaLine1              String?  @db.VarChar(255)
  finalCtaLine2              String?  @db.VarChar(255)
  finalCtaLine3              String?  @db.VarChar(255)

  // Sticky bottom conversion bar
  stickyCtaEnabled           Boolean  @default(true)
  stickyCtaText              String?  @db.VarChar(255)
  stickyCtaButtonLabel       String?  @db.VarChar(100)

  // Access display setting
  accessLabel                String?  @db.VarChar(100)

  // Why Register section
  whyRegisterEnabled         Boolean  @default(true)
  whyRegisterEyebrow         String?  @db.VarChar(100)
  whyRegisterHeading         String?  @db.VarChar(255)
  whyRegisterIntro           String?  @db.Text
  whyRegisterEmphasisText    String?  @db.Text
  whyRegisterWantHeading     String?  @default("This course is for you if you want to:") @db.VarChar(255)
  whyRegisterGetHeading      String?  @default("What you get:") @db.VarChar(255)
  whyRegisterClosingText     String?  @db.Text

  // Highlights section
  highlightsEnabled          Boolean  @default(true)
  highlightsEyebrow          String?  @default("Course Highlights") @db.VarChar(100)
  highlightsHeading          String?  @default("Course Highlights") @db.VarChar(255)
  highlightsDescription      String?  @db.Text

  // Purchase Card / Access Box
  purchaseCardEnabled        Boolean  @default(true)
  purchaseCardEyebrow        String?  @db.VarChar(100)
  purchaseCardHeading        String?  @db.VarChar(255)
  purchaseCardDescription    String?  @db.Text
  purchaseCardButtonLabel    String?  @db.VarChar(100)

  // Comparison section
  comparisonEnabled          Boolean  @default(false)
  comparisonEyebrow          String?  @db.VarChar(100)
  comparisonHeading          String?  @db.VarChar(255)
  comparisonDescription      String?  @db.Text

  // How will you get access section
  accessSectionEnabled       Boolean  @default(false)
  accessEyebrow              String?  @db.VarChar(100)
  accessHeading              String?  @db.VarChar(255)
  accessDescription          String?  @db.Text
  accessMediaType            String?  @default("NONE") @db.VarChar(20) // "VIDEO", "IMAGE", "NONE"
  accessMediaUrl             String?  @db.VarChar(500)
  accessStepsEnabled         Boolean  @default(true)

  // Social Proof section
  socialProofEnabled         Boolean  @default(false)
  socialProofMode            String?  @default("AUTO") @db.VarChar(20) // "AUTO", "MANUAL"
  socialProofValue           String?  @db.VarChar(100)
  socialProofLabel           String?  @db.VarChar(255)

  // Reviews / Testimonials section (DISABLED by default!)
  reviewsEnabled             Boolean  @default(false)
  reviewsEyebrow             String?  @default("Student Reviews") @db.VarChar(100)
  reviewsHeading             String?  @default("Reviews from dentists who transformed their practice with this masterclass") @db.VarChar(255)
  reviewsIntro               String?  @db.Text

  // Meet Your Mentor section settings
  mentorSectionEnabled       Boolean  @default(true)
  mentorEyebrow              String?  @default("Meet Your Mentor") @db.VarChar(100)
  mentorHeading              String?  @default("Learn from an Experienced Clinician") @db.VarChar(255)

  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_landing_contents")
}

