<%
/* Presentation-only icon lookup (icon isn't stored in the DB). Falls back to
   a generic icon for any category slug not listed here. */
const categoryIcons = {
    cosmetology: 'bi-scissors',
    aesthetics: 'bi-stars',
    'dental-sciences': 'bi-heart-pulse',
    'skin-hair': 'bi-person-hearts',
};

/* Presentation-only demo imagery lookup (image isn't stored in the DB). */
const categoryImages = {
    cosmetology: '/images/demo/category-cosmetology.jpg',
    aesthetics: '/images/demo/category-aesthetics.jpg',
    'dental-sciences': '/images/demo/category-dental.jpg',
    'skin-hair': '/images/demo/category-skin-hair.jpg',
};
%>

<% const sec = cms.categories; %>
<% if (sec.enabled) { %>
<!-- CATEGORIES -->
<section class="section-space" id="categories">

    <div class="container">

        <div class="section-heading reveal-element">

            <div class="section-tag">
                <%= sec.eyebrow %>
            </div>

            <h2 class="section-title">
                <%= sec.heading %>
            </h2>

            <% if (sec.description) { %>
            <p class="section-description">
                <%= sec.description %>
            </p>
            <% } %>

        </div>


        <% if (categories.length === 0) { %>

            <p class="text-center text-muted">
                <%= sec.emptyText %>
            </p>

        <% } else { %>

            <div class="row g-4">

                <% categories.forEach(function (category) { %>

                    <div class="col-6 col-lg-3 reveal-element">

                        <a href="/courses?category=<%= category.slug %>" class="text-decoration-none">

                            <div class="category-card">

                                <% if (categoryImages[category.slug]) { %>
                                    <div class="category-image-wrap">
                                        <img
                                            class="category-image"
                                            src="<%= categoryImages[category.slug] %>"
                                            alt="<%= category.name %>"
                                            loading="lazy">
                                    </div>
                                <% } %>

                                <div class="category-icon">
                                    <i class="bi <%= categoryIcons[category.slug] || 'bi-mortarboard' %>"></i>
                                </div>

                                <h3 class="category-title">
                                    <%= category.name %>
                                </h3>

                                <div class="category-count">
                                    <%= category._count.courses %> Course<%= category._count.courses === 1 ? '' : 's' %>
                                </div>

                            </div>

                        </a>

                    </div>

                <% }); %>

            </div>

        <% } %>

    </div>

</section>
<% } %>
