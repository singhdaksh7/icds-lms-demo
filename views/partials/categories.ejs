<%
/* Presentation-only icon lookup (icon isn't stored in the DB). Falls back to
   a generic icon for any category slug not listed here. */
const categoryIcons = {
    cosmetology: 'bi-scissors',
    aesthetics: 'bi-stars',
    'dental-sciences': 'bi-heart-pulse',
    'skin-hair': 'bi-person-hearts',
};

%>

<% const sec = cms.categories; %>
<% if (sec.enabled) { %>
<!-- CATEGORIES -->
<section class="section-space categories-section" id="categories">

    <div class="container">

        <div class="section-heading reveal-element">

            <div class="section-tag">
                <%= sec.eyebrow %>
            </div>

            <h2 class="section-title">
                <%= sec.heading %>
            </h2>

            <% if (sec.description) { %>
            <p class="section-description">
                <%= sec.description %>
            </p>
            <% } %>

        </div>


        <% if (categories.length === 0) { %>

            <p class="text-center text-muted">
                <%= sec.emptyText %>
            </p>

        <% } else if (categories.length === 1) { %>
            <% const category = categories[0]; %>
            <div class="category-featured-wrap reveal-element">
                <div class="category-card category-featured-card">
                    <div class="category-featured-content">
                        <div class="category-featured-eyebrow">
                            <i class="bi bi-award-fill me-1"></i> Featured Discipline
                        </div>
                        <h3 class="category-title category-featured-title">
                            <%= category.name %>
                        </h3>
                        <% if (category.description) { %>
                            <p class="category-featured-desc">
                                <%= category.description %>
                            </p>
                        <% } else { %>
                            <p class="category-featured-desc">
                                Explore master-level clinical training in <%= category.name %>, with structured modules, evidence-based workflows, and practical hands-on demonstrations.
                            </p>
                        <% } %>
                        <div class="category-featured-meta">
                            <span class="category-count category-featured-pill">
                                <i class="bi bi-collection-play-fill me-1"></i>
                                <%= category._count.courses %> Course<%= category._count.courses === 1 ? '' : 's' %>
                            </span>
                        </div>
                        <div class="category-featured-action">
                            <a href="/courses?category=<%= category.slug %>" class="category-featured-btn">
                                <span>Explore Courses</span>
                                <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                    <div class="category-featured-media">
                        <% if (category.imageUrl) { %>
                            <img
                                class="category-featured-img"
                                src="<%= category.imageUrl %>"
                                alt="<%= category.name %>"
                                loading="lazy"
                                data-fallback-src="/assets/images/hero-placeholder.svg">
                        <% } else { %>
                            <div class="category-featured-fallback">
                                <i class="bi <%= categoryIcons[category.slug] || 'bi-mortarboard' %>"></i>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

        <% } else { %>

            <div class="row g-4 categories-grid">

                <% categories.forEach(function (category) { %>

                    <div class="col-12 col-md-6 col-lg-4 reveal-element">

                        <a href="/courses?category=<%= category.slug %>" class="text-decoration-none d-block h-100">

                            <div class="category-card h-100">

                                <% if (category.imageUrl) { %>
                                    <div class="category-image-wrap">
                                        <img
                                            class="category-image"
                                            src="<%= category.imageUrl %>"
                                            alt="<%= category.name %>"
                                            loading="lazy"
                                            data-fallback-src="/assets/images/hero-placeholder.svg">
                                    </div>
                                <% } %>

                                <div class="category-card-body">
                                    <div class="category-icon">
                                        <i class="bi <%= categoryIcons[category.slug] || 'bi-mortarboard' %>"></i>
                                    </div>

                                    <h3 class="category-title">
                                        <%= category.name %>
                                    </h3>

                                    <div class="category-count">
                                        <%= category._count.courses %> Course<%= category._count.courses === 1 ? '' : 's' %>
                                    </div>
                                </div>

                            </div>

                        </a>

                    </div>

                <% }); %>

            </div>

        <% } %>

    </div>

</section>
<% } %>
