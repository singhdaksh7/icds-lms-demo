<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%- include('./seo-head', { pageTitle, metaDescription, seo: typeof seo !== 'undefined' ? seo : undefined, site }) %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..800&family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap"
          rel="stylesheet">

    <!-- Bootstrap 5.3.8 -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous">

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+"
        crossorigin="anonymous">

    <!-- Site styles (extracted from the original inline <style> block) -->
    <link rel="stylesheet" href="/css/main.css">
    <script src="/js/ui-guards.js"></script>
</head>

<body>

<% const h = cms.header; const nav = cms.nav; %>
<% if (h.stripEnabled) { %>
<!-- TOP BAR -->
<div class="top-strip">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-stars me-1"></i>
                <%= h.stripText || cms.brand.tagline %>
            </div>

            <div class="d-flex gap-3">
                <% if (h.stripShowPhone && site.phoneHref) { %><a href="<%= site.phoneHref %>">
                    <i class="bi bi-telephone me-1"></i> <%= site.contactPhone %>
                </a><% } %>

                <% if (h.stripShowEmail && site.contactEmail) { %>
                    <a href="mailto:<%= site.contactEmail %>">
                        <i class="bi bi-envelope me-1"></i> <%= site.contactEmail %>
                    </a>
                <% } %>
            </div>
        </div>
    </div>
</div>
<% } %>


<!-- NAVIGATION -->
<nav class="navbar navbar-expand-lg main-navigation sticky-top">

    <div class="container">

        <a href="/" class="brand-logo">

            <% if (cms.brand.logoUrl) { %>
                <img class="brand-logo-image" src="<%= cms.brand.logoUrl %>" alt="" data-fallback-src="/assets/icons/favicon.svg">
            <% } else { %>
                <span class="brand-logo-mark">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>
            <% } %>

            <span class="brand-logo-text">
                <% const brandParts = String(site.name).split(' & '); %>
                <% if (brandParts.length === 2) { %>
                    <%= brandParts[0] %>
                    <small>&amp; <%= brandParts[1] %></small>
                <% } else { %>
                    <%= site.name %>
                <% } %>
            </span>

        </a>

        <button
            class="navbar-toggler border-0 shadow-none"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavigation">

            <i class="bi bi-list fs-2"></i>

        </button>

        <div class="collapse navbar-collapse" id="mainNavigation">

            <ul class="navbar-nav mx-auto align-items-lg-center">

                <% if (typeof navHeader !== 'undefined' && navHeader) { %>
                <%# Admin-managed navigation (Admin > Navigation). Courses keeps its category dropdown. %>
                <% const dynCategories = (typeof footerCategories !== 'undefined' && footerCategories) ? footerCategories : []; %>
                <% const here = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : ''; %>
                <% navHeader.forEach(function (item) { %>
                    <% const itemPath = item.external ? '' : String(item.url).split(/[?#]/)[0]; %>
                    <% const isActive = !item.external && here && (itemPath === '/' ? here === '/' : (here === itemPath || here.indexOf(itemPath + '/') === 0)); %>
                    <% if (item.isCourses && dynCategories.length) { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link navigation-link dropdown-toggle<%= isActive ? ' active' : '' %>" href="<%= item.url %>" data-bs-toggle="dropdown" aria-expanded="false"><%= item.label %></a>
                            <ul class="dropdown-menu border-0 shadow-lg">
                                <li><a class="dropdown-item py-2" href="<%= item.url %>"><%= nav.allCoursesLabel %></a></li>
                                <% dynCategories.forEach(function (category) { %>
                                    <li><a class="dropdown-item py-2" href="/courses?category=<%= encodeURIComponent(category.slug) %>"><%= category.name %></a></li>
                                <% }); %>
                            </ul>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link navigation-link<%= isActive ? ' active' : '' %>" href="<%= item.url %>"<% if (isActive) { %> aria-current="page"<% } %><% if (item.openInNewTab) { %> target="_blank" rel="noopener noreferrer"<% } %>><%= item.label %></a>
                        </li>
                    <% } %>
                <% }); %>
                <% } else { %>
                <% if (nav.showHome) { %>
                    <li class="nav-item">
                        <a class="nav-link navigation-link active" href="/#home">
                            <%= nav.homeLabel %>
                        </a>
                    </li>
                <% } %>

                <% const navCategories = (typeof footerCategories !== 'undefined' && footerCategories) ? footerCategories : []; %>
                <% if (nav.showCourses) { %>
                <% if (navCategories.length) { %>
                    <li class="nav-item dropdown">

                        <a
                            class="nav-link navigation-link dropdown-toggle"
                            href="/courses"
                            data-bs-toggle="dropdown">

                            <%= nav.coursesLabel %>
                        </a>

                        <ul class="dropdown-menu border-0 shadow-lg">

                            <li>
                                <a class="dropdown-item py-2" href="/courses">
                                    <%= nav.allCoursesLabel %>
                                </a>
                            </li>

                            <% navCategories.forEach(function (category) { %>
                                <li>
                                    <a class="dropdown-item py-2" href="/courses?category=<%= encodeURIComponent(category.slug) %>">
                                        <%= category.name %>
                                    </a>
                                </li>
                            <% }); %>

                        </ul>

                    </li>
                <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link navigation-link" href="/courses">
                            <%= nav.coursesLabel %>
                        </a>
                    </li>
                <% } %>
                <% } %>

                <% if (nav.showAbout) { %>
                    <li class="nav-item">
                        <a class="nav-link navigation-link" href="/founder">
                            <%= nav.aboutLabel %>
                        </a>
                    </li>
                <% } %>

                <% if (nav.showInstructors) { %>
                    <li class="nav-item">
                        <a class="nav-link navigation-link" href="/#instructors">
                            <%= nav.instructorsLabel %>
                        </a>
                    </li>
                <% } %>

                <% if (nav.showReviews) { %>
                    <li class="nav-item">
                        <a class="nav-link navigation-link" href="/#testimonials">
                            <%= nav.reviewsLabel %>
                        </a>
                    </li>
                <% } %>

                <% if (nav.showFaq) { %>
                    <li class="nav-item">
                        <a class="nav-link navigation-link" href="/#faq">
                            <%= nav.faqLabel %>
                        </a>
                    </li>
                <% } %>

                <% if (nav.showContact) { %>
                    <li class="nav-item">
                        <a class="nav-link navigation-link" href="/contact">
                            <%= nav.contactLabel %>
                        </a>
                    </li>
                <% } %>
                <% } %>

            </ul>

            <div class="d-flex gap-2 align-items-center mt-3 mt-lg-0">

                <% if (typeof currentUser !== 'undefined' && currentUser) { %>

                    <a
                        class="btn login-button"
                        href="<%= currentUser.role === 'ADMIN' ? '/admin' : '/student/dashboard' %>">

                        <i class="bi bi-person-circle me-1"></i>
                        <%= currentUser.name %>

                    </a>

                    <% if (currentUser.role === 'STUDENT') { %>
                        <a class="btn login-button" href="/student/orders">
                            <i class="bi bi-receipt me-1"></i>
                            <%= nav.ordersLabel %>
                        </a>
                    <% } %>

                    <form method="POST" action="/auth/logout" class="m-0">
                        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
                        <button type="submit" class="btn signup-button">
                            <%= nav.logoutLabel %>
                        </button>
                    </form>

                <% } else { %>

                    <a class="btn login-button" href="/login">
                        <%= nav.loginLabel %>
                    </a>

                    <a class="btn signup-button" href="/signup">
                        <%= nav.signupLabel %>
                    </a>

                <% } %>

            </div>

        </div>

    </div>

</nav>

<% if (typeof flash !== 'undefined' && (flash.success || flash.error)) { %>
    <div class="container mt-3">
        <% if (flash.success) { %>
            <div class="alert alert-success"><%= flash.success %></div>
        <% } %>
        <% if (flash.error) { %>
            <div class="alert alert-danger"><%= flash.error %></div>
        <% } %>
    </div>
<% } %>
