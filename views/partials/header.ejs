<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title><%= pageTitle %></title>

    <meta name="description" content="<%= metaDescription %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap"
          rel="stylesheet">

    <!-- Bootstrap 5.3.8 -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous">

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Site styles (extracted from the original inline <style> block) -->
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>

<!-- TOP BAR -->
<div class="top-strip">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-stars me-1"></i>
                Learn. Practice. Grow. Build Your Professional Future.
            </div>

            <div class="d-flex gap-3">
                <a href="tel:+911234567890">
                    <i class="bi bi-telephone me-1"></i> +91 12345 67890
                </a>

                <a href="mailto:info@icds.example">
                    <i class="bi bi-envelope me-1"></i> info@icds.example
                </a>
            </div>
        </div>
    </div>
</div>


<!-- NAVIGATION -->
<nav class="navbar navbar-expand-lg main-navigation sticky-top">

    <div class="container">

        <a href="/" class="brand-logo">

            <span class="brand-logo-mark">
                <i class="bi bi-mortarboard-fill"></i>
            </span>

            <span class="brand-logo-text">
                Institute of Cosmetology
                <small>& Dental Sciences</small>
            </span>

        </a>

        <button
            class="navbar-toggler border-0 shadow-none"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavigation">

            <i class="bi bi-list fs-2"></i>

        </button>

        <div class="collapse navbar-collapse" id="mainNavigation">

            <ul class="navbar-nav mx-auto align-items-lg-center">

                <li class="nav-item">
                    <a class="nav-link navigation-link active" href="/#home">
                        Home
                    </a>
                </li>

                <li class="nav-item dropdown">

                    <a
                        class="nav-link navigation-link dropdown-toggle"
                        href="/#courses"
                        data-bs-toggle="dropdown">

                        Courses
                    </a>

                    <ul class="dropdown-menu border-0 shadow-lg">

                        <li>
                            <a class="dropdown-item py-2" href="/#courses">
                                Cosmetology
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item py-2" href="/#courses">
                                Aesthetics
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item py-2" href="/#courses">
                                Dental Sciences
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item py-2" href="/#courses">
                                Skin & Hair
                            </a>
                        </li>

                    </ul>

                </li>

                <li class="nav-item">
                    <a class="nav-link navigation-link" href="/#about">
                        About
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link navigation-link" href="/#instructors">
                        Instructors
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link navigation-link" href="/#testimonials">
                        Reviews
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link navigation-link" href="/#faq">
                        FAQ
                    </a>
                </li>

            </ul>

            <div class="d-flex gap-2 align-items-center mt-3 mt-lg-0">

                <% if (typeof currentUser !== 'undefined' && currentUser) { %>

                    <a
                        class="btn login-button"
                        href="<%= currentUser.role === 'ADMIN' ? '/admin' : '/student/dashboard' %>">

                        <i class="bi bi-person-circle me-1"></i>
                        <%= currentUser.name %>

                    </a>

                    <form method="POST" action="/auth/logout" class="m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn signup-button">
                            Logout
                        </button>
                    </form>

                <% } else { %>

                    <a class="btn login-button" href="/login">
                        Login
                    </a>

                    <a class="btn signup-button" href="/signup">
                        Sign Up
                    </a>

                <% } %>

            </div>

        </div>

    </div>

</nav>

<% if (typeof flash !== 'undefined' && (flash.success || flash.error)) { %>
    <div class="container mt-3">
        <% if (flash.success) { %>
            <div class="alert alert-success"><%= flash.success %></div>
        <% } %>
        <% if (flash.error) { %>
            <div class="alert alert-danger"><%= flash.error %></div>
        <% } %>
    </div>
<% } %>
