<!-- FAQ -->
<section class="section-space faq-section" id="faq">

    <div class="container">

        <div class="section-heading reveal-element">

            <div class="section-tag">
                Frequently Asked Questions
            </div>

            <h2 class="section-title">
                Everything you need to know
            </h2>

        </div>


        <div class="row justify-content-center">

            <div class="col-lg-9">

                <div class="accordion faq-accordion" id="faqAccordion">

                    <div class="accordion-item reveal-element">

                        <h2 class="accordion-header">

                            <button
                                class="accordion-button"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqOne">

                                How do I purchase a course?

                            </button>

                        </h2>

                        <div
                            id="faqOne"
                            class="accordion-collapse collapse show"
                            data-bs-parent="#faqAccordion">

                            <div class="accordion-body">
                                Create your student account and open the course
                                you're interested in. Free courses give you
                                instant access. For paid courses, submit a
                                Request Enrollment and our team will contact you
                                to complete enrollment — once confirmed, the
                                course appears in your student dashboard.
                            </div>

                        </div>

                    </div>


                    <div class="accordion-item reveal-element">

                        <h2 class="accordion-header">

                            <button
                                class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqTwo">

                                Can I access my course from mobile?

                            </button>

                        </h2>

                        <div
                            id="faqTwo"
                            class="accordion-collapse collapse"
                            data-bs-parent="#faqAccordion">

                            <div class="accordion-body">
                                Yes. The learning platform is designed to work
                                across desktop, tablet and mobile devices.
                            </div>

                        </div>

                    </div>


                    <div class="accordion-item reveal-element">

                        <h2 class="accordion-header">

                            <button
                                class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqThree">

                                Do courses have certificates?

                            </button>

                        </h2>

                        <div
                            id="faqThree"
                            class="accordion-collapse collapse"
                            data-bs-parent="#faqAccordion">

                            <div class="accordion-body">
                                Eligible courses provide a certificate once you
                                complete every lesson in the course.
                            </div>

                        </div>

                    </div>


                    <div class="accordion-item reveal-element">

                        <h2 class="accordion-header">

                            <button
                                class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqFour">

                                How long will I have access to a purchased course?

                            </button>

                        </h2>

                        <div
                            id="faqFour"
                            class="accordion-collapse collapse"
                            data-bs-parent="#faqAccordion">

                            <div class="accordion-body">
                                Course access duration can be configured by the
                                institute. The course detail page should clearly
                                display the access period before purchase.
                            </div>

                        </div>

                    </div>


                    <div class="accordion-item reveal-element">

                        <h2 class="accordion-header">

                            <button
                                class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqFive">

                                Can I watch the videos more than once?

                            </button>

                        </h2>

                        <div
                            id="faqFive"
                            class="accordion-collapse collapse"
                            data-bs-parent="#faqAccordion">

                            <div class="accordion-body">
                                Yes. Students can revisit available lessons
                                according to the access rules of their purchased course.
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
