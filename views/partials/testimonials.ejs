<% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
<!-- TESTIMONIALS -->
<section class="section-space" id="testimonials">

    <div class="container">

        <div class="section-heading reveal-element">

            <div class="section-tag">
                Student Stories
            </div>

            <h2 class="section-title">
                What our learners say
            </h2>

            <p class="section-description">
                Real reviews from enrolled students.
            </p>

        </div>


        <div class="row g-4">

            <% reviews.forEach(function (review) { %>

                <div class="col-md-6 col-lg-4 reveal-element">

                    <div class="testimonial-card">

                        <div class="testimonial-quote">
                            <i class="bi bi-quote"></i>
                        </div>

                        <% if (review.comment) { %>
                            <p class="testimonial-text">
                                <%= review.comment %>
                            </p>
                        <% } %>

                        <div class="testimonial-user">

                            <div class="testimonial-avatar-fallback" aria-hidden="true">
                                <i class="bi bi-person-fill"></i>
                            </div>

                            <div>
                                <strong><%= review.user.name %></strong>
                                <span><%= review.course.title %></span>
                            </div>

                        </div>

                    </div>

                </div>

            <% }); %>

        </div>

    </div>

</section>
<% } %>
