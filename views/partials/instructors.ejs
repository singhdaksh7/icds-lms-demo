<% const sec = cms.instructors; %>
<% if (sec.enabled) { %>
<!-- INSTRUCTORS -->
<section class="section-space" id="instructors">

    <div class="container">

        <div class="section-heading reveal-element">

            <div class="section-tag">
                <%= sec.eyebrow %>
            </div>

            <h2 class="section-title">
                <%= sec.heading %>
            </h2>

            <p class="section-description">
                <%= sec.description %>
            </p>

        </div>


        <% if (instructors.length === 0) { %>

            <p class="text-center text-muted">
                <%= sec.emptyStateText %>
            </p>

        <% } else { %>

            <div class="row g-4">

                <% instructors.forEach(function (instructor) { %>

                    <div class="col-md-6 col-lg-3 reveal-element">

                        <div class="instructor-card">

                            <div class="instructor-image-wrap">

                                <img
                                    class="instructor-image"
                                    src="<%= instructor.photoUrl || cms.brand.defaultInstructorImageUrl || '/assets/images/instructor-placeholder.svg' %>"
                                    alt="<%= instructor.name %>"
                                    loading="lazy"
                                    data-fallback-src="/assets/images/instructor-placeholder.svg">

                                <% if (instructor.linkedinUrl || instructor.instagramUrl) { %>
                                    <div class="instructor-social">

                                        <% if (instructor.linkedinUrl) { %>
                                            <a href="<%= instructor.linkedinUrl %>" target="_blank" rel="noopener noreferrer">
                                                <i class="bi bi-linkedin"></i>
                                            </a>
                                        <% } %>

                                        <% if (instructor.instagramUrl) { %>
                                            <a href="<%= instructor.instagramUrl %>" target="_blank" rel="noopener noreferrer">
                                                <i class="bi bi-instagram"></i>
                                            </a>
                                        <% } %>

                                    </div>
                                <% } %>

                            </div>

                            <h3 class="instructor-name">
                                <%= instructor.name %>
                            </h3>

                            <div class="instructor-role">
                                <%= instructor.title || '' %>
                            </div>

                        </div>

                    </div>

                <% }); %>

            </div>

        <% } %>

    </div>

</section>
<% } %>
