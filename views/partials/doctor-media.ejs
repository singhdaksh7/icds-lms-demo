<%# Doctor VIDEO card used by the homepage mentor block, the /founder hero and the /about founder card.
   Inputs: dm (view-model from doctorMedia.service.toPublicDoctorMedia, mode VIDEO), variant ('mentor'|'founder'|'about'), name.
   The shared reel player builds the iframe / <video> only when it starts: on the visitor's click, or - when the Admin option
   'Autoplay muted' is on (default) - automatically, always MUTED, once the card is scrolled into view (the visitor can unmute).
   The initial HTML has no iframe and no <video>. The object key never reaches the page. #%>
<% const dmv = (typeof dm !== 'undefined' && dm && dm.mode === 'VIDEO' && dm.video) ? dm : null; %>
<% if (dmv) { %>
<%
    const dmName = (typeof name !== 'undefined' && name) ? name : (dmv.fallbackAlt || 'the doctor');
    const dmPoster = dmv.video.posterUrl || dmv.photoUrl || dmv.fallbackPhotoUrl || '';
    const dmVariant = (typeof variant !== 'undefined' && variant) ? variant : 'mentor';
%>
<link rel="stylesheet" href="/css/home-intro-video.css">
<link rel="stylesheet" href="/css/doctor-media.css">
<figure class="doctor-media doctor-media--<%= dmVariant %>">
    <div class="intro-reel doctor-media-card"
         data-intro-reel
         data-kind="<%= dmv.video.kind %>"
         <% if (dmv.video.kind === 'hosted') { %>data-source-url="/api/home/doctor-video/source"<% } else { %>data-embed="<%= dmv.video.embedUrl %>" data-provider="<%= dmv.video.provider %>"<% } %>
         data-muted-start="<%= dmv.video.autoplayMuted ? '1' : '0' %>"
         data-autoplay-mobile="1"
         data-loop="<%= dmv.video.loop ? '1' : '0' %>"
         data-title="Video: <%= dmName %>">
        <button type="button" class="intro-reel-play" data-intro-reel-play aria-label="Play video: <%= dmName %>">
            <% if (dmPoster) { %><img class="intro-reel-poster" src="<%= dmPoster %>" alt="" loading="lazy"><% } else { %><span class="intro-reel-poster is-empty" aria-hidden="true"><i class="bi bi-camera-video"></i></span><% } %>
            <span class="intro-reel-play-icon" aria-hidden="true"><i class="bi bi-play-fill"></i></span>
        </button>
    </div>
    <% if (dmv.caption) { %><figcaption class="doctor-media-caption"><%= dmv.caption %></figcaption><% } %>
</figure>
<script src="/js/home-intro-video.js" defer></script>
<% } %>
