<% const f = cms.footer; const fnav = cms.nav; %>
<!-- FOOTER -->
<footer class="main-footer">

    <div class="container">

        <div class="row g-5">

            <div class="col-lg-4">

                <a href="/" class="footer-brand">
                    <% if (cms.brand.footerLogoUrl) { %>
                        <img class="footer-logo-image" src="<%= cms.brand.footerLogoUrl %>" alt="<%= site.name %>" data-fallback-src="/assets/icons/favicon.svg">
                    <% } else { %>
                        <%= site.name %>
                    <% } %>
                </a>

                <p class="footer-description">
                    <%= cms.brand.footerDescription %>
                </p>

                <% if (site.address) { %>
                    <p class="footer-description mb-0">
                        <i class="bi bi-geo-alt me-1"></i><%= site.address %>
                    </p>
                <% } %>

                <% if (site.hasSocialLinks) { %>
                    <div class="footer-social">
                        <% if (site.social.facebook) { %>
                            <a href="<%= site.social.facebook %>" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <% } %>
                        <% if (site.social.instagram) { %>
                            <a href="<%= site.social.instagram %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <% } %>
                        <% if (site.social.youtube) { %>
                            <a href="<%= site.social.youtube %>" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        <% } %>
                        <% if (site.social.linkedin) { %>
                            <a href="<%= site.social.linkedin %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <% } %>
                    </div>
                <% } %>

            </div>


            <div class="col-6 col-lg-2">

                <h4 class="footer-title">
                    <%= f.platformHeading %>
                </h4>

                <ul class="footer-links">

                    <li>
                        <a href="/courses"><%= f.allCoursesLabel %></a>
                    </li>

                    <% if (cms.categories.enabled) { %>
                    <li>
                        <a href="/#categories"><%= f.categoriesLinkLabel %></a>
                    </li>
                    <% } %>

                    <% if (fnav.showInstructors && cms.instructors.enabled) { %>
                    <li>
                        <a href="/#instructors"><%= f.instructorsLabel %></a>
                    </li>
                    <% } %>

                    <% if (fnav.showReviews && cms.reviews.enabled) { %>
                    <li>
                        <a href="/#testimonials"><%= f.reviewsLabel %></a>
                    </li>
                    <% } %>

                    <% if (fnav.showFaq && cms.faq.enabled) { %>
                    <li>
                        <a href="/#faq"><%= f.faqLabel %></a>
                    </li>
                    <% } %>

                </ul>

            </div>


            <div class="col-6 col-lg-2">

                <h4 class="footer-title">
                    <%= f.categoriesHeading %>
                </h4>

                <ul class="footer-links">

                    <% if (typeof footerCategories !== 'undefined' && footerCategories.length) { %>
                        <% footerCategories.slice(0, 4).forEach(function (category) { %>
                            <li>
                                <a href="/courses?category=<%= encodeURIComponent(category.slug) %>"><%= category.name %></a>
                            </li>
                        <% }); %>
                    <% } else { %>
                        <li>
                            <a href="/courses"><%= f.allCoursesLabel %></a>
                        </li>
                    <% } %>

                </ul>

            </div>


            <div class="col-6 col-lg-2">

                <h4 class="footer-title">
                    <%= f.studentHeading %>
                </h4>

                <ul class="footer-links">

                    <% if (typeof currentUser !== 'undefined' && currentUser) { %>

                        <li>
                            <a href="<%= currentUser.role === 'ADMIN' ? '/admin' : '/student/dashboard' %>">
                                <%= f.dashboardLabel %>
                            </a>
                        </li>

                    <% } else { %>

                        <li>
                            <a href="/login">
                                <%= f.loginLabel %>
                            </a>
                        </li>

                        <li>
                            <a href="/signup">
                                <%= f.createAccountLabel %>
                            </a>
                        </li>

                    <% } %>

                    <li>
                        <a href="<%= (typeof currentUser !== 'undefined' && currentUser) ? '/student/dashboard' : '/login?returnTo=' + encodeURIComponent('/student/dashboard') %>">
                            <%= f.myCoursesLabel %>
                        </a>
                    </li>

                    <li>
                        <a href="<%= (typeof currentUser !== 'undefined' && currentUser) ? '/student/certificates' : '/login?returnTo=' + encodeURIComponent('/student/certificates') %>">
                            <%= f.certificatesLabel %>
                        </a>
                    </li>

                    <li>
                        <a href="/contact">
                            <%= f.helpLabel %>
                        </a>
                    </li>

                </ul>

            </div>


            <div class="col-6 col-lg-2">

                <h4 class="footer-title">
                    <%= f.contactHeading %>
                </h4>

                <ul class="footer-links">

                    <% if (site.phoneHref) { %>
                        <li>
                            <a href="<%= site.phoneHref %>">
                                <%= site.contactPhone %>
                            </a>
                        </li>
                    <% } %>

                    <% if (site.contactEmail) { %>
                        <li>
                            <a href="mailto:<%= site.contactEmail %>">
                                <%= site.contactEmail %>
                            </a>
                        </li>
                    <% } %>

                    <li>
                        <a href="/contact">
                            <%= f.contactUsLabel %>
                        </a>
                    </li>

                </ul>

            </div>

        </div>


        <div class="footer-bottom">

            <div class="row align-items-center">

                <div class="col-md-6">
                    &copy; <%= new Date().getFullYear() %> <%= site.copyrightName %>.
                    <%= f.copyrightNotice %>
                </div>

                <div class="col-md-6 text-md-end mt-2 mt-md-0">

                    <a href="/privacy" class="text-white-50 text-decoration-none me-3">
                        <%= f.privacyLabel %>
                    </a>

                    <a href="/terms" class="text-white-50 text-decoration-none">
                        <%= f.termsLabel %>
                    </a>

                </div>

            </div>

        </div>

    </div>

</footer>


<!-- FLOATING HELP -->
<div class="floating-help">

    <button
        type="button"
        aria-label="<%= f.supportHeading %>"
        data-bs-toggle="modal"
        data-bs-target="#supportModal">

        <i class="bi bi-chat-dots-fill"></i>

    </button>

</div>


<!-- SUPPORT MODAL -->
<div
    class="modal fade"
    id="supportModal"
    tabindex="-1"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-body p-4">

                <div class="d-flex justify-content-between mb-4">

                    <div>

                        <h4 class="mb-1">
                            <%= f.supportHeading %>
                        </h4>

                        <p class="small mb-0">
                            <%= f.supportText %>
                        </p>

                    </div>

                    <button
                        type="button"
                        class="btn-close"
                        aria-label="Close"
                        data-bs-dismiss="modal">
                    </button>

                </div>


                <a class="d-flex gap-3 p-3 rounded-3 mb-3 text-decoration-none"
                   style="background:#eeefff;"
                   href="<%= site.whatsappHref || '/contact' %>"
                   target="_blank"
                   rel="noopener noreferrer">

                    <i class="bi bi-whatsapp fs-4"
                       style="color:#565acf;"></i>

                    <div>
                        <strong class="d-block text-dark">
                            <%= f.whatsappLabel %>
                        </strong>

                        <small class="text-muted">
                            <%= f.whatsappText %>
                        </small>
                    </div>

                </a>


                <% if (site.supportEmail) { %>
                    <a class="d-flex gap-3 p-3 rounded-3 text-decoration-none"
                       style="background:#eeefff;"
                       href="mailto:<%= site.supportEmail %>">

                        <i class="bi bi-envelope fs-4"
                           style="color:#565acf;"></i>

                        <div>
                            <strong class="d-block text-dark">
                                <%= f.emailSupportLabel %>
                            </strong>

                            <small class="text-muted">
                                <%= site.supportEmail %>
                            </small>
                        </div>

                    </a>
                <% } %>

            </div>

        </div>

    </div>

</div>


<!-- BOOTSTRAP -->
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous">
</script>

<!-- Site behavior (extracted from the original inline <script> block) -->
<script src="/js/main.js"></script>

</body>
</html>
