<!-- FOOTER -->
<footer class="main-footer">

    <div class="container">

        <div class="row g-5">

            <div class="col-lg-4">

                <a href="/" class="footer-brand">
                    <%= site.name %>
                </a>

                <p class="footer-description">
                    A professional learning platform for cosmetology,
                    aesthetics, dental sciences, skin, hair and beauty education.
                </p>

                <% if (site.address) { %>
                    <p class="footer-description mb-0">
                        <i class="bi bi-geo-alt me-1"></i><%= site.address %>
                    </p>
                <% } %>

                <% if (site.hasSocialLinks) { %>
                    <div class="footer-social">
                        <% if (site.social.facebook) { %>
                            <a href="<%= site.social.facebook %>" target="_blank" rel="noopener"><i class="bi bi-facebook"></i></a>
                        <% } %>
                        <% if (site.social.instagram) { %>
                            <a href="<%= site.social.instagram %>" target="_blank" rel="noopener"><i class="bi bi-instagram"></i></a>
                        <% } %>
                        <% if (site.social.youtube) { %>
                            <a href="<%= site.social.youtube %>" target="_blank" rel="noopener"><i class="bi bi-youtube"></i></a>
                        <% } %>
                        <% if (site.social.linkedin) { %>
                            <a href="<%= site.social.linkedin %>" target="_blank" rel="noopener"><i class="bi bi-linkedin"></i></a>
                        <% } %>
                    </div>
                <% } %>

            </div>


            <div class="col-6 col-lg-2">

                <h4 class="footer-title">
                    Platform
                </h4>

                <ul class="footer-links">

                    <li>
                        <a href="/courses">All Courses</a>
                    </li>

                    <li>
                        <a href="/#categories">Categories</a>
                    </li>

                    <li>
                        <a href="/#instructors">Instructors</a>
                    </li>

                    <li>
                        <a href="/#testimonials">Reviews</a>
                    </li>

                    <li>
                        <a href="/#faq">FAQ</a>
                    </li>

                </ul>

            </div>


            <div class="col-6 col-lg-2">

                <h4 class="footer-title">
                    Categories
                </h4>

                <ul class="footer-links">

                    <li>
                        <a href="/courses?category=cosmetology">Cosmetology</a>
                    </li>

                    <li>
                        <a href="/courses?category=aesthetics">Aesthetics</a>
                    </li>

                    <li>
                        <a href="/courses?category=dental-sciences">Dental Sciences</a>
                    </li>

                    <li>
                        <a href="/courses?category=skin-hair">Skin & Hair</a>
                    </li>

                </ul>

            </div>


            <div class="col-6 col-lg-2">

                <h4 class="footer-title">
                    Student
                </h4>

                <ul class="footer-links">

                    <% if (typeof currentUser !== 'undefined' && currentUser) { %>

                        <li>
                            <a href="<%= currentUser.role === 'ADMIN' ? '/admin' : '/student/dashboard' %>">
                                Dashboard
                            </a>
                        </li>

                    <% } else { %>

                        <li>
                            <a href="#" data-bs-toggle="modal" data-bs-target="#loginModal">
                                Login
                            </a>
                        </li>

                        <li>
                            <a href="#" data-bs-toggle="modal" data-bs-target="#signupModal">
                                Create Account
                            </a>
                        </li>

                    <% } %>

                    <li>
                        <a href="<%= (typeof currentUser !== 'undefined' && currentUser) ? '/student/dashboard' : '/login?returnTo=' + encodeURIComponent('/student/dashboard') %>">
                            My Courses
                        </a>
                    </li>

                    <li>
                        <a href="<%= (typeof currentUser !== 'undefined' && currentUser) ? '/student/certificates' : '/login?returnTo=' + encodeURIComponent('/student/certificates') %>">
                            Certificates
                        </a>
                    </li>

                    <li>
                        <a href="/contact">
                            Help Center
                        </a>
                    </li>

                </ul>

            </div>


            <div class="col-6 col-lg-2">

                <h4 class="footer-title">
                    Contact
                </h4>

                <ul class="footer-links">

                    <li>
                        <% if (site.phoneHref) { %><a href="<%= site.phoneHref %>">
                            <%= site.contactPhone %>
                        </a>
                        <% } %>
                    </li>

                    <li>
                        <a href="mailto:<%= site.contactEmail %>">
                            <%= site.contactEmail %>
                        </a>
                    </li>

                    <li>
                        <a href="/contact">
                            Contact Us
                        </a>
                    </li>

                </ul>

            </div>

        </div>


        <div class="footer-bottom">

            <div class="row align-items-center">

                <div class="col-md-6">
                    &copy; <%= new Date().getFullYear() %> <%= site.copyrightName %>.
                    All Rights Reserved.
                </div>

                <div class="col-md-6 text-md-end mt-2 mt-md-0">

                    <a href="/privacy" class="text-white-50 text-decoration-none me-3">
                        Privacy Policy
                    </a>

                    <a href="/terms" class="text-white-50 text-decoration-none">
                        Terms & Conditions
                    </a>

                </div>

            </div>

        </div>

    </div>

</footer>


<!-- LOGIN MODAL -->
<div
    class="modal fade"
    id="loginModal"
    tabindex="-1"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <div class="row g-0">

                <div class="col-md-5 d-none d-md-block">

                    <div class="auth-brand-panel">

                        <h3>
                            Welcome back.
                        </h3>

                        <p>
                            Continue your learning journey and access
                            all your purchased courses from one place.
                        </p>

                        <div class="auth-feature">
                            <i class="bi bi-check-circle-fill"></i>
                            Access your purchased courses
                        </div>

                        <div class="auth-feature">
                            <i class="bi bi-check-circle-fill"></i>
                            Track your learning progress
                        </div>

                        <div class="auth-feature">
                            <i class="bi bi-check-circle-fill"></i>
                            Download eligible certificates
                        </div>

                    </div>

                </div>


                <div class="col-md-7">

                    <div class="auth-form-area">

                        <div class="d-flex justify-content-between">

                            <div>

                                <h4>
                                    Student Login
                                </h4>

                                <p>
                                    Sign in to continue learning.
                                </p>

                            </div>

                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                            </button>

                        </div>

                        <form class="mt-4" method="POST" action="/auth/login">

                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <div class="mb-3">

                                <label class="form-label small fw-semibold">
                                    Email Address
                                </label>

                                <input
                                    type="email"
                                    name="email"
                                    class="form-control form-control-custom"
                                    placeholder="you@example.com"
                                    required>

                            </div>


                            <div class="mb-3">

                                <label class="form-label small fw-semibold">
                                    Password
                                </label>

                                <input
                                    type="password"
                                    name="password"
                                    class="form-control form-control-custom"
                                    placeholder="Enter password"
                                    required>

                            </div>


                            <div class="d-flex justify-content-end mb-4">

                                <a
                                    href="/forgot-password"
                                    class="small text-decoration-none"
                                    style="color:#565acf;">

                                    Forgot Password?

                                </a>

                            </div>


                            <button type="submit" class="auth-submit">
                                Login to Account
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- SIGNUP MODAL -->
<div
    class="modal fade"
    id="signupModal"
    tabindex="-1"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <div class="row g-0">

                <div class="col-md-5 d-none d-md-block">

                    <div class="auth-brand-panel">

                        <h3>
                            Start learning today.
                        </h3>

                        <p>
                            Create your student account and start
                            building professional skills through expert-led courses.
                        </p>

                        <div class="auth-feature">
                            <i class="bi bi-check-circle-fill"></i>
                            One account for all courses
                        </div>

                        <div class="auth-feature">
                            <i class="bi bi-check-circle-fill"></i>
                            Personal learning dashboard
                        </div>

                        <div class="auth-feature">
                            <i class="bi bi-check-circle-fill"></i>
                            Track progress and certificates
                        </div>

                    </div>

                </div>


                <div class="col-md-7">

                    <div class="auth-form-area">

                        <div class="d-flex justify-content-between">

                            <div>

                                <h4>
                                    Create Account
                                </h4>

                                <p>
                                    Join thousands of learners.
                                </p>

                            </div>

                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                            </button>

                        </div>

                        <form class="mt-4" method="POST" action="/auth/signup">

                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <div class="row g-3">

                                <div class="col-12">

                                    <label class="form-label small fw-semibold">
                                        Full Name
                                    </label>

                                    <input
                                        type="text"
                                        name="name"
                                        class="form-control form-control-custom"
                                        placeholder="Your full name"
                                        required>

                                </div>


                                <div class="col-12">

                                    <label class="form-label small fw-semibold">
                                        Email Address
                                    </label>

                                    <input
                                        type="email"
                                        name="email"
                                        class="form-control form-control-custom"
                                        placeholder="you@example.com"
                                        required>

                                </div>


                                <div class="col-12">

                                    <label class="form-label small fw-semibold">
                                        Password
                                    </label>

                                    <input
                                        type="password"
                                        name="password"
                                        class="form-control form-control-custom"
                                        placeholder="Create password (min 8 characters)"
                                        minlength="8"
                                        required>

                                </div>

                                <div class="col-12">

                                    <label class="form-label small fw-semibold">
                                        Confirm Password
                                    </label>

                                    <input
                                        type="password"
                                        name="confirmPassword"
                                        class="form-control form-control-custom"
                                        placeholder="Re-enter password"
                                        minlength="8"
                                        required>

                                </div>

                            </div>


                            <div class="form-check mt-3 mb-4">

                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    id="termsCheck"
                                    required>

                                <label
                                    class="form-check-label small"
                                    for="termsCheck">

                                    I agree to the Terms & Conditions.

                                </label>

                            </div>


                            <button type="submit" class="auth-submit">
                                Create Student Account
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- FLOATING HELP -->
<div class="floating-help">

    <button
        type="button"
        data-bs-toggle="modal"
        data-bs-target="#supportModal">

        <i class="bi bi-chat-dots-fill"></i>

    </button>

</div>


<!-- SUPPORT MODAL -->
<div
    class="modal fade"
    id="supportModal"
    tabindex="-1"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-body p-4">

                <div class="d-flex justify-content-between mb-4">

                    <div>

                        <h4 class="mb-1">
                            Need Help?
                        </h4>

                        <p class="small mb-0">
                            Our team is here to assist you.
                        </p>

                    </div>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>


                <a class="d-flex gap-3 p-3 rounded-3 mb-3 text-decoration-none"
                   style="background:#eeefff;"
                   href="<%= site.whatsappHref || '/contact' %>"
                   target="_blank"
                   rel="noopener">

                    <i class="bi bi-whatsapp fs-4"
                       style="color:#565acf;"></i>

                    <div>
                        <strong class="d-block text-dark">
                            WhatsApp Support
                        </strong>

                        <small class="text-muted">
                            Chat with our support team.
                        </small>
                    </div>

                </a>


                <a class="d-flex gap-3 p-3 rounded-3 text-decoration-none"
                   style="background:#eeefff;"
                   href="mailto:<%= site.supportEmail %>">

                    <i class="bi bi-envelope fs-4"
                       style="color:#565acf;"></i>

                    <div>
                        <strong class="d-block text-dark">
                            Email Support
                        </strong>

                        <small class="text-muted">
                            <%= site.supportEmail %>
                        </small>
                    </div>

                </a>

            </div>

        </div>

    </div>

</div>


<!-- BOOTSTRAP -->
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous">
</script>

<!-- Site behavior (extracted from the original inline <script> block) -->
<script src="/js/main.js"></script>

</body>
</html>
