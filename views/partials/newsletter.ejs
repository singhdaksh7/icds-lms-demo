<!-- NEWSLETTER -->
<section class="newsletter-section">

    <div class="container">

        <div class="newsletter-box reveal-element">

            <div class="row align-items-center">

                <div class="col-lg-7">

                    <div class="section-tag text-white-50">
                        Stay Updated
                    </div>

                    <h2>
                        Get new course updates in your inbox.
                    </h2>

                    <p>
                        Subscribe for new course announcements, educational
                        resources, special offers and upcoming learning programs.
                    </p>

                    <!-- NOTE: submit is still a client-side placeholder (public/js/main.js).
                         Wiring to NewsletterSubscriber via a real endpoint is a later phase. -->
                    <form class="newsletter-form">

                        <input
                            type="email"
                            placeholder="Enter your email address"
                            required>

                        <button type="submit">
                            Subscribe
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>
