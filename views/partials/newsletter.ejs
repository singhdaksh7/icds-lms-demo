<% const sec = cms.newsletter; %>
<% if (sec.enabled) { %>
<!-- NEWSLETTER -->
<section class="newsletter-section">

    <div class="container">

        <div class="newsletter-box reveal-element">

            <div class="row align-items-center">

                <div class="col-lg-7">

                    <div class="section-tag text-white-50">
                        <%= sec.eyebrow %>
                    </div>

                    <h2>
                        <%= sec.heading %>
                    </h2>

                    <p>
                        <%= sec.description %>
                    </p>

                    <form class="newsletter-form" method="POST" action="/newsletter/subscribe">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <input
                            type="email" name="email"
                            placeholder="<%= sec.placeholder %>"
                            aria-label="<%= sec.placeholder %>"
                            required>

                        <button type="submit">
                            <%= sec.buttonLabel %>
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>
<% } %>
