<%
    var reviewRatings = Array.isArray(course.reviews) ? course.reviews.map(function (r) { return r.rating; }) : [];
    var avgRating = reviewRatings.length > 0
        ? (reviewRatings.reduce(function (a, b) { return a + b; }, 0) / reviewRatings.length)
        : null;
    var lessonCount = course._count ? Number(course._count.lessons) || 0 : 0;
    var shortDesc = course.shortDescription ? String(course.shortDescription).trim() : '';
    var instructorName = course.instructor && course.instructor.name ? course.instructor.name : '';
%>
<div class="course-card">

    <div class="course-thumbnail">

        <img
            src="<%= course.thumbnailUrl || cms.brand.defaultCourseImageUrl || '/assets/images/course-placeholder.svg' %>"
            alt="<%= course.title %>"
            loading="lazy"
            data-fallback-src="/assets/images/course-placeholder.svg">

        <span class="course-thumb-shade" aria-hidden="true"></span>

        <% if (course.featured) { %>
            <span class="course-badge">Featured</span>
        <% } else if (course.level === 'ADVANCED') { %>
            <span class="course-badge">Advanced</span>
        <% } %>

    </div>

    <div class="course-content">

        <div class="course-category">
            <%= course.category ? course.category.name : 'General' %>
        </div>

        <h3 class="course-title">
            <a href="/courses/<%= course.slug %>" class="course-title-link"><%= course.title %></a>
        </h3>

        <% if (shortDesc) { %>
        <p class="course-short-desc"><%= shortDesc %></p>
        <% } %>

        <% if (instructorName) { %>
        <div class="course-instructor">
            <i class="bi bi-person-circle" aria-hidden="true"></i>
            <span><%= instructorName %></span>
        </div>
        <% } %>

        <% if (avgRating) { %>
        <div class="course-rating">
            <span class="course-stars">
                <%= '★'.repeat(Math.round(avgRating)) %><%= '☆'.repeat(5 - Math.round(avgRating)) %>
            </span>
            <strong><%= avgRating.toFixed(1) %></strong>
            <span>(<%= reviewRatings.length %> review<%= reviewRatings.length === 1 ? '' : 's' %>)</span>
        </div>
        <% } %>

        <% if (lessonCount > 0 || course.duration) { %>
        <div class="course-meta">

            <% if (lessonCount > 0) { %>
            <span>
                <i class="bi bi-play-btn"></i>
                <%= lessonCount %> Lesson<%= lessonCount === 1 ? '' : 's' %>
            </span>
            <% } %>

            <% if (course.duration) { %>
            <span>
                <i class="bi bi-clock"></i>
                <%= course.duration %>
            </span>
            <% } %>

        </div>
        <% } %>

        <div class="course-footer">

            <div class="course-price">
                <% if (Number(course.salePrice || course.price) === 0) { %>Free<% } else { %><%= course.currency === 'INR' ? '₹' : course.currency + ' ' %><%= Number(course.salePrice || course.price).toLocaleString('en-IN') %><% } %>

                <% if (course.salePrice && Number(course.salePrice || course.price) !== 0) { %>
                    <del><%= course.currency === 'INR' ? '₹' : course.currency + ' ' %><%= Number(course.price).toLocaleString('en-IN') %></del>
                <% } %>
            </div>

            <a href="/courses/<%= course.slug %>" class="course-view-btn">
                View Course
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>

    </div>

</div>
