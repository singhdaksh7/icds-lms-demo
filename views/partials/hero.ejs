<!-- HERO -->
<section class="hero-section" id="home">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <div class="hero-content reveal-element">

                    <div class="hero-label">
                        <i class="bi bi-patch-check-fill"></i>
                        Professional Online Learning
                    </div>

                    <h1 class="hero-title brand-heading">
                        Master the skills that
                        <span>shape confidence.</span>
                    </h1>

                    <p class="hero-description">
                        Learn professional cosmetology, aesthetics, dental sciences
                        and beauty skills through expert-led video courses designed
                        for students, professionals and aspiring practitioners.
                    </p>

                    <form class="hero-search" method="GET" action="/courses">

                        <div class="hero-search-icon">
                            <i class="bi bi-search"></i>
                        </div>

                        <input
                            type="text"
                            name="q"
                            maxlength="100"
                            placeholder="What do you want to learn today?">

                        <button type="submit">
                            Search
                        </button>

                    </form>

                    <div class="hero-buttons">

                        <a href="#courses" class="hero-primary-btn">
                            Explore Courses
                            <i class="bi bi-arrow-right ms-2"></i>
                        </a>

                        <a href="#process" class="hero-secondary-btn">
                            How It Works
                        </a>

                    </div>

                </div>

            </div>


            <div class="col-lg-6">

                <div class="hero-visual reveal-element">

                    <div class="hero-image-wrapper">

                        <!-- Local placeholder graphic — swap for a licensed/owned photo once available (see public/assets/images/README.md) -->
                        <img
                            class="hero-image"
                            src="/assets/images/hero-placeholder.svg"
                            alt="ICDS online learning">

                        <div class="hero-floating-card first">

                            <div class="floating-icon">
                                <i class="bi bi-play-circle-fill"></i>
                            </div>

                            <div class="floating-text">
                                <strong>Video Lessons</strong>
                                <small>Learn at your own pace</small>
                            </div>

                        </div>

                        <div class="hero-floating-card second">

                            <div class="floating-icon">
                                <i class="bi bi-award-fill"></i>
                            </div>

                            <div class="floating-text">
                                <strong>Course Certificate</strong>
                                <small>Complete & earn</small>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<%
  // Real, DB-derived stats only — no fabricated numbers. Hide the whole
  // strip until there's at least one meaningful figure to show.
  var hasStats = typeof stats !== 'undefined' && stats &&
    (stats.courseCount > 0 || stats.instructorCount > 0 || stats.studentCount > 0 || stats.averageRating);
%>
<% if (hasStats) { %>
<!-- STATS -->
<section class="stats-strip">

    <div class="container">

        <div class="stats-box">

            <div class="row">

                <% if (stats.courseCount > 0) { %>
                <div class="col-6 col-lg-3">
                    <div class="stat-item">
                        <div class="stat-number"><%= stats.courseCount %>+</div>
                        <div class="stat-label">Professional Courses</div>
                    </div>
                </div>
                <% } %>

                <% if (stats.studentCount > 0) { %>
                <div class="col-6 col-lg-3">
                    <div class="stat-item">
                        <div class="stat-number"><%= stats.studentCount %></div>
                        <div class="stat-label">Students Learning</div>
                    </div>
                </div>
                <% } %>

                <% if (stats.instructorCount > 0) { %>
                <div class="col-6 col-lg-3">
                    <div class="stat-item">
                        <div class="stat-number"><%= stats.instructorCount %></div>
                        <div class="stat-label">Expert Instructors</div>
                    </div>
                </div>
                <% } %>

                <% if (stats.averageRating) { %>
                <div class="col-6 col-lg-3">
                    <div class="stat-item">
                        <div class="stat-number"><%= stats.averageRating %>/5</div>
                        <div class="stat-label">Student Rating (<%= stats.ratingCount %> reviews)</div>
                    </div>
                </div>
                <% } %>

            </div>

        </div>

    </div>

</section>
<% } %>
