<% const hero = cms.hero; %>
<% if (hero.enabled) { %>
<!-- HERO -->
<section class="hero-section" id="home">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <div class="hero-content reveal-element">

                    <div class="hero-label">
                        <i class="bi bi-patch-check-fill"></i>
                        <%= hero.eyebrow %>
                    </div>

                    <h1 class="hero-title brand-heading">
                        <%= hero.heading %>
                        <% if (hero.highlight) { %><span><%= hero.highlight %></span><% } %>
                    </h1>

                    <p class="hero-description">
                        <%= hero.description %>
                    </p>

                    <form class="hero-search" method="GET" action="/courses">

                        <div class="hero-search-icon">
                            <i class="bi bi-search"></i>
                        </div>

                        <input
                            type="text"
                            name="q"
                            maxlength="100"
                            placeholder="<%= hero.searchPlaceholder %>">

                        <button type="submit">
                            <%= hero.searchButton %>
                        </button>

                    </form>

                    <div class="hero-buttons">

                        <a href="<%= hero.primaryTarget %>" class="hero-primary-btn">
                            <%= hero.primaryLabel %>
                            <i class="bi bi-arrow-right ms-2"></i>
                        </a>

                        <a href="<%= hero.secondaryTarget %>" class="hero-secondary-btn">
                            <%= hero.secondaryLabel %>
                        </a>

                    </div>

                </div>

            </div>


            <div class="col-lg-6">

                <div class="hero-visual reveal-element">

                    <div class="hero-image-wrapper">

                        <img
                            class="hero-image"
                            src="<%= hero.imageUrl || '/images/demo/hero.jpg' %>"
                            alt="<%= hero.imageAlt %>"
                            data-fallback-src="/assets/images/hero-placeholder.svg">

                        <% if (hero.showBadges) { %>
                        <div class="hero-floating-card first">

                            <div class="floating-icon">
                                <i class="bi bi-play-circle-fill"></i>
                            </div>

                            <div class="floating-text">
                                <strong><%= hero.badge1Title %></strong>
                                <small><%= hero.badge1Text %></small>
                            </div>

                        </div>

                        <div class="hero-floating-card second">

                            <div class="floating-icon">
                                <i class="bi bi-award-fill"></i>
                            </div>

                            <div class="floating-text">
                                <strong><%= hero.badge2Title %></strong>
                                <small><%= hero.badge2Text %></small>
                            </div>

                        </div>
                        <% } %>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
<% } %>

<%
  // Real, DB-derived stats only — no fabricated numbers. Hide the whole
  // strip until there's at least one meaningful figure to show.
  var hasStats = hero.showStats && typeof stats !== 'undefined' && stats &&
    (stats.courseCount > 0 || stats.instructorCount > 0 || stats.studentCount > 0 || stats.averageRating);
%>
<% if (hasStats) { %>
<!-- STATS -->
<section class="stats-strip">

    <div class="container">

        <div class="stats-box">

            <div class="row">

                <% if (stats.courseCount > 0) { %>
                <div class="col-6 col-lg-3">
                    <div class="stat-item">
                        <div class="stat-number"><%= stats.courseCount %>+</div>
                        <div class="stat-label"><%= hero.statCoursesLabel %></div>
                    </div>
                </div>
                <% } %>

                <% if (stats.studentCount > 0) { %>
                <div class="col-6 col-lg-3">
                    <div class="stat-item">
                        <div class="stat-number"><%= stats.studentCount %></div>
                        <div class="stat-label"><%= hero.statStudentsLabel %></div>
                    </div>
                </div>
                <% } %>

                <% if (stats.instructorCount > 0) { %>
                <div class="col-6 col-lg-3">
                    <div class="stat-item">
                        <div class="stat-number"><%= stats.instructorCount %></div>
                        <div class="stat-label"><%= hero.statInstructorsLabel %></div>
                    </div>
                </div>
                <% } %>

                <% if (stats.averageRating) { %>
                <div class="col-6 col-lg-3">
                    <div class="stat-item">
                        <div class="stat-number"><%= stats.averageRating %>/5</div>
                        <div class="stat-label"><%= hero.statRatingLabel %> (<%= stats.ratingCount %> reviews)</div>
                    </div>
                </div>
                <% } %>

            </div>

        </div>

    </div>

</section>
<% } %>
