<% const sec = cms.featured; %>
<% if (sec.enabled) { %>
<!-- FEATURED COURSES -->
<section class="section-space course-section" id="courses">

    <div class="container">

        <div class="section-heading reveal-element">

            <div class="section-tag">
                <%= sec.eyebrow %>
            </div>

            <h2 class="section-title">
                <%= sec.heading %>
            </h2>

            <% if (sec.description) { %>
            <p class="section-description">
                <%= sec.description %>
            </p>
            <% } %>

        </div>


        <% if (featuredCourses.length === 0) { %>

            <p class="text-center text-muted">
                <%= sec.emptyText %>
            </p>

        <% } else { %>

            <div class="row g-4">

                <% featuredCourses.forEach(function (course) { %>

                    <div class="col-md-6 col-xl-4 reveal-element">
                        <%- include('./course-card', { course }) %>
                    </div>

                <% }); %>

            </div>

        <% } %>


        <div class="text-center mt-5">

            <a href="/courses" class="hero-primary-btn d-inline-block">
                <%= sec.ctaLabel %>
                <i class="bi bi-arrow-right ms-2"></i>
            </a>

        </div>

    </div>

</section>
<% } %>
