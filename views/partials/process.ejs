<% if (typeof settings === 'undefined' || !settings || settings.processEnabled) { %>
<!-- PROCESS -->
<section class="section-space process-section" id="process">

    <div class="container">

        <div class="section-heading reveal-element">

            <div class="section-tag text-white-50">
                <%= (typeof settings !== 'undefined' && settings) ? settings['process.eyebrow'] : 'Simple Learning Process' %>
            </div>

            <h2 class="section-title">
                <%= (typeof settings !== 'undefined' && settings) ? settings['process.heading'] : 'Start learning in four simple steps' %>
            </h2>

            <p class="section-description">
                <%= (typeof settings !== 'undefined' && settings) ? settings['process.description'] : 'From selecting your course to completing your lessons, everything is designed to be simple and convenient.' %>
            </p>

        </div>


        <div class="row g-5">

            <% [1, 2, 3, 4].forEach(function (n) { %>
                <div class="col-md-3 reveal-element">

                    <div class="process-step">

                        <div class="process-number">
                            <%= String(n).padStart(2, '0') %>
                        </div>

                        <h4><%= (typeof settings !== 'undefined' && settings) ? settings['process.step' + n + 'Title'] : '' %></h4>

                        <p>
                            <%= (typeof settings !== 'undefined' && settings) ? settings['process.step' + n + 'Desc'] : '' %>
                        </p>

                    </div>

                </div>
            <% }); %>

        </div>

    </div>

</section>
<% } %>
