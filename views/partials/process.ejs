<% const proc = cms.process; %>
<% if (proc.enabled) { %>
<!-- PROCESS -->
<section class="section-space process-section" id="process">

    <div class="container">

        <div class="section-heading reveal-element">

            <div class="section-tag">
                <%= proc.eyebrow %>
            </div>

            <h2 class="section-title">
                <%= proc.heading %>
            </h2>

            <p class="section-description">
                <%= proc.description %>
            </p>

        </div>


        <div class="process-steps-track reveal-element">
            <div class="process-steps-line" aria-hidden="true"></div>

            <div class="row g-4 process-steps-row">

                <% [1, 2, 3, 4].forEach(function (n) { %>
                    <div class="col-12 col-md-6 col-lg-3">

                        <div class="process-step">

                            <div class="process-number-wrap">
                                <div class="process-number">
                                    <%= proc['step' + n + 'Number'] %>
                                </div>
                            </div>

                            <div class="process-step-content">
                                <h4><%= proc['step' + n + 'Title'] %></h4>

                                <p>
                                    <%= proc['step' + n + 'Desc'] %>
                                </p>
                            </div>

                        </div>

                    </div>
                <% }); %>

            </div>
        </div>

    </div>

</section>
<% } %>
