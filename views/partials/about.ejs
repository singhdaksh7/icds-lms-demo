<% const why = cms.why; %>
<% if (why.enabled) { %>
<!-- ABOUT / WHY US -->
<section class="section-space feature-section" id="about">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-5">

                <div class="feature-image-wrap reveal-element">

                    <img
                        class="feature-image"
                        src="<%= why.imageUrl || '/images/demo/about-training.jpg' %>"
                        alt="<%= why.imageAlt %>"
                        loading="lazy"
                        data-fallback-src="/assets/images/hero-placeholder.svg">

                </div>

            </div>


            <div class="col-lg-7">

                <div class="feature-content reveal-element">

                    <div class="section-tag">
                        <%= why.eyebrow %>
                    </div>

                    <h2 class="section-title">
                        <%= why.heading %>
                    </h2>

                    <p class="section-description">
                        <%= why.description %>
                    </p>


                    <ul class="feature-list">

                        <% [1, 2, 3, 4].forEach(function (n) { %>
                            <% var title = why['feature' + n + 'Title']; %>
                            <% var desc = why['feature' + n + 'Desc']; %>
                            <% if (title) { %>
                                <li>

                                    <div class="feature-check">
                                        <i class="bi bi-check-lg"></i>
                                    </div>

                                    <div>
                                        <strong><%= title %></strong>
                                        <% if (desc) { %>
                                            <span>
                                                <%= desc %>
                                            </span>
                                        <% } %>
                                    </div>

                                </li>
                            <% } %>
                        <% }); %>

                    </ul>


                    <a href="<%= why.ctaTarget %>" class="hero-primary-btn d-inline-block">
                        <%= why.ctaLabel %>
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>
<% } %>
