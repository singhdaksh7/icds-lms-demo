<% if (typeof settings === 'undefined' || !settings || settings.whyEnabled) { %>
<!-- ABOUT / WHY US -->
<section class="section-space feature-section" id="about">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <div class="feature-image-wrap reveal-element">

                    <img
                        class="feature-image"
                        src="/images/demo/about-training.jpg"
                        alt="Students in a professional cosmetology training environment"
                        loading="lazy"
                        onerror="this.onerror=null;this.src='/assets/images/hero-placeholder.svg';">

                </div>

            </div>


            <div class="col-lg-6">

                <div class="feature-content reveal-element">

                    <div class="section-tag">
                        <%= (typeof settings !== 'undefined' && settings) ? settings['why.eyebrow'] : 'Why ICDS' %>
                    </div>

                    <h2 class="section-title">
                        <%= (typeof settings !== 'undefined' && settings) ? settings['why.heading'] : 'Education that goes beyond watching videos.' %>
                    </h2>

                    <p class="section-description">
                        <%= (typeof settings !== 'undefined' && settings) ? settings['why.description'] : 'Our online learning experience combines structured lessons, practical demonstrations and expert guidance to help students turn knowledge into professional skills.' %>
                    </p>


                    <ul class="feature-list">

                        <% [1, 2, 3, 4].forEach(function (n) { %>
                            <% var title = (typeof settings !== 'undefined' && settings) ? settings['why.feature' + n + 'Title'] : ''; %>
                            <% var desc = (typeof settings !== 'undefined' && settings) ? settings['why.feature' + n + 'Desc'] : ''; %>
                            <% if (title) { %>
                                <li>

                                    <div class="feature-check">
                                        <i class="bi bi-check-lg"></i>
                                    </div>

                                    <div>
                                        <strong><%= title %></strong>
                                        <% if (desc) { %>
                                            <span>
                                                <%= desc %>
                                            </span>
                                        <% } %>
                                    </div>

                                </li>
                            <% } %>
                        <% }); %>

                    </ul>


                    <a href="<%= (typeof settings !== 'undefined' && settings) ? settings['why.ctaTarget'] : '#courses' %>" class="hero-primary-btn d-inline-block">
                        <%= (typeof settings !== 'undefined' && settings) ? settings['why.ctaLabel'] : 'Start Learning' %>
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>
<% } %>
