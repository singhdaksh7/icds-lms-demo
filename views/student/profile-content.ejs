<section class="section-space"><div class="container" style="max-width:720px"><h1 class="section-title">My Profile</h1><% if(errors.length){ %><div class="alert alert-danger"><%= errors.join(' ') %></div><% } %><form method="POST" action="/student/profile" class="mt-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label">Name</label><input class="form-control" name="name" maxlength="120" required value="<%= values.name %>"></div><div class="mb-3"><label class="form-label">Email</label><input class="form-control" type="email" name="email" maxlength="254" required value="<%= values.email %>"></div><button class="auth-submit">Save Profile</button></form></div></section>
