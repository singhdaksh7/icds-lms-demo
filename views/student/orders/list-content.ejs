<section class="section-space">
    <div class="container">

        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <h1 class="section-title" style="text-align:left;">My Orders</h1>
            <a href="/student/dashboard" class="hero-secondary-btn">
                <i class="bi bi-arrow-left me-1"></i> My Courses
            </a>
        </div>

        <% if (orders.length === 0) { %>

            <div class="text-center py-5">
                <i class="bi bi-receipt fs-1 d-block mb-3" style="color:var(--primary-color);"></i>
                <p class="section-description mb-3">You haven't placed any orders yet.</p>
                <a href="/courses" class="hero-primary-btn d-inline-block">Browse Courses</a>
            </div>

        <% } else { %>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Course</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(function (order) { %>
                            <tr>
                                <td>ICDS-<%= order.id %></td>
                                <td><%= order.items.map(function (i) { return i.course.title; }).join(', ') %></td>
                                <td><%= order.currency %> <%= Number(order.amount).toLocaleString('en-IN') %></td>
                                <td>
                                    <span class="badge bg-<%= order.status === 'PAID' ? 'success' : (order.status === 'PENDING' ? 'secondary' : 'danger') %>">
                                        <%= order.status %>
                                    </span>
                                </td>
                                <td><%= order.createdAt.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                                <td>
                                    <a href="/student/orders/<%= order.id %>" class="small" style="color:#565acf;">View</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <%- include('../../partials/pagination', { pagination, pageUrl }) %>

        <% } %>

    </div>
</section>
