<section class="section-space">
    <div class="container">
        <div class="pay-shell">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                <div>
                    <h1 class="pay-title mb-1">My Orders</h1>
                    <p class="pay-sub mb-0">Your payments and invoices.</p>
                </div>
                <a href="/student/dashboard" class="hero-secondary-btn"><i class="bi bi-arrow-left me-2"></i>My Courses</a>
            </div>

            <% if (orders.length === 0) { %>

                <div class="pay-card text-center py-5">
                    <i class="bi bi-receipt fs-1 d-block mb-3" style="color:var(--primary-color);"></i>
                    <p class="section-description mb-3">You haven't placed any orders yet.</p>
                    <a href="/courses" class="hero-primary-btn">Browse Courses</a>
                </div>

            <% } else { %>

                <div class="orders-card">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Course</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% orders.forEach(function (order) { %>
                                <% const st = order.status.toLowerCase(); %>
                                <tr>
                                    <td data-label="Order"><strong>ICDS-<%= order.id %></strong></td>
                                    <td data-label="Course"><%= order.items.map(function (i) { return i.course.title; }).join(', ') %></td>
                                    <td data-label="Amount"><%= order.currency === 'INR' ? '₹' : order.currency + ' ' %><%= Number(order.amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td data-label="Status"><span class="status-pill <%= st %>"><%= st.charAt(0).toUpperCase() + st.slice(1) %></span></td>
                                    <td data-label="Date"><%= order.createdAt.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                                    <td class="orders-actions-cell">
                                        <div class="orders-actions">
                                            <% if (order.status === 'PAID' || order.status === 'REFUNDED') { %>
                                                <a href="/student/orders/<%= order.id %>/invoice.pdf" class="btn-mini primary"><i class="bi bi-download"></i>Invoice</a>
                                            <% } %>
                                            <a href="/student/orders/<%= order.id %>" class="btn-mini">View</a>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <%- include('../../partials/pagination', { pagination, pageUrl }) %>

            <% } %>

        </div>
    </div>
</section>
