<%
    const sym = order.currency === 'INR' ? '₹' : order.currency + ' ';
    const money = (n) => sym + Number(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const tax = Number(order.taxAmount) || 0;
    const st = order.status.toLowerCase();
    const course = order.items[0].course;
%>
<section class="section-space">
    <div class="container">
        <div class="pay-result" style="max-width:640px;">

            <div class="mb-3 text-start">
                <a href="/student/orders" class="small text-decoration-none" style="color:var(--primary-color);">
                    <i class="bi bi-arrow-left me-1"></i> Back to My Orders
                </a>
            </div>

            <div class="pay-card text-start">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h1 class="pay-title mb-0" style="font-size:22px;">Order ICDS-<%= order.id %></h1>
                    <span class="status-pill <%= st %>"><%= st.charAt(0).toUpperCase() + st.slice(1) %></span>
                </div>

                <div class="pay-receipt">
                    <% order.items.forEach(function (item) { %>
                        <div class="pay-row">
                            <span><a href="/courses/<%= item.course.slug %>" class="text-decoration-none"><%= item.course.title %></a></span>
                            <span><%= money(item.price) %></span>
                        </div>
                    <% }); %>
                    <% if (tax > 0) { %>
                        <div class="pay-row"><span>GST (<%= Number(order.taxRate) %>%<%= order.taxInclusive ? ', included' : '' %>)</span><span><%= money(tax) %></span></div>
                    <% } %>
                    <div class="pay-row pay-total"><span>Total</span><span><%= money(order.amount) %></span></div>
                    <div class="pay-row"><span>Order date</span><span><%= order.createdAt.toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span></div>
                    <div class="pay-row"><span>Payment method</span><span><%= order.paymentProvider ? order.paymentProvider.charAt(0).toUpperCase() + order.paymentProvider.slice(1) : '—' %></span></div>
                    <% if (order.providerPaymentId) { %>
                        <div class="pay-row"><span>Payment reference</span><span class="small"><%= order.providerPaymentId %></span></div>
                    <% } %>
                </div>

                <div class="pay-actions">
                    <% if (order.status === 'PAID' || order.status === 'REFUNDED') { %>
                        <a href="/student/orders/<%= order.id %>/invoice.pdf" class="auth-submit text-decoration-none"><i class="bi bi-download me-2"></i>Download invoice (PDF)</a>
                        <% if (order.status === 'PAID') { %>
                            <a href="/learn/<%= course.slug %>" class="hero-secondary-btn">Continue Learning</a>
                        <% } %>
                    <% } else if (order.status === 'PENDING') { %>
                        <a href="/checkout/<%= course.slug %>" class="auth-submit text-decoration-none">Complete Payment</a>
                    <% } else { %>
                        <a href="/payment/failed/<%= order.id %>" class="hero-secondary-btn">View details</a>
                    <% } %>
                </div>
            </div>

        </div>
    </div>
</section>
