<section class="section-space">
    <div class="container">

        <div class="mb-3">
            <a href="/student/orders" class="small text-decoration-none" style="color:#565acf;">
                <i class="bi bi-arrow-left me-1"></i> Back to My Orders
            </a>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h1 class="section-title" style="text-align:left;">Order ICDS-<%= order.id %></h1>
            <span class="badge bg-<%= order.status === 'PAID' ? 'success' : (order.status === 'PENDING' ? 'secondary' : 'danger') %> fs-6">
                <%= order.status %>
            </span>
        </div>

        <div class="modal-content p-4">

            <p class="small text-muted mb-1">Order Date</p>
            <p class="mb-3"><%= order.createdAt.toLocaleString('en-IN') %></p>

            <p class="small text-muted mb-1">Payment Provider</p>
            <p class="mb-3"><%= order.paymentProvider || '—' %></p>

            <% if (order.providerPaymentId) { %>
                <p class="small text-muted mb-1">Payment Reference</p>
                <p class="mb-3"><%= order.providerPaymentId %></p>
            <% } %>

            <h6 class="mt-4 mb-3">Items</h6>
            <ul class="list-group mb-3">
                <% order.items.forEach(function (item) { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a href="/courses/<%= item.course.slug %>" class="text-decoration-none"><%= item.course.title %></a>
                        <span><%= order.currency %> <%= Number(item.price).toLocaleString('en-IN') %></span>
                    </li>
                <% }); %>
            </ul>

            <div class="d-flex justify-content-between mb-4">
                <strong>Total</strong>
                <strong><%= order.currency %> <%= Number(order.amount).toLocaleString('en-IN') %></strong>
            </div>

            <% if (order.status === 'PAID') { %>
                <a href="/payment/success/<%= order.id %>" class="auth-submit d-block text-center text-decoration-none">
                    View Receipt
                </a>
            <% } else if (order.status === 'PENDING') { %>
                <a href="/checkout/<%= order.items[0].course.slug %>" class="auth-submit d-block text-center text-decoration-none">
                    Complete Payment
                </a>
            <% } else { %>
                <a href="/payment/failed/<%= order.id %>" class="hero-secondary-btn d-block text-center">
                    View Details
                </a>
            <% } %>

        </div>

    </div>
</section>
