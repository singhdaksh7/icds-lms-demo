<section class="section-space">
    <div class="container">

        <h1 class="section-title" style="text-align:left;">My Certificates</h1>

        <% if (!certificates.length) { %>

            <%- include('../partials/empty-state', {
                icon: 'bi-award',
                title: 'No certificates yet',
                text: 'Certificates are issued once you complete every published lesson in an active course.',
                actionHref: '/student/dashboard',
                actionLabel: 'Go to My Courses',
            }) %>

        <% } else { %>

            <div class="admin-card table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Certificate Number</th>
                            <th>Issued</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% certificates.forEach(function (c) { %>
                            <tr>
                                <td><%= c.course.title %></td>
                                <td><code><%= c.certificateNumber %></code></td>
                                <td class="text-muted small"><%= c.issuedAt.toLocaleDateString('en-IN') %></td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" href="/student/certificates/<%= c.id %>/download">
                                        <i class="bi bi-download"></i> Download PDF
                                    </a>
                                    <a class="btn btn-sm btn-outline-secondary" href="/certificates/verify/<%= c.certificateNumber %>" target="_blank" rel="noopener">
                                        <i class="bi bi-patch-check"></i> Verify
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

        <% } %>

    </div>
</section>
