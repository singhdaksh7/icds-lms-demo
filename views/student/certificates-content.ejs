<section class="section-space"><div class="container"><h1 class="section-title">My Certificates</h1><% if (!certificates.length) { %><p class="section-description">Certificates are issued after you complete every published lesson in an active course.</p><% } else { %><div class="table-responsive"><table class="table"><thead><tr><th>Course</th><th>Certificate number</th><th>Issued</th><th></th></tr></thead><tbody><% certificates.forEach(c => { %><tr><td><%= c.course.title %></td><td><%= c.certificateNumber %></td><td><%= c.issuedAt.toLocaleDateString('en-IN') %></td><td><a class="btn btn-sm btn-outline-primary" href="/student/certificates/<%= c.id %>/download">Download PDF</a></td></tr><% }) %></tbody></table></div><% } %></div></section>
