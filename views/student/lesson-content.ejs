<% const ls = cms.lesson; %>
<div class="learning-player-wrapper bg-light-subtle py-4">
    <div class="container-fluid px-lg-4">

        <!-- Top Breadcrumbs Bar -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item">
                        <a href="/student/dashboard" class="text-decoration-none text-muted">
                            <i class="bi bi-mortarboard me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="/learn/<%= course.slug %>" class="text-decoration-none text-muted">
                            <%= fill(ls.backLabel, { course: course.title }) %>
                        </a>
                    </li>
                    <% if (typeof currentModule !== 'undefined' && currentModule && !currentModule.isVirtual) { %>
                        <li class="breadcrumb-item text-muted">
                            <%= currentModule.title %>
                        </li>
                    <% } %>
                    <% if (typeof currentTopic !== 'undefined' && currentTopic && !currentTopic.isVirtual) { %>
                        <li class="breadcrumb-item text-muted">
                            <%= currentTopic.title %>
                        </li>
                    <% } %>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">
                        <%= lesson.title %>
                    </li>
                </ol>
            </nav>

            <!-- Mobile Drawer Button (Visible on mobile & tablet) -->
            <div class="d-lg-none">
                <button class="btn btn-sm btn-outline-primary fw-semibold" type="button" data-bs-toggle="offcanvas" data-bs-target="#curriculumDrawer" aria-controls="curriculumDrawer">
                    <i class="bi bi-list-nested me-1"></i> Course Content (<%= typeof progress !== 'undefined' && progress ? progress.percent : 0 %>%)
                </button>
            </div>
        </div>

        <div class="row g-4">

            <!-- Main Learning Stage (Video Player & Lesson Content) -->
            <div class="col-lg-8 col-xl-9">

                <!-- Video Stage -->
                <% const isR2Video = lesson.videoType === 'R2' && lesson.videoObjectKey; %>
                <% if ((lesson.videoType === 'LOCAL' && lesson.videoPath) || isR2Video) { %>
                    <% const trackProgress = typeof enrolled !== 'undefined' && enrolled && (typeof isAdmin === 'undefined' || !isAdmin); %>
                    <% const savedProgress = trackProgress && typeof progressMap !== 'undefined' && progressMap ? progressMap[lesson.id] : null; %>
                    <div class="ratio ratio-16x9 mb-3 rounded-4 overflow-hidden bg-black shadow">
                        <video
                            id="lesson-video"
                            <% if (trackProgress) { %>
                            data-lesson-id="<%= lesson.id %>"
                            data-resume-seconds="<%= savedProgress ? savedProgress.lastPositionSeconds : 0 %>"
                            data-progress-url="/student/lessons/<%= lesson.id %>/progress"
                            data-csrf="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
                            <% } %>
                            <% if (isR2Video) { %>
                            data-source-url="/api/lessons/<%= lesson.id %>/video-source"
                            <% } %>
                            controls preload="metadata" playsinline
                            controlsList="nodownload noremoteplayback"
                            disablePictureInPicture>
                            <% if (!isR2Video) { %>
                            <source src="/media/lessons/<%= lesson.id %>/video" type="<%= lesson.videoPath.endsWith('.webm') ? 'video/webm' : 'video/mp4' %>">
                            <% } %>
                            Your browser does not support the video tag.
                        </video>
                    </div>
                    <script src="/js/lesson-video-guard.js" defer></script>
                    <% if (isR2Video) { %>
                        <script src="/js/lesson-video-source.js" defer></script>
                    <% } %>
                    <% if (trackProgress) { %>
                        <script src="/js/lesson-progress.js" defer></script>
                    <% } %>
                <% } else if (typeof videoEmbed !== 'undefined' && videoEmbed) { %>
                    <div class="ratio ratio-16x9 mb-3 rounded-4 overflow-hidden bg-black shadow">
                        <iframe
                            src="<%= videoEmbed.embedUrl %>"
                            title="<%= lesson.title %>"
                            allowfullscreen
                            referrerpolicy="strict-origin-when-cross-origin">
                        </iframe>
                    </div>
                <% } else { %>
                    <div class="ratio ratio-16x9 mb-3 rounded-4 d-flex align-items-center justify-content-center bg-dark text-white shadow">
                        <div class="text-center p-4">
                            <i class="bi bi-camera-video-off fs-1 d-block mb-2 text-warning"></i>
                            <h5 class="text-white"><%= ls.unavailableText || 'Video lesson in production' %></h5>
                            <p class="text-muted small mb-0">This lesson content will become available as soon as post-processing is complete.</p>
                        </div>
                    </div>
                <% } %>

                <!-- Lesson Header & Completion Badge -->
                <div class="bg-white p-4 rounded-4 border shadow-sm mb-4">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                        <div>
                            <div class="text-primary small fw-bold text-uppercase mb-1">
                                <% if (typeof currentModule !== 'undefined' && currentModule) { %><%= currentModule.title %><% } %>
                                <% if (typeof currentTopic !== 'undefined' && currentTopic) { %> &bull; <%= currentTopic.title %><% } %>
                            </div>
                            <h1 class="h3 fw-bold text-dark mb-0"><%= lesson.title %></h1>
                        </div>
                        <div>
                            <% const isLessonDone = typeof progressMap !== 'undefined' && progressMap && progressMap[lesson.id] && progressMap[lesson.id].completed; %>
                            <% if (isLessonDone) { %>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fs-6">
                                    <i class="bi bi-check-circle-fill me-1"></i> <%= ls.completedLabel || 'Completed' %>
                                </span>
                            <% } else if (lesson.duration) { %>
                                <span class="badge bg-light text-muted border px-3 py-2 rounded-pill">
                                    <i class="bi bi-clock me-1"></i> <%= lesson.duration %>
                                </span>
                            <% } %>
                        </div>
                    </div>

                    <% if (lesson.description) { %>
                        <hr class="my-3 text-muted opacity-25">
                        <div class="text-secondary" style="white-space:pre-line; line-height:1.7;">
                            <%= lesson.description %>
                        </div>
                    <% } %>

                    <!-- Completion status message for tracked students -->
                    <% if (typeof enrolled !== 'undefined' && enrolled && (typeof isAdmin === 'undefined' || !isAdmin)) { %>
                        <div class="mt-3 small text-muted">
                            <% if (isLessonDone) { %>
                                <i class="bi bi-check-all text-success me-1"></i> <%= ls.completedLabel || 'Completed' %>
                            <% } else { %>
                                <i class="bi bi-info-circle me-1 text-primary"></i> <%= ls.autoCompleteHelp || 'Watch progress is tracked automatically.' %>
                            <% } %>
                        </div>
                    <% } %>
                </div>

                <!-- Attached Resources (Topic or Course Resources) -->
                <% if (typeof resources !== 'undefined' && resources && resources.length > 0) { %>
                    <div class="bg-white p-4 rounded-4 border shadow-sm mb-4">
                        <h5 class="fw-bold text-dark mb-3">
                            <i class="bi bi-file-earmark-pdf-fill text-danger me-2"></i>Lesson & Course Clinical Resources
                        </h5>
                        <div class="list-group">
                            <% resources.forEach(function(resItem) { %>
                                <div class="list-group-item d-flex justify-content-between align-items-center p-3 rounded-3 border mb-2">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-danger-subtle text-danger p-2 rounded-3">
                                            <i class="bi bi-file-earmark-pdf fs-4"></i>
                                        </div>
                                        <div>
                                            <strong class="d-block text-dark"><%= resItem.title %></strong>
                                            <span class="small text-muted">
                                                <%= resItem.contentType %> &bull;
                                                <%= resItem.sizeBytes ? (resItem.sizeBytes / (1024 * 1024)).toFixed(2) + ' MB' : 'Resource' %>
                                            </span>
                                        </div>
                                    </div>
                                    <a href="/learn/<%= course.slug %>/resources/<%= resItem.id %>/download" class="btn btn-sm btn-outline-primary fw-medium px-3">
                                        <i class="bi bi-download me-1"></i> Download
                                    </a>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>

                <!-- Previous / Next Controls -->
                <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-4 border shadow-sm">
                    <% if (typeof previousLesson !== 'undefined' && previousLesson) { %>
                        <a href="/learn/<%= course.slug %>/<%= previousLesson.slug %>" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-left"></i>
                            <div class="text-start d-none d-sm-block">
                                <div class="small text-muted" style="font-size:10px;"><%= ls.previousLabel || 'PREVIOUS' %></div>
                                <div class="small fw-semibold text-truncate" style="max-width:180px;"><%= previousLesson.title %></div>
                            </div>
                        </a>
                    <% } else { %>
                        <div></div>
                    <% } %>

                    <a href="/learn/<%= course.slug %>" class="btn btn-light border small text-muted">
                        <i class="bi bi-grid-3x3-gap me-1"></i> All Lessons
                    </a>

                    <% if (typeof nextLesson !== 'undefined' && nextLesson) { %>
                        <a href="/learn/<%= course.slug %>/<%= nextLesson.slug %>" class="btn btn-primary d-flex align-items-center gap-2">
                            <div class="text-end d-none d-sm-block">
                                <div class="small opacity-75" style="font-size:10px;"><%= ls.nextLabel || 'NEXT' %></div>
                                <div class="small fw-semibold text-truncate" style="max-width:180px;"><%= nextLesson.title %></div>
                            </div>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    <% } else { %>
                        <a href="/student/dashboard" class="btn btn-success d-flex align-items-center gap-2">
                            <i class="bi bi-trophy-fill"></i> Finish Course
                        </a>
                    <% } %>
                </div>

            </div>

            <!-- Desktop Sidebar (Curriculum Hierarchy) -->
            <div class="col-lg-4 col-xl-3 d-none d-lg-block">
                <div class="bg-white p-3 rounded-4 border shadow-sm" style="position:sticky; top:80px; max-height:calc(100vh - 100px); overflow-y:auto;">

                    <!-- Progress Header -->
                    <% if (typeof isAdmin === 'undefined' || !isAdmin) { %>
                        <div class="mb-3 pb-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-center small mb-1">
                                <span class="fw-bold text-dark"><%= ls.progressLabel || 'Course Progress' %></span>
                                <span class="badge bg-primary-subtle text-primary fw-semibold"><%= typeof progress !== 'undefined' && progress ? progress.percent : 0 %>%</span>
                            </div>
                            <div class="progress" style="height:6px; border-radius:6px;">
                                <div class="progress-bar" role="progressbar" style="width: <%= typeof progress !== 'undefined' && progress ? progress.percent : 0 %>%; background: var(--primary-color);"></div>
                            </div>
                            <div class="small text-muted mt-1" style="font-size:11px;">
                                <%= typeof progress !== 'undefined' && progress ? (progress.completed + ' of ' + progress.total + ' lessons completed') : '' %>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="mb-3 pb-2 border-bottom">
                            <span class="badge bg-dark-subtle text-dark border">
                                <i class="bi bi-shield-check me-1"></i> Admin Preview
                            </span>
                        </div>
                    <% } %>

                    <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-collection-play-fill text-primary"></i> <%= ls.curriculumHeading || 'Course Curriculum' %>
                    </h6>

                    <!-- Nested Accordion: Module -> Topic -> Lesson -->
                    <div class="accordion curriculum-sidebar-accordion" id="desktopCurriculumAccordion">
                        <% (typeof curriculum !== 'undefined' && curriculum ? curriculum : []).forEach(function(mod, modIdx) { %>
                            <% const isModActive = typeof currentModule !== 'undefined' && currentModule && currentModule.id === mod.id; %>
                            <div class="accordion-item border rounded-3 mb-2 overflow-hidden shadow-none">
                                <h2 class="accordion-header" id="sidebar-mod-heading-<%= mod.id %>">
                                    <button class="accordion-button <%= isModActive ? '' : 'collapsed' %> py-2 px-3 bg-light-subtle small fw-bold text-dark"
                                            type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-mod-collapse-<%= mod.id %>"
                                            aria-expanded="<%= isModActive ? 'true' : 'false' %>">
                                        <div class="d-flex justify-content-between align-items-center w-100 me-2">
                                            <span><%= mod.title %></span>
                                        </div>
                                    </button>
                                </h2>
                                <div id="sidebar-mod-collapse-<%= mod.id %>" class="accordion-collapse collapse <%= isModActive ? 'show' : '' %>" data-bs-parent="#desktopCurriculumAccordion">
                                    <div class="accordion-body p-2 bg-white">
                                        <% (mod.topics || []).forEach(function(topic, topicIdx) { %>
                                            <div class="mb-2">
                                                <div class="small text-muted fw-bold px-2 py-1 bg-light rounded" style="font-size:11px;">
                                                    <i class="bi bi-folder2-open me-1 text-primary"></i> <%= topic.title %>
                                                </div>
                                                <div class="list-group list-group-flush mt-1">
                                                    <% (topic.lessons || []).forEach(function(item) { %>
                                                        <% const isDone = typeof progressMap !== 'undefined' && progressMap && progressMap[item.id] && progressMap[item.id].completed; %>
                                                        <% const isCurrent = item.id === lesson.id; %>
                                                        <% const locked = !item.preview && !(typeof enrolled !== 'undefined' && enrolled) && !(typeof isAdmin !== 'undefined' && isAdmin); %>
                                                        <a href="<%= locked ? '#' : ('/learn/' + course.slug + '/' + item.slug) %>"
                                                           class="list-group-item list-group-item-action py-2 px-2 rounded-2 border-0 d-flex justify-content-between align-items-center mb-1 <%= isCurrent ? 'bg-primary-subtle text-primary fw-bold' : '' %> <%= locked ? 'disabled text-muted' : '' %>"
                                                           style="font-size:12px;">
                                                            <div class="d-flex align-items-center gap-2 text-truncate">
                                                                <% if (isDone) { %>
                                                                    <i class="bi bi-check-circle-fill text-success flex-shrink-0"></i>
                                                                <% } else if (isCurrent) { %>
                                                                    <i class="bi bi-play-circle-fill text-primary flex-shrink-0"></i>
                                                                <% } else { %>
                                                                    <i class="bi bi-circle text-muted flex-shrink-0"></i>
                                                                <% } %>
                                                                <span class="text-truncate"><%= item.title %></span>
                                                            </div>
                                                            <div class="flex-shrink-0 ms-2">
                                                                <% if (locked) { %>
                                                                    <i class="bi bi-lock-fill text-muted"></i>
                                                                <% } else if (item.duration) { %>
                                                                    <span class="text-muted" style="font-size:10px;"><%= item.duration %></span>
                                                                <% } %>
                                                            </div>
                                                        </a>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>

                </div>
            </div>

        </div>

    </div>
</div>

<!-- Mobile Curriculum Offcanvas Drawer (Phase 12) -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="curriculumDrawer" aria-labelledby="curriculumDrawerLabel" style="width:340px; max-width:85vw;">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title fw-bold" id="curriculumDrawerLabel">
            <i class="bi bi-collection-play-fill text-primary me-2"></i><%= ls.curriculumHeading || 'Course Curriculum' %>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-3">
        <% if (typeof isAdmin === 'undefined' || !isAdmin) { %>
            <div class="mb-3 pb-3 border-bottom">
                <div class="d-flex justify-content-between align-items-center small mb-1">
                    <span class="fw-bold"><%= ls.progressLabel || 'Progress' %></span>
                    <span class="badge bg-primary text-white"><%= typeof progress !== 'undefined' && progress ? progress.percent : 0 %>%</span>
                </div>
                <div class="progress" style="height:6px;">
                    <div class="progress-bar" style="width: <%= typeof progress !== 'undefined' && progress ? progress.percent : 0 %>%; background: var(--primary-color);"></div>
                </div>
            </div>
        <% } %>

        <div class="accordion" id="mobileCurriculumAccordion">
            <% (typeof curriculum !== 'undefined' && curriculum ? curriculum : []).forEach(function(mod, modIdx) { %>
                <% const isModActive = typeof currentModule !== 'undefined' && currentModule && currentModule.id === mod.id; %>
                <div class="accordion-item border rounded-3 mb-2 overflow-hidden shadow-none">
                    <h2 class="accordion-header" id="mobile-mod-heading-<%= mod.id %>">
                        <button class="accordion-button <%= isModActive ? '' : 'collapsed' %> py-2 px-3 bg-light-subtle small fw-bold text-dark"
                                type="button" data-bs-toggle="collapse" data-bs-target="#mobile-mod-collapse-<%= mod.id %>"
                                aria-expanded="<%= isModActive ? 'true' : 'false' %>">
                            <%= mod.title %>
                        </button>
                    </h2>
                    <div id="mobile-mod-collapse-<%= mod.id %>" class="accordion-collapse collapse <%= isModActive ? 'show' : '' %>" data-bs-parent="#mobileCurriculumAccordion">
                        <div class="accordion-body p-2 bg-white">
                            <% (mod.topics || []).forEach(function(topic) { %>
                                <div class="mb-2">
                                    <div class="small text-muted fw-bold px-2 py-1 bg-light rounded" style="font-size:11px;">
                                        <%= topic.title %>
                                    </div>
                                    <div class="list-group list-group-flush mt-1">
                                        <% (topic.lessons || []).forEach(function(item) { %>
                                            <% const isDone = typeof progressMap !== 'undefined' && progressMap && progressMap[item.id] && progressMap[item.id].completed; %>
                                            <% const isCurrent = item.id === lesson.id; %>
                                            <% const locked = !item.preview && !(typeof enrolled !== 'undefined' && enrolled) && !(typeof isAdmin !== 'undefined' && isAdmin); %>
                                            <a href="<%= locked ? '#' : ('/learn/' + course.slug + '/' + item.slug) %>"
                                               class="list-group-item list-group-item-action py-2 px-2 rounded-2 border-0 d-flex justify-content-between align-items-center mb-1 <%= isCurrent ? 'bg-primary-subtle text-primary fw-bold' : '' %>"
                                               style="font-size:13px; min-height:48px;">
                                                <div class="d-flex align-items-center gap-2 text-truncate">
                                                    <% if (isDone) { %>
                                                        <i class="bi bi-check-circle-fill text-success flex-shrink-0"></i>
                                                    <% } else if (isCurrent) { %>
                                                        <i class="bi bi-play-circle-fill text-primary flex-shrink-0"></i>
                                                    <% } else { %>
                                                        <i class="bi bi-circle text-muted flex-shrink-0"></i>
                                                    <% } %>
                                                    <span class="text-truncate"><%= item.title %></span>
                                                </div>
                                                <% if (locked) { %>
                                                    <i class="bi bi-lock-fill text-muted"></i>
                                                <% } else if (item.duration) { %>
                                                    <span class="text-muted small"><%= item.duration %></span>
                                                <% } %>
                                            </a>
                                        <% }); %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</div>
