<%
    const ls = cms.lesson;
    // Per-course player presentation (Admin > Course > Landing Page > Player).
    // A missing settings object means "defaults": every flag is on.
    const ps = (typeof playerSettings !== 'undefined' && playerSettings) ? playerSettings : {};
    const on = (k) => ps[k] !== false;
    const showSidebar = on('showSidebar');
    const sidebarDefaultOpen = on('sidebarDefaultOpen');
    const theaterEnabled = showSidebar && on('theaterModeEnabled');
    const showCourseProgress = on('showCourseProgress');
    const showModuleProgress = on('showModuleProgress');
    const showDurations = on('showLessonDurations');
    const showDone = on('showCompletedMarks');
    const showPrevNext = on('showPrevNext');
    const showResources = on('showResources');
    const showDescription = on('showLessonDescription');
    const sidebarTitle = ps.sidebarTitle || ls.curriculumHeading || 'Course Content';
    const theaterLabel = ps.theaterButtonLabel || '';
    const isAdminViewer = typeof isAdmin !== 'undefined' && isAdmin;
    const isEnrolledViewer = typeof enrolled !== 'undefined' && enrolled;
    const progressPct = typeof progress !== 'undefined' && progress ? (progress.percent || 0) : 0;
    const curriculumList = typeof curriculum !== 'undefined' && curriculum ? curriculum : [];
    const modActiveId = typeof currentModule !== 'undefined' && currentModule ? currentModule.id : null;
    const topicActiveId = typeof currentTopic !== 'undefined' && currentTopic ? currentTopic.id : null;
    const pMap = typeof progressMap !== 'undefined' && progressMap ? progressMap : {};
%>
<link rel="stylesheet" href="/css/lesson-player.css">
<div class="lp-page"
     id="lpPage"
     data-lp
     data-course-id="<%= course.id || '' %>"
     data-sidebar-default="<%= sidebarDefaultOpen ? 'open' : 'closed' %>"
     data-sidebar-enabled="<%= showSidebar ? 'true' : 'false' %>"
     data-theater-enabled="<%= theaterEnabled ? 'true' : 'false' %>"
     data-show-done="<%= showDone ? 'true' : 'false' %>"
     data-label-hide="<%= theaterLabel || 'Hide Course Content' %>"
     data-label-show="<%= theaterLabel || 'Show Course Content' %>">
    <div class="lp-container">

        <!-- Breadcrumb + player controls -->
        <div class="lp-topbar">
            <nav aria-label="breadcrumb" class="lp-breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item">
                        <a href="/student/dashboard" class="text-decoration-none text-muted">
                            <i class="bi bi-mortarboard me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="/learn/<%= course.slug %>" class="text-decoration-none text-muted">
                            <%= fill(ls.backLabel, { course: course.title }) %>
                        </a>
                    </li>
                    <% if (typeof currentModule !== 'undefined' && currentModule && !currentModule.isVirtual) { %>
                        <li class="breadcrumb-item text-muted"><%= currentModule.title %></li>
                    <% } %>
                    <% if (typeof currentTopic !== 'undefined' && currentTopic && !currentTopic.isVirtual) { %>
                        <li class="breadcrumb-item text-muted"><%= currentTopic.title %></li>
                    <% } %>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page"><%= lesson.title %></li>
                </ol>
            </nav>

            <% if (showSidebar) { %>
                <div class="lp-controls">
                    <% if (theaterEnabled) { %>
                        <!-- Desktop: Theater mode (hide / show the course content column) -->
                        <button type="button" class="btn btn-sm btn-outline-secondary lp-btn lp-theater-toggle d-none d-lg-inline-flex"
                                id="lpTheaterToggle" data-lp-theater-toggle aria-controls="lpSidebar" aria-expanded="<%= sidebarDefaultOpen ? 'true' : 'false' %>">
                            <i class="bi bi-layout-sidebar-inset-reverse" aria-hidden="true"></i>
                            <span data-lp-theater-label><%= theaterLabel || (sidebarDefaultOpen ? 'Hide Course Content' : 'Show Course Content') %></span>
                        </button>
                    <% } %>
                    <!-- Tablet / mobile: open the slide-over drawer -->
                    <button type="button" class="btn btn-sm btn-outline-primary lp-btn lp-drawer-toggle d-lg-none"
                            id="lpDrawerToggle" data-lp-drawer-toggle aria-controls="lpSidebar" aria-expanded="false">
                        <i class="bi bi-list-nested" aria-hidden="true"></i>
                        <span>Course Content</span>
                        <% if (showCourseProgress && !isAdminViewer) { %>(<span class="course-progress-percent-text"><%= progressPct %></span>%)<% } %>
                    </button>
                </div>
            <% } %>
        </div>

        <div class="lp-layout" id="lpLayout">

            <!-- Main learning stage -->
            <div class="lp-main" id="lpMain">

                <!-- Video Stage -->
                <% const isR2Video = lesson.videoType === 'R2' && lesson.videoObjectKey; %>
                <% if ((lesson.videoType === 'LOCAL' && lesson.videoPath) || isR2Video) { %>
                    <% const trackProgress = isEnrolledViewer && !isAdminViewer; %>
                    <% const savedProgress = trackProgress && pMap ? pMap[lesson.id] : null; %>
                    <div class="lp-video-wrap">
                    <div class="ratio ratio-16x9 mb-3 rounded-4 overflow-hidden bg-black shadow lp-video">
                        <video
                            id="lesson-video"
                            <% if (trackProgress) { %>
                            data-lesson-id="<%= lesson.id %>"
                            data-resume-seconds="<%= savedProgress ? savedProgress.lastPositionSeconds : 0 %>"
                            data-progress-url="/student/lessons/<%= lesson.id %>/progress"
                            data-csrf="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
                            <% } %>
                            <% if (isR2Video) { %>
                            data-source-url="/api/lessons/<%= lesson.id %>/video-source"
                            <% } %>
                            controls preload="metadata" playsinline
                            controlsList="nodownload noremoteplayback"
                            disablePictureInPicture>
                            <% if (!isR2Video) { %>
                            <source src="/media/lessons/<%= lesson.id %>/video" type="<%= lesson.videoPath.endsWith('.webm') ? 'video/webm' : 'video/mp4' %>">
                            <% } %>
                            Your browser does not support the video tag.
                        </video>
                    </div>
                    </div>
                    <script src="/js/lesson-video-guard.js" defer></script>
                    <% if (isR2Video) { %>
                        <script src="/js/lesson-video-source.js" defer></script>
                    <% } %>
                    <% if (trackProgress) { %>
                        <script src="/js/lesson-progress.js" defer></script>
                    <% } %>
                <% } else if (typeof videoEmbed !== 'undefined' && videoEmbed) { %>
                    <div class="lp-video-wrap">
                    <div class="ratio ratio-16x9 mb-3 rounded-4 overflow-hidden bg-black shadow lp-video">
                        <iframe
                            src="<%= videoEmbed.embedUrl %>"
                            title="<%= lesson.title %>"
                            allowfullscreen
                            referrerpolicy="strict-origin-when-cross-origin">
                        </iframe>
                    </div>
                    </div>
                <% } else { %>
                    <div class="lp-video-wrap">
                    <div class="ratio ratio-16x9 mb-3 rounded-4 d-flex align-items-center justify-content-center bg-dark text-white shadow lp-video">
                        <div class="text-center p-4">
                            <i class="bi bi-camera-video-off fs-1 d-block mb-2 text-warning"></i>
                            <h5 class="text-white"><%= ls.unavailableText || 'Video lesson in production' %></h5>
                            <p class="text-muted small mb-0">This lesson content will become available as soon as post-processing is complete.</p>
                        </div>
                    </div>
                    </div>
                <% } %>

                <!-- Lesson header & completion badge -->
                <div class="bg-white p-4 rounded-4 border shadow-sm mb-4 lp-lesson-card">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                        <div>
                            <div class="text-primary small fw-bold text-uppercase mb-1 lp-lesson-crumb">
                                <% if (typeof currentModule !== 'undefined' && currentModule) { %><%= currentModule.title %><% } %>
                                <% if (typeof currentTopic !== 'undefined' && currentTopic) { %> &bull; <%= currentTopic.title %><% } %>
                            </div>
                            <h1 class="h3 fw-bold text-dark mb-0"><%= lesson.title %></h1>
                        </div>
                        <div id="lesson-completion-badge">
                            <% const isLessonDone = pMap && pMap[lesson.id] && pMap[lesson.id].completed; %>
                            <% if (isLessonDone && showDone) { %>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fs-6">
                                    <i class="bi bi-check-circle-fill me-1"></i> <%= ls.completedLabel || 'Completed' %>
                                </span>
                            <% } else if (!isLessonDone && lesson.duration && showDurations) { %>
                                <span class="badge bg-light text-muted border px-3 py-2 rounded-pill">
                                    <i class="bi bi-clock me-1"></i> <%= lesson.duration %>
                                </span>
                            <% } %>
                        </div>
                    </div>

                    <% if (lesson.description && showDescription) { %>
                        <hr class="my-3 text-muted opacity-25">
                        <div class="text-secondary lp-description" style="white-space:pre-line; line-height:1.7;">
                            <%= lesson.description %>
                        </div>
                    <% } %>

                    <% if (isEnrolledViewer && !isAdminViewer) { %>
                        <div class="mt-3 small text-muted" id="lesson-completion-note">
                            <% if (isLessonDone) { %>
                                <i class="bi bi-check-all text-success me-1"></i> <%= ls.completedLabel || 'Completed' %>
                            <% } else { %>
                                <i class="bi bi-info-circle me-1 text-primary"></i> <%= ls.autoCompleteHelp || 'Watch progress is tracked automatically.' %>
                            <% } %>
                        </div>
                    <% } %>
                </div>

                <!-- Attached resources -->
                <% if (showResources && typeof resources !== 'undefined' && resources && resources.length > 0) { %>
                    <div class="bg-white p-4 rounded-4 border shadow-sm mb-4 lp-resources">
                        <h5 class="fw-bold text-dark mb-3">
                            <i class="bi bi-file-earmark-pdf-fill text-danger me-2"></i>Lesson &amp; Course Clinical Resources
                        </h5>
                        <div class="list-group">
                            <% resources.forEach(function(resItem) { %>
                                <div class="list-group-item d-flex justify-content-between align-items-center p-3 rounded-3 border mb-2">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-danger-subtle text-danger p-2 rounded-3">
                                            <i class="bi bi-file-earmark-pdf fs-4"></i>
                                        </div>
                                        <div>
                                            <strong class="d-block text-dark"><%= resItem.title %></strong>
                                            <span class="small text-muted">
                                                <%= resItem.contentType %> &bull;
                                                <%= resItem.sizeBytes ? (Number(resItem.sizeBytes) / (1024 * 1024)).toFixed(2) + ' MB' : 'Resource' %>
                                            </span>
                                        </div>
                                    </div>
                                    <a href="/learn/<%= course.slug %>/resources/<%= resItem.id %>/download" class="btn btn-sm btn-outline-primary fw-medium px-3">
                                        <i class="bi bi-download me-1"></i> Download
                                    </a>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>

                <!-- Previous / Next -->
                <% if (showPrevNext) { %>
                <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-4 border shadow-sm lp-prevnext">
                    <% if (typeof previousLesson !== 'undefined' && previousLesson) { %>
                        <a href="/learn/<%= course.slug %>/<%= previousLesson.slug %>" class="btn btn-outline-secondary d-flex align-items-center gap-2" rel="prev">
                            <i class="bi bi-arrow-left"></i>
                            <div class="text-start d-none d-sm-block">
                                <div class="small text-muted" style="font-size:10px;"><%= ls.previousLabel || 'PREVIOUS' %></div>
                                <div class="small fw-semibold text-truncate" style="max-width:180px;"><%= previousLesson.title %></div>
                            </div>
                        </a>
                    <% } else { %>
                        <div></div>
                    <% } %>

                    <a href="/learn/<%= course.slug %>" class="btn btn-light border small text-muted">
                        <i class="bi bi-grid-3x3-gap me-1"></i> All Lessons
                    </a>

                    <% if (typeof nextLesson !== 'undefined' && nextLesson) { %>
                        <a href="/learn/<%= course.slug %>/<%= nextLesson.slug %>" class="btn btn-primary d-flex align-items-center gap-2" rel="next">
                            <div class="text-end d-none d-sm-block">
                                <div class="small opacity-75" style="font-size:10px;"><%= ls.nextLabel || 'NEXT' %></div>
                                <div class="small fw-semibold text-truncate" style="max-width:180px;"><%= nextLesson.title %></div>
                            </div>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    <% } else { %>
                        <a href="/student/dashboard" class="btn btn-success d-flex align-items-center gap-2">
                            <i class="bi bi-trophy-fill"></i> Finish Course
                        </a>
                    <% } %>
                </div>
                <% } %>

            </div>

            <% if (showSidebar) { %>
            <!-- Course content: right column on desktop, slide-over drawer on tablet/mobile -->
            <aside class="lp-sidebar <%= sidebarDefaultOpen ? '' : 'is-collapsed' %>" id="lpSidebar" aria-label="<%= sidebarTitle %>" role="complementary">
                <div class="lp-sidebar-inner">
                    <div class="lp-sidebar-head">
                        <h2 class="lp-sidebar-title">
                            <i class="bi bi-collection-play-fill text-primary" aria-hidden="true"></i>
                            <span><%= sidebarTitle %></span>
                        </h2>
                        <button type="button" class="btn-close lp-drawer-close d-lg-none" data-lp-drawer-close aria-label="Close course content"></button>
                    </div>
                    <div class="lp-course-name"><%= course.title %></div>

                    <% if (!isAdminViewer) { %>
                        <% if (showCourseProgress) { %>
                            <div class="lp-progress-block">
                                <div class="d-flex justify-content-between align-items-center small mb-1">
                                    <span class="fw-bold text-dark"><%= ls.progressLabel || 'Course Progress' %></span>
                                    <span class="badge bg-primary-subtle text-primary fw-semibold"><span class="course-progress-percent-text"><%= progressPct %></span>%</span>
                                </div>
                                <div class="progress" style="height:6px; border-radius:6px;">
                                    <div class="progress-bar course-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= progressPct %>" style="width: <%= progressPct %>%; background: var(--primary-color);"></div>
                                </div>
                                <div class="small text-muted mt-1 course-progress-count-text" style="font-size:11px;">
                                    <%= typeof progress !== 'undefined' && progress ? (progress.completed + ' of ' + progress.total + ' lessons completed') : '' %>
                                </div>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div class="lp-progress-block">
                            <span class="badge bg-dark-subtle text-dark border"><i class="bi bi-shield-check me-1"></i> Admin Preview</span>
                        </div>
                    <% } %>

                    <!-- Module -> Topic -> Lesson (real curriculum hierarchy) -->
                    <div class="lp-curriculum" id="lpCurriculum">
                        <% curriculumList.forEach(function (mod) { %>
                            <% const modOpen = modActiveId === mod.id || (modActiveId === null && curriculumList.length === 1); %>
                            <% const modDone = typeof mod.completedLessons !== 'undefined' ? mod.completedLessons : 0; %>
                            <% const modTotal = typeof mod.totalLessons !== 'undefined' ? mod.totalLessons : (mod.lessons ? mod.lessons.length : 0); %>
                            <div class="lp-module <%= modActiveId === mod.id ? 'is-current' : '' %>" data-lp-module="<%= mod.id %>">
                                <button type="button" class="lp-module-btn" data-lp-collapse
                                        aria-expanded="<%= modOpen ? 'true' : 'false' %>" aria-controls="lp-mod-panel-<%= mod.id %>" id="lp-mod-btn-<%= mod.id %>">
                                    <i class="bi bi-chevron-right lp-chevron" aria-hidden="true"></i>
                                    <span class="lp-module-title"><%= mod.title %></span>
                                    <% if (showModuleProgress && !isAdminViewer) { %>
                                        <span class="badge bg-light text-muted border module-progress-badge" data-module-id="<%= mod.id %>" title="Lessons completed in this module"><%= modDone %>/<%= modTotal %></span>
                                    <% } else { %>
                                        <span class="badge bg-light text-muted border module-progress-badge lp-hidden-badge" data-module-id="<%= mod.id %>" hidden><%= modDone %>/<%= modTotal %></span>
                                    <% } %>
                                </button>
                                <div class="lp-panel" id="lp-mod-panel-<%= mod.id %>" role="region" aria-labelledby="lp-mod-btn-<%= mod.id %>" <%= modOpen ? '' : 'hidden' %>>
                                    <% (mod.topics || []).forEach(function (topic) { %>
                                        <% const topicOpen = topicActiveId === topic.id || (!topicActiveId && (mod.topics || []).length === 1) || !!topic.isVirtual; %>
                                        <% const topicDone = typeof topic.completedLessons !== 'undefined' ? topic.completedLessons : 0; %>
                                        <% const topicTotal = typeof topic.totalLessons !== 'undefined' ? topic.totalLessons : (topic.lessons ? topic.lessons.length : 0); %>
                                        <div class="lp-topic" data-lp-topic="<%= topic.id %>">
                                            <% if (!topic.isVirtual) { %>
                                                <button type="button" class="lp-topic-btn" data-lp-collapse
                                                        aria-expanded="<%= topicOpen ? 'true' : 'false' %>" aria-controls="lp-topic-panel-<%= topic.id %>" id="lp-topic-btn-<%= topic.id %>">
                                                    <i class="bi bi-chevron-right lp-chevron" aria-hidden="true"></i>
                                                    <span class="lp-topic-title"><i class="bi bi-folder2-open me-1 text-primary" aria-hidden="true"></i> <%= topic.title %></span>
                                                    <span class="badge bg-white text-muted border topic-progress-badge" data-topic-id="<%= topic.id %>"><%= topicDone %>/<%= topicTotal %></span>
                                                </button>
                                            <% } %>
                                            <ul class="lp-lessons list-unstyled mb-0" id="lp-topic-panel-<%= topic.id %>" <%= (topic.isVirtual || topicOpen) ? '' : 'hidden' %>>
                                                <% (topic.lessons || []).forEach(function (item) { %>
                                                    <% const isDone = pMap[item.id] && pMap[item.id].completed; %>
                                                    <% const isCurrent = item.id === lesson.id; %>
                                                    <% const locked = !item.preview && !isEnrolledViewer && !isAdminViewer; %>
                                                    <li>
                                                        <% if (locked) { %>
                                                            <span class="lp-lesson is-locked" data-sidebar-lesson-id="<%= item.id %>" aria-disabled="true">
                                                                <span class="lp-lesson-main">
                                                                    <i class="bi bi-lock-fill text-muted flex-shrink-0" aria-hidden="true"></i>
                                                                    <span class="lp-lesson-title"><%= item.title %></span>
                                                                </span>
                                                                <span class="visually-hidden">Locked</span>
                                                            </span>
                                                        <% } else { %>
                                                            <a href="/learn/<%= course.slug %>/<%= item.slug %>"
                                                               data-sidebar-lesson-id="<%= item.id %>"
                                                               class="lp-lesson <%= isCurrent ? 'is-current' : '' %> <%= (isDone && showDone) ? 'is-done' : '' %>"
                                                               <%- isCurrent ? 'aria-current="page"' : '' %>>
                                                                <span class="lp-lesson-main">
                                                                    <% if (isDone && showDone) { %>
                                                                        <i class="bi bi-check-circle-fill text-success flex-shrink-0" aria-hidden="true"></i><span class="visually-hidden">Completed: </span>
                                                                    <% } else if (isCurrent) { %>
                                                                        <i class="bi bi-play-circle-fill text-primary flex-shrink-0" aria-hidden="true"></i><span class="visually-hidden">Now playing: </span>
                                                                    <% } else { %>
                                                                        <i class="bi bi-circle text-muted flex-shrink-0" aria-hidden="true"></i>
                                                                    <% } %>
                                                                    <span class="lp-lesson-title"><%= item.title %></span>
                                                                </span>
                                                                <% if (showDurations && item.duration) { %><span class="lp-lesson-dur"><%= item.duration %></span><% } %>
                                                            </a>
                                                        <% } %>
                                                    </li>
                                                <% }); %>
                                            </ul>
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </aside>
            <div class="lp-backdrop" id="lpBackdrop" data-lp-drawer-close hidden></div>
            <% } %>

        </div>
    </div>
</div>
<script src="/js/lesson-player-ui.js" defer></script>
