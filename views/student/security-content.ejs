<section class="section-space"><div class="container" style="max-width:720px"><h1 class="section-title">Security</h1><% if(errors.length){ %><div class="alert alert-danger"><%= errors.join(' ') %></div><% } %><form method="POST" action="/student/security/password" class="mt-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label">Current password</label><input class="form-control" type="password" name="currentPassword" required></div><div class="mb-3"><label class="form-label">New password</label><input class="form-control" type="password" name="newPassword" minlength="8" required></div><div class="mb-3"><label class="form-label">Confirm new password</label><input class="form-control" type="password" name="confirmPassword" minlength="8" required></div><button class="auth-submit">Change Password</button></form></div></section>
