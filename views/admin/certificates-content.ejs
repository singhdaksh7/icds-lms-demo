<h1 class="mb-4">Certificates</h1><div class="admin-card table-responsive"><table class="table"><thead><tr><th>Number</th><th>Student</th><th>Course</th><th>Issued</th></tr></thead><tbody><% certificates.forEach(c => { %><tr><td><%= c.certificateNumber %></td><td><%= c.user.name %><br><small><%= c.user.email %></small></td><td><%= c.course.title %></td><td><%= c.issuedAt.toLocaleDateString('en-IN') %></td></tr><% }) %></tbody></table></div>
