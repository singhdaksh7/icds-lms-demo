<h1 style="font-size:24px;" class="mb-2">Certificates</h1>
<p class="text-muted small mb-4">
    Certificates are normally issued automatically when a student completes every published lesson. Use
    <strong>Issue Certificate</strong> only for an explicit administrative override (for example, an offline practical
    assessment). The reason you enter is recorded internally and is never shown to the student or on the public
    verification page.
</p>

<% if (errors && errors.length) { %>
    <div class="alert alert-danger">
        <ul class="mb-0 ps-3">
            <% errors.forEach(function (error) { %><li><%= error %></li><% }) %>
        </ul>
    </div>
<% } %>

<form id="issue-certificate" class="admin-card mb-4" method="POST" action="/admin/certificates" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h3 class="h6 mb-3">Issue Certificate</h3>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label class="form-label small fw-semibold" for="cert-student">Student</label>
            <input type="text" id="cert-student" name="studentEmail" list="cert-student-list" class="form-control form-control-custom" placeholder="Start typing a name or email" autocomplete="off" required value="<%= values.studentEmail || '' %>">
            <datalist id="cert-student-list">
                <% students.forEach(function (s) { %><option value="<%= s.email %>"><%= s.name %></option><% }); %>
            </datalist>
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label small fw-semibold" for="cert-course">Course</label>
            <select id="cert-course" name="courseId" class="form-select form-control-custom" required>
                <option value="">Select a course</option>
                <% courses.forEach(function (c) { %>
                    <option value="<%= c.id %>" <%= String(values.courseId) === String(c.id) ? 'selected' : '' %>><%= c.title %></option>
                <% }); %>
            </select>
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label small fw-semibold" for="cert-date">Issue date</label>
            <input type="date" id="cert-date" name="issueDate" class="form-control form-control-custom" required value="<%= values.issueDate || '' %>">
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label small fw-semibold" for="cert-type">Certificate type</label>
            <input type="text" id="cert-type" class="form-control form-control-custom" value="Admin Issued" disabled>
        </div>
        <div class="col-12">
            <label class="form-label small fw-semibold" for="cert-note">Reason for override (required, internal only)</label>
            <textarea id="cert-note" name="adminNote" class="form-control form-control-custom" rows="2" maxlength="500" required placeholder="e.g. Offline practical assessment completed"><%= values.adminNote || '' %></textarea>
        </div>
        <div class="col-12">
            <label class="form-label small fw-semibold" for="cert-pdf">Certificate PDF (optional)</label>
            <input type="file" id="cert-pdf" name="certificatePdf" class="form-control form-control-custom" accept="application/pdf,.pdf">
            <p class="small text-muted mt-1 mb-0">PDF only, up to 10MB. Leave empty to generate the standard certificate automatically.</p>
        </div>
    </div>

    <div class="mt-3 pt-3 border-top">
        <button type="submit" class="auth-submit" style="width:auto; padding:0 28px;">Issue Certificate</button>
    </div>
</form>

<div class="admin-card">
    <% if (!certificates.length) { %>
        <%- include('../partials/empty-state', { icon: 'bi-award', title: 'No certificates issued yet', text: 'Certificates appear here once a student completes every published lesson, or when you issue one above.' }) %>
    <% } else { %>
        <div class="table-responsive">
            <table class="table admin-table align-middle mb-0">
                <thead>
                    <tr><th>Number</th><th>Student</th><th>Course</th><th>Issued</th><th>Type</th><th>Status</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    <% certificates.forEach(function (c) { %>
                        <tr>
                            <td><code><%= c.certificateNumber %></code></td>
                            <td><%= c.user.name %><br><small class="text-muted"><%= c.user.email %></small></td>
                            <td><%= c.course.title %></td>
                            <td class="text-muted small"><%= c.issuedAt.toLocaleDateString('en-IN') %></td>
                            <td class="small">
                                <% if (c.source === 'ADMIN_ISSUED') { %>
                                    <span class="badge text-bg-info">Admin issued</span>
                                    <% if (c.issuedBy) { %><div class="text-muted">by <%= c.issuedBy.name %></div><% } %>
                                    <% if (c.adminNote) { %><div class="text-muted" style="white-space:pre-line;"><%= c.adminNote %></div><% } %>
                                    <div class="text-muted"><%= c.fileUrl ? 'Uploaded PDF' : 'Generated PDF' %></div>
                                <% } else { %>
                                    <span class="badge text-bg-secondary">Completion</span>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge text-bg-<%= c.status === 'ACTIVE' ? 'success' : 'danger' %>"><%= c.status === 'ACTIVE' ? 'Active' : 'Revoked' %></span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" href="/admin/certificates/<%= c.id %>/download">PDF</a>
                                <a class="btn btn-sm btn-outline-secondary" href="/certificates/verify/<%= c.certificateNumber %>" target="_blank" rel="noopener noreferrer">Verify</a>
                                <% if (c.status === 'ACTIVE') { %>
                                    <form method="POST" action="/admin/certificates/<%= c.id %>/revoke" class="d-inline" data-confirm="Revoke this certificate? It will stop verifying as valid and disappear from the student's list.">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                                    </form>
                                <% } else { %>
                                    <form method="POST" action="/admin/certificates/<%= c.id %>/restore" class="d-inline">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Restore</button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>
