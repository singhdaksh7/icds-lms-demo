<%# Expects: name, title, items, fields[{key,label,type,options?,max?}], summaryKey, canAdd %>
<%
    function fieldHtmlValue(item, f) { return item && item[f.key] != null ? item[f.key] : ''; }
%>
<div class="admin-card mb-4" id="<%= name %>">
    <h2 style="font-size:18px;"><%= title %></h2>

    <% if (items.length === 0) { %><p class="text-muted small">Nothing here yet.</p><% } %>
    <% items.forEach(function (it, i) { %>
        <div class="border rounded p-2 mb-2">
            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                <div>
                    <strong><%= it[summaryKey] %></strong>
                    <% if (!it.isPublished) { %><span class="badge bg-secondary ms-1">Hidden</span><% } %>
                </div>
                <div class="d-flex gap-1">
                    <% ['up', 'down'].forEach(function (dir) { %>
                        <form method="POST" action="/admin/founder/items/<%= name %>/<%= it.id %>/move" class="m-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="direction" value="<%= dir %>">
                            <button class="btn btn-sm btn-outline-secondary" title="Move <%= dir %>"><i class="bi bi-arrow-<%= dir %>"></i></button>
                        </form>
                    <% }); %>
                    <form method="POST" action="/admin/founder/items/<%= name %>/<%= it.id %>/toggle" class="m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-sm btn-outline-secondary"><%= it.isPublished ? 'Hide' : 'Publish' %></button>
                    </form>
                    <form method="POST" action="/admin/founder/items/<%= name %>/<%= it.id %>/delete" class="m-0" data-confirm="Delete this item?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </div>
            </div>
            <details class="mt-2">
                <summary class="small" style="cursor:pointer;">Edit</summary>
                <form method="POST" action="/admin/founder/items/<%= name %>/<%= it.id %>/edit" class="mt-2">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <%- include('./entity-fields', { fields: fields, item: it, idp: name + '-' + it.id }) %>
                    <input type="hidden" name="isPublished" value="false">
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="isPublished" value="true" id="pub-<%= name %>-<%= it.id %>" <%= it.isPublished ? 'checked' : '' %>><label class="form-check-label" for="pub-<%= name %>-<%= it.id %>">Published</label></div>
                    <button class="btn btn-sm btn-primary">Save</button>
                </form>
            </details>
        </div>
    <% }); %>

    <% if (canAdd) { %>
    <details class="mt-3">
        <summary class="small fw-semibold" style="cursor:pointer;"><i class="bi bi-plus-lg"></i> Add new</summary>
        <form method="POST" action="/admin/founder/items/<%= name %>" class="mt-2">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <%- include('./entity-fields', { fields: fields, item: null, idp: name + '-new' }) %>
            <input type="hidden" name="isPublished" value="true">
            <button class="btn btn-sm btn-primary">Add</button>
        </form>
    </details>
    <% } else { %>
        <p class="small text-warning mb-0">Mark an instructor as the founder (above) before adding items here.</p>
    <% } %>
</div>
