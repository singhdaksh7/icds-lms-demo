<h1 style="font-size:24px;" class="mb-2">Tax &amp; Invoice</h1>
<p class="text-muted mb-4">
    Set up GST and the look of the invoice PDF that students and admins can download for every paid order.
    Individual courses can override the GST rate in the course editor.
</p>

<% if (errors && errors.length) { %>
    <div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul></div>
<% } %>

<form method="POST" action="/admin/tax-settings" autocomplete="off" data-no-format>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="admin-card mb-4">
        <h6 class="mb-3">GST</h6>
        <div class="row g-3">
            <div class="col-12">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="enabled" id="enabled" value="1" <%= values.enabled ? 'checked' : '' %>>
                    <label class="form-check-label" for="enabled">Charge GST on paid courses</label>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Default GST rate (%)</label>
                <input type="text" inputmode="decimal" name="rate" class="form-control form-control-custom" value="<%= values.rate %>" data-no-format>
            </div>
            <div class="col-md-8">
                <label class="form-label small fw-semibold">How are course prices entered?</label>
                <select name="priceMode" class="form-select form-control-custom">
                    <option value="inclusive" <%= values.inclusive ? 'selected' : '' %>>Prices already include GST (student pays the listed price)</option>
                    <option value="exclusive" <%= !values.inclusive ? 'selected' : '' %>>Prices exclude GST (GST is added at checkout)</option>
                </select>
            </div>
        </div>
    </div>

    <div class="admin-card mb-4">
        <h6 class="mb-3">Business details on the invoice</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small fw-semibold">Business / legal name</label>
                <input type="text" name="legalName" class="form-control form-control-custom" maxlength="150" value="<%= values.legalName %>">
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-semibold">GSTIN</label>
                <input type="text" name="gstin" class="form-control form-control-custom" maxlength="15" placeholder="07ABCDE1234F1Z5" value="<%= values.gstin %>" data-no-format>
            </div>
            <div class="col-12">
                <label class="form-label small fw-semibold">Business address</label>
                <textarea name="address" rows="3" class="form-control form-control-custom" maxlength="400"><%= values.address %></textarea>
            </div>
        </div>
    </div>

    <div class="admin-card mb-4">
        <h6 class="mb-3">Invoice design</h6>
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label small fw-semibold">Invoice title</label>
                <input type="text" name="invoiceTitle" class="form-control form-control-custom" maxlength="40" value="<%= values.invoiceTitle %>" placeholder="TAX INVOICE">
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Invoice number prefix</label>
                <input type="text" name="invoicePrefix" class="form-control form-control-custom" maxlength="10" value="<%= values.invoicePrefix %>" placeholder="INV-" data-no-format>
                <div class="form-text">Example: INV-000123</div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Accent colour</label>
                <input type="color" name="accent" class="form-control form-control-color" value="<%= values.accent %>" style="width:100%;height:42px;" data-no-format>
            </div>
            <div class="col-12">
                <label class="form-label small fw-semibold">Terms &amp; conditions (optional)</label>
                <textarea name="terms" rows="3" class="form-control form-control-custom" maxlength="800"><%= values.terms %></textarea>
            </div>
            <div class="col-md-8">
                <label class="form-label small fw-semibold">Footer note (optional)</label>
                <input type="text" name="note" class="form-control form-control-custom" maxlength="400" value="<%= values.note %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Authorised signatory (optional)</label>
                <input type="text" name="signatory" class="form-control form-control-custom" maxlength="100" value="<%= values.signatory %>">
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="auth-submit" style="width:auto;padding:0 28px;">Save settings</button>
        <a href="/admin/tax-settings/preview.pdf" class="hero-secondary-btn"><i class="bi bi-file-earmark-pdf me-2"></i>Preview sample invoice</a>
    </div>
    <p class="small text-muted mt-2">Save first, then preview, to see your latest changes.</p>
</form>
