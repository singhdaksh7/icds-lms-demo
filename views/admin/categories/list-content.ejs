<h1 style="font-size:24px;" class="mb-4">Categories</h1>

<% if (errors && errors.length) { %>
    <div class="alert alert-danger">
        <ul class="mb-0 ps-3">
            <% errors.forEach(function (error) { %><li><%= error %></li><% }) %>
        </ul>
    </div>
<% } %>

<div class="row g-4">

    <div class="col-lg-4">
        <div class="admin-card">
            <h6 class="mb-3">Add Category</h6>
            <form method="POST" action="/admin/categories">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Name</label>
                    <input type="text" name="name" class="form-control form-control-custom" value="<%= values.name || '' %>" required>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Slug (optional)</label>
                    <input type="text" name="slug" class="form-control form-control-custom" value="<%= values.slug || '' %>">
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Description</label>
                    <textarea name="description" class="form-control form-control-custom" rows="2"><%= values.description || '' %></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Status</label>
                    <select name="status" class="form-select form-control-custom">
                        <% statuses.forEach(function (status) { %>
                            <option value="<%= status %>"><%= status %></option>
                        <% }); %>
                    </select>
                </div>

                <button type="submit" class="auth-submit">Create Category</button>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="admin-card">
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Courses</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (categories.length === 0) { %>
                            <tr><td colspan="5" class="text-center text-muted py-4">No categories yet.</td></tr>
                        <% } %>
                        <% categories.forEach(function (category) { %>
                            <tr>
                                <td style="min-width:210px;">
                                    <div class="d-flex align-items-start gap-2">
                                        <div>
                                            <img id="pv-cat-<%= category.id %>" class="img-thumb" src="<%= category.imageUrl || '' %>" alt="<%= category.name %> image" <%- category.imageUrl ? '' : 'hidden' %> data-fallback-src="/assets/images/hero-placeholder.svg">
                                            <div id="pe-cat-<%= category.id %>" class="img-thumb d-flex align-items-center justify-content-center small text-muted" <%- category.imageUrl ? 'hidden' : '' %>>No image</div>
                                            <span id="pb-cat-<%= category.id %>" class="badge mt-1 text-bg-<%= category.imageUrl ? 'success' : 'secondary' %>"><%= category.imageUrl ? 'Custom image' : 'Not set' %></span>
                                        </div>
                                        <div>
                                            <form method="POST" action="/admin/categories/<%= category.id %>/image/upload" enctype="multipart/form-data" class="m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="file" name="thumbnail" accept="image/jpeg,image/png,image/webp" class="form-control form-control-sm mb-1" style="max-width:190px;" required data-preview-img="pv-cat-<%= category.id %>" data-preview-empty="pe-cat-<%= category.id %>" data-preview-badge="pb-cat-<%= category.id %>" aria-label="Category image">
                                                <button type="submit" class="btn btn-sm btn-outline-primary"><%= category.imageUrl ? 'Replace image' : 'Upload image' %></button>
                                            </form>
                                            <% if (category.imageUrl) { %>
                                                <form method="POST" action="/admin/categories/<%= category.id %>/image/remove" class="m-0 mt-1" data-confirm="Remove this category image?">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove image</button>
                                                </form>
                                            <% } %>
                                            <div class="small text-muted mt-1">JPG, PNG or WebP, max 5MB</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <form method="POST" action="/admin/categories/<%= category.id %>" class="d-flex gap-2 align-items-center m-0">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="text" name="name" class="form-control form-control-sm" value="<%= category.name %>" style="max-width:160px;" required>
                                        <select name="status" class="form-select form-select-sm" style="max-width:110px;">
                                            <% statuses.forEach(function (status) { %>
                                                <option value="<%= status %>" <%= category.status === status ? 'selected' : '' %>><%= status %></option>
                                            <% }); %>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                                    </form>
                                </td>
                                <td><span class="badge bg-<%= category.status === 'ACTIVE' ? 'success' : 'secondary' %>"><%= category.status %></span></td>
                                <td><%= category._count.courses %></td>
                                <td class="text-end">
                                    <form method="POST" action="/admin/categories/<%= category.id %>/delete" class="m-0"
                                          data-confirm="Delete this category? <%= category._count.courses %> course(s) will become uncategorized.">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
