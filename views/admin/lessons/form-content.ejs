<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 style="font-size:24px;" class="mb-0"><%= lesson ? 'Edit Lesson' : 'New Lesson' %></h1>
    <a href="/admin/courses/<%= course.id %>/lessons" class="btn btn-sm btn-outline-secondary">Back to Lessons</a>
</div>

<p class="text-muted mb-4">Course: <strong><%= course.title %></strong></p>

<% if (errors && errors.length) { %>
    <div class="alert alert-danger">
        <ul class="mb-0 ps-3">
            <% errors.forEach(function (error) { %><li><%= error %></li><% }) %>
        </ul>
    </div>
<% } %>

<div class="admin-card">
    <form method="POST" action="<%= lesson ? '/admin/lessons/' + lesson.id : '/admin/courses/' + course.id + '/lessons' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="row g-3">

            <div class="col-md-8">
                <label class="form-label small fw-semibold">Title</label>
                <input type="text" name="title" class="form-control form-control-custom" value="<%= values.title || '' %>" required>
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-semibold">Slug (optional)</label>
                <input type="text" name="slug" class="form-control form-control-custom" value="<%= values.slug || '' %>">
            </div>

            <div class="col-12">
                <label class="form-label small fw-semibold">Description</label>
                <textarea name="description" class="form-control form-control-custom" rows="3"><%= values.description || '' %></textarea>
            </div>

            <div class="col-12">
                <label class="form-label small fw-semibold">Video URL</label>
                <input type="text" name="videoUrl" class="form-control form-control-custom" value="<%= values.videoUrl || '' %>" placeholder="https://www.youtube.com/watch?v=... or Vimeo link">
                <div class="form-text">YouTube and Vimeo links are embedded automatically. Other providers are stored but won't preview yet.</div>
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-semibold">Duration (e.g. "12m")</label>
                <input type="text" name="duration" class="form-control form-control-custom" value="<%= values.duration || '' %>">
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-semibold">Sort Order</label>
                <input type="number" min="0" name="sortOrder" class="form-control form-control-custom" value="<%= (values.sortOrder !== undefined && values.sortOrder !== null) ? values.sortOrder : 0 %>">
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-control-custom">
                    <% statuses.forEach(function (status) { %>
                        <option value="<%= status %>" <%= values.status === status ? 'selected' : '' %>><%= status %></option>
                    <% }); %>
                </select>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="preview" id="preview" <%= values.preview ? 'checked' : '' %>>
                    <label class="form-check-label" for="preview">
                        Allow anonymous/non-enrolled preview access
                    </label>
                </div>
            </div>

        </div>

        <button type="submit" class="auth-submit mt-4" style="width:auto; padding:0 32px;">
            <%= lesson ? 'Save Changes' : 'Create Lesson' %>
        </button>
    </form>
</div>

<% if (lesson) { %>
<div class="admin-card mt-4">
    <h5 class="mb-3">Local (Hostinger-hosted) Video</h5>

    <% if (lesson.videoType === 'LOCAL' && lesson.videoPath) { %>
        <p class="small text-success mb-3">
            <i class="bi bi-check-circle-fill me-1"></i>
            This lesson currently plays a local video file (<code><%= lesson.videoPath %></code>) instead of the Video URL above.
        </p>
        <form method="POST" action="/admin/lessons/<%= lesson.id %>/video/remove" onsubmit="return confirm('Detach the local video? The file itself is not deleted.');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm btn-outline-danger">Detach local video (fall back to Video URL)</button>
        </form>
    <% } else { %>
        <p class="small text-muted mb-3">No local video attached — this lesson uses the Video URL above (YouTube/Vimeo).</p>

        <div class="row g-4">
            <div class="col-md-6">
                <h6 class="small fw-semibold">Option A — Upload directly</h6>
                <p class="form-text mt-0">Best for small files (well under 200MB). For full-length course videos, prefer Option B.</p>
                <form method="POST" action="/admin/lessons/<%= lesson.id %>/video/upload" enctype="multipart/form-data">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="file" name="video" accept=".mp4,.webm,video/mp4,video/webm" class="form-control form-control-custom mb-2" required>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Upload video</button>
                </form>
            </div>
            <div class="col-md-6">
                <h6 class="small fw-semibold">Option B — Register an uploaded file</h6>
                <p class="form-text mt-0">
                    Upload the .mp4/.webm file to this course's video folder via
                    File Manager or SFTP (see README "Video Upload" for the exact
                    path on this server), then enter just the filename here.
                </p>
                <form method="POST" action="/admin/lessons/<%= lesson.id %>/video/register">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="text" name="filename" placeholder="e.g. lesson-1.mp4" class="form-control form-control-custom mb-2" required>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Register file</button>
                </form>
            </div>
        </div>
    <% } %>
</div>
<% } %>
