<h1 class="mb-4">Contact Messages</h1><div class="admin-card table-responsive"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Subject</th><th>Status</th><th>Received</th></tr></thead><tbody><% messages.forEach(m => { %><tr><td><a href="/admin/messages/<%= m.id %>"><%= m.name %></a></td><td><%= m.email %></td><td><%= m.subject %></td><td><%= m.status %></td><td><%= m.createdAt.toLocaleDateString('en-IN') %></td></tr><% }) %></tbody></table></div>
