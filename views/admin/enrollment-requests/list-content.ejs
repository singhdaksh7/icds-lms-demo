<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 style="font-size:24px;" class="mb-0">Enrollment Requests</h1>
</div>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <a href="/admin/enrollment-requests" class="btn btn-sm <%= activeStatus === '' ? 'btn-secondary' : 'btn-outline-secondary' %>">All</a>
    <% statuses.forEach(function (s) { %>
        <a href="/admin/enrollment-requests?status=<%= s %>" class="btn btn-sm <%= activeStatus === s ? 'btn-secondary' : 'btn-outline-secondary' %>"><%= s %></a>
    <% }); %>
</div>

<div class="admin-card table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Student</th>
                <th>Course</th>
                <th>Status</th>
                <th>Requested</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (requests.length === 0) { %>
                <tr><td colspan="5" class="text-center text-muted py-4">No enrollment requests<%= activeStatus ? ` with status ${activeStatus}` : '' %>.</td></tr>
            <% } %>
            <% requests.forEach(function (r) { %>
                <tr>
                    <td>
                        <a href="/admin/students/<%= r.user.id %>"><%= r.user.name %></a>
                        <div class="small text-muted"><%= r.user.email %></div>
                    </td>
                    <td><a href="/admin/courses/<%= r.course.id %>/edit"><%= r.course.title %></a></td>
                    <td><span class="badge bg-secondary"><%= r.status %></span></td>
                    <td class="small text-muted"><%= r.createdAt.toLocaleDateString('en-IN') %></td>
                    <td class="text-end">
                        <% if (r.status === 'PENDING' || r.status === 'CONTACTED') { %>
                            <form method="POST" action="/admin/enrollment-requests/<%= r.id %>/approve" class="d-inline">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-sm btn-outline-success">Enroll</button>
                            </form>
                        <% } %>
                        <% if (r.status === 'PENDING') { %>
                            <form method="POST" action="/admin/enrollment-requests/<%= r.id %>/status" class="d-inline">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="status" value="CONTACTED">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark Contacted</button>
                            </form>
                        <% } %>
                        <% if (r.status !== 'DECLINED' && r.status !== 'ENROLLED') { %>
                            <form method="POST" action="/admin/enrollment-requests/<%= r.id %>/status" class="d-inline">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="status" value="DECLINED">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Decline</button>
                            </form>
                        <% } %>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>
