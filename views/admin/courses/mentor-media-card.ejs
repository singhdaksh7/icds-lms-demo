<%#
  "Mentor photo / video" card for the course landing editor (Mentor Display tab).
  Locals: course, mentorMediaView = { media (merged row), r2Configured }, csrfToken.
  Own multipart form (does not touch the Mentor section settings form below it). #%>
<%
    const mm = mentorMediaView.media;
    const mmHosted = mm.videoType === 'UPLOAD' && mm.videoObjectKey;
    const mmLink = (mm.videoType === 'YOUTUBE' || mm.videoType === 'VIMEO') && mm.videoUrl;
    const mmHasVideo = Boolean(mmHosted || mmLink);
%>
<div class="admin-card mb-4" id="mentorMediaCard">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
        <h5 class="mb-0 text-primary"><i class="bi bi-camera-video me-2"></i>Mentor photo / video</h5>
        <span class="badge bg-light text-dark border">This course only</span>
    </div>
    <p class="small text-muted">Choose what the Mentor section of <strong><%= course.title %></strong> shows next to the mentor&rsquo;s details: the instructor&rsquo;s normal photo (default), an uploaded photo, or a video. Other courses are not affected.</p>

    <% if (mm.mediaMode === 'VIDEO' && !mmHasVideo) { %>
        <div class="alert alert-warning small">Video is selected but there is no playable video yet, so the page keeps showing the photo. Upload a video or paste a YouTube / Vimeo link below.</div>
    <% } %>

    <form method="POST" action="/admin/courses/<%= course.id %>/mentor-media" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label small fw-semibold" for="mmMode">Display</label>
                <select class="form-select form-select-sm" id="mmMode" name="mediaMode">
                    <option value="DEFAULT" <%= mm.mediaMode === 'DEFAULT' ? 'selected' : '' %>>Instructor photo (default)</option>
                    <option value="PHOTO" <%= mm.mediaMode === 'PHOTO' ? 'selected' : '' %>>Uploaded photo</option>
                    <option value="VIDEO" <%= mm.mediaMode === 'VIDEO' ? 'selected' : '' %>>Video</option>
                </select>
            </div>
            <div class="col-md-8">
                <label class="form-label small fw-semibold" for="mmCaption">Caption (optional)</label>
                <input type="text" class="form-control form-control-sm" id="mmCaption" name="caption" maxlength="200" value="<%= mm.caption || '' %>" placeholder="e.g. A message from your mentor">
                <div class="form-text">Shown under the video. Leave blank to hide it.</div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label small fw-semibold" for="mmPhoto">Photo (JPG, PNG or WEBP, max 5MB)</label>
                <input type="file" class="form-control form-control-sm" id="mmPhoto" name="photo" accept="image/jpeg,image/png,image/webp">
                <div class="form-text">Used when Display is &ldquo;Uploaded photo&rdquo;.</div>
                <% if (mm.photoUrl) { %>
                    <div class="d-flex align-items-center gap-3 mt-2">
                        <img src="<%= mm.photoUrl %>" alt="Current photo" style="height:72px; width:auto; border-radius:8px; border:1px solid #e2e8f0;">
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="mmRemovePhoto" name="removePhoto" value="true"><label class="form-check-label small" for="mmRemovePhoto">Remove this photo</label></div>
                    </div>
                <% } %>
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-semibold" for="mmPoster">Video poster / thumbnail (JPG, PNG or WEBP, max 5MB)</label>
                <input type="file" class="form-control form-control-sm" id="mmPoster" name="poster" accept="image/jpeg,image/png,image/webp">
                <div class="form-text">Shown before play. If empty, the instructor photo is used.</div>
                <% if (mm.posterUrl) { %>
                    <div class="d-flex align-items-center gap-3 mt-2">
                        <img src="<%= mm.posterUrl %>" alt="Current poster" style="height:72px; width:auto; border-radius:8px; border:1px solid #e2e8f0;">
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="mmRemovePoster" name="removePoster" value="true"><label class="form-check-label small" for="mmRemovePoster">Remove poster</label></div>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="border rounded p-3 mb-3 bg-light">
            <div class="small fw-semibold mb-2"><i class="bi bi-film me-1"></i> Video</div>
            <% if (mmHasVideo) { %>
                <div class="small mb-2">Current video:
                    <% if (mmHosted) { %><strong>Uploaded file</strong><% } else { %><strong><%= mm.videoType === 'VIMEO' ? 'Vimeo' : 'YouTube' %></strong> &middot; <span class="text-break"><%= mm.videoUrl %></span><% } %>
                </div>
                <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="mmRemoveVideo" name="removeVideo" value="true"><label class="form-check-label small" for="mmRemoveVideo">Remove the current video</label></div>
            <% } else { %>
                <div class="small text-muted mb-2">No video yet.</div>
            <% } %>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold" for="mmVideo">Upload video (MP4 or WebM)</label>
                    <input type="file" class="form-control form-control-sm" id="mmVideo" name="video" accept="video/mp4,video/webm,.mp4,.webm" <%= mentorMediaView.r2Configured ? '' : 'disabled' %>>
                    <div class="form-text"><% if (mentorMediaView.r2Configured) { %>Uploading replaces the current video. Stored on Cloudflare R2 and played through a short-lived link.<% } else { %>Cloudflare R2 is not configured (<a href="/admin/video-storage">Video Storage</a>). Use a YouTube / Vimeo link instead.<% } %></div>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold" for="mmVideoUrl">&hellip;or YouTube / Vimeo link</label>
                    <input type="url" class="form-control form-control-sm" id="mmVideoUrl" name="videoUrl" maxlength="500" placeholder="https://www.youtube.com/watch?v=..." value="<%= mmLink ? mm.videoUrl : '' %>">
                    <div class="form-text">Pasting a link replaces an uploaded video.</div>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <input type="hidden" name="autoplayMuted" value="false">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="mmAutoplay" name="autoplayMuted" value="true" <%= mm.autoplayMuted !== false ? 'checked' : '' %>>
                        <label class="form-check-label small" for="mmAutoplay">Autoplay (muted) when scrolled into view</label>
                    </div>
                    <div class="form-text">Browsers only allow automatic playback without sound, so it starts muted with an unmute button. Never plays with sound on its own.</div>
                </div>
                <div class="col-md-6">
                    <input type="hidden" name="loopVideo" value="false">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="mmLoop" name="loopVideo" value="true" <%= mm.loopVideo === true ? 'checked' : '' %>>
                        <label class="form-check-label small" for="mmLoop">Loop the video</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button type="submit" class="btn btn-primary btn-sm px-4"><i class="bi bi-save me-1"></i> Save mentor photo / video</button>
            <a href="/admin/courses/<%= course.id %>/landing-page/preview#mentor" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm"><i class="bi bi-box-arrow-up-right me-1"></i> Preview</a>
        </div>
    </form>

    <form method="POST" action="/admin/courses/<%= course.id %>/mentor-media/reset" class="mt-3" data-confirm="Reset this course&rsquo;s mentor media to the default instructor photo? Any uploaded photo, poster or video for this course will be removed.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-outline-danger btn-sm" <%= mm.mediaMode === 'DEFAULT' && !mm.photoUrl && !mm.posterUrl && !mmHasVideo ? 'disabled' : '' %>><i class="bi bi-arrow-counterclockwise me-1"></i> Reset to default</button>
    </form>
</div>
