<!-- Edit modals for every repeatable landing item. The Edit buttons in each tab
     target #<prefix>-<id>; each form posts to the matching /edit route and
     always submits the Published state explicitly (hidden "false" + checkbox). -->
<%
const editModalDefs = [
    { prefix: 'editChipModal', route: 'chips', tab: 'hero', title: 'Edit Highlight Chip', items: typeof heroChips !== 'undefined' ? heroChips : [],
      fields: [{ n: 'label', l: 'Chip Label', t: 'text', max: 100, req: true }] },
    { prefix: 'editAccessPlanModal', route: 'access-plans', tab: 'access-plans', title: 'Edit Access Plan', items: typeof accessPlans !== 'undefined' ? accessPlans : [],
      fields: [
        { n: 'label', l: 'Plan Label', t: 'text', max: 100, req: true },
        { n: 'durationDays', l: 'Duration (in Days, blank = Lifetime)', t: 'number' },
        { n: 'price', l: 'Price (INR)', t: 'number', step: '0.01' },
        { n: 'salePrice', l: 'Sale Price (optional)', t: 'number', step: '0.01' },
      ], flags: [{ n: 'isDefault', l: 'Default Selected Plan' }] },
    { prefix: 'editStatModal', route: 'stats', tab: 'stats', title: 'Edit Quick Stat', items: typeof courseStats !== 'undefined' ? courseStats : [],
      fields: [
        { n: 'statType', l: 'Stat Type', t: 'select', opts: ['MANUAL', 'PUBLISHED_VIDEO_COUNT', 'TOTAL_VIDEO_DURATION', 'RESOURCE_COUNT', 'MODULE_COUNT', 'TOPIC_COUNT', 'REVIEW_COUNT'] },
        { n: 'value', l: 'Stat Value (ignored if AUTO)', t: 'text', max: 100 },
        { n: 'label', l: 'Stat Label', t: 'text', max: 100, req: true },
        { n: 'icon', l: 'Bootstrap Icon Class', t: 'text', max: 50 },
      ] },
    { prefix: 'editQuestionModal', route: 'questions', tab: 'questions', title: 'Edit Clinical Question', items: typeof questions !== 'undefined' ? questions : [],
      fields: [{ n: 'question', l: 'Question', t: 'textarea', req: true }] },
    { prefix: 'editWhyItemModal', route: 'why-register', tab: 'why-register', title: 'Edit Why Register Item', items: typeof whyRegisterItems !== 'undefined' ? whyRegisterItems : [],
      fields: [
        { n: 'type', l: 'Column Group', t: 'select', opts: ['WANT', 'GET'], labels: { WANT: 'This course is for you if you want to (Left)', GET: 'What you get (Right)' } },
        { n: 'title', l: 'Item Title', t: 'text', req: true },
        { n: 'description', l: 'Description (optional)', t: 'textarea' },
      ] },
    { prefix: 'editHighlightModal', route: 'highlights', tab: 'highlights', title: 'Edit Highlight', items: typeof highlights !== 'undefined' ? highlights : [],
      fields: [
        { n: 'title', l: 'Highlight Title', t: 'text', req: true },
        { n: 'description', l: 'Description (optional)', t: 'textarea' },
      ] },
    { prefix: 'editAudienceModal', route: 'audience', tab: 'audience', title: 'Edit Audience Item', items: typeof audienceItems !== 'undefined' ? audienceItems : [],
      fields: [
        { n: 'type', l: 'Audience Group', t: 'select', opts: ['FOR', 'NOT_FOR'], labels: { FOR: 'Ideal For (Good fit)', NOT_FOR: 'Not For (Probably not for)' } },
        { n: 'title', l: 'Item Text', t: 'text', req: true },
      ] },
    { prefix: 'editFaqModal', route: 'faqs', tab: 'faqs', title: 'Edit Course FAQ', items: typeof faqs !== 'undefined' ? faqs : [],
      fields: [
        { n: 'question', l: 'Question', t: 'text', req: true },
        { n: 'answer', l: 'Answer', t: 'textarea', req: true },
      ] },
    { prefix: 'editAccessStepModal', route: 'access-steps', tab: 'access-steps', title: 'Edit Access Step', items: typeof accessSteps !== 'undefined' ? accessSteps : [],
      fields: [
        { n: 'title', l: 'Step Title', t: 'text', max: 200, req: true },
        { n: 'description', l: 'Description (optional)', t: 'textarea' },
        { n: 'icon', l: 'Icon (optional)', t: 'text', max: 50 },
      ] },
    { prefix: 'editComparisonColumnModal', route: 'comparison-columns', tab: 'comparison', title: 'Edit Comparison Column', items: typeof comparisonColumns !== 'undefined' ? comparisonColumns : [],
      fields: [
        { n: 'title', l: 'Column Title', t: 'text', max: 200, req: true },
        { n: 'subtitle', l: 'Subtitle (optional)', t: 'text', max: 200 },
        { n: 'badgeText', l: 'Badge Text (optional)', t: 'text', max: 100 },
      ], flags: [{ n: 'isRecommended', l: 'Highlight as Recommended' }] },
    { prefix: 'editComparisonItemModal', route: 'comparison-items', tab: 'comparison', title: 'Edit Feature Item',
      items: (typeof comparisonColumns !== 'undefined' ? comparisonColumns : []).reduce(function (acc, c) { return acc.concat(c.items || []); }, []),
      fields: [{ n: 'text', l: 'Feature Text', t: 'text', max: 300, req: true }] },
    { prefix: 'editTakeawayModal', route: 'takeaways', tab: 'takeaways', title: 'Edit Learning Outcome', items: typeof takeaways !== 'undefined' ? takeaways : [],
      fields: [
        { n: 'title', l: 'Title', t: 'text', max: 200, req: true },
        { n: 'description', l: 'Description (optional)', t: 'textarea' },
        { n: 'icon', l: 'Card Number / Icon Text (optional)', t: 'text', max: 50 },
      ] },
];
%>
<% editModalDefs.forEach(function (def) { (def.items || []).forEach(function (it) { %>
<div class="modal fade" id="<%= def.prefix %>-<%= it.id %>" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/<%= def.route %>/<%= it.id %>/edit">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="<%= def.tab %>">
                <div class="modal-header">
                    <h5 class="modal-title"><%= def.title %></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <% def.fields.forEach(function (f) { const fid = def.prefix + '-' + it.id + '-' + f.n; const cur = (it[f.n] === null || it[f.n] === undefined) ? '' : String(it[f.n]); %>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold" for="<%= fid %>"><%= f.l %></label>
                            <% if (f.t === 'textarea') { %>
                                <textarea id="<%= fid %>" name="<%= f.n %>" class="form-control" rows="3" <%= f.req ? 'required' : '' %>><%= cur %></textarea>
                            <% } else if (f.t === 'select') { %>
                                <select id="<%= fid %>" name="<%= f.n %>" class="form-select">
                                    <% f.opts.forEach(function (o) { %>
                                        <option value="<%= o %>" <%= cur === o ? 'selected' : '' %>><%= (f.labels && f.labels[o]) || o %></option>
                                    <% }); %>
                                </select>
                            <% } else { %>
                                <input id="<%= fid %>" type="<%= f.t %>" name="<%= f.n %>" class="form-control" value="<%= cur %>" <%- f.step ? 'step="' + f.step + '"' : '' %> <%- f.max ? 'maxlength="' + f.max + '"' : '' %> <%= f.req ? 'required' : '' %>>
                            <% } %>
                        </div>
                    <% }); %>
                    <% (def.flags || []).forEach(function (fl) { %>
                        <div class="form-check mb-2">
                            <input type="hidden" name="<%= fl.n %>" value="false">
                            <input class="form-check-input" type="checkbox" name="<%= fl.n %>" id="<%= def.prefix %>-<%= it.id %>-<%= fl.n %>" <%= it[fl.n] ? 'checked' : '' %>>
                            <label class="form-check-label" for="<%= def.prefix %>-<%= it.id %>-<%= fl.n %>"><%= fl.l %></label>
                        </div>
                    <% }); %>
                    <div class="form-check">
                        <input type="hidden" name="isPublished" value="false">
                        <input class="form-check-input" type="checkbox" name="isPublished" id="<%= def.prefix %>-<%= it.id %>-pub" <%= it.isPublished ? 'checked' : '' %>>
                        <label class="form-check-label" for="<%= def.prefix %>-<%= it.id %>-pub">Published (uncheck to hide from the public page)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
<% }); }); %>

