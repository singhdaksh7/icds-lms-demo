            01 Hero
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'chips' ? 'active' : '' %>" id="tab-chips-nav" data-bs-toggle="tab" data-bs-target="#tab-chips" type="button" role="tab">
            02 Hero Highlights (<%= heroChips.length %>)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'why-register' ? 'active' : '' %>" id="tab-why-register-nav" data-bs-toggle="tab" data-bs-target="#tab-why-register" type="button" role="tab">
            03 Why Register (<%= whyRegisterItems.length %>)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'highlights' ? 'active' : '' %>" id="tab-highlights-nav" data-bs-toggle="tab" data-bs-target="#tab-highlights" type="button" role="tab">
            04 Highlights (<%= highlights.length %>)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'about' ? 'active' : '' %>" id="tab-about-nav" data-bs-toggle="tab" data-bs-target="#tab-about" type="button" role="tab">
            05 About
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'takeaways' ? 'active' : '' %>" id="tab-takeaways-nav" data-bs-toggle="tab" data-bs-target="#tab-takeaways" type="button" role="tab">
            06 Takeaways (<%= takeaways.length %>)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'sneak' ? 'active' : '' %>" id="tab-sneak-nav" data-bs-toggle="tab" data-bs-target="#tab-sneak" type="button" role="tab">
            07 Sneak Peek
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'questions' ? 'active' : '' %>" id="tab-questions-nav" data-bs-toggle="tab" data-bs-target="#tab-questions" type="button" role="tab">
            08 Clinical Questions (<%= questions.length %>)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'curriculum' ? 'active' : '' %>" id="tab-curriculum-nav" data-bs-toggle="tab" data-bs-target="#tab-curriculum" type="button" role="tab">
            09 Curriculum Display
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'resources' ? 'active' : '' %>" id="tab-resources-nav" data-bs-toggle="tab" data-bs-target="#tab-resources" type="button" role="tab">
            10 Resources
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'reviews' ? 'active' : '' %>" id="tab-reviews-nav" data-bs-toggle="tab" data-bs-target="#tab-reviews" type="button" role="tab">
            11 Reviews (<%= testimonials.length %>)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'mentor' ? 'active' : '' %>" id="tab-mentor-nav" data-bs-toggle="tab" data-bs-target="#tab-mentor" type="button" role="tab">
            12 Meet Your Mentor
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'audience' ? 'active' : '' %>" id="tab-audience-nav" data-bs-toggle="tab" data-bs-target="#tab-audience" type="button" role="tab">
            13 Target Audience (<%= audienceItems.length %>)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'certificate' ? 'active' : '' %>" id="tab-certificate-nav" data-bs-toggle="tab" data-bs-target="#tab-certificate" type="button" role="tab">
            14 Certificate
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'faqs' ? 'active' : '' %>" id="tab-faqs-nav" data-bs-toggle="tab" data-bs-target="#tab-faqs" type="button" role="tab">
            15 FAQs (<%= faqs.length %>)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'final-cta' ? 'active' : '' %>" id="tab-final-cta-nav" data-bs-toggle="tab" data-bs-target="#tab-final-cta" type="button" role="tab">
            16 Final CTA
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link <%= activeTab === 'sticky-cta' ? 'active' : '' %>" id="tab-sticky-cta-nav" data-bs-toggle="tab" data-bs-target="#tab-sticky-cta" type="button" role="tab">
            17 Sticky CTA
        </button>
    </li>
</ul>

<!-- Tabs Content -->
<div class="tab-content" id="landingTabContent">

    <!-- 1. HERO TAB -->
    <div class="tab-pane fade <%= activeTab === 'hero' ? 'show active' : '' %>" id="tab-hero" role="tabpanel">
        <div class="admin-card">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="hero">

                <h5 class="mb-3 text-primary"><i class="bi bi-image me-2"></i>Hero Section Settings</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Hero Eyebrow / Category Tagline</label>
                        <input type="text" name="heroEyebrow" class="form-control form-control-custom" value="<%= landingContent.heroEyebrow || '' %>" placeholder="<%= course.category ? course.category.name + ' • Online Certificate Course' : 'ICDS • Online Certificate Course' %>">
                        <div class="form-text">Small subtitle badge shown right above the main title.</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Title Override (optional)</label>
                        <input type="text" name="heroTitleOverride" class="form-control form-control-custom" value="<%= landingContent.heroTitleOverride || '' %>" placeholder="<%= course.title %>">
                        <div class="form-text">Defaults to course title: "<%= course.title %>"</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Hero Accent Phrase / Word</label>
                        <input type="text" name="heroAccentText" class="form-control form-control-custom" value="<%= landingContent.heroAccentText || '' %>" placeholder="e.g. Master Class or Hands-on Protocol">
                        <div class="form-text">Highlighted in elegant italic serif style in the headline.</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Price Subtitle / Access Tagline</label>
                        <input type="text" name="priceSubtitle" class="form-control form-control-custom" value="<%= landingContent.priceSubtitle || 'Full Lifetime Access' %>">
                        <div class="form-text">e.g. "Full Lifetime Access" or "Annual Subscription"</div>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-semibold">Hero Short Description (Lede)</label>
                        <textarea name="heroDescription" class="form-control form-control-custom" rows="3" placeholder="<%= course.shortDescription || course.description || '' %>"><%= landingContent.heroDescription || '' %></textarea>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Hero Media Type</label>
                        <select name="heroMediaType" class="form-select form-control-custom">
                            <option value="THUMBNAIL" <%= landingContent.heroMediaType === 'THUMBNAIL' ? 'selected' : '' %>>Course Thumbnail</option>
                            <option value="IMAGE" <%= landingContent.heroMediaType === 'IMAGE' ? 'selected' : '' %>>Custom Image URL</option>
                            <option value="VIDEO" <%= landingContent.heroMediaType === 'VIDEO' ? 'selected' : '' %>>Video Preview URL</option>
                            <option value="NONE" <%= landingContent.heroMediaType === 'NONE' ? 'selected' : '' %>>No Media Column</option>
                        </select>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Hero Media URL (if custom image or video)</label>
                        <input type="text" name="heroMediaUrl" class="form-control form-control-custom" value="<%= landingContent.heroMediaUrl || '' %>" placeholder="https://...">
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-semibold">Hero Media Strip Caption</label>
                        <input type="text" name="heroMediaCaption" class="form-control form-control-custom" value="<%= landingContent.heroMediaCaption || '100% Verified Clinical Curriculum' %>">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Secondary CTA Label</label>
                        <input type="text" name="secondaryCtaLabel" class="form-control form-control-custom" value="<%= landingContent.secondaryCtaLabel || 'Explore Curriculum' %>">
                        <div class="form-text">Leave blank to omit secondary button.</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Secondary CTA Target Anchor or URL</label>
                        <input type="text" name="secondaryCtaTarget" class="form-control form-control-custom" value="<%= landingContent.secondaryCtaTarget || '#curriculum' %>">
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save Hero Settings
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 2. HIGHLIGHTS / CHIPS TAB -->
    <div class="tab-pane fade <%= activeTab === 'chips' ? 'show active' : '' %>" id="tab-chips" role="tabpanel">
        <div class="admin-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 text-primary"><i class="bi bi-tags me-2"></i>Hero Highlight Chips</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createChipModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Chip
                </button>
            </div>
            <p class="small text-muted mb-4">
                Pill badges rendered under the hero paragraph (e.g. "Self-Paced Learning", "Structured Videos", "Private Streaming"). If 0 active chips exist, the chips row is hidden.
            </p>

            <% if (heroChips.length === 0) { %>
                <div class="alert alert-secondary mb-0">No highlight chips added yet. Click "Add Chip" above.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:60px;">Order</th>
                                <th>Chip Text / Label</th>
                                <th style="width:120px;">Status</th>
                                <th style="width:160px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% heroChips.forEach(function(chip, idx) { %>
                                <tr>
                                    <td>
                                        <span class="badge bg-light text-dark border"><%= idx + 1 %></span>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill bg-primary-subtle text-primary border px-3 py-2 fs-6">
                                            ✓ <%= chip.label %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-<%= chip.isPublished ? 'success' : 'secondary' %>">
                                            <%= chip.isPublished ? 'Active' : 'Hidden' %>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1 align-items-center">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/chips/<%= chip.id %>/move" class="d-inline m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" <%= idx === 0 ? 'disabled' : '' %> title="Move Up">↑</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/chips/<%= chip.id %>/move" class="d-inline m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" <%= idx === heroChips.length - 1 ? 'disabled' : '' %> title="Move Down">↓</button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" data-bs-toggle="modal" data-bs-target="#editChipModal-<%= chip.id %>">
                                                Edit
                                            </button>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/chips/<%= chip.id %>/delete" class="d-inline m-0" data-confirm="Delete chip '<%= chip.label %>'?">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">Delete</button>
                                            </form>
                                        </div>

                                        <!-- Edit Modal -->
                                        <div class="modal fade text-start" id="editChipModal-<%= chip.id %>" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/chips/<%= chip.id %>/edit">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Edit Highlight Chip</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-semibold">Chip Label</label>
                                                                <input type="text" name="label" class="form-control" value="<%= chip.label %>" required maxlength="100">
                                                            </div>
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" name="isPublished" id="chipPub-<%= chip.id %>" <%= chip.isPublished ? 'checked' : '' %>>
                                                                <label class="form-check-label" for="chipPub-<%= chip.id %>">Published (Visible on landing page)</label>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>

        <!-- Create Chip Modal -->
        <div class="modal fade" id="createChipModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/chips">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="modal-header">
                            <h5 class="modal-title">Add Highlight Chip</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Chip Label</label>
                                <input type="text" name="label" class="form-control" placeholder="e.g. Structured Video Lessons" required maxlength="100">
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isPublished" id="createChipPub" checked>
                                <label class="form-check-label" for="createChipPub">Published (Visible on landing page)</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-sm btn-primary">Add Chip</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 03. WHY REGISTER TAB -->
    <div class="tab-pane fade <%= activeTab === 'why-register' ? 'show active' : '' %>" id="tab-why-register" role="tabpanel">
        <div class="admin-card mb-4">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="why-register">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-question-diamond me-2"></i>Why Register Section Settings</h5>
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" name="whyRegisterEnabled" id="whyRegisterEnabled" <%= landingContent.whyRegisterEnabled !== false ? 'checked' : '' %>>
                        <label class="form-check-label fs-6 fw-semibold" for="whyRegisterEnabled">Section Enabled</label>
                    </div>
                </div>
                <p class="small text-muted mb-4">
                    Matches the approved reference layout: Heading &rarr; Intro &rarr; Strong Emphasized Line &rarr; Two Checklist Columns (WANT vs GET) &rarr; Closing Statement.
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Eyebrow</label>
                        <input type="text" name="whyRegisterEyebrow" class="form-control form-control-custom" value="<%= landingContent.whyRegisterEyebrow || 'Why Register For This Course?' %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Main Heading</label>
                        <input type="text" name="whyRegisterHeading" class="form-control form-control-custom" value="<%= landingContent.whyRegisterHeading || 'Why Register For This Course?' %>">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Intro Paragraph</label>
                        <textarea name="whyRegisterIntro" class="form-control form-control-custom" rows="2"><%= landingContent.whyRegisterIntro || '' %></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Strong Emphasized Statement (Highlighted line)</label>
                        <input type="text" name="whyRegisterEmphasisText" class="form-control form-control-custom" value="<%= landingContent.whyRegisterEmphasisText || '' %>" placeholder="e.g. Gain the confidence to evaluate, plan, and execute complex full mouth cases systematically.">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Left Column Heading (WANT items)</label>
                        <input type="text" name="whyRegisterWantHeading" class="form-control form-control-custom" value="<%= landingContent.whyRegisterWantHeading || 'This course is for you if you want to:' %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Right Column Heading (GET items)</label>
                        <input type="text" name="whyRegisterGetHeading" class="form-control form-control-custom" value="<%= landingContent.whyRegisterGetHeading || 'What you get:' %>">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Closing Statement Underneath</label>
                        <textarea name="whyRegisterClosingText" class="form-control form-control-custom" rows="2"><%= landingContent.whyRegisterClosingText || '' %></textarea>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save Why Register Settings
                    </button>
                </div>
            </form>
        </div>

        <!-- Repeatable Items Manager (WANT / GET) -->
        <div class="admin-card">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h5 class="mb-1 text-primary"><i class="bi bi-list-check me-2"></i>Checklist Items (<%= whyRegisterItems.length %>)</h5>
                    <div class="small text-muted">Repeatable points grouped into "WANT" (left column) and "GET" (right column).</div>
                </div>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createWhyItemModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Checklist Item
                </button>
            </div>

            <% if (whyRegisterItems.length === 0) { %>
                <div class="alert alert-secondary mb-0">No checklist items added yet. Click "Add Checklist Item" above.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:60px;">Order</th>
                                <th style="width:110px;">Group</th>
                                <th>Item Title</th>
                                <th>Description</th>
                                <th style="width:100px;">Status</th>
                                <th style="width:160px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% whyRegisterItems.forEach(function(item, idx) { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/why-register/<%= item.id %>/move" class="m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
