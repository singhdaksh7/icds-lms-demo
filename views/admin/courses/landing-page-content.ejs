            </div>
        </div>
    </div>

    <!-- 11. REVIEWS TAB -->
    <div class="tab-pane fade <%= activeTab === 'reviews' ? 'show active' : '' %>" id="tab-reviews" role="tabpanel">
        <div class="admin-card mb-4">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="reviews">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-chat-square-quote me-2"></i>Reviews / Testimonials Settings</h5>
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" name="reviewsEnabled" id="reviewsEnabled" <%= landingContent.reviewsEnabled === true ? 'checked' : '' %>>
                        <label class="form-check-label fs-6 fw-semibold" for="reviewsEnabled">Section Enabled</label>
                    </div>
                </div>
                <div class="alert alert-warning py-2 small">
                    <i class="bi bi-shield-exclamation me-1"></i> <strong>Strict Authenticity Rule:</strong> By default this section is disabled. It renders on the public landing page <em>only</em> if "Section Enabled" is checked AND at least one published testimonial exists. Never invent or copy competitor testimonials.
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Reviews Eyebrow</label>
                        <input type="text" name="reviewsEyebrow" class="form-control form-control-custom" value="<%= landingContent.reviewsEyebrow || 'Dentist Testimonials' %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Reviews Heading</label>
                        <input type="text" name="reviewsHeading" class="form-control form-control-custom" value="<%= landingContent.reviewsHeading || 'Reviews from clinicians who transformed their practice' %>">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Reviews Intro Paragraph</label>
                        <textarea name="reviewsIntro" class="form-control form-control-custom" rows="2"><%= landingContent.reviewsIntro || '' %></textarea>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save Reviews Settings
                    </button>
                </div>
            </form>
        </div>

        <!-- Repeatable Testimonials List -->
        <div class="admin-card">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h5 class="mb-1 text-primary"><i class="bi bi-stars me-2"></i>Verified Testimonials (<%= testimonials.length %>)</h5>
                    <div class="small text-muted">Published student/dentist reviews displayed in cards with star ratings.</div>
                </div>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createTestimonialModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Testimonial
                </button>
            </div>

            <% if (testimonials.length === 0) { %>
                <div class="alert alert-secondary mb-0">No testimonials added yet. Click "Add Testimonial" above when authentic reviews are available.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:60px;">Order</th>
                                <th style="width:110px;">Rating</th>
                                <th>Reviewer</th>
                                <th>Quote</th>
                                <th style="width:100px;">Status</th>
                                <th style="width:160px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% testimonials.forEach(function(rev, idx) { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/reviews/<%= rev.id %>/move" class="m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="btn btn-sm btn-light border p-0 px-1" <%= idx === 0 ? 'disabled' : '' %>>▲</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/reviews/<%= rev.id %>/move" class="m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="btn btn-sm btn-light border p-0 px-1" <%= idx === testimonials.length - 1 ? 'disabled' : '' %>>▼</button>
                                            </form>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-warning fw-bold">
                                            <%= '★'.repeat(rev.rating || 5) %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold"><%= rev.reviewerName %></div>
                                        <% if (rev.reviewerDesignation || rev.reviewerLocation) { %>
                                            <div class="small text-muted"><%= rev.reviewerDesignation || '' %><%= (rev.reviewerDesignation && rev.reviewerLocation) ? ' • ' : '' %><%= rev.reviewerLocation || '' %></div>
                                        <% } %>
                                    </td>
                                    <td class="small text-muted">
                                        "<%= rev.quote.length > 80 ? rev.quote.slice(0, 80) + '...' : rev.quote %>"
                                    </td>
                                    <td>
                                        <span class="badge bg-<%= rev.isPublished ? 'success' : 'secondary' %>">
                                            <%= rev.isPublished ? 'Active' : 'Hidden' %>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" data-bs-toggle="modal" data-bs-target="#editTestimonialModal-<%= rev.id %>">Edit</button>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/reviews/<%= rev.id %>/delete" class="m-0" data-confirm="Delete testimonial by <%= rev.reviewerName %>?">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">Delete</button>
