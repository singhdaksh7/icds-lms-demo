<!-- Modal: Add Testimonial -->
<div class="modal fade" id="createTestimonialModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/reviews" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="formSubmitted" value="1">
                <div class="modal-header">
                    <h5 class="modal-title">Add Review / Testimonial</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-start">
                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small fw-semibold">Reviewer Full Name</label>
                            <input type="text" name="reviewerName" class="form-control" placeholder="e.g. Dr. Rajesh Sharma" required>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold">Rating</label>
                            <select name="rating" class="form-select">
                                <option value="5">5 Stars</option>
                                <option value="4">4 Stars</option>
                                <option value="3">3 Stars</option>
                                <option value="2">2 Stars</option>
                                <option value="1">1 Star</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Designation (optional)</label>
                            <input type="text" name="reviewerDesignation" class="form-control" placeholder="e.g. Prosthodontist">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Location (optional)</label>
                            <input type="text" name="reviewerLocation" class="form-control" placeholder="e.g. New Delhi">
                        </div>
                    </div>
                    <div class="mb-3">
                                            <label class="form-label small fw-semibold" for="createRevType">Review Type</label>
                                            <select name="reviewType" id="createRevType" class="form-select">
                                                <option value="TEXT" selected>Text Review (quote required)</option>
                                                <option value="VIDEO" >Video Review (video required, quote optional)</option>
                                                <option value="TEXT_VIDEO" >Text + Video (video and quote required)</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                        <label class="form-label small fw-semibold">Quote / Feedback <span class="text-muted fw-normal">(required for Text and Text + Video)</span></label>
                        <textarea name="quote" class="form-control" rows="3" placeholder="Real feedback from clinician"></textarea>
                    </div>
                                        <div class="border rounded p-2 mb-3 bg-light">
                                            <div class="small fw-semibold mb-2"><i class="bi bi-camera-video me-1"></i>Video (Video and Text + Video reviews)</div>
                                            
                                            <label class="form-label small fw-semibold" for="createRevVideo">Upload video <span class="text-muted fw-normal">(MP4 or WebM, stored privately in Cloudflare R2)</span></label>
                                            <input type="file" name="video" id="createRevVideo" class="form-control form-control-sm mb-2" accept=".mp4,.webm,video/mp4,video/webm">
                                            <label class="form-label small fw-semibold" for="createRevVideoUrl">&hellip;or YouTube / Vimeo link</label>
                                            <input type="url" name="videoUrl" id="createRevVideoUrl" class="form-control form-control-sm" value="" placeholder="https://www.youtube.com/watch?v=&hellip;" maxlength="500">
                                            <div class="form-text">Optional &mdash; use either an upload or a link. Hidden on the public page for Text reviews.</div>
                                            <label class="form-label small fw-semibold mt-2" for="createRevThumb">Thumbnail <span class="text-muted fw-normal">(optional JPG/PNG/WEBP &mdash; a default poster is used when empty)</span></label>
                                            <input type="file" name="thumbnail" id="createRevThumb" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">
                                            
                                        </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="form-check">
                                <input type="hidden" name="isPublished" value="false">
                                <input class="form-check-input" type="checkbox" name="isPublished" id="revPub" checked>
                                <label class="form-check-label" for="revPub">Published</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check">
                                <input type="hidden" name="isDemo" value="false">
                                <input class="form-check-input" type="checkbox" name="isDemo" id="revDemo">
                                <label class="form-check-label text-warning-emphasis fw-semibold" for="revDemo">
                                    Demo Review (Preview only)
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="row g-2 mt-2 align-items-end">
                        <div class="col-12">
                            <div class="form-check">
                                <input type="hidden" name="featuredOnHome" value="false">
                                <input class="form-check-input" type="checkbox" name="featuredOnHome" value="true" id="createRevHome">
                                <label class="form-check-label fw-semibold" for="createRevHome">Show on Homepage</label>
                                <div class="form-text">Genuine, published reviews only. Does not affect this course page.</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold" for="createRevHomeOrder">Homepage order</label>
                            <input type="number" min="0" max="100000" name="homeSortOrder" id="createRevHomeOrder" class="form-control form-control-sm">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold" for="createRevCourseOrder">Course page order</label>
                            <input type="number" min="0" max="100000" name="sortOrder" id="createRevCourseOrder" class="form-control form-control-sm" placeholder="Auto">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Add Review</button>
                </div>
            </form>
        </div>
    </div>
</div>

