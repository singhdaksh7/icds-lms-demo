                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Media URL (if applicable)</label>
                        <input type="text" name="accessMediaUrl" class="form-control form-control-custom" value="<%= landingContent.accessMediaUrl || '' %>" placeholder="https://...">
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save Access Section Settings
                    </button>
                </div>
