                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 6. CLINICAL QUESTIONS TAB -->
    <div class="tab-pane fade <%= activeTab === 'questions' ? 'show active' : '' %>" id="tab-questions" role="tabpanel">
        <div class="admin-card mb-4">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings" class="mb-4 pb-3 border-bottom">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="questions">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-patch-question me-2"></i>Clinical Questions Settings</h5>
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" name="questionsEnabled" id="questionsEnabled" <%= landingContent.questionsEnabled !== false ? 'checked' : '' %>>
                        <label class="form-check-label fs-6 fw-semibold" for="questionsEnabled">Section Enabled</label>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Section Eyebrow</label>
                        <input type="text" name="questionsEyebrow" class="form-control form-control-custom" value="<%= landingContent.questionsEyebrow || 'Clinical Fundamentals' %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Section Heading</label>
                        <input type="text" name="questionsHeading" class="form-control form-control-custom" value="<%= landingContent.questionsHeading || 'Core clinical questions this masterclass helps you answer' %>">
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-sm btn-outline-primary">Save Section Header</button>
                </div>
            </form>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0 fw-bold">Questions List (<%= questions.length %>)</h6>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createQuestionModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Question
                </button>
            </div>

            <% if (questions.length === 0) { %>
                <div class="alert alert-secondary mb-0">No questions added yet. Section remains hidden if 0 published questions exist.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:60px;">#</th>
                                <th>Clinical Question</th>
                                <th style="width:120px;">Status</th>
                                <th style="width:160px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% questions.forEach(function(q, idx) { %>
                                <tr>
                                    <td>
                                        <span class="badge bg-light text-dark border"><%= String(idx + 1).padStart(2, '0') %></span>
                                    </td>
                                    <td class="fw-medium"><%= q.question %></td>
                                    <td>
                                        <span class="badge bg-<%= q.isPublished ? 'success' : 'secondary' %>">
                                            <%= q.isPublished ? 'Published' : 'Hidden' %>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/questions/<%= q.id %>/move" class="d-inline m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" <%= idx === 0 ? 'disabled' : '' %>>↑</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/questions/<%= q.id %>/move" class="d-inline m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" <%= idx === questions.length - 1 ? 'disabled' : '' %>>↓</button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" data-bs-toggle="modal" data-bs-target="#editQuestionModal-<%= q.id %>">Edit</button>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/questions/<%= q.id %>/delete" class="d-inline m-0" data-confirm="Delete question '<%= q.question %>'?">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">Delete</button>
                                            </form>
                                        </div>

                                        <!-- Edit Question Modal -->
                                        <div class="modal fade text-start" id="editQuestionModal-<%= q.id %>" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/questions/<%= q.id %>/edit">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Edit Clinical Question</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-semibold">Question</label>
                                                                <textarea name="question" class="form-control" rows="3" required maxlength="300"><%= q.question %></textarea>
                                                            </div>
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" name="isPublished" id="editQPub-<%= q.id %>" <%= q.isPublished ? 'checked' : '' %>>
                                                                <label class="form-check-label" for="editQPub-<%= q.id %>">Published (Visible)</label>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>

        <!-- Create Question Modal -->
        <div class="modal fade" id="createQuestionModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/questions">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="modal-header">
                            <h5 class="modal-title">Add Clinical Question</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Question</label>
                                <textarea name="question" class="form-control" rows="3" placeholder="e.g. How to stabilize, deprogram, and restore a collapsed bite" required maxlength="300"></textarea>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isPublished" id="createQPub" checked>
                                <label class="form-check-label" for="createQPub">Published (Visible)</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-sm btn-primary">Add Question</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 7. CURRICULUM DISPLAY SETTINGS TAB -->
