                    <div class="form-check form-switch fs-5">
                        <input type="hidden" name="purchaseCardEnabled" value="false">
                        <input class="form-check-input" type="checkbox" name="purchaseCardEnabled" id="purchaseCardEnabled" <%= landingContent.purchaseCardEnabled !== false ? 'checked' : '' %>>
