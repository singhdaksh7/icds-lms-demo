    <!-- 09. REVIEWS / TESTIMONIALS TAB -->
    <div class="tab-pane fade <%= activeTab === 'reviews' ? 'show active' : '' %>" id="tab-reviews" role="tabpanel">
        <% if (typeof reviewsCarousel !== 'undefined' && reviewsCarousel) { %>
        <div class="admin-card mb-4">
            <form method="POST" action="/admin/courses/<%= course.id %>/reviews-carousel">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <h5 class="mb-1 text-primary"><i class="bi bi-arrow-left-right me-2"></i>Reviews Carousel Presentation</h5>
                <p class="small text-muted">How this course&rsquo;s reviews move on its landing page. Applies to this course only.</p>
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold" for="rcMode">Carousel mode</label>
                        <select class="form-select form-select-sm" id="rcMode" name="mode">
                            <% [['STATIC', 'Static (no movement, swipeable)'], ['SLIDE', 'Slide (pauses between moves)'], ['CONTINUOUS', 'Continuous (slow marquee)']].forEach(function (m) { %>
                                <option value="<%= m[0] %>" <%= reviewsCarousel.mode === m[0] ? 'selected' : '' %>><%= m[1] %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold" for="rcSpeed">Continuous speed</label>
                        <select class="form-select form-select-sm" id="rcSpeed" name="speed">
                            <% [['VERY_SLOW', 'Very slow (~45s loop)'], ['SLOW', 'Slow (~32s loop)'], ['NORMAL', 'Normal (~22s loop)']].forEach(function (s) { %>
                                <option value="<%= s[0] %>" <%= reviewsCarousel.speed === s[0] ? 'selected' : '' %>><%= s[1] %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold" for="rcDirection">Direction</label>
                        <select class="form-select form-select-sm" id="rcDirection" name="direction">
                            <option value="LEFT_TO_RIGHT" <%= reviewsCarousel.direction === 'LEFT_TO_RIGHT' ? 'selected' : '' %>>Left to right</option>
                            <option value="RIGHT_TO_LEFT" <%= reviewsCarousel.direction === 'RIGHT_TO_LEFT' ? 'selected' : '' %>>Right to left</option>
                        </select>
                    </div>
                    <div class="col-md-2"><button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-save me-1"></i> Save</button></div>
                </div>
            </form>
        </div>
        <% } %>
        <div class="admin-card mb-4">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="reviews">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-chat-heart me-2"></i>Reviews Section Settings</h5>
                    <div class="form-check form-switch fs-5">
                        <input type="hidden" name="reviewsEnabled" value="false">
                        <input class="form-check-input" type="checkbox" name="reviewsEnabled" id="reviewsEnabled" <%= landingContent.reviewsEnabled === true ? 'checked' : '' %>>
                        <label class="form-check-label fs-6 fw-semibold" for="reviewsEnabled">Section Enabled</label>
                    </div>
                </div>

                <div class="alert alert-warning py-2 small mb-4">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <strong>Integrity Rule:</strong> Only genuine reviews from real practicing dentists may be published. Current FMR has 0 reviews, so this section is kept <strong>OFF</strong> by default until real clinician feedback is collected.
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Section Eyebrow</label>
                        <input type="text" name="reviewsEyebrow" class="form-control form-control-custom" value="<%= landingContent.reviewsEyebrow || '' %>" placeholder="Optional — hidden when empty">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Section Heading</label>
                        <input type="text" name="reviewsHeading" class="form-control form-control-custom" value="<%= landingContent.reviewsHeading || '' %>" placeholder="Optional — hidden when empty">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Section Intro (optional)</label>
                        <textarea name="reviewsIntro" class="form-control form-control-custom" rows="2"><%= landingContent.reviewsIntro || '' %></textarea>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save Reviews Settings
                    </button>
                </div>
            </form>
        </div>

        <div class="admin-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 text-primary"><i class="bi bi-person-hearts me-2"></i>Testimonials &amp; Reviews (<%= testimonials.length %>)</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createTestimonialModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Review
                </button>
            </div>

            <% if (testimonials.length === 0) { %>
                <div class="alert alert-secondary mb-0">No reviews entered. Section is cleanly hidden from public view.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:70px;">Order</th>
                                <th style="width:110px;">Type</th>
                                <th>Reviewer</th>
                                <th>Designation / Location</th>
                                <th style="width:90px;">Rating</th>
                                <th>Quote</th>
                                <th style="width:110px;">Status</th>
                                <th style="width:180px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% testimonials.forEach(function(rev, idx) { %>
                                <tr class="<%= rev.isDemo ? 'table-warning bg-opacity-10' : '' %>">
                                    <td><span class="badge bg-light text-dark border">#<%= rev.sortOrder %></span></td>
                                    <td>
                                        <% if (rev.isDemo) { %>
                                            <span class="badge bg-warning text-dark border border-warning" title="Test/Demo review - never visible to public visitors">
                                                <i class="bi bi-flask me-1"></i>DEMO
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-success" title="Genuine verified testimonial">
                                                <i class="bi bi-check-circle me-1"></i>REAL
                                            </span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <strong><%= rev.reviewerName %></strong>
                                        <% if (rev.reviewType && rev.reviewType !== 'TEXT') { %><span class="badge bg-info text-dark ms-1"><i class="bi bi-camera-video me-1"></i><%= rev.reviewType === 'VIDEO' ? 'Video' : 'Text + Video' %></span><% } %>
                                        <% if (rev.isDemo) { %>
                                            <div class="small text-muted fst-italic">Demo / QA Preview</div>
                                        <% } %>
                                    </td>
                                    <td><%= rev.reviewerDesignation || rev.reviewerLocation || '-' %></td>
                                    <td><span class="text-warning">★ <%= rev.rating %></span></td>
                                    <td class="text-truncate" style="max-width:260px;">"<%= rev.quote %>"</td>
                                    <td>
                                        <span class="badge bg-<%= rev.isPublished ? 'success' : 'secondary' %>">
                                            <%= rev.isPublished ? 'Published' : 'Hidden' %>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/reviews/<%= rev.id %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move Up" <%= idx === 0 ? 'disabled' : '' %>>↑</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/reviews/<%= rev.id %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move Down" <%= idx === testimonials.length - 1 ? 'disabled' : '' %>>↓</button>
                                            </form>
                                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editTestimonialModal-<%= rev.id %>" title="Edit Review">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/reviews/<%= rev.id %>/delete" class="d-inline" data-confirm='Delete testimonial?'>
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <% testimonials.forEach(function(rev) { %>
                    <!-- Modal: Edit Testimonial <%= rev.id %> -->
                    <div class="modal fade" id="editTestimonialModal-<%= rev.id %>" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/reviews/<%= rev.id %>/edit" enctype="multipart/form-data">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="formSubmitted" value="1">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Edit <%= rev.isDemo ? 'Demo' : 'Genuine' %> Review</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body text-start">
                                        <div class="row g-2 mb-3">
                                            <div class="col-8">
                                                <label class="form-label small fw-semibold">Reviewer Full Name</label>
                                                <input type="text" name="reviewerName" class="form-control" value="<%= rev.reviewerName %>" required>
                                            </div>
                                            <div class="col-4">
                                                <label class="form-label small fw-semibold">Rating</label>
                                                <select name="rating" class="form-select">
                                                    <option value="5" <%= rev.rating === 5 ? 'selected' : '' %>>5 Stars</option>
                                                    <option value="4" <%= rev.rating === 4 ? 'selected' : '' %>>4 Stars</option>
                                                    <option value="3" <%= rev.rating === 3 ? 'selected' : '' %>>3 Stars</option>
                                                    <option value="2" <%= rev.rating === 2 ? 'selected' : '' %>>2 Stars</option>
                                                    <option value="1" <%= rev.rating === 1 ? 'selected' : '' %>>1 Star</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="row g-2 mb-3">
                                            <div class="col-6">
                                                <label class="form-label small fw-semibold">Designation (optional)</label>
                                                <input type="text" name="reviewerDesignation" class="form-control" value="<%= rev.reviewerDesignation || '' %>">
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-semibold">Location (optional)</label>
                                                <input type="text" name="reviewerLocation" class="form-control" value="<%= rev.reviewerLocation || '' %>">
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold" for="editRevType-<%= rev.id %>">Review Type</label>
                                            <select name="reviewType" id="editRevType-<%= rev.id %>" class="form-select">
                                                <option value="TEXT" <%= rev.reviewType === 'TEXT' || !rev.reviewType ? 'selected' : '' %>>Text Review (quote required)</option>
                                                <option value="VIDEO" <%= rev.reviewType === 'VIDEO' ? 'selected' : '' %>>Video Review (video required, quote optional)</option>
                                                <option value="TEXT_VIDEO" <%= rev.reviewType === 'TEXT_VIDEO' ? 'selected' : '' %>>Text + Video (video and quote required)</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold">Quote / Feedback <span class="text-muted fw-normal">(required for Text and Text + Video)</span></label>
                                            <textarea name="quote" class="form-control" rows="3"><%= rev.quote %></textarea>
                                        </div>
                                        <div class="border rounded p-2 mb-3 bg-light">
                                            <div class="small fw-semibold mb-2"><i class="bi bi-camera-video me-1"></i>Video (Video and Text + Video reviews)</div>
