            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-0 text-primary"><i class="bi bi-arrow-down-up me-2"></i>Dynamic Landing Page Section Order</h5>
                    <div class="small text-muted">Reorder, enable, or disable any section. The public landing page renders strictly according to this sequence.</div>
                </div>
            </div>

            <div class="alert alert-info py-2 small mb-4">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Empty Section Guard:</strong> A section will only render publicly if it is marked as Active <em>AND</em> has valid content entered. If disabled or empty, it will disappear automatically without leaving any visual gap.
            </div>

            <% if (!landingSections || landingSections.length === 0) { %>
                <div class="alert alert-secondary mb-0">No custom order configured. Using default reference sequence.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:70px;">Order</th>
                                <th style="width:160px;">Section Key</th>
                                <th>Section Name</th>
                                <th style="width:120px;">Visibility</th>
                                <th style="width:200px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% 
                            const sectionNames = {
                                HERO: '01 Hero Section',
                                STATS: '02 Course Quick Stats',
                                QUESTIONS: '03 Questions This Course Will Answer',
                                WHY_REGISTER: '04 Why Register For This Course',
                                CURRICULUM: '05 Detailed Course Curriculum',
                                HIGHLIGHTS: '06 Course Highlights',
                                PURCHASE: '07 Course CTA / Access Card',
                                REVIEWS: '08 Reviews / Testimonials',
                                COMPARISON: '09 Course Comparison Matrix',
                                AUDIENCE: '10 Target Audience (Ideal For / Not For)',
                                ACCESS: '11 How You Get Access',
                                RESOURCES: '12 Downloadable Clinical Resources',
                                MENTOR: '13 Meet Your Mentor',
                                FAQ: '14 Frequently Asked Questions',
                                SOCIAL_PROOF: '15 Social Proof Summary',
                                FINAL_CTA: '16 Final Conversion Banner',
                            };
                            landingSections.forEach(function(sec, idx) { 
                            %>
                                <tr>
                                    <td><span class="badge bg-light text-dark border">#<%= sec.sortOrder %></span></td>
                                    <td><code><%= sec.sectionKey %></code></td>
                                    <td><strong><%= sectionNames[sec.sectionKey] || sec.sectionKey %></strong></td>
                                    <td>
                                        <span class="badge bg-<%= sec.isEnabled ? 'success' : 'secondary' %>">
                                            <%= sec.isEnabled ? 'Active' : 'Disabled' %>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/sections/<%= sec.sectionKey %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move Up" <%= idx === 0 ? 'disabled' : '' %>>↑</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/sections/<%= sec.sectionKey %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move Down" <%= idx === landingSections.length - 1 ? 'disabled' : '' %>>↓</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/sections/<%= sec.sectionKey %>/toggle" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-outline-<%= sec.isEnabled ? 'warning' : 'success' %> btn-sm" title="Toggle Visibility">
                                                    <%= sec.isEnabled ? 'Disable' : 'Enable' %>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>

    <!-- 20. SEO / SOCIAL PREVIEW TAB -->
    <div class="tab-pane fade <%= activeTab === 'seo' ? 'show active' : '' %>" id="tab-seo" role="tabpanel">
        <div class="admin-card">
            <h5 class="mb-3 text-primary"><i class="bi bi-search me-2"></i>SEO &amp; Social Share Preview</h5>
            <p class="small text-muted mb-4">
                This preview reflects how search engines (Google, Bing) and social platforms (Twitter, LinkedIn, Facebook) render the course landing page link.
            </p>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="border rounded p-3 bg-light">
                        <div class="small fw-bold text-muted mb-2">GOOGLE SEARCH SNIPPET PREVIEW</div>
                        <div style="font-family: Arial, sans-serif;">
                            <div style="font-size: 13px; color: #202124;">https://icds.drtanuraghav.in › courses › <%= course.slug %></div>
                            <div style="font-size: 18px; color: #1a0dab; text-decoration: underline; line-height: 1.3;" class="mt-1">
                                <%= landingContent.heroTitleOverride || course.title %> | ICDS
                            </div>
                            <div style="font-size: 13px; color: #4d5156; line-height: 1.5;" class="mt-1">
                                <%= course.shortDescription || course.description || 'Master clinical restorative techniques with the Institute of Cosmetology & Dental Sciences.' %>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 bg-light">
                        <div class="small fw-bold text-muted mb-2">SOCIAL CARD PREVIEW</div>
                        <div class="border rounded overflow-hidden bg-white">
                            <div style="height: 140px; background: #e2e8f0; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                                <img src="<%= course.thumbnailUrl || '/assets/images/course-placeholder.svg' %>" alt="<%= course.title %>" style="width:100%; height:100%; object-fit:cover;">
                            </div>
                            <div class="p-2">
                                <div class="small text-muted text-uppercase" style="font-size:10px;">icds.drtanuraghav.in</div>
                                <div class="fw-bold small text-truncate"><%= course.title %></div>
                                <div class="text-muted small text-truncate" style="font-size:11px;"><%= course.shortDescription || course.description %></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 21. APPEARANCE TAB (per-course theme) -->
    <div class="tab-pane fade <%= activeTab === 'appearance' ? 'show active' : '' %>" id="tab-appearance" role="tabpanel">
        <% if (typeof appearanceView !== 'undefined' && appearanceView) { %><%- include('appearance-tab', locals) %><% } %>
    </div>

    <!-- 22. PLAYER TAB (per-course student player presentation) -->
    <div class="tab-pane fade <%= activeTab === 'player' ? 'show active' : '' %>" id="tab-player" role="tabpanel">
        <% if (typeof playerSettings !== 'undefined' && playerSettings) { %><%- include('player-tab', locals) %><% } %>
    </div>

</div>

