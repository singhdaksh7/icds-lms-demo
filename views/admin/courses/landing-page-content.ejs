                                <label class="form-label small fw-semibold">Reviewer Name</label>
                                <input type="text" name="reviewerName" class="form-control" placeholder="e.g. Dr. Priya Sharma" required maxlength="120">
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Designation (optional)</label>
