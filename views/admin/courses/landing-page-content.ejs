                        <input type="text" name="purchaseCardEyebrow" class="form-control form-control-custom" value="<%= landingContent.purchaseCardEyebrow || '' %>" placeholder="Optional — hidden when empty">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Card Heading</label>
                        <input type="text" name="purchaseCardHeading" class="form-control form-control-custom" value="<%= landingContent.purchaseCardHeading || '' %>" placeholder="Optional — hidden when empty">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Card Description</label>
