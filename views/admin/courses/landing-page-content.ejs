                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">FAQ Heading</label>
                        <input type="text" name="faqHeading" class="form-control form-control-custom" value="<%= landingContent.faqHeading || 'Frequently asked course questions' %>">
