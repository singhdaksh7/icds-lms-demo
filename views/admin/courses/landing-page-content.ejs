                                <th>Description</th>
                                <th style="width:110px;">Status</th>
                                <th style="width:180px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% accessSteps.forEach(function(step, idx) { %>
                                <tr>
                                    <td><span class="badge bg-light text-dark border">#<%= idx + 1 %></span></td>
                                    <td><strong><%= step.title %></strong></td>
                                    <td><%= step.description || '-' %></td>
                                    <td>
                                        <span class="badge bg-<%= step.isPublished ? 'success' : 'secondary' %>">
                                            <%= step.isPublished ? 'Published' : 'Hidden' %>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/access-steps/<%= step.id %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move Up" <%= idx === 0 ? 'disabled' : '' %>>↑</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/access-steps/<%= step.id %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move Down" <%= idx === accessSteps.length - 1 ? 'disabled' : '' %>>↓</button>
                                            </form>
                                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editAccessStepModal-<%= step.id %>">
