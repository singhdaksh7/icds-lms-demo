    <!-- 9. TARGET AUDIENCE TAB -->
    <div class="tab-pane fade <%= activeTab === 'audience' ? 'show active' : '' %>" id="tab-audience" role="tabpanel">
        <div class="admin-card mb-4">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings" class="mb-4 pb-3 border-bottom">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="audience">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-people me-2"></i>Candidate Profile / Audience Settings</h5>
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" name="audienceEnabled" id="audienceEnabled" <%= landingContent.audienceEnabled !== false ? 'checked' : '' %>>
                        <label class="form-check-label fs-6 fw-semibold" for="audienceEnabled">Section Enabled</label>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Section Eyebrow</label>
                        <input type="text" name="audienceEyebrow" class="form-control form-control-custom" value="<%= landingContent.audienceEyebrow || 'Candidate Profile' %>">
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Section Heading</label>
                        <input type="text" name="audienceHeading" class="form-control form-control-custom" value="<%= landingContent.audienceHeading || 'Is this online Master Class right for you?' %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Left Column Title ("Best For")</label>
                        <input type="text" name="audienceForHeading" class="form-control form-control-custom" value="<%= landingContent.audienceForHeading || 'Good fit for' %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Right Column Title ("Not For")</label>
                        <input type="text" name="audienceNotForHeading" class="form-control form-control-custom" value="<%= landingContent.audienceNotForHeading || 'Probably not for' %>">
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-sm btn-outline-primary">Save Audience Headers</button>
                </div>
            </form>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0 fw-bold">Audience Checklist Items (<%= audienceItems.length %>)</h6>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createAudienceModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Checklist Item
                </button>
            </div>

            <div class="row g-4">
                <!-- FOR Column -->
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100 bg-light-subtle">
                        <h6 class="fw-bold text-success mb-3"><i class="bi bi-check-circle me-1"></i> <%= landingContent.audienceForHeading || 'Good fit for' %></h6>
                        <% const forItems = audienceItems.filter(i => i.type === 'FOR'); %>
                        <% if (forItems.length === 0) { %>
                            <div class="text-muted small">No items added yet.</div>
                        <% } else { %>
                            <ul class="list-group list-group-flush bg-transparent">
                                <% forItems.forEach(function(item, idx) { %>
                                    <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0">
                                        <div class="me-2">
                                            <span class="small fw-medium"><%= item.title %></span>
                                            <% if (!item.isPublished) { %>
                                                <span class="badge bg-secondary ms-1">Hidden</span>
                                            <% } %>
                                        </div>
                                        <div class="d-flex gap-1">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/audience/<%= item.id %>/move" class="d-inline m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" <%= idx === 0 ? 'disabled' : '' %>>↑</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/audience/<%= item.id %>/move" class="d-inline m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" <%= idx === forItems.length - 1 ? 'disabled' : '' %>>↓</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/audience/<%= item.id %>/delete" class="d-inline m-0" data-confirm="Delete item?">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">×</button>
                                            </form>
                                        </div>
                                    </li>
                                <% }); %>
                            </ul>
                        <% } %>
                    </div>
                </div>

                <!-- NOT FOR Column -->
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100 bg-light-subtle">
                        <h6 class="fw-bold text-danger mb-3"><i class="bi bi-x-circle me-1"></i> <%= landingContent.audienceNotForHeading || 'Probably not for' %></h6>
                        <% const notForItems = audienceItems.filter(i => i.type === 'NOT_FOR'); %>
                        <% if (notForItems.length === 0) { %>
                            <div class="text-muted small">No items added yet.</div>
                        <% } else { %>
                            <ul class="list-group list-group-flush bg-transparent">
                                <% notForItems.forEach(function(item, idx) { %>
                                    <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0">
                                        <div class="me-2">
                                            <span class="small fw-medium"><%= item.title %></span>
                                            <% if (!item.isPublished) { %>
                                                <span class="badge bg-secondary ms-1">Hidden</span>
                                            <% } %>
                                        </div>
                                        <div class="d-flex gap-1">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/audience/<%= item.id %>/move" class="d-inline m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" <%= idx === 0 ? 'disabled' : '' %>>↑</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/audience/<%= item.id %>/move" class="d-inline m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" <%= idx === notForItems.length - 1 ? 'disabled' : '' %>>↓</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/audience/<%= item.id %>/delete" class="d-inline m-0" data-confirm="Delete item?">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">×</button>
                                            </form>
                                        </div>
                                    </li>
                                <% }); %>
                            </ul>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Create Audience Item Modal -->
        <div class="modal fade" id="createAudienceModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/audience">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="modal-header">
                            <h5 class="modal-title">Add Candidate Profile Item</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Target Column</label>
                                <select name="type" class="form-select" required>
                                    <option value="FOR">Good fit for (Left Column)</option>
                                    <option value="NOT_FOR">Probably not for (Right Column)</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Bullet Item Text</label>
                                <textarea name="title" class="form-control" rows="2" placeholder="e.g. Ambitious dentists aiming to excel in functional and restorative dentistry" required maxlength="300"></textarea>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isPublished" id="createAudPub" checked>
                                <label class="form-check-label" for="createAudPub">Published (Visible)</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-sm btn-primary">Add Item</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 10. FAQs TAB -->
    <div class="tab-pane fade <%= activeTab === 'faqs' ? 'show active' : '' %>" id="tab-faqs" role="tabpanel">
        <div class="admin-card mb-4">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings" class="mb-4 pb-3 border-bottom">
