                </div>
            <% } else { %>
                <div class="alert alert-warning mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <strong>No instructor currently assigned to this course.</strong>
                    Please go to <a href="/admin/courses/<%= course.id %>/edit" class="alert-link">Course Settings</a> and select <strong>Dr. Tanu Raghav</strong> as the instructor.
                </div>
            <% } %>
        </div>
    </div>

    <!-- 14. CERTIFICATE TAB (CRITICAL: OFF BY DEFAULT) -->
