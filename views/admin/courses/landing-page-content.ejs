    </div>

    <!-- 12. MEET YOUR MENTOR TAB -->
    <div class="tab-pane fade <%= activeTab === 'mentor' ? 'show active' : '' %>" id="tab-mentor" role="tabpanel">
        <div class="admin-card mb-4">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="mentor">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-person-badge me-2"></i>Meet Your Mentor Section Settings</h5>
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" name="mentorSectionEnabled" id="mentorSectionEnabled" <%= landingContent.mentorSectionEnabled !== false ? 'checked' : '' %>>
                        <label class="form-check-label fs-6 fw-semibold" for="mentorSectionEnabled">Section Enabled</label>
                    </div>
                </div>
                <p class="small text-muted mb-4">
                    Course landing page automatically uses <strong>Course.instructor</strong>. The biography, credentials, and experience badge are maintained once under Instructors Admin.
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Mentor Eyebrow</label>
                        <input type="text" name="mentorEyebrow" class="form-control form-control-custom" value="<%= landingContent.mentorEyebrow || 'Meet Your Mentor' %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Section Heading Override (optional)</label>
                        <input type="text" name="mentorHeading" class="form-control form-control-custom" value="<%= landingContent.mentorHeading || '' %>" placeholder="Defaults to instructor's name">
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save Mentor Section Settings
                    </button>
                </div>
            </form>
        </div>

        <!-- Instructor Profile Details & Direct Link -->
        <div class="admin-card">
            <h5 class="mb-3 text-primary"><i class="bi bi-person-check me-2"></i>Assigned Course Mentor Information</h5>
            <% if (course.instructor) { %>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <img src="<%= course.instructor.photoUrl || cms.brand.defaultInstructorImageUrl || '/assets/images/instructor-placeholder.svg' %>"
                         alt="<%= course.instructor.name %>"
                         style="width:80px; height:80px; border-radius:50%; object-fit:cover; border:2px solid #5d3fd3;">
                    <div class="flex-grow-1">
                        <h5 class="mb-1"><%= course.instructor.name %></h5>
                        <div class="text-muted small">
                            <%= course.instructor.designation || course.instructor.title || 'Instructor' %>
                            <% if (course.instructor.organization) { %> &bull; <%= course.instructor.organization %><% } %>
                            <% if (course.instructor.experienceLabel) { %> &bull; <span class="badge bg-dark"><%= course.instructor.experienceLabel %></span><% } %>
                        </div>
                    </div>
                    <div>
                        <a href="/admin/instructors/<%= course.instructor.id %>/edit" class="btn btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i> Edit <%= course.instructor.name %>'s Profile &amp; Credentials
                        </a>
