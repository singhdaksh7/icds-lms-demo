                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-sm btn-outline-primary">Save FAQ Headers</button>
                </div>
            </form>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0 fw-bold">Course FAQs (<%= faqs.length %>)</h6>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createFaqModal">
                    <i class="bi bi-plus-lg me-1"></i> Add FAQ Question
                </button>
            </div>

            <% if (faqs.length === 0) { %>
                <div class="alert alert-secondary mb-0">No course-specific FAQs added yet. If zero FAQs exist, the FAQ section remains hidden.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:60px;">#</th>
                                <th>Question &amp; Answer</th>
                                <th style="width:120px;">Status</th>
                                <th style="width:160px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% faqs.forEach(function(faq, idx) { %>
                                <tr>
                                    <td>
                                        <span class="badge bg-light text-dark border"><%= idx + 1 %></span>
                                    </td>
                                    <td>
                                        <div class="fw-bold mb-1"><%= faq.question %></div>
                                        <div class="small text-muted text-truncate" style="max-width:500px;"><%= faq.answer %></div>
                                    </td>
                                    <td>
                                        <span class="badge bg-<%= faq.isPublished ? 'success' : 'secondary' %>">
                                            <%= faq.isPublished ? 'Published' : 'Hidden' %>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/faqs/<%= faq.id %>/move" class="d-inline m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" <%= idx === 0 ? 'disabled' : '' %>>↑</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/faqs/<%= faq.id %>/move" class="d-inline m-0">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" <%= idx === faqs.length - 1 ? 'disabled' : '' %>>↓</button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" data-bs-toggle="modal" data-bs-target="#editFaqModal-<%= faq.id %>">Edit</button>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/faqs/<%= faq.id %>/delete" class="d-inline m-0" data-confirm="Delete FAQ '<%= faq.question %>'?">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">Delete</button>
                                            </form>
                                        </div>

                                        <!-- Edit FAQ Modal -->
                                        <div class="modal fade text-start" id="editFaqModal-<%= faq.id %>" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/faqs/<%= faq.id %>/edit">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Edit Course FAQ</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-semibold">Question</label>
                                                                <input type="text" name="question" class="form-control" value="<%= faq.question %>" required maxlength="300">
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-semibold">Answer</label>
                                                                <textarea name="answer" class="form-control" rows="4" required><%= faq.answer %></textarea>
                                                            </div>
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" name="isPublished" id="editFaqPub-<%= faq.id %>" <%= faq.isPublished ? 'checked' : '' %>>
                                                                <label class="form-check-label" for="editFaqPub-<%= faq.id %>">Published (Visible)</label>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>

        <!-- Create FAQ Modal -->
        <div class="modal fade" id="createFaqModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/faqs">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="modal-header">
                            <h5 class="modal-title">Add Course FAQ</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Question</label>
                                <input type="text" name="question" class="form-control" placeholder="e.g. Will I get lifetime access to clinical videos?" required maxlength="300">
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Answer</label>
                                <textarea name="answer" class="form-control" rows="4" placeholder="Enter clear, helpful answer..." required></textarea>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isPublished" id="createFaqPub" checked>
                                <label class="form-check-label" for="createFaqPub">Published (Visible)</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-sm btn-primary">Add FAQ</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 11. FINAL CTA TAB -->
    <div class="tab-pane fade <%= activeTab === 'final-cta' ? 'show active' : '' %>" id="tab-final-cta" role="tabpanel">
        <div class="admin-card">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="final-cta">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-megaphone me-2"></i>Final Conversion CTA Banner</h5>
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" name="finalCtaEnabled" id="finalCtaEnabled" <%= landingContent.finalCtaEnabled !== false ? 'checked' : '' %>>
                        <label class="form-check-label fs-6 fw-semibold" for="finalCtaEnabled">Section Enabled</label>
                    </div>
                </div>
                <p class="small text-muted mb-4">
                    The large branded card at the bottom of the course page before the footer. Pricing, payment flow, and enrollment actions remain business-driven.
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Card Eyebrow</label>
                        <input type="text" name="finalCtaEyebrow" class="form-control form-control-custom" value="<%= landingContent.finalCtaEyebrow || 'Start Learning Today' %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Heading Override (optional)</label>
                        <input type="text" name="finalCtaHeading" class="form-control form-control-custom" value="<%= landingContent.finalCtaHeading || '' %>" placeholder="Enroll in <%= course.title %>">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Body Copy</label>
                        <textarea name="finalCtaBody" class="form-control form-control-custom" rows="3"><%= landingContent.finalCtaBody || '' %></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Custom Button Label (optional)</label>
                        <input type="text" name="finalCtaButtonLabel" class="form-control form-control-custom" value="<%= landingContent.finalCtaButtonLabel || '' %>" placeholder="e.g. Enroll Free → or Buy Course">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Bottom Badge / Guarantees</label>
                        <input type="text" name="finalCtaBadgeText" class="form-control form-control-custom" value="<%= landingContent.finalCtaBadgeText || '✓ 100% Free · Full Access' %>">
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save Final CTA Settings
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 12. STICKY CTA TAB -->
    <div class="tab-pane fade <%= activeTab === 'sticky-cta' ? 'show active' : '' %>" id="tab-sticky-cta" role="tabpanel">
        <div class="admin-card">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="sticky-cta">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-pin-angle me-2"></i>Floating Bottom Bar Settings</h5>
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" name="stickyCtaEnabled" id="stickyCtaEnabled" <%= landingContent.stickyCtaEnabled !== false ? 'checked' : '' %>>
                        <label class="form-check-label fs-6 fw-semibold" for="stickyCtaEnabled">Sticky Bar Enabled</label>
                    </div>
                </div>
                <p class="small text-muted mb-4">
                    The floating conversion bar anchored to the bottom of the viewport as the visitor scrolls down. Pricing is calculated directly from the course.
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Secondary / Tagline Text</label>
                        <input type="text" name="stickyCtaText" class="form-control form-control-custom" value="<%= landingContent.stickyCtaText || 'Full Lifetime Access' %>">
                        <div class="form-text">Shown next to the price (e.g. "Full Lifetime Access" or "Immediate Streaming").</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Custom Button Label (optional)</label>
                        <input type="text" name="stickyCtaButtonLabel" class="form-control form-control-custom" value="<%= landingContent.stickyCtaButtonLabel || '' %>" placeholder="Defaults to business flow action">
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save Sticky Bar Settings
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>
