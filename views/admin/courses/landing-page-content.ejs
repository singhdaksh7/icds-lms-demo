                                            <label class="form-label small fw-semibold" for="editRev<%= rev.id %>Video">Upload video <span class="text-muted fw-normal">(MP4 or WebM, stored privately in Cloudflare R2)</span></label>
                                            <input type="file" name="video" id="editRev<%= rev.id %>Video" class="form-control form-control-sm mb-2" accept=".mp4,.webm,video/mp4,video/webm">
                                            <label class="form-label small fw-semibold" for="editRev<%= rev.id %>VideoUrl">&hellip;or YouTube / Vimeo link</label>
                                            <input type="url" name="videoUrl" id="editRev<%= rev.id %>VideoUrl" class="form-control form-control-sm" value="<%= rev.videoUrl || '' %>" placeholder="https://www.youtube.com/watch?v=&hellip;" maxlength="500">
