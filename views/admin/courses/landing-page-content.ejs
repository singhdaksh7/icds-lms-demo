<!-- Tabs Content -->
<div class="tab-content" id="landingTabContent">

    <!-- 01. HERO TAB -->
    <div class="tab-pane fade <%= activeTab === 'hero' ? 'show active' : '' %>" id="tab-hero" role="tabpanel">
        <div class="admin-card mb-4">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="hero">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-image me-2"></i>Hero Section Settings</h5>
                    <div class="form-check form-switch fs-5">
                        <input type="hidden" name="heroEnabled" value="false">
                        <input class="form-check-input" type="checkbox" name="heroEnabled" id="heroEnabled" <%= landingContent.heroEnabled !== false ? 'checked' : '' %>>
                        <label class="form-check-label fs-6 fw-semibold" for="heroEnabled">Hero Section Enabled</label>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Hero Eyebrow Text</label>
                        <input type="text" name="heroEyebrow" class="form-control form-control-custom" value="<%= landingContent.heroEyebrow || (course.category ? course.category.name + ' • Online Certificate Course' : 'Online Certificate Course') %>">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Hero Title Override (optional)</label>
                        <input type="text" name="heroTitleOverride" class="form-control form-control-custom" value="<%= landingContent.heroTitleOverride || '' %>" placeholder="Defaults to course title: <%= course.title %>">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Hero Accent Phrase (highlighted styling)</label>
                        <input type="text" name="heroAccentText" class="form-control form-control-custom" value="<%= landingContent.heroAccentText || '' %>" placeholder="Phrase inside title to emphasize">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Access Label (under the enroll buttons)</label>
                        <input type="text" name="accessLabel" class="form-control form-control-custom" value="<%= landingContent.accessLabel || '' %>" placeholder="e.g. Self-Paced Access">
                        <div class="form-text">Optional &mdash; hidden when empty. Course price and enrollment state are automatic.</div>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-semibold">Hero Description / Lede</label>
                        <textarea name="heroDescription" class="form-control form-control-custom" rows="3"><%= landingContent.heroDescription || course.shortDescription || course.description || '' %></textarea>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Hero Media Type</label>
                        <select name="heroMediaType" class="form-select form-control-custom">
                            <option value="IMAGE" <%= landingContent.heroMediaType === 'IMAGE' ? 'selected' : '' %>>Image</option>
                            <option value="VIDEO" <%= landingContent.heroMediaType === 'VIDEO' ? 'selected' : '' %>>Video Embed / Link</option>
                            <option value="THUMBNAIL" <%= (landingContent.heroMediaType === 'THUMBNAIL' || !landingContent.heroMediaType) ? 'selected' : '' %>>Course Thumbnail</option>
                            <option value="NONE" <%= landingContent.heroMediaType === 'NONE' ? 'selected' : '' %>>None (Hide media column)</option>
                        </select>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Media URL (Image or Video link)</label>
                        <input type="text" name="heroMediaUrl" class="form-control form-control-custom" value="<%= landingContent.heroMediaUrl || '' %>" placeholder="https://...">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Hero Media Strip Caption</label>
                        <input type="text" name="heroMediaCaption" class="form-control form-control-custom" value="<%= landingContent.heroMediaCaption || '' %>" placeholder="Optional — hidden when empty">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Primary CTA Label (optional override)</label>
                        <input type="text" name="heroPrimaryCtaLabel" class="form-control form-control-custom" value="<%= landingContent.heroPrimaryCtaLabel || '' %>" placeholder="e.g. Enroll Free or Buy Now">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Secondary CTA Label</label>
                        <input type="text" name="secondaryCtaLabel" class="form-control form-control-custom" value="<%= landingContent.secondaryCtaLabel || '' %>" placeholder="Optional — hidden when empty">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Secondary CTA Target Anchor</label>
                        <input type="text" name="secondaryCtaTarget" class="form-control form-control-custom" value="<%= landingContent.secondaryCtaTarget || '#curriculum' %>">
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save Hero Settings
                    </button>
                </div>
            </form>
        </div>

        <!-- Hero Highlight Chips Management -->
        <div class="admin-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-0 text-primary"><i class="bi bi-tags me-2"></i>Hero Highlight Chips (<%= heroChips.length %>)</h5>
                    <div class="small text-muted">Badges displayed underneath hero copy (e.g. "Self-Paced Learning", "Structured Videos").</div>
                </div>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createChipModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Chip
                </button>
            </div>

            <% if (heroChips.length === 0) { %>
                <div class="alert alert-secondary mb-0">No hero highlight chips added yet.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:70px;">Order</th>
                                <th>Chip Label</th>
                                <th style="width:110px;">Status</th>
                                <th style="width:180px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% heroChips.forEach(function(chip, idx) { %>
                                <tr>
                                    <td><span class="badge bg-light text-dark border">#<%= chip.sortOrder %></span></td>
                                    <td><strong><%= chip.label %></strong></td>
                                    <td>
                                        <span class="badge bg-<%= chip.isPublished ? 'success' : 'secondary' %>">
                                            <%= chip.isPublished ? 'Published' : 'Hidden' %>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/chips/<%= chip.id %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move Up" <%= idx === 0 ? 'disabled' : '' %>>↑</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/chips/<%= chip.id %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move Down" <%= idx === heroChips.length - 1 ? 'disabled' : '' %>>↓</button>
                                            </form>
                                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editChipModal-<%= chip.id %>">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/chips/<%= chip.id %>/delete" class="d-inline" data-confirm='Delete this chip?'>
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>

    <!-- 02. ACCESS PLANS TAB -->
    <div class="tab-pane fade <%= activeTab === 'access-plans' ? 'show active' : '' %>" id="tab-access-plans" role="tabpanel">
        <div class="admin-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-0 text-primary"><i class="bi bi-clock-history me-2"></i>Course Access Plans</h5>
                    <div class="small text-muted">Configure multi-duration or tiered access packages (e.g. 30 Day Access, 180 Day Access, 365 Day Access).</div>
                </div>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createAccessPlanModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Access Plan
                </button>
            </div>

            <div class="alert alert-info py-2 small mb-4">
                <i class="bi bi-shield-check me-1"></i>
                <strong>Dynamic Fallback:</strong> If no custom access plans are created, the system uses the course's standard price (or Free enrollment) with lifetime streaming access. Razorpay checkout continues operating seamlessly.
            </div>

            <% if (!accessPlans || accessPlans.length === 0) { %>
                <div class="alert alert-secondary mb-0">
                    No custom access plans configured. The course currently uses the default course pricing (<%= Number(course.price) === 0 ? 'Free' : ('₹' + Number(course.price).toLocaleString('en-IN')) %>).
                </div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:70px;">Order</th>
                                <th>Plan Label</th>
                                <th>Duration</th>
                                <th>Price</th>
                                <th>Sale Price</th>
                                <th>Default</th>
                                <th>Status</th>
                                <th style="width:180px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% accessPlans.forEach(function(plan, idx) { %>
                                <tr>
                                    <td><span class="badge bg-light text-dark border">#<%= plan.sortOrder %></span></td>
                                    <td><strong><%= plan.label %></strong></td>
                                    <td><%= plan.durationDays ? plan.durationDays + ' Days' : 'Lifetime' %></td>
                                    <td><%= plan.price !== null ? '₹' + Number(plan.price).toLocaleString('en-IN') : 'Default' %></td>
                                    <td><%= plan.salePrice !== null ? '₹' + Number(plan.salePrice).toLocaleString('en-IN') : '-' %></td>
                                    <td>
                                        <% if (plan.isDefault) { %>
                                            <span class="badge bg-success">Default</span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="badge bg-<%= plan.isPublished ? 'success' : 'secondary' %>">
                                            <%= plan.isPublished ? 'Published' : 'Hidden' %>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/access-plans/<%= plan.id %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move Up" <%= idx === 0 ? 'disabled' : '' %>>↑</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/access-plans/<%= plan.id %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move Down" <%= idx === accessPlans.length - 1 ? 'disabled' : '' %>>↓</button>
                                            </form>
                                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editAccessPlanModal-<%= plan.id %>">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/access-plans/<%= plan.id %>/delete" class="d-inline" data-confirm='Delete access plan?'>
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>

    <!-- 03. QUICK STATS TAB -->
    <div class="tab-pane fade <%= activeTab === 'stats' ? 'show active' : '' %>" id="tab-stats" role="tabpanel">
        <div class="admin-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-0 text-primary"><i class="bi bi-bar-chart me-2"></i>Course Quick Stats Grid</h5>
                    <div class="small text-muted">Stat cards positioned directly underneath the hero. Supports AUTO stats derived strictly from real course metrics.</div>
                </div>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createStatModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Quick Stat
                </button>
            </div>

