                                            <label class="form-label small fw-semibold mt-2" for="editRev<%= rev.id %>Thumb">Thumbnail <span class="text-muted fw-normal">(optional JPG/PNG/WEBP &mdash; a default poster is used when empty)</span></label>
                                            <input type="file" name="thumbnail" id="editRev<%= rev.id %>Thumb" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">
                                            <div class="form-check mt-2">
                                                <input type="hidden" name="removeVideo" value="false">
                                                <input class="form-check-input" type="checkbox" name="removeVideo" id="editRevRmVid-<%= rev.id %>">
                                                <label class="form-check-label small" for="editRevRmVid-<%= rev.id %>">Remove current video</label>
                                            </div>
                                            <div class="form-check">
                                                <input type="hidden" name="removeThumbnail" value="false">
                                                <input class="form-check-input" type="checkbox" name="removeThumbnail" id="editRevRmThumb-<%= rev.id %>">
                                                <label class="form-check-label small" for="editRevRmThumb-<%= rev.id %>">Remove current thumbnail</label>
                                            </div>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <div class="form-check">
                                                    <input type="hidden" name="isPublished" value="false">
                                                    <input class="form-check-input" type="checkbox" name="isPublished" id="editRevPub-<%= rev.id %>" <%= rev.isPublished ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="editRevPub-<%= rev.id %>">Published</label>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="form-check">
                                                    <input type="hidden" name="isDemo" value="false">
                                                    <input class="form-check-input" type="checkbox" name="isDemo" id="editRevDemo-<%= rev.id %>" <%= rev.isDemo ? 'checked' : '' %>>
                                                    <label class="form-check-label text-warning-emphasis fw-semibold" for="editRevDemo-<%= rev.id %>">
                                                        Demo Review (Preview only)
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                    <div class="row g-2 mt-2 align-items-end">
                        <div class="col-12">
                            <div class="form-check">
                                <input type="hidden" name="featuredOnHome" value="false">
                                <input class="form-check-input" type="checkbox" name="featuredOnHome" value="true" id="editRev-<%= rev.id %>Home" <%= rev.featuredOnHome ? 'checked' : '' %>>
                                <label class="form-check-label fw-semibold" for="editRev-<%= rev.id %>Home">Show on Homepage</label>
                                <div class="form-text">Genuine, published reviews only. Does not affect this course page.</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold" for="editRev-<%= rev.id %>HomeOrder">Homepage order</label>
                            <input type="number" min="0" max="100000" name="homeSortOrder" id="editRev-<%= rev.id %>HomeOrder" class="form-control form-control-sm" value="<%= rev.homeSortOrder || 0 %>">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold" for="editRev-<%= rev.id %>CourseOrder">Course page order</label>
                            <input type="number" min="0" max="100000" name="sortOrder" id="editRev-<%= rev.id %>CourseOrder" class="form-control form-control-sm" value="<%= rev.sortOrder || 0 %>">
                        </div>
                    </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>

    <!-- 10. COMPARISON TAB -->
    <div class="tab-pane fade <%= activeTab === 'comparison' ? 'show active' : '' %>" id="tab-comparison" role="tabpanel">
        <div class="admin-card mb-4">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="comparison">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-columns-gap me-2"></i>Curriculum Comparison Matrix</h5>
                    <div class="form-check form-switch fs-5">
                        <input type="hidden" name="comparisonEnabled" value="false">
                        <input class="form-check-input" type="checkbox" name="comparisonEnabled" id="comparisonEnabled" <%= landingContent.comparisonEnabled === true ? 'checked' : '' %>>
                        <label class="form-check-label fs-6 fw-semibold" for="comparisonEnabled">Section Enabled</label>
                    </div>
                </div>

                <div class="alert alert-info py-2 small mb-4">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>Multi-tier Comparison:</strong> Like the reference (e.g. Starter Guide vs Masterclass), this section renders side-by-side comparison columns. It remains strictly hidden until columns and items are populated.
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Section Eyebrow</label>
                        <input type="text" name="comparisonEyebrow" class="form-control form-control-custom" value="<%= landingContent.comparisonEyebrow || '' %>" placeholder="Optional — hidden when empty">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Section Heading</label>
                        <input type="text" name="comparisonHeading" class="form-control form-control-custom" value="<%= landingContent.comparisonHeading || '' %>" placeholder="Optional — hidden when empty">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Section Description (optional)</label>
                        <textarea name="comparisonDescription" class="form-control form-control-custom" rows="2"><%= landingContent.comparisonDescription || '' %></textarea>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save Comparison Header
                    </button>
                </div>
            </form>
        </div>

        <div class="admin-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 text-primary"><i class="bi bi-layout-split me-2"></i>Comparison Columns (<%= (typeof comparisonColumns !== 'undefined' && comparisonColumns) ? comparisonColumns.length : 0 %>)</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createComparisonColumnModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Column
                </button>
            </div>

            <% if (!comparisonColumns || comparisonColumns.length === 0) { %>
                <div class="alert alert-secondary mb-0">No comparison columns configured yet.</div>
            <% } else { %>
                <div class="row g-4">
                    <% comparisonColumns.forEach(function(col, idx) { %>
                        <div class="col-md-6">
                            <div class="border rounded p-3 bg-light position-relative">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="mb-0 fw-bold"><%= col.title %></h6>
                                        <div class="small text-muted"><%= col.subtitle || 'Standard Edition' %></div>
                                    </div>
                                    <div class="d-flex gap-1">
                                        <% if (col.isRecommended) { %>
                                            <span class="badge bg-primary">Recommended</span>
                                        <% } %>
                                        <span class="badge bg-<%= col.isPublished ? 'success' : 'secondary' %>"><%= col.isPublished ? 'Published' : 'Hidden' %></span>
                                        <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/comparison-columns/<%= col.id %>/move" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="direction" value="up">
                                            <button type="submit" class="btn btn-outline-secondary btn-sm p-1" title="Move Up" <%= idx === 0 ? 'disabled' : '' %>>&uarr;</button>
                                        </form>
                                        <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/comparison-columns/<%= col.id %>/move" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="direction" value="down">
                                            <button type="submit" class="btn btn-outline-secondary btn-sm p-1" title="Move Down" <%= idx === comparisonColumns.length - 1 ? 'disabled' : '' %>>&darr;</button>
                                        </form>
                                        <button type="button" class="btn btn-outline-primary btn-sm p-1" data-bs-toggle="modal" data-bs-target="#editComparisonColumnModal-<%= col.id %>" title="Edit Column"><i class="bi bi-pencil"></i></button>
                                        <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/comparison-columns/<%= col.id %>/delete" class="d-inline" data-confirm='Delete this comparison column?'>
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-outline-danger btn-sm p-1" title="Delete Column"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </div>

                                <div class="small mb-2"><strong>Feature Checklist (<%= col.items ? col.items.length : 0 %>):</strong></div>
                                <ul class="list-group list-group-flush mb-3 small">
                                    <% (col.items || []).forEach(function(cItem, iIdx) { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1 bg-transparent">
                                            <span><%= cItem.isPublished ? '✓' : '✕' %> <%= cItem.text %> <% if (!cItem.isPublished) { %><span class="badge bg-secondary">Hidden</span><% } %></span>
                                            <span class="d-inline-flex gap-1 align-items-center">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/comparison-items/<%= cItem.id %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="btn btn-link p-0" style="font-size:11px;" title="Move Up" <%= iIdx === 0 ? 'disabled' : '' %>>&uarr;</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/comparison-items/<%= cItem.id %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="btn btn-link p-0" style="font-size:11px;" title="Move Down" <%= iIdx === col.items.length - 1 ? 'disabled' : '' %>>&darr;</button>
                                            </form>
                                            <button type="button" class="btn btn-link p-0" style="font-size:11px;" data-bs-toggle="modal" data-bs-target="#editComparisonItemModal-<%= cItem.id %>" title="Edit"><i class="bi bi-pencil"></i></button>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/comparison-items/<%= cItem.id %>/delete" class="d-inline" data-confirm='Delete feature item?'>
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-link text-danger p-0 ms-2" style="font-size:11px;">✕</button>
                                            </form>
                                            </span>
                                        </li>
                                    <% }); %>
                                </ul>

                                <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/comparison-columns/<%= col.id %>/items" class="d-flex gap-2">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="text" name="text" class="form-control form-control-sm" placeholder="Add feature item..." required>
                                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">+ Add</button>
                                </form>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </div>

    <!-- 11. IDEAL FOR / NOT FOR TAB -->
    <div class="tab-pane fade <%= activeTab === 'audience' ? 'show active' : '' %>" id="tab-audience" role="tabpanel">
        <div class="admin-card mb-4">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="audience">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-people me-2"></i>Audience Section Settings</h5>
                    <div class="form-check form-switch fs-5">
                        <input type="hidden" name="audienceEnabled" value="false">
                        <input class="form-check-input" type="checkbox" name="audienceEnabled" id="audienceEnabled" <%= landingContent.audienceEnabled !== false ? 'checked' : '' %>>
                        <label class="form-check-label fs-6 fw-semibold" for="audienceEnabled">Section Enabled</label>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Section Eyebrow</label>
                        <input type="text" name="audienceEyebrow" class="form-control form-control-custom" value="<%= landingContent.audienceEyebrow || '' %>" placeholder="Optional — hidden when empty">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Section Heading</label>
                        <input type="text" name="audienceHeading" class="form-control form-control-custom" value="<%= landingContent.audienceHeading || '' %>" placeholder="Optional — hidden when empty">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Section Intro (optional)</label>
                        <textarea name="audienceIntro" class="form-control form-control-custom" rows="2"><%= landingContent.audienceIntro || '' %></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Who Is This Course Ideal For? (Heading)</label>
                        <input type="text" name="audienceForHeading" class="form-control form-control-custom" value="<%= landingContent.audienceForHeading || '' %>" placeholder="Optional — hidden when empty">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Who Should Not Take This Course? (Heading)</label>
                        <input type="text" name="audienceNotForHeading" class="form-control form-control-custom" value="<%= landingContent.audienceNotForHeading || '' %>" placeholder="Optional — hidden when empty">
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save Audience Settings
                    </button>
                </div>
            </form>
        </div>

        <div class="admin-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 text-primary"><i class="bi bi-list-nested me-2"></i>Audience Items (<%= audienceItems.length %>)</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createAudienceModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Audience Item
                </button>
            </div>

            <% if (audienceItems.length === 0) { %>
                <div class="alert alert-secondary mb-0">No audience criteria added yet.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:70px;">Order</th>
                                <th style="width:140px;">Group</th>
                                <th>Criteria Description</th>
                                <th style="width:110px;">Status</th>
                                <th style="width:180px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% audienceItems.forEach(function(item, idx) { %>
                                <tr>
                                    <td><span class="badge bg-light text-dark border">#<%= item.sortOrder %></span></td>
                                    <td>
                                        <span class="badge bg-<%= item.type === 'FOR' ? 'success' : 'danger' %>">
                                            <%= item.type === 'FOR' ? 'Ideal For' : 'Not For' %>
                                        </span>
                                    </td>
                                    <td><strong><%= item.title %></strong></td>
                                    <td>
                                        <span class="badge bg-<%= item.isPublished ? 'success' : 'secondary' %>">
                                            <%= item.isPublished ? 'Published' : 'Hidden' %>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/audience/<%= item.id %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move Up" <%= idx === 0 ? 'disabled' : '' %>>↑</button>
                                            </form>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/audience/<%= item.id %>/move" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move Down" <%= idx === audienceItems.length - 1 ? 'disabled' : '' %>>↓</button>
                                            </form>
                                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editAudienceModal-<%= item.id %>">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/audience/<%= item.id %>/delete" class="d-inline" data-confirm='Delete audience item?'>
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>

    <!-- 12. HOW YOU GET ACCESS TAB -->
    <div class="tab-pane fade <%= activeTab === 'access-steps' ? 'show active' : '' %>" id="tab-access-steps" role="tabpanel">
        <div class="admin-card mb-4">
            <form method="POST" action="/admin/courses/<%= course.id %>/landing-page/settings">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="currentTab" value="access-steps">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-signpost-split me-2"></i>How You Get Access Settings</h5>
                    <div class="form-check form-switch fs-5">
                        <input type="hidden" name="accessSectionEnabled" value="false">
                        <input class="form-check-input" type="checkbox" name="accessSectionEnabled" id="accessSectionEnabled" <%= landingContent.accessSectionEnabled === true ? 'checked' : '' %>>
                        <label class="form-check-label fs-6 fw-semibold" for="accessSectionEnabled">Section Enabled</label>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Section Eyebrow</label>
                        <input type="text" name="accessEyebrow" class="form-control form-control-custom" value="<%= landingContent.accessEyebrow || '' %>" placeholder="Optional — hidden when empty">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Section Heading</label>
                        <input type="text" name="accessHeading" class="form-control form-control-custom" value="<%= landingContent.accessHeading || '' %>" placeholder="Optional — hidden when empty">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Section Description</label>
                        <textarea name="accessDescription" class="form-control form-control-custom" rows="2"><%= landingContent.accessDescription || 'Simple, direct steps to start streaming lessons immediately.' %></textarea>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Optional Explanatory Media</label>
