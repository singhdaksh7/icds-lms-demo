<%# One Site Content field. The setting key is only used as the form field name,
    never shown as a label. Everything is HTML-escaped. #%>
<% if (field.heading) { %>
    <div class="col-12"><h4 class="sc-subheading"><%= field.heading %></h4></div>
<% } else if (field.type === 'bool') { %>
    <div class="col-12 col-md-6">
        <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" id="f-<%= field.key %>" name="<%= field.key %>" value="true" <%= settings[field.key] === 'true' ? 'checked' : '' %>>
            <label class="form-check-label small fw-semibold" for="f-<%= field.key %>"><%= field.label %></label>
        </div>
    </div>
<% } else if (field.type === 'image') { %>
    <% const customUrl = imageUrls[field.key]; const shownUrl = customUrl || field.defaultPreview || ''; %>
    <div class="col-12 sc-image-field">
        <label class="form-label small fw-semibold" for="f-<%= field.key %>"><%= field.label %></label>
        <div class="d-flex align-items-start gap-3 flex-wrap">
            <div class="sc-preview-box">
                <img id="pv-<%= field.key %>" class="sc-preview" src="<%= shownUrl %>" alt="Current <%= field.label %>" <%- shownUrl ? '' : 'hidden' %>>
                <div class="sc-preview sc-preview-empty" id="pe-<%= field.key %>" <%- shownUrl ? 'hidden' : '' %>>No image</div>
                <span id="pb-<%= field.key %>" class="badge mt-1 text-bg-<%= customUrl ? 'success' : 'secondary' %>"><%= customUrl ? 'Custom image' : (field.defaultPreview ? 'Default image' : 'Not set') %></span>
            </div>
            <div class="flex-grow-1" style="min-width:220px;">
                <input type="file" class="form-control form-control-custom" id="f-<%= field.key %>" name="file__<%= field.key %>" accept="image/jpeg,image/png,image/webp" data-preview-img="pv-<%= field.key %>" data-preview-empty="pe-<%= field.key %>" data-preview-badge="pb-<%= field.key %>">
                <p class="small text-muted mt-1 mb-2">JPG, PNG or WebP, max 5MB. <%= field.help || '' %></p>
                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-sm btn-outline-primary"><%= customUrl ? 'Replace image' : 'Upload image' %></button>
                    <% if (customUrl) { %>
                        <button type="submit" name="remove__<%= field.key %>" value="1" form="form-<%= formId %>" formnovalidate class="btn btn-sm btn-outline-danger" data-confirm="Remove this image and go back to the default?"><%= field.defaultPreview ? 'Reset to default' : 'Remove image' %></button>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
<% } else if (field.type === 'target') { %>
    <div class="col-12 col-md-6">
        <label class="form-label small fw-semibold" for="f-<%= field.key %>"><%= field.label %></label>
        <select class="form-select form-control-custom" id="f-<%= field.key %>" name="<%= field.key %>">
            <% linkTargets.forEach(function (t) { %>
                <option value="<%= t.value %>" <%= settings[field.key] === t.value ? 'selected' : '' %>><%= t.label %></option>
            <% }); %>
        </select>
    </div>
<% } else if (field.type === 'instructor') { %>
    <div class="col-12 col-md-6">
        <label class="form-label small fw-semibold" for="f-<%= field.key %>"><%= field.label %></label>
        <select class="form-select form-control-custom" id="f-<%= field.key %>" name="<%= field.key %>">
            <option value="">-- Default (Dr. Tanu Raghav / Primary Mentor) --</option>
            <% if (typeof instructors !== 'undefined' && Array.isArray(instructors)) { %>
                <% instructors.forEach(function (inst) { %>
                    <option value="<%= inst.id %>" <%= String(settings[field.key] || '') === String(inst.id) ? 'selected' : '' %>><%= inst.name %><%= inst.designation || inst.title ? ' (' + (inst.designation || inst.title) + ')' : '' %></option>
                <% }); %>
            <% } %>
        </select>
        <% if (field.help) { %><p class="small text-muted mt-1 mb-0"><%= field.help %></p><% } %>
    </div>
<% } else if (field.type === 'textarea' || field.type === 'longtext') { %>
    <div class="col-12">
        <label class="form-label small fw-semibold" for="f-<%= field.key %>"><%= field.label %></label>
        <% if (field.provisionalKey && legalProvisional[field.provisionalKey]) { %>
            <div class="alert alert-warning py-2 small">
                This page is still showing the built-in provisional wording. Replace it with the client-approved
                text before launch. (This notice is shown only here in Admin, never on the public site.)
            </div>
        <% } %>
        <textarea class="form-control form-control-custom" id="f-<%= field.key %>" name="<%= field.key %>" rows="<%= field.rows || 3 %>" maxlength="<%= field.max %>"
            <% if (env && field.envKey && env[field.envKey]) { %>placeholder="<%= env[field.envKey] %>"<% } %>><%= settings[field.key] %></textarea>
        <% if (field.legalHelp) { %>
            <p class="small text-muted mt-1 mb-0">Plain text only. Separate paragraphs with a blank line, start a line with <code>## </code> for a heading and with <code>- </code> for a list item. HTML is not interpreted.</p>
        <% } %>
        <% if (field.help) { %><p class="small text-muted mt-1 mb-0"><%= field.help %></p><% } %>
    </div>
<% } else { %>
    <div class="col-12 col-md-6">
        <label class="form-label small fw-semibold" for="f-<%= field.key %>"><%= field.label %></label>
        <input
            type="<%= field.type === 'email' ? 'email' : (field.type === 'date' ? 'date' : 'text') %>"
            class="form-control form-control-custom"
            id="f-<%= field.key %>"
            name="<%= field.key %>"
            value="<%= settings[field.key] %>"
            maxlength="<%= field.max || (field.type === 'email' ? 254 : (field.type === 'phone' ? 30 : 150)) %>"
            <% if (env && field.envKey && env[field.envKey]) { %>placeholder="<%= env[field.envKey] %>"<% } %>>
        <% if (field.help) { %><p class="small text-muted mt-1 mb-0"><%= field.help %></p><% } %>
    </div>
<% } %>
