<h1 style="font-size:24px;" class="mb-2">Site Content</h1>
<p class="text-muted small mb-3">
    Change the text, images and links visitors see on the public website. Each section below saves on its own and the
    change appears on the site right away - no redeploy needed. Only plain text is accepted; images must be JPG, PNG or
    WebP up to 5MB.
</p>

<nav class="sc-tabs mb-4" aria-label="Site content sections">
    <% tabs.forEach(function (t) { %>
        <a href="/admin/site-content/<%= t.id %>" class="<%= t.id === tab.id ? 'active' : '' %>"><i class="bi <%= t.icon %> me-1"></i><%= t.title %></a>
    <% }); %>
</nav>

<h2 class="h5 mb-3"><%= tab.title %></h2>

<% if (tab.note) { %>
    <div class="admin-card mb-4">
        <p class="mb-0"><i class="bi bi-info-circle me-1"></i><%= tab.note %></p>
    </div>
<% } %>

<% const collapsible = tab.forms.length > 2; %>
<% tab.forms.forEach(function (form) { %>
    <% const imageFields = form.fields.filter(function (f) { return f.type === 'image'; }); %>
    <% const hasImage = imageFields.length > 0; %>
    <details
        id="section-<%= form.id %>"
        class="admin-card sc-accordion mb-3"
        <%- (!collapsible || errorFormId === form.id) ? 'open' : '' %>>
        <summary class="sc-summary">
            <span class="sc-summary-title"><%= form.title %></span>
            <% if (hasImage) { %><span class="badge text-bg-light border ms-2"><i class="bi bi-image me-1"></i><%= imageFields.length %> image<%= imageFields.length === 1 ? '' : 's' %></span><% } %>
            <i class="bi bi-chevron-down sc-chevron ms-auto"></i>
        </summary>

        <form
            id="form-<%= form.id %>"
            class="pt-3"
            method="POST"
            action="/admin/site-content/<%= tab.id %>/<%= form.id %>"
            <%- hasImage ? 'enctype="multipart/form-data"' : '' %>>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <% if (form.description) { %><p class="small text-muted"><%= form.description %></p><% } %>

            <% if (errors && errors.length && errorFormId === form.id) { %>
                <div class="alert alert-danger">
                    <ul class="mb-0 ps-3">
                        <% errors.forEach(function (error) { %><li><%= error %></li><% }) %>
                    </ul>
                </div>
            <% } %>

            <div class="row g-3">
                <% form.fields.forEach(function (field) { %>
                    <%- include('./field', { field, settings, linkTargets, imageUrls, env, legalProvisional, formId: form.id, instructors: (typeof instructors !== 'undefined' ? instructors : []) }) %>
                <% }); %>
            </div>

            <div class="mt-3 pt-3 border-top">
                <button type="submit" class="auth-submit" style="width:auto; padding:0 28px;">Save <%= form.title %></button>
            </div>
        </form>
    </details>
<% }); %>
