<%
    const sym = order.currency === 'INR' ? '₹' : order.currency + ' ';
    const money = (n) => sym + Number(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const tax = Number(order.taxAmount) || 0;
%>
<div class="mb-3">
    <a href="/admin/orders" class="small text-decoration-none" style="color:#565acf;">
        <i class="bi bi-arrow-left me-1"></i> Back to Orders
    </a>
</div>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 style="font-size:24px;" class="mb-0">Order ICDS-<%= order.id %></h1>
    <div class="d-flex align-items-center gap-2">
        <% if (order.status === 'PAID' || order.status === 'REFUNDED') { %>
            <a href="/admin/orders/<%= order.id %>/invoice.pdf" class="btn-mini primary"><i class="bi bi-download"></i>Download invoice</a>
        <% } %>
        <span class="status-pill <%= order.status.toLowerCase() %>"><%= order.status %></span>
    </div>
</div>

<div class="row g-4">

    <div class="col-lg-4">
        <div class="admin-card mb-4">
            <h6 class="mb-3">Student</h6>
            <p class="mb-1"><strong><%= order.user.name %></strong></p>
            <p class="text-muted small mb-0"><%= order.user.email %></p>
        </div>

        <div class="admin-card">
            <h6 class="mb-3">Payment</h6>
            <p class="mb-1 small"><strong>Provider:</strong> <%= order.paymentProvider || '—' %></p>
            <p class="mb-1 small"><strong>Razorpay Order ID:</strong> <%= order.providerOrderId || '—' %></p>
            <p class="mb-1 small"><strong>Razorpay Payment ID:</strong> <%= order.providerPaymentId || '—' %></p>
            <p class="mb-1 small"><strong>Placed:</strong> <%= order.createdAt.toLocaleString('en-IN') %></p>
            <p class="mb-0 small"><strong>Paid:</strong> <%= order.paidAt ? order.paidAt.toLocaleString('en-IN') : '—' %></p>
            <p class="text-muted small mt-3 mb-0">
                Payment status is set only by verified Razorpay events — there is no manual "mark as paid" override.
                Refunds are issued from the Razorpay Dashboard.
            </p>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="admin-card">
            <h6 class="mb-3">Items</h6>
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th class="text-end">Price (at time of order)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% order.items.forEach(function (item) { %>
                            <tr>
                                <td><a href="/admin/courses/<%= item.course.id %>/edit"><%= item.course.title %></a></td>
                                <td class="text-end"><%= money(item.price) %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                    <tfoot>
                        <% if (tax > 0) { %>
                            <tr>
                                <td class="text-muted">GST (<%= Number(order.taxRate) %>%<%= order.taxInclusive ? ', included' : ', added' %>)</td>
                                <td class="text-end"><%= money(tax) %></td>
                            </tr>
                        <% } %>
                        <tr>
                            <th>Total charged</th>
                            <th class="text-end"><%= money(order.amount) %></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

</div>
