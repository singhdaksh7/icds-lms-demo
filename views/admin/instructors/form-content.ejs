<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 style="font-size:24px;" class="mb-0"><%= instructor ? 'Edit Instructor' : 'New Instructor' %></h1>
    <a href="/admin/instructors" class="btn btn-sm btn-outline-secondary">Back to Instructors</a>
</div>

<% if (errors && errors.length) { %>
    <div class="alert alert-danger">
        <ul class="mb-0 ps-3">
            <% errors.forEach(function (error) { %><li><%= error %></li><% }) %>
        </ul>
    </div>
<% } %>

<div class="admin-card">
    <form method="POST" action="<%= instructor ? '/admin/instructors/' + instructor.id : '/admin/instructors' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="row g-3">

            <div class="col-md-8">
                <label class="form-label small fw-semibold">Name</label>
                <input type="text" name="name" class="form-control form-control-custom" value="<%= values.name || '' %>" required>
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-semibold">Slug (optional)</label>
                <input type="text" name="slug" class="form-control form-control-custom" value="<%= values.slug || '' %>">
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-semibold">Designation / Professional Title</label>
                <input type="text" name="designation" class="form-control form-control-custom" value="<%= values.designation || values.title || '' %>" placeholder="e.g. Lead Clinical Mentor & Prosthodontist">
                <div class="form-text">Displayed prominently below name on Course Landing and Homepage.</div>
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-semibold">Organization / Affiliation</label>
                <input type="text" name="organization" class="form-control form-control-custom" value="<%= values.organization || '' %>" placeholder="e.g. Institute of Cosmetology & Dental Sciences">
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-semibold">Experience Badge Label</label>
                <input type="text" name="experienceLabel" class="form-control form-control-custom" value="<%= values.experienceLabel || '' %>" placeholder="e.g. 18+ Years Experience">
                <div class="form-text">Floating badge on portrait. Leave blank to hide.</div>
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-semibold">Practice Name (optional)</label>
                <input type="text" name="practiceName" class="form-control form-control-custom" value="<%= values.practiceName || '' %>" placeholder="e.g. Raghav Dental Clinic">
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-semibold">Practice Location (optional)</label>
                <input type="text" name="practiceLocation" class="form-control form-control-custom" value="<%= values.practiceLocation || '' %>" placeholder="e.g. Delhi NCR, India">
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-semibold">Contact Email</label>
                <input type="email" name="email" class="form-control form-control-custom" value="<%= values.email || '' %>">
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-control-custom">
                    <% statuses.forEach(function (status) { %>
                        <option value="<%= status %>" <%= values.status === status ? 'selected' : '' %>><%= status %></option>
                    <% }); %>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label small fw-semibold">Short Biography (Summary / Homepage card)</label>
                <textarea name="shortBio" class="form-control form-control-custom" rows="2" placeholder="Brief 1-2 sentence overview for cards and spotlight sections..."><%= values.shortBio || '' %></textarea>
                <div class="form-text">Used on the homepage mentor spotlight card and quick summaries.</div>
            </div>

            <div class="col-12">
                <label class="form-label small fw-semibold">Full Biography (Course Landing Page)</label>
                <textarea name="bio" class="form-control form-control-custom" rows="5" placeholder="Comprehensive professional background and clinical journey..."><%= values.bio || values.fullBio || '' %></textarea>
                <div class="form-text">Displayed on the dedicated Meet Your Mentor course section. Plain text or markdown paragraphs.</div>
            </div>

            <div class="col-12">
                <label class="form-label small fw-semibold">Qualifications Summary (optional)</label>
                <input type="text" name="qualificationSummary" class="form-control form-control-custom" value="<%= values.qualificationSummary || '' %>" placeholder="e.g. BDS, MDS (Prosthodontics), Certified Clinical Implantologist">
            </div>

            <div class="col-12">
                <label class="form-label small fw-semibold">Mentor Philosophy Quote (optional)</label>
                <textarea name="mentorQuote" class="form-control form-control-custom" rows="2" placeholder="e.g. Clinical excellence begins with systematic diagnostic evaluation..."><%= values.mentorQuote || '' %></textarea>
                <div class="form-text">Displayed as a stylized blockquote in the mentor profile.</div>
            </div>

            <div class="col-12">
                <label class="form-label small fw-semibold">Photo URL</label>
                <input type="text" name="photoUrl" class="form-control form-control-custom" value="<%= values.photoUrl || '' %>" placeholder="https://...">
                <div class="form-text">Set directly, or upload a local photo below (saved after upload).</div>
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-semibold">LinkedIn URL</label>
                <input type="text" name="linkedinUrl" class="form-control form-control-custom" value="<%= values.linkedinUrl || '' %>">
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-semibold">Instagram URL</label>
                <input type="text" name="instagramUrl" class="form-control form-control-custom" value="<%= values.instagramUrl || '' %>">
            </div>

        </div>

        <button type="submit" class="auth-submit mt-4" style="width:auto; padding:0 32px;">
            <%= instructor ? 'Save Changes' : 'Create Instructor' %>
        </button>
    </form>
</div>

<% if (instructor) { %>
    <!-- CREDENTIALS MANAGEMENT SECTION -->
    <div class="admin-card mt-4" id="credentials">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h5 class="mb-1 text-primary"><i class="bi bi-patch-check me-2"></i>Verified Credentials &amp; Achievements (<%= (instructor.credentials || []).length %>)</h5>
                <div class="small text-muted">
                    Checklist items displayed in the "Meet Your Mentor" section on course pages and homepage.
                    <strong>Rule:</strong> Enter only verified, owner-supplied credentials.
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createCredModal">
                <i class="bi bi-plus-lg me-1"></i> Add Credential
            </button>
        </div>

        <% const credsList = instructor.credentials || []; %>
        <% if (credsList.length === 0) { %>
            <div class="text-center py-4 border rounded bg-light">
                <i class="bi bi-patch-check text-muted" style="font-size:28px;"></i>
                <p class="text-muted small mt-2 mb-0">No credentials added yet. Click "Add Credential" to enter verified items.</p>
            </div>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:50px;">Order</th>
                            <th>Credential Title</th>
                            <th>Description</th>
                            <th style="width:100px;">Status</th>
                            <th style="width:180px;" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% credsList.forEach(function(cred, cIdx) { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <form method="POST" action="/admin/instructors/<%= instructor.id %>/credentials/<%= cred.id %>/move" class="m-0">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="direction" value="up">
                                            <button type="submit" class="btn btn-sm btn-light border p-0 px-1" title="Move Up" <%= cIdx === 0 ? 'disabled' : '' %>>▲</button>
                                        </form>
                                        <form method="POST" action="/admin/instructors/<%= instructor.id %>/credentials/<%= cred.id %>/move" class="m-0">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="direction" value="down">
                                            <button type="submit" class="btn btn-sm btn-light border p-0 px-1" title="Move Down" <%= cIdx === credsList.length - 1 ? 'disabled' : '' %>>▼</button>
                                        </form>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold">
                                        <i class="bi <%= cred.icon || 'bi-check2-circle' %> text-primary me-1"></i>
                                        <%= cred.title %>
                                    </div>
                                </td>
                                <td class="small text-muted">
                                    <%= cred.description || '—' %>
                                </td>
                                <td>
                                    <span class="badge bg-<%= cred.isPublished ? 'success' : 'secondary' %>">
                                        <%= cred.isPublished ? 'Published' : 'Hidden' %>
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editCredModal-<%= cred.id %>">
                                            Edit
                                        </button>
                                        <form method="POST" action="/admin/instructors/<%= instructor.id %>/credentials/<%= cred.id %>/delete" class="m-0" data-confirm="Delete this credential item?">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <!-- Edit Credential Modal -->
                            <div class="modal fade" id="editCredModal-<%= cred.id %>" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form method="POST" action="/admin/instructors/<%= instructor.id %>/credentials/<%= cred.id %>/edit">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Edit Credential</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body text-start">
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Credential Title</label>
                                                    <input type="text" name="title" class="form-control" value="<%= cred.title %>" required maxlength="191">
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Description (optional)</label>
                                                    <textarea name="description" class="form-control" rows="2" maxlength="500"><%= cred.description || '' %></textarea>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Bootstrap Icon Class (optional)</label>
                                                    <input type="text" name="icon" class="form-control" value="<%= cred.icon || 'bi-check2-circle' %>" placeholder="e.g. bi-check2-circle, bi-award">
                                                </div>
                                                <div class="form-check">
                                                    <input type="hidden" name="isPublished" value="false">
                                                    <input class="form-check-input" type="checkbox" name="isPublished" id="editCredPub-<%= cred.id %>" <%= cred.isPublished ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="editCredPub-<%= cred.id %>">Published (Visible in profile)</label>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- Create Credential Modal -->
    <div class="modal fade" id="createCredModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="POST" action="/admin/instructors/<%= instructor.id %>/credentials">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Verified Credential</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Credential Title</label>
                            <input type="text" name="title" class="form-control" placeholder="e.g. Master in Prosthodontics & Crown Bridge" required maxlength="191">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Description (optional)</label>
                            <textarea name="description" class="form-control" rows="2" placeholder="e.g. Certified specialist in advanced occlusal rehab" maxlength="500"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Bootstrap Icon Class (optional)</label>
                            <input type="text" name="icon" class="form-control" value="bi-check2-circle" placeholder="bi-check2-circle">
                        </div>
                        <div class="form-check">
                            <input type="hidden" name="isPublished" value="false">
                            <input class="form-check-input" type="checkbox" name="isPublished" id="createCredPub" checked>
                            <label class="form-check-label" for="createCredPub">Published (Visible on site)</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary">Add Credential</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
<% } %>

<% if (instructor) { %>
    <div class="admin-card mt-4">
        <h5 class="mb-3">Instructor photo</h5>
        <% const instructorDefault = cms.brand.defaultInstructorImageUrl || '/assets/images/instructor-placeholder.svg'; %>
        <div class="d-flex align-items-start gap-3 flex-wrap">
            <div>
                <img id="pv-instructor" src="<%= values.photoUrl || instructorDefault %>" alt="Current photo" style="width:120px; height:120px; object-fit:cover; border-radius:50%; border:1px solid #dee2e6; display:block;" data-fallback-src="/assets/images/instructor-placeholder.svg">
                <span id="pb-instructor" class="badge mt-1 text-bg-<%= values.photoUrl ? 'success' : 'secondary' %>"><%= values.photoUrl ? 'Custom photo' : 'Default placeholder' %></span>
            </div>
            <div style="min-width:240px;">
                <form method="POST" action="/admin/instructors/<%= instructor.id %>/photo/upload" enctype="multipart/form-data" class="d-flex gap-2 align-items-center flex-wrap">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="file" name="thumbnail" accept="image/jpeg,image/png,image/webp" class="form-control form-control-custom" style="max-width:320px;" required data-preview-img="pv-instructor" data-preview-badge="pb-instructor">
                    <button type="submit" class="btn btn-sm btn-outline-primary"><%= values.photoUrl ? 'Replace photo' : 'Upload photo' %></button>
                </form>
                <div class="form-text mt-2">JPG, PNG or WebP, max 5MB. Use only a real photo of this instructor.</div>
                <% if (values.photoUrl) { %>
                    <form method="POST" action="/admin/instructors/<%= instructor.id %>/photo/remove" class="mt-2" data-confirm="Remove this photo and use the default placeholder?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove photo</button>
                    </form>
                <% } %>
            </div>
        </div>
    </div>
<% } %>
