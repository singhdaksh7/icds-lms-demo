<h1 class="mb-4">Contact Message</h1><div class="admin-card"><dl><dt>Name</dt><dd><%= message.name %></dd><dt>Email</dt><dd><%= message.email %></dd><dt>Subject</dt><dd><%= message.subject %></dd><dt>Received</dt><dd><%= message.createdAt.toLocaleString('en-IN') %></dd></dl><hr><p style="white-space:pre-wrap"><%= message.message %></p><form method="POST" action="/admin/messages/<%= message.id %>/status" class="mt-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status" class="form-select d-inline-block w-auto"><% ['NEW','READ','RESOLVED'].forEach(s => { %><option <%= message.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select><button class="btn btn-primary ms-2">Update Status</button></form></div>
