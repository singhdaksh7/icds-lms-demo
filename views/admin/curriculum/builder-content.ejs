<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="/admin/courses" class="text-decoration-none">Courses</a></li>
            <li class="breadcrumb-item active" aria-current="page"><%= course.title %></li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 style="font-size:24px;" class="mb-1 d-flex align-items-center gap-2">
                <%= course.title %>
                <span class="badge bg-<%= course.status === 'PUBLISHED' ? 'success' : (course.status === 'DRAFT' ? 'secondary' : 'dark') %>" style="font-size:12px;">
                    <%= course.status %>
                </span>
            </h1>
            <div class="small text-muted">
                Category: <%= course.category ? course.category.name : 'Unassigned' %> &bull;
                Price: <%= Number(course.salePrice || course.price) === 0 ? 'Free' : (course.currency + ' ' + Number(course.salePrice || course.price).toLocaleString('en-IN')) %>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a href="/courses/<%= course.slug %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-box-arrow-up-right me-1"></i> Public Page
            </a>
            <a href="/admin/courses/<%= course.id %>/landing-page" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-layout-text-window-reverse me-1"></i> Landing Page
            </a>
            <a href="/admin/courses/<%= course.id %>/lessons" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-list-ol me-1"></i> Lesson List
            </a>
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createResourceModal">
                <i class="bi bi-file-earmark-arrow-up me-1"></i> Attach Resource
            </button>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createModuleModal">
                <i class="bi bi-folder-plus me-1"></i> Add Module
            </button>
        </div>
    </div>
</div>

<!-- Honest Statistics Bar -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-2">
        <div class="admin-card p-3 text-center">
            <div class="small text-muted text-uppercase fw-semibold" style="font-size:11px;">Modules</div>
            <div class="fs-4 fw-bold text-primary"><%= stats.moduleCount %></div>
            <div class="small text-muted"><%= stats.publishedModuleCount %> published</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="admin-card p-3 text-center">
            <div class="small text-muted text-uppercase fw-semibold" style="font-size:11px;">Topics</div>
            <div class="fs-4 fw-bold text-primary"><%= stats.topicCount %></div>
            <div class="small text-muted"><%= stats.publishedTopicCount %> published</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="admin-card p-3 text-center">
            <div class="small text-muted text-uppercase fw-semibold" style="font-size:11px;">Curriculum Lessons</div>
            <div class="fs-4 fw-bold text-dark"><%= stats.lessonCount %></div>
            <div class="small text-muted"><%= stats.publishedLessonCount %> published / <%= stats.lessonCount - stats.publishedLessonCount %> draft</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="admin-card p-3 text-center">
            <div class="small text-muted text-uppercase fw-semibold" style="font-size:11px;">Available Videos</div>
            <div class="fs-4 fw-bold text-success"><%= stats.videoCount %></div>
            <div class="small text-muted"><%= stats.lessonCount - stats.videoCount %> without video</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="admin-card p-3 text-center">
            <div class="small text-muted text-uppercase fw-semibold" style="font-size:11px;">Total Duration</div>
            <div class="fs-4 fw-bold text-info"><%= stats.totalDurationFormatted %></div>
            <div class="small text-muted"><%= stats.totalDurationSeconds %>s total</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="admin-card p-3 text-center">
            <div class="small text-muted text-uppercase fw-semibold" style="font-size:11px;">Resources</div>
            <div class="fs-4 fw-bold text-warning"><%= stats.resourceCount %></div>
            <div class="small text-muted">PDF / Clinical docs</div>
        </div>
    </div>
</div>

<!-- Curriculum Hierarchy Tree -->
<div class="admin-card mb-4 p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="font-size:18px;" class="mb-0">
            <i class="bi bi-diagram-3-fill me-2 text-primary"></i>Curriculum Hierarchy (Module &rarr; Topic &rarr; Lesson)
        </h2>
        <span class="badge bg-light text-muted border">Top-to-bottom playback order</span>
    </div>

    <% if (!curriculum || curriculum.length === 0) { %>
        <div class="text-center py-5 border rounded-3 bg-light">
            <i class="bi bi-folder-x fs-1 text-muted d-block mb-2"></i>
            <h5 class="text-muted">No Curriculum Modules Defined</h5>
            <p class="small text-muted mb-3">Create your first module to begin organizing lessons into modules and topics.</p>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createModuleModal">
                <i class="bi bi-folder-plus me-1"></i> Add Module
            </button>
        </div>
    <% } else { %>
        <div class="modules-accordion d-flex flex-column gap-3">
            <% curriculum.forEach(function(mod, modIdx) { %>
                <div class="card border rounded-3 overflow-hidden shadow-sm">
                    <!-- Module Header -->
                    <div class="card-header bg-white py-3 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary text-white px-2 py-1">Module <%= modIdx + 1 %></span>
                            <strong class="fs-6"><%= mod.title %></strong>
                            <% if (mod.isVirtual) { %>
                                <span class="badge bg-warning text-dark">Legacy Unorganized Container</span>
                            <% } else if (mod.isPublished) { %>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Published</span>
                            <% } else { %>
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Hidden (Draft)</span>
                            <% } %>
                            <% if (mod.description) { %>
                                <span class="text-muted small ms-2 d-none d-md-inline">&bull; <%= mod.description %></span>
                            <% } %>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <% if (!mod.isVirtual) { %>
                                <!-- Reorder Buttons -->
                                <button type="button" class="btn btn-sm btn-light border py-0 px-2 btn-swap-module" title="Move Up"
                                    <%= modIdx === 0 ? 'disabled' : '' %>
                                    data-from="<%= modIdx %>" data-to="<%= modIdx - 1 %>">
                                    <i class="bi bi-arrow-up"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-light border py-0 px-2 btn-swap-module" title="Move Down"
                                    <%= modIdx === curriculum.length - 1 ? 'disabled' : '' %>
                                    data-from="<%= modIdx %>" data-to="<%= modIdx + 1 %>">
                                    <i class="bi bi-arrow-down"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Edit Module"
                                    data-bs-toggle="modal" data-bs-target="#editModuleModal-<%= mod.id %>">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2"
                                    data-bs-toggle="modal" data-bs-target="#createTopicModal-<%= mod.id %>">
                                    <i class="bi bi-plus-lg me-1"></i> Add Topic
                                </button>
                                <form method="POST" action="/admin/courses/<%= course.id %>/curriculum/modules/<%= mod.id %>/delete" class="m-0"
                                    data-confirm="Delete module '<%= mod.title %>'? Topics will be deleted and child lessons will become unassigned. Lessons and videos are NEVER deleted.">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" title="Safe Delete Module">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>

                    <!-- Module Body (Topics) -->
                    <div class="card-body p-3 bg-light-subtle">
                        <% if (!mod.topics || mod.topics.length === 0) { %>
                            <div class="text-muted small py-2 px-3 border border-dashed rounded bg-white">
                                <i class="bi bi-info-circle me-1"></i> No topics in this module yet.
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-decoration-none" data-bs-toggle="modal" data-bs-target="#createTopicModal-<%= mod.id %>">
                                    + Add Topic
                                </button>
                            </div>
                        <% } else { %>
                            <div class="d-flex flex-column gap-3">
                                <% mod.topics.forEach(function(topic, topicIdx) { %>
                                    <div class="card border rounded-2 bg-white">
                                        <!-- Topic Header -->
                                        <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-folder2-open text-primary"></i>
                                                <span class="fw-semibold small">Topic <%= topicIdx + 1 %>: <%= topic.title %></span>
                                                <% if (topic.isPublished) { %>
                                                    <span class="badge bg-success-subtle text-success" style="font-size:10px;">Published</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary-subtle text-secondary" style="font-size:10px;">Hidden</span>
                                                <% } %>
                                                <% if (topic.description) { %>
                                                    <span class="text-muted small d-none d-lg-inline">&bull; <%= topic.description %></span>
                                                <% } %>
                                            </div>
                                            <div class="d-flex align-items-center gap-1">
                                                <% if (!topic.isVirtual) { %>
                                                    <button type="button" class="btn btn-sm btn-white border py-0 px-1 btn-swap-topic" title="Move Topic Up"
                                                        <%= topicIdx === 0 ? 'disabled' : '' %>
                                                        data-module-id="<%= mod.id %>" data-from="<%= topicIdx %>" data-to="<%= topicIdx - 1 %>">
                                                        <i class="bi bi-chevron-up"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-white border py-0 px-1 btn-swap-topic" title="Move Topic Down"
                                                        <%= topicIdx === mod.topics.length - 1 ? 'disabled' : '' %>
                                                        data-module-id="<%= mod.id %>" data-from="<%= topicIdx %>" data-to="<%= topicIdx + 1 %>">
                                                        <i class="bi bi-chevron-down"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Move to another module"
                                                        data-bs-toggle="modal" data-bs-target="#moveTopicModal-<%= topic.id %>">
                                                        <i class="bi bi-arrows-move me-1"></i> Move
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Edit Topic"
                                                        data-bs-toggle="modal" data-bs-target="#editTopicModal-<%= topic.id %>">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <a href="/admin/courses/<%= course.id %>/lessons/new?topicId=<%= topic.id %>" class="btn btn-sm btn-outline-primary py-0 px-2" title="Add Lesson to Topic">
                                                        <i class="bi bi-plus-lg me-1"></i> New Lesson
                                                    </a>
                                                    <form method="POST" action="/admin/courses/<%= course.id %>/curriculum/topics/<%= topic.id %>/delete" class="m-0"
                                                        data-confirm="Delete topic '<%= topic.title %>'? Lessons will become unassigned and remain safe.">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Safe Delete Topic">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </div>

                                        <!-- Topic Lessons -->
                                        <div class="card-body p-2">
                                            <% if (!topic.lessons || topic.lessons.length === 0) { %>
                                                <div class="text-muted small py-2 px-3 text-center">
                                                    No lessons in this topic yet.
                                                    <a href="/admin/courses/<%= course.id %>/lessons/new?topicId=<%= topic.id %>" class="text-decoration-none ms-1">
                                                        Create one now
                                                    </a>
                                                </div>
                                            <% } else { %>
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-hover mb-0 align-middle">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th style="width:30px;">#</th>
                                                                <th>Lesson Title</th>
                                                                <th>Status</th>
                                                                <th>Video State</th>
                                                                <th>Duration</th>
                                                                <th>Preview</th>
                                                                <th style="min-width:180px;">Assigned Topic</th>
                                                                <th class="text-end">Actions</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <% topic.lessons.forEach(function(les, lesIdx) { %>
                                                                <tr>
                                                                    <td class="text-muted small"><%= lesIdx + 1 %></td>
                                                                    <td>
                                                                        <strong><%= les.title %></strong>
                                                                        <div class="small text-muted"><%= les.slug %></div>
                                                                    </td>
                                                                    <td>
                                                                        <span class="badge bg-<%= les.status === 'PUBLISHED' ? 'success' : 'secondary' %>" style="font-size:11px;">
                                                                            <%= les.status %>
                                                                        </span>
                                                                    </td>
                                                                    <td>
                                                                        <% if (les.videoStorageKey || les.videoLocalPath) { %>
                                                                            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:11px;">
                                                                                <i class="bi bi-check-circle me-1"></i> R2 Video
                                                                            </span>
                                                                        <% } else { %>
                                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:11px;">
                                                                                <i class="bi bi-x-circle me-1"></i> No Video
                                                                            </span>
                                                                        <% } %>
                                                                    </td>
                                                                    <td class="small text-muted"><%= les.duration || '—' %></td>
                                                                    <td>
                                                                        <% if (les.preview) { %>
                                                                            <span class="badge bg-info-subtle text-info border border-info-subtle" style="font-size:10px;">Free Preview</span>
                                                                        <% } else { %>
                                                                            <span class="text-muted small">Locked</span>
                                                                        <% } %>
                                                                    </td>
                                                                    <td>
                                                                        <!-- Move Topic Dropdown -->
                                                                        <form method="POST" action="/admin/courses/<%= course.id %>/curriculum/lessons/move" class="m-0 d-flex gap-1">
                                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                                            <input type="hidden" name="lessonId" value="<%= les.id %>">
                                                                            <select name="targetTopicId" class="form-select form-select-sm auto-submit-topic-select" style="font-size:12px;">
                                                                                <option value="">(Unassigned)</option>
                                                                                <% allTopics.forEach(function(t) { %>
                                                                                    <option value="<%= t.id %>" <%= t.id === topic.id ? 'selected' : '' %>>
                                                                                        <%= t.title %>
                                                                                    </option>
                                                                                <% }); %>
                                                                            </select>
                                                                        </form>
                                                                    </td>
                                                                    <td class="text-end">
                                                                        <div class="d-flex justify-content-end gap-1">
                                                                            <button type="button" class="btn btn-sm btn-light border py-0 px-1 btn-swap-lesson" title="Move Up"
                                                                                <%= lesIdx === 0 ? 'disabled' : '' %>
                                                                                data-topic-id="<%= topic.id %>" data-from="<%= lesIdx %>" data-to="<%= lesIdx - 1 %>">
                                                                                <i class="bi bi-arrow-up"></i>
                                                                            </button>
                                                                            <button type="button" class="btn btn-sm btn-light border py-0 px-1 btn-swap-lesson" title="Move Down"
                                                                                <%= lesIdx === topic.lessons.length - 1 ? 'disabled' : '' %>
                                                                                data-topic-id="<%= topic.id %>" data-from="<%= lesIdx %>" data-to="<%= lesIdx + 1 %>">
                                                                                <i class="bi bi-arrow-down"></i>
                                                                            </button>
                                                                            <a href="/admin/lessons/<%= les.id %>/edit" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Edit Lesson Details">
                                                                                <i class="bi bi-pencil"></i>
                                                                            </a>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            <% }); %>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>

                                    <!-- Edit Topic Modal -->
                                    <div class="modal fade" id="editTopicModal-<%= topic.id %>" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form method="POST" action="/admin/courses/<%= course.id %>/curriculum/topics/<%= topic.id %>/edit">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Edit Topic</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label class="form-label">Topic Title <span class="text-danger">*</span></label>
                                                            <input type="text" name="title" class="form-control" value="<%= topic.title %>" required>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label">Description (Optional)</label>
                                                            <textarea name="description" class="form-control" rows="2"><%= topic.description || '' %></textarea>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label">Sort Order</label>
                                                            <input type="number" name="sortOrder" class="form-control" value="<%= topic.sortOrder %>">
                                                        </div>
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" name="isPublished" value="true" id="topicPub-<%= topic.id %>" <%= topic.isPublished ? 'checked' : '' %>>
                                                            <label class="form-check-label" for="topicPub-<%= topic.id %>">Published (Visible to students)</label>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary">Save Changes</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Move Topic Modal -->
                                    <div class="modal fade" id="moveTopicModal-<%= topic.id %>" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form method="POST" action="/admin/courses/<%= course.id %>/curriculum/topics/<%= topic.id %>/move">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Move Topic to Another Module</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="small text-muted mb-3">Select the target module for <strong><%= topic.title %></strong>:</p>
                                                        <div class="mb-3">
                                                            <label class="form-label">Target Module <span class="text-danger">*</span></label>
                                                            <select name="targetModuleId" class="form-select" required>
                                                                <% curriculum.forEach(function(m) { %>
                                                                    <% if (!m.isVirtual) { %>
                                                                        <option value="<%= m.id %>" <%= m.id === mod.id ? 'selected' : '' %>>
                                                                            <%= m.title %> <%= m.id === mod.id ? '(Current)' : '' %>
                                                                        </option>
                                                                    <% } %>
                                                                <% }); %>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary">Move Topic</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Edit Module Modal -->
                <div class="modal fade" id="editModuleModal-<%= mod.id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form method="POST" action="/admin/courses/<%= course.id %>/curriculum/modules/<%= mod.id %>/edit">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="modal-header">
                                    <h5 class="modal-title">Edit Module</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label">Module Title <span class="text-danger">*</span></label>
                                        <input type="text" name="title" class="form-control" value="<%= mod.title %>" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Description (Optional)</label>
                                        <textarea name="description" class="form-control" rows="2"><%= mod.description || '' %></textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Sort Order</label>
                                        <input type="number" name="sortOrder" class="form-control" value="<%= mod.sortOrder %>">
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="isPublished" value="true" id="modPub-<%= mod.id %>" <%= mod.isPublished ? 'checked' : '' %>>
                                        <label class="form-check-label" for="modPub-<%= mod.id %>">Published (Visible to students)</label>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save Changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Create Topic Modal for Module -->
                <div class="modal fade" id="createTopicModal-<%= mod.id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form method="POST" action="/admin/courses/<%= course.id %>/curriculum/topics">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="moduleId" value="<%= mod.id %>">
                                <div class="modal-header">
                                    <h5 class="modal-title">Add Topic to "<%= mod.title %>"</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label">Topic Title <span class="text-danger">*</span></label>
                                        <input type="text" name="title" class="form-control" placeholder="e.g. Tooth Wear and Collapsed Bite" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Description (Optional)</label>
                                        <textarea name="description" class="form-control" rows="2" placeholder="Brief summary of what this topic covers"></textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Sort Order</label>
                                        <input type="number" name="sortOrder" class="form-control" value="<%= (mod.topics ? mod.topics.length + 1 : 1) * 10 %>">
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="isPublished" value="true" id="newTopicPub-<%= mod.id %>" checked>
                                        <label class="form-check-label" for="newTopicPub-<%= mod.id %>">Published (Visible)</label>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Create Topic</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<!-- Course Resources Section -->
<div class="admin-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 style="font-size:18px;" class="mb-1">
                <i class="bi bi-file-earmark-pdf-fill me-2 text-danger"></i>Course Resources & Materials
            </h2>
            <div class="small text-muted">Protected clinical documents, PDF case forms, and resources for enrolled students.</div>
        </div>
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createResourceModal">
            <i class="bi bi-plus-lg me-1"></i> Attach Resource
        </button>
    </div>

    <% if (!resources || resources.length === 0) { %>
        <div class="text-center py-4 border rounded-3 bg-light">
            <i class="bi bi-file-earmark-x fs-2 text-muted d-block mb-2"></i>
            <p class="text-muted small mb-2">No downloadable resources attached yet.</p>
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createResourceModal">
                Attach Existing R2 PDF or Resource
            </button>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table admin-table align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Associated Topic</th>
                        <th>R2 Object Key</th>
                        <th>Type / Size</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% resources.forEach(function(resItem) { %>
                        <tr>
                            <td>
                                <strong><%= resItem.title %></strong>
                            </td>
                            <td>
                                <% if (resItem.topic) { %>
                                    <span class="badge bg-light text-dark border">
                                        <%= resItem.topic.module ? resItem.topic.module.title + ' &rarr; ' : '' %><%= resItem.topic.title %>
                                    </span>
                                <% } else { %>
                                    <span class="badge bg-secondary-subtle text-secondary">Course Level</span>
                                <% } %>
                            </td>
                            <td>
                                <code class="small text-break"><%= resItem.objectKey %></code>
                            </td>
                            <td>
                                <span class="badge bg-light text-muted border"><%= resItem.contentType %></span>
                                <% if (resItem.sizeBytes) { %>
                                    <div class="small text-muted"><%= (Number(resItem.sizeBytes) / (1024 * 1024)).toFixed(2) %> MB</div>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge bg-<%= resItem.isPublished ? 'success' : 'secondary' %>">
                                    <%= resItem.isPublished ? 'Published' : 'Hidden' %>
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="/admin/courses/<%= course.id %>/curriculum/resources/<%= resItem.id %>/download" class="btn btn-sm btn-outline-success" title="Test Signed R2 URL Download">
                                        <i class="bi bi-download me-1"></i> Test
                                    </a>
                                    <form method="POST" action="/admin/courses/<%= course.id %>/curriculum/resources/<%= resItem.id %>/delete" class="m-0"
                                        data-confirm="Remove resource '<%= resItem.title %>'? The file in R2 will NOT be deleted.">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Resource">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<!-- Modal: Create Module -->
<div class="modal fade" id="createModuleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" action="/admin/courses/<%= course.id %>/curriculum/modules">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="modal-header">
                    <h5 class="modal-title">Create Course Module</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Module Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" placeholder="e.g. FMR Foundations & Occlusal Principles" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description (Optional)</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Overview of this module's curriculum"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sort Order</label>
                        <input type="number" name="sortOrder" class="form-control" value="<%= (curriculum ? curriculum.length + 1 : 1) * 10 %>">
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isPublished" value="true" id="newModPub" checked>
                        <label class="form-check-label" for="newModPub">Published (Visible to students)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Module</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Create Resource -->
<div class="modal fade" id="createResourceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" action="/admin/courses/<%= course.id %>/curriculum/resources">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="modal-header">
                    <h5 class="modal-title">Attach Course Resource</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Resource Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" placeholder="e.g. Dental Case History Forms" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Associated Topic (Optional)</label>
                        <select name="topicId" class="form-select">
                            <option value="">Course Level (All Topics)</option>
                            <% allTopics.forEach(function(t) { %>
                                <option value="<%= t.id %>"><%= t.title %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cloudflare R2 Object Key <span class="text-danger">*</span></label>
                        <input type="text" name="objectKey" class="form-control" placeholder="e.g. courses/advanced-fmr-master-class/resources/dental-case-history-forms.pdf" required>
                        <div class="form-text">Must be an existing key in your configured R2 bucket under courses/.../resources/...</div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label">Content Type</label>
                            <input type="text" name="contentType" class="form-control" value="application/pdf">
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">File Size (Bytes)</label>
                            <input type="number" name="sizeBytes" class="form-control" placeholder="e.g. 1010253">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sort Order</label>
                        <input type="number" name="sortOrder" class="form-control" value="10">
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isPublished" value="true" id="newResPub" checked>
                        <label class="form-check-label" for="newResPub">Published (Visible to enrolled students)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Attach Resource</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
// Client-side quick swap reordering using API endpoints
const CSRF_TOKEN = '<%= csrfToken %>';
const COURSE_ID = <%= course.id %>;
const CURRICULUM = <%- JSON.stringify(curriculum.map(m => ({ id: m.id, topics: (m.topics || []).map(t => ({ id: t.id, lessons: (t.lessons || []).map(l => l.id) })) }))) %>;

function postReorder(url, body) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = url;
    const csrfInput = document.createElement('input');
    csrfInput.type = 'hidden';
    csrfInput.name = '_csrf';
    csrfInput.value = CSRF_TOKEN;
    form.appendChild(csrfInput);

    for (const [key, val] of Object.entries(body)) {
        if (Array.isArray(val)) {
            val.forEach(v => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = `${key}[]`;
                input.value = v;
                form.appendChild(input);
            });
        } else {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = key;
            input.value = val;
            form.appendChild(input);
        }
    }
    document.body.appendChild(form);
    form.submit();
}

function swapModuleOrder(fromIdx, toIdx) {
    if (fromIdx < 0 || toIdx < 0 || fromIdx >= CURRICULUM.length || toIdx >= CURRICULUM.length) return;
    const ids = CURRICULUM.map(m => m.id);
    const temp = ids[fromIdx];
    ids[fromIdx] = ids[toIdx];
    ids[toIdx] = temp;
    postReorder(`/admin/courses/${COURSE_ID}/curriculum/modules/reorder`, { moduleIds: ids });
}

function swapTopicOrder(moduleId, fromIdx, toIdx) {
    const mod = CURRICULUM.find(m => m.id === moduleId);
    if (!mod || !mod.topics) return;
    const ids = mod.topics.map(t => t.id);
    if (fromIdx < 0 || toIdx < 0 || fromIdx >= ids.length || toIdx >= ids.length) return;
    const temp = ids[fromIdx];
    ids[fromIdx] = ids[toIdx];
    ids[toIdx] = temp;
    postReorder(`/admin/courses/${COURSE_ID}/curriculum/topics/reorder`, { moduleId, topicIds: ids });
}

function swapLessonOrder(topicId, fromIdx, toIdx) {
    let targetTopic = null;
    for (const m of CURRICULUM) {
        const found = (m.topics || []).find(t => t.id === topicId);
        if (found) { targetTopic = found; break; }
    }
    if (!targetTopic || !targetTopic.lessons) return;
    const ids = [...targetTopic.lessons];
    if (fromIdx < 0 || toIdx < 0 || fromIdx >= ids.length || toIdx >= ids.length) return;
    const temp = ids[fromIdx];
    ids[fromIdx] = ids[toIdx];
    ids[toIdx] = temp;
    postReorder(`/admin/courses/${COURSE_ID}/curriculum/lessons/reorder`, { topicId, lessonIds: ids });
}

document.addEventListener('click', function(e) {
    const modBtn = e.target.closest('.btn-swap-module');
    if (modBtn) {
        swapModuleOrder(Number(modBtn.dataset.from), Number(modBtn.dataset.to));
        return;
    }
    const topBtn = e.target.closest('.btn-swap-topic');
    if (topBtn) {
        swapTopicOrder(Number(topBtn.dataset.moduleId), Number(topBtn.dataset.from), Number(topBtn.dataset.to));
        return;
    }
    const lesBtn = e.target.closest('.btn-swap-lesson');
    if (lesBtn) {
        swapLessonOrder(Number(lesBtn.dataset.topicId), Number(lesBtn.dataset.from), Number(lesBtn.dataset.to));
        return;
    }
});

document.addEventListener('change', function(e) {
    if (e.target && e.target.classList.contains('auto-submit-topic-select')) {
        e.target.form.submit();
    }
});
</script>
