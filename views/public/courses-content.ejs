<% const pg = cms.courses; %>
<section class="section-space course-section">
    <div class="container">

        <div class="section-heading reveal-element">
            <div class="section-tag"><%= pg.eyebrow %></div>
            <h1 class="section-title"><%= pg.heading %></h1>
            <% if (pg.description) { %>
            <p class="section-description">
                <%= pg.description %>
            </p>
            <% } %>
        </div>

        <form method="GET" action="/courses" class="row g-3 mb-5 align-items-end">

            <div class="col-md-5">
                <label class="form-label small fw-semibold"><%= pg.searchLabel %></label>
                <input
                    type="text"
                    name="q"
                    maxlength="100"
                    class="form-control form-control-custom"
                    placeholder="<%= pg.searchPlaceholder %>"
                    value="<%= filters.q %>">
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold"><%= pg.categoryLabel %></label>
                <select name="category" class="form-select form-control-custom">
                    <option value=""><%= pg.allCategoriesLabel %></option>
                    <% categories.forEach(function (category) { %>
                        <option value="<%= category.slug %>" <%= filters.categorySlug === category.slug ? 'selected' : '' %>>
                            <%= category.name %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold"><%= pg.levelLabel %></label>
                <select name="level" class="form-select form-control-custom">
                    <option value=""><%= pg.allLevelsLabel %></option>
                    <% levels.forEach(function (level) { %>
                        <option value="<%= level %>" <%= filters.level === level ? 'selected' : '' %>>
                            <%= level.charAt(0) + level.slice(1).toLowerCase() %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="col-md-1">
                <button type="submit" class="auth-submit"><%= pg.submitLabel %></button>
            </div>

        </form>

        <% if (filters.q || filters.categorySlug || filters.level) { %>
            <p class="text-muted mb-4">
                <%= pagination.total %> result<%= pagination.total === 1 ? '' : 's' %>
                <% if (filters.q) { %> for "<%= filters.q %>"<% } %>
                <a href="/courses" class="ms-2" style="color:#565acf;"><%= pg.clearFiltersLabel %></a>
            </p>
        <% } %>

        <% if (courses.length === 0) { %>

            <%- include('../partials/empty-state', {
                icon: 'bi-search',
                title: pg.emptyHeading,
                text: pg.emptyText,
                actionHref: '/courses',
                actionLabel: pg.emptyCta,
            }) %>

        <% } else { %>

            <div class="row g-4">
                <% courses.forEach(function (course) { %>
                    <div class="col-md-6 col-xl-4 reveal-element">
                        <%- include('../partials/course-card', { course }) %>
                    </div>
                <% }); %>
            </div>

            <%- include('../partials/pagination', { pagination, pageUrl }) %>

        <% } %>

    </div>
</section>
