<section class="section-space">
    <div class="container" style="max-width:860px">
        <h1 class="section-title"><%= heading %></h1>
        <% if (updatedLabel) { %>
            <p class="text-muted small mb-4">Last updated: <%= updatedLabel %></p>
        <% } %>
        <% blocks.forEach(function (block) { %>
            <% if (block.type === 'h2') { %>
                <h2 class="h5 mt-4 mb-2"><%= block.text %></h2>
            <% } else if (block.type === 'ul') { %>
                <ul class="mb-3">
                    <% block.items.forEach(function (item) { %><li><%= item %></li><% }) %>
                </ul>
            <% } else { %>
                <p class="section-description" style="text-align:left; white-space:pre-line;"><%= block.text %></p>
            <% } %>
        <% }) %>
    </div>
</section>
