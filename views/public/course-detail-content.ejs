<%
const cd = cms.course;
const effectivePrice = Number(course.salePrice || course.price);
const freeCourse = typeof isFree !== 'undefined' ? isFree : (effectivePrice === 0);
const formattedPriceLabel = typeof priceLabel !== 'undefined' ? priceLabel : ((course.currency === 'INR' ? '₹' : course.currency + ' ') + effectivePrice.toLocaleString('en-IN'));
const courseStats = typeof stats !== 'undefined' && stats ? stats : {
    moduleCount: (typeof curriculum !== 'undefined' && Array.isArray(curriculum) ? curriculum.length : 0),
    publishedModuleCount: (typeof curriculum !== 'undefined' && Array.isArray(curriculum) ? curriculum.length : 0),
    topicCount: 0,
    publishedTopicCount: 0,
    lessonCount: (course.lessons ? course.lessons.length : 0),
    publishedLessonCount: (course.lessons ? course.lessons.filter(l => l.status === 'PUBLISHED').length : (course.lessons ? course.lessons.length : 0)),
    videoCount: (course.lessons ? course.lessons.filter(l => l.videoStorageKey || l.videoPath || l.videoType === 'R2').length : 0),
    totalDurationSeconds: 0,
    totalDurationFormatted: course.duration || 'Comprehensive',
    resourceCount: (typeof resources !== 'undefined' && Array.isArray(resources) ? resources.length : 0),
};
const safeCurriculum = typeof curriculum !== 'undefined' && Array.isArray(curriculum) ? curriculum : [];
const safeResources = typeof resources !== 'undefined' && Array.isArray(resources) ? resources : [];
const safeFaqs = typeof faqs !== 'undefined' && Array.isArray(faqs) ? faqs : [];
const userIsEnrolled = typeof isEnrolled !== 'undefined' && isEnrolled;
const hasPending = typeof hasPendingRequest !== 'undefined' && hasPendingRequest;
%>
<link rel="stylesheet" href="/css/course-landing.css">

<div class="course-landing-page">
    <main>
        <% if (cd.backLabel) { %>
            <div class="wrap" style="padding-top:16px;">
                <a href="/courses" style="color:#5d3fd3; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px;">
                    <i class="bi bi-arrow-left"></i> <%= cd.backLabel %>
                </a>
            </div>
        <% } %>

        <!-- Semantic Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <div class="wrap">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li><a href="/courses">Courses</a></li>
                    <% if (course.category) { %>
                        <li><a href="/courses?category=<%= course.category.slug %>"><%= course.category.name %></a></li>
                    <% } %>
                    <li aria-current="page"><%= course.title %></li>
                </ol>
            </div>
        </nav>

        <!-- Hero Section -->
        <section class="hero">
            <div class="wrap hero-grid">
                <div class="hero-copy">
                    <span class="eyebrow rv">
                        <%= course.category ? course.category.name : 'ICDS' %> &bull; Online Certificate Course
                    </span>
                    <h1 class="rv d1">
                        <% 
                            const words = (course.title || '').trim().split(/\s+/);
                            let titleLead = course.title;
                            let titleAccent = '';
                            if (words.length >= 3) {
                                titleLead = words.slice(0, 2).join(' ');
                                titleAccent = words.slice(2).join(' ');
                            } else if (words.length === 2) {
                                titleLead = words[0];
                                titleAccent = words[1];
                            }
                        %>
                        <%= titleLead %> <% if (titleAccent) { %><em><%= titleAccent %></em><% } %>
                    </h1>

                    <p class="lede rv d2">
                        <%= course.shortDescription || course.description || 'Comprehensive clinical masterclass covering foundational principles, occlusion, case diagnostics, treatment sequencing, and hands-on clinical workflows.' %>
                    </p>

                    <div class="chips rv d2">
                        <span class="chip">✓ <%= courseStats.totalDurationFormatted || course.duration || 'Self-paced' %></span>
                        <span class="chip">✓ <%= courseStats.publishedLessonCount %> Structured Videos</span>
                        <span class="chip">✓ Pre-Recorded</span>
                        <span class="chip">✓ E-Certificate</span>
                        <span class="chip">✓ Lifetime Access</span>
                    </div>

                    <div class="price-row rv d3">
                        <div>
                            <div class="from">Full Lifetime Access</div>
                            <div class="price"><%= freeCourse ? 'Free' : formattedPriceLabel %></div>
                        </div>
                        <% if (!freeCourse && course.salePrice && Number(course.salePrice) < Number(course.price)) { %>
                            <div class="mrp">₹<%= Number(course.price).toLocaleString('en-IN') %></div>
                            <div class="save-pill">Save ₹<%= (Number(course.price) - Number(course.salePrice)).toLocaleString('en-IN') %></div>
                        <% } %>
                    </div>

                    <div class="actions rv d3">
                        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'STUDENT') { %>
                            <% if (userIsEnrolled) { %>
                                <a class="btn btn-primary" href="/learn/<%= course.slug %>">Continue Learning →</a>
                            <% } else if (freeCourse) { %>
                                <form method="POST" action="/courses/<%= course.slug %>/enroll-free" class="m-0 d-inline-block">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <button type="submit" class="btn btn-primary"><%= cd.freeCta || 'Enroll Free →' %></button>
                                </form>
                            <% } else if (typeof paymentsEnabled !== 'undefined' && paymentsEnabled) { %>
                                <a class="btn btn-primary" href="/checkout/<%= course.slug %>">Buy Course – <%= formattedPriceLabel %></a>
                            <% } else if (hasPending) { %>
                                <button class="btn btn-secondary" disabled><%= cd.requestedLabel || 'Request Pending' %></button>
                            <% } else { %>
                                <form method="POST" action="/courses/<%= course.slug %>/request-enrollment" class="m-0 d-inline-block">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <button type="submit" class="btn btn-primary"><%= cd.requestCta || 'Request Enrollment →' %></button>
                                </form>
                            <% } %>
                        <% } else if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'ADMIN') { %>
                            <a class="btn btn-primary" href="/learn/<%= course.slug %>">View as Admin →</a>
                        <% } else { %>
                            <a class="btn btn-primary" href="/login?returnTo=<%= encodeURIComponent('/courses/' + course.slug) %>">
                                <%= freeCourse ? (cd.loginFreeCta || 'Enroll Free →') : ((typeof paymentsEnabled !== 'undefined' && paymentsEnabled) ? 'Buy Course – ' + formattedPriceLabel : (cd.loginRequestCta || 'Sign In to Access →')) %>
                            </a>
                        <% } %>
                        <a class="btn btn-secondary" href="#curriculum">Explore Curriculum</a>
                    </div>
                </div>

                <div class="rv d2">
                    <div class="video-card">
                        <div class="portrait">
                            <img src="<%= course.thumbnailUrl || cms.brand.defaultCourseImageUrl || '/assets/images/course-placeholder.svg' %>"
                                 alt="<%= course.title %>"
                                 data-fallback-src="/assets/images/course-placeholder.svg">
                            <div class="play-overlay">
                                <a href="#curriculum" class="play-btn" aria-label="Explore curriculum">▶</a>
                            </div>
                        </div>
                    </div>
                    <div class="mentor-strip">
                        <span><b>Institute of Cosmetology &amp; Dental Sciences</b></span>
                        <span>•</span>
                        <span>100% Verified Clinical Curriculum</span>
                    </div>
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="wrap stats rv">
                <div class="stat">
                    <strong><%= courseStats.publishedLessonCount %></strong>
                    <span>video lessons</span>
                </div>
                <div class="stat">
                    <strong><%= courseStats.publishedModuleCount %></strong>
                    <span>structured modules</span>
                </div>
                <div class="stat">
                    <strong><%= courseStats.publishedTopicCount %></strong>
                    <span>clinical topics</span>
                </div>
                <div class="stat">
                    <strong>Full</strong>
                    <span>lifetime access</span>
                </div>
            </div>
        </section>

        <!-- Course Fundamentals / Context Card -->
        <section class="seo-intro" aria-labelledby="course-fundamentals-heading">
            <div class="wrap">
                <div class="context-card rv">
                    <span class="eyebrow"><%= course.category ? course.category.name : 'Clinical Fundamentals' %></span>
                    <h2 id="course-fundamentals-heading"><%= cd.aboutHeading || 'About This Masterclass' %></h2>
                    <% if (course.description) { %>
                        <div style="margin-top:14px; font-size:16px; line-height:1.8; color:var(--muted); white-space:pre-line;">
                            <%= course.description %>
                        </div>
                    <% } else { %>
                        <p>This masterclass provides a comprehensive, logically sequenced clinical curriculum designed to help practitioners understand diagnosis, treatment sequencing, and hands-on execution with clarity and confidence.</p>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- Learning Outcomes -->
        <section>
            <div class="wrap">
                <div class="section-head rv">
                    <span class="eyebrow">Masterclass Learning Outcomes</span>
                    <h2>What clinicians will learn in this <em>master class</em></h2>
                    <p>A practical, evidence-based clinical framework designed to help you master treatment planning logically before you attempt complex clinical cases.</p>
                </div>
                <div class="grid2">
                    <div class="card takeaway rv">
                        <div class="ico">01</div>
                        <div>
                            <h3>Foundational Occlusal Philosophy</h3>
                            <p>Understand the foundational principles of Full Mouth Rehabilitation, tooth wear mechanisms, and core occlusal relationships.</p>
                        </div>
                    </div>
                    <div class="card takeaway rv d1">
                        <div class="ico">02</div>
                        <div>
                            <h3>Tooth Wear &amp; Bite Collapse</h3>
                            <p>Accurately differentiate bruxers from clenchers, manage severe anterior attrition, and stabilize collapsed vertical dimension.</p>
                        </div>
                    </div>
                    <div class="card takeaway rv">
                        <div class="ico">03</div>
                        <div>
                            <h3>Facebow Records &amp; Protocols</h3>
                            <p>Master clinical Facebow transfer theory and execute real-world patient demonstration protocols with repeatable precision.</p>
                        </div>
                    </div>
                    <div class="card takeaway rv d1">
                        <div class="ico">04</div>
                        <div>
                            <h3>Articulator Programming &amp; TMJ</h3>
                            <p>Master semi-adjustable Hanau articulators, zeroing, calibration, programming, condylar guidance, and diagnostic TMJ evaluation.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Sneak Peek Dark Band -->
        <section class="sneak">
            <div class="wrap">
                <div class="section-head rv">
                    <span class="eyebrow">A Sneak Peek</span>
                    <h2>See the learning experience <em>before you enroll</em></h2>
                    <p>Watch this high-definition clinical preview to experience the depth, clarity, and systematic presentation style of the course.</p>
                </div>
                <div class="youtube-shell rv">
                    <div class="youtube-lite" id="yt-preview">
                        <img src="<%= course.thumbnailUrl || cms.brand.defaultCourseImageUrl || '/assets/images/course-placeholder.svg' %>"
                             alt="<%= course.title %> preview"
                             loading="lazy">
                        <a href="#curriculum" class="play" aria-label="Explore lessons">▶</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Clinical Questions Section -->
        <section>
            <div class="wrap">
                <div class="section-head rv">
                    <span class="eyebrow">Clinical FMR Fundamentals</span>
                    <h2>Core clinical questions this masterclass <em>helps you answer</em></h2>
                </div>
                <div class="question-grid">
                    <div class="qcard rv"><div class="qnum">01</div>How to systematically assess, plan, and execute an FMR case</div>
                    <div class="qcard rv d1"><div class="qnum">02</div>What sequential workflow steps to follow from diagnostics to delivery</div>
                    <div class="qcard rv"><div class="qnum">03</div>How to stabilize, deprogram, and restore a collapsed bite</div>
                    <div class="qcard rv d1"><div class="qnum">04</div>How to establish and verify the correct vertical dimension (VDO)</div>
                    <div class="qcard rv"><div class="qnum">05</div>How to capture a precise, verifiable centric relation (CR) record</div>
                    <div class="qcard rv d1"><div class="qnum">06</div>How to identify and eliminate damaging occlusal interferences</div>
                    <div class="qcard rv"><div class="qnum">07</div>Why, when, and how to execute a clinical Facebow transfer record</div>
                    <div class="qcard rv d1"><div class="qnum">08</div>How to zero, calibrate, and program semi-adjustable articulators</div>
                    <div class="qcard rv"><div class="qnum">09</div>How to ensure long-term structural and biological success of restorative cases</div>
                </div>
            </div>
        </section>

        <!-- Curriculum Section -->
        <section id="curriculum" class="curriculum">
            <div class="wrap">
                <div class="section-head rv">
                    <span class="eyebrow"><%= cd.curriculumHeading || 'Course Curriculum' %></span>
                    <h2><%= courseStats.publishedModuleCount %> structured <em>modules for dentists</em></h2>
                    <p>Learn the essential clinical workflow through structured modules covering occlusal foundations, centric relation, facebow transfer, articulators, vertical dimension, and comprehensive case planning.</p>
                </div>

                <% if (safeCurriculum.length === 0 && (!course.lessons || course.lessons.length === 0)) { %>
                    <p class="text-muted"><%= cd.emptyLessons || 'No lessons published yet.' %></p>
                <% } else { %>
                    <div class="modules-container">
                        <% safeCurriculum.forEach(function(mod, modIdx) { 
                            const modLessons = (mod.topics || []).reduce((acc, t) => acc.concat((t.lessons || []).filter(l => l.status === 'PUBLISHED')), []);
                            const modTopics = (mod.topics || []).filter(t => (t.lessons || []).some(l => l.status === 'PUBLISHED') || (t.resources || []).length > 0);
                            if (modLessons.length === 0 && modTopics.length === 0) return;
                        %>
                            <div class="module-card rv <%= modIdx === 0 ? 'is-open' : '' %>" id="mod-card-<%= mod.id %>">
                                <button type="button" class="module-header-btn" data-toggle-module="<%= mod.id %>" aria-expanded="<%= modIdx === 0 ? 'true' : 'false' %>">
                                    <div class="module-header-left">
                                        <span class="module-pill">Module <%= modIdx + 1 %></span>
                                        <span class="module-title"><%= mod.title %></span>
                                    </div>
                                    <div class="module-header-right">
                                        <span class="module-meta">
                                            <%= modTopics.length %> Topic<%= modTopics.length === 1 ? '' : 's' %> &bull; <%= modLessons.length %> Video<%= modLessons.length === 1 ? '' : 's' %>
                                        </span>
                                        <span class="module-chevron">⌄</span>
                                    </div>
                                </button>
                                <div class="module-body" id="mod-body-<%= mod.id %>">
                                    <% if (mod.description) { %>
                                        <div class="module-desc"><%= mod.description %></div>
                                    <% } %>

                                    <% modTopics.forEach(function(topic, topicIdx) { 
                                        const topicPubLessons = (topic.lessons || []).filter(l => l.status === 'PUBLISHED');
                                    %>
                                        <div class="topic-box">
                                            <div class="topic-box-header">
                                                <div>
                                                    <i class="bi bi-folder2-open me-2" style="color:#5d3fd3;"></i>Topic <%= topicIdx + 1 %>: <%= topic.title %>
                                                </div>
                                                <span class="lesson-badge">
                                                    <%= topicPubLessons.length %> Video<%= topicPubLessons.length === 1 ? '' : 's' %>
                                                </span>
                                            </div>
                                            <ul class="lesson-list">
                                                <% topicPubLessons.forEach(function(lesson) { %>
                                                    <li class="lesson-row">
                                                        <div class="lesson-title-area">
                                                            <span class="lesson-ico"><i class="bi bi-play-circle-fill"></i></span>
                                                            <span class="lesson-title"><%= lesson.title %></span>
                                                            <% if (lesson.preview) { %>
                                                                <span class="lesson-badge">Free Preview</span>
                                                            <% } %>
                                                        </div>
                                                        <div class="lesson-right">
                                                            <% if (lesson.duration) { %>
                                                                <span class="lesson-dur"><%= lesson.duration %></span>
                                                            <% } %>
                                                            <% if (lesson.preview) { %>
                                                                <a href="/learn/<%= course.slug %>/<%= lesson.slug %>" class="btn btn-sm btn-secondary" style="min-height:36px; padding:6px 16px; font-size:12.5px;">
                                                                    Watch Preview
                                                                </a>
                                                            <% } else if (userIsEnrolled) { %>
                                                                <a href="/learn/<%= course.slug %>/<%= lesson.slug %>" class="btn btn-sm btn-secondary" style="min-height:36px; padding:6px 16px; font-size:12.5px; color:#1d9168 !important;">
                                                                    Watch
                                                                </a>
                                                            <% } else { %>
                                                                <span class="lesson-lock" title="Enroll to unlock this lesson">
                                                                    <i class="bi bi-lock-fill"></i>
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                    </li>
                                                <% }); %>
                                            </ul>
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </section>

        <!-- Certificate Section -->
        <section>
            <div class="wrap certificate">
                <div class="certificate-img rv">
                    <div class="certificate-mockup">
                        <div class="certificate-mockup-title">Institute of Cosmetology &amp; Dental Sciences</div>
                        <div class="certificate-mockup-certifies">Certificate of Clinical Masterclass Completion</div>
                        <div class="certificate-mockup-course"><%= course.title %></div>
                        <div class="certificate-mockup-footer">
                            Official Verifiable Clinical Credential &bull; ICDS Academic Board
                        </div>
                    </div>
                </div>
                <div class="certificate-copy rv d1">
                    <span class="eyebrow">E-Certificate</span>
                    <h2>Recognize your progress in <em><%= course.title %></em></h2>
                    <p>Upon completion of all video lessons and clinical evaluations, you will receive an official verifiable digital Certificate of Completion recognizing your mastery and commitment to advancing clinical patient care.</p>
                    <p class="certificate-note">Certificate issued digitally after verified curriculum completion.</p>
                </div>
            </div>
        </section>

        <!-- Candidate Profile / Audience Section -->
        <section class="audience">
            <div class="wrap">
                <div class="section-head rv">
                    <span class="eyebrow">Candidate Profile</span>
                    <h2>Is this online Master Class <em>right for you?</em></h2>
                </div>
                <div class="grid2">
                    <div class="card yes rv">
                        <h3>Good fit for</h3>
                        <ul class="checklist">
                            <li><%= cd.benefit1 || 'Ambitious dentists aiming to excel in functional and restorative dentistry' %></li>
                            <li><%= cd.benefit2 || 'Clinicians seeking stronger mastery and predictable occlusal outcomes' %></li>
                            <li><%= cd.benefit3 || 'Dental professionals dedicated to disciplined clinical protocols' %></li>
                            <li>Dentists who prioritize long-term patient function, comfort, and stability</li>
                        </ul>
                    </div>
                    <div class="card no rv d1">
                        <h3>Probably not for</h3>
                        <ul class="checklist">
                            <li>Those unwilling to invest effort in learning foundational occlusion principles</li>
                            <li>Dentists completely content with intuitive or non-standardized restorative guesswork</li>
                            <li>Clinicians resistant to systematic clinical documentation and articulator programming</li>
                            <li>Anyone seeking superficial cosmetic quick-fixes without functional stability</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Clinical Resources Section -->
        <% if (safeResources.length > 0) { %>
            <section>
                <div class="wrap">
                    <div class="section-head rv">
                        <span class="eyebrow">Clinical Documentation</span>
                        <h2>Downloadable clinical <em>protocols &amp; tools</em></h2>
                        <p>Enrolled practitioners receive verified downloadable clinical protocols, evaluation forms, and documentation tools.</p>
                    </div>
                    <div>
                        <% safeResources.forEach(function(resItem) { %>
                            <div class="resource-card rv">
                                <div class="resource-info">
                                    <div class="resource-ico"><i class="bi bi-file-earmark-pdf-fill"></i></div>
                                    <div>
                                        <div class="resource-title"><%= resItem.title %></div>
                                        <div class="resource-meta">
                                            <%= resItem.contentType %> &bull;
                                            <%= resItem.sizeBytes ? (Number(resItem.sizeBytes) / (1024 * 1024)).toFixed(2) + ' MB' : 'Official Clinical Form' %>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <% if (userIsEnrolled) { %>
                                        <a href="/learn/<%= course.slug %>/resources/<%= resItem.id %>/download" class="btn btn-sm btn-secondary" style="min-height:42px; padding:8px 20px; font-size:13px; color:#1d9168 !important;">
                                            <i class="bi bi-download me-1"></i> Download
                                        </a>
                                    <% } else { %>
                                        <span class="lesson-badge" style="font-size:12px; padding:6px 14px;">
                                            <i class="bi bi-lock-fill me-1"></i> Included Free With Enrollment
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- Instructor Section (Shown ONLY if instructor exists) -->
        <% if (course.instructor) { %>
            <section id="mentor">
                <div class="wrap mentor">
                    <div class="mentor-frame rv">
                        <img src="<%= course.instructor.photoUrl || cms.brand.defaultInstructorImageUrl || '/assets/images/instructor-placeholder.svg' %>"
                             alt="<%= course.instructor.name %>"
                             loading="lazy"
                             data-fallback-src="/assets/images/instructor-placeholder.svg">
                    </div>
                    <div class="rv d1">
                        <span class="eyebrow"><%= cd.instructorHeading || 'Course Instructor' %></span>
                        <h2><%= course.instructor.name %></h2>
                        <% if (course.instructor.title) { %>
                            <p style="font-weight:700; color:#5d3fd3; margin-top:8px;"><%= course.instructor.title %></p>
                        <% } %>
                        <p><%= course.instructor.bio || '' %></p>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- FAQ Section -->
        <% if (safeFaqs.length > 0) { %>
            <section>
                <div class="wrap">
                    <div class="section-head rv">
                        <span class="eyebrow">Questions &amp; Answers</span>
                        <h2>Frequently asked <em>course questions</em></h2>
                    </div>
                    <div class="faq">
                        <% safeFaqs.forEach(function(faq, faqIdx) { %>
                            <details class="rv" <%= faqIdx === 0 ? 'open' : '' %>>
                                <summary><%= faq.question %><span class="pm">+</span></summary>
                                <div class="faq-a">
                                    <p><%= faq.answer %></p>
                                </div>
                            </details>
                        <% }); %>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- Final CTA Banner -->
        <section>
            <div class="wrap">
                <div class="final-card rv">
                    <span class="eyebrow">Start Learning Today</span>
                    <h2 style="margin-top:16px;">Enroll in <em><%= course.title %></em></h2>
                    <p style="max-width:700px; margin:16px auto 0; font-size:17px;">
                        Immediate online access to all <%= courseStats.publishedLessonCount %> structured video lessons, clinical demonstrations, and downloadable forms.
                    </p>
                    <div class="price-row">
                        <div>
                            <div class="from">Full Lifetime Access</div>
                            <div class="price"><%= freeCourse ? 'Free' : formattedPriceLabel %></div>
                        </div>
                    </div>
                    <div class="actions">
                        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'STUDENT') { %>
                            <% if (userIsEnrolled) { %>
                                <a class="btn btn-primary" href="/learn/<%= course.slug %>">Continue Learning →</a>
                            <% } else if (freeCourse) { %>
                                <form method="POST" action="/courses/<%= course.slug %>/enroll-free" class="m-0">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <button type="submit" class="btn btn-primary"><%= cd.freeCta || 'Enroll Free →' %></button>
                                </form>
                            <% } else if (typeof paymentsEnabled !== 'undefined' && paymentsEnabled) { %>
                                <a class="btn btn-primary" href="/checkout/<%= course.slug %>">Buy Course – <%= formattedPriceLabel %></a>
                            <% } %>
                        <% } else { %>
                            <a class="btn btn-primary" href="/login?returnTo=<%= encodeURIComponent('/courses/' + course.slug) %>">
                                <%= freeCourse ? (cd.loginFreeCta || 'Enroll Free →') : ('Enroll Now – ' + formattedPriceLabel) %>
                            </a>
                        <% } %>
                    </div>
                    <div>
                        <span class="plan-badge">✓ 100% Free · Lifetime Access · Verifiable Certificate</span>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Floating Sticky Bottom CTA Bar -->
    <div class="floating" id="course-floating-bar">
        <div class="floating-inner">
            <div class="floating-copy">
                <strong><%= course.title %></strong>
                <span>Full Lifetime Access &bull; <%= freeCourse ? 'Free' : formattedPriceLabel %></span>
            </div>
            <div>
                <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'STUDENT') { %>
                    <% if (userIsEnrolled) { %>
                        <a class="btn btn-primary" href="/learn/<%= course.slug %>">Continue Learning →</a>
                    <% } else if (freeCourse) { %>
                        <form method="POST" action="/courses/<%= course.slug %>/enroll-free" class="m-0">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <button type="submit" class="btn btn-primary"><%= cd.freeCta || 'Enroll Free →' %></button>
                        </form>
                    <% } else if (typeof paymentsEnabled !== 'undefined' && paymentsEnabled) { %>
                        <a class="btn btn-primary" href="/checkout/<%= course.slug %>">Buy Course – <%= formattedPriceLabel %></a>
                    <% } %>
                <% } else { %>
                    <a class="btn btn-primary" href="/login?returnTo=<%= encodeURIComponent('/courses/' + course.slug) %>">
                        <%= freeCourse ? (cd.loginFreeCta || 'Enroll Free →') : ('Enroll Now – ' + formattedPriceLabel) %>
                    </a>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
document.addEventListener('DOMContentLoaded', function() {
    // Accordion toggle delegation
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-toggle-module]');
        if (btn) {
            var modId = btn.getAttribute('data-toggle-module');
            var card = document.getElementById('mod-card-' + modId);
            if (card) {
                var isOpen = card.classList.toggle('is-open');
                btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            }
        }
    });

    // Scroll reveal observer
    if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    e.target.classList.add('in');
                    io.unobserve(e.target);
                }
            });
        }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

        document.querySelectorAll('.course-landing-page .rv').forEach(function(el) {
            io.observe(el);
        });
    } else {
        document.querySelectorAll('.course-landing-page .rv').forEach(function(el) {
            el.classList.add('in');
        });
    }
});
</script>
