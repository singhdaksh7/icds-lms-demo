<%
const cd = cms.course;
const effectivePrice = Number(course.salePrice || course.price);
const freeCourse = typeof isFree !== 'undefined' ? isFree : (effectivePrice === 0);
const formattedPriceLabel = typeof priceLabel !== 'undefined' ? priceLabel : ((course.currency === 'INR' ? '₹' : course.currency + ' ') + effectivePrice.toLocaleString('en-IN'));
const courseStats = typeof stats !== 'undefined' && stats ? stats : {
    moduleCount: (typeof curriculum !== 'undefined' && Array.isArray(curriculum) ? curriculum.length : 0),
    publishedModuleCount: (typeof curriculum !== 'undefined' && Array.isArray(curriculum) ? curriculum.length : 0),
    topicCount: 0,
    publishedTopicCount: 0,
    lessonCount: (course.lessons ? course.lessons.length : 0),
    publishedLessonCount: (course.lessons ? course.lessons.filter(l => l.status === 'PUBLISHED').length : (course.lessons ? course.lessons.length : 0)),
    videoCount: (course.lessons ? course.lessons.filter(l => l.videoStorageKey || l.videoPath || l.videoType === 'R2').length : 0),
    totalDurationSeconds: 0,
    totalDurationFormatted: course.duration || 'Comprehensive',
    resourceCount: (typeof resources !== 'undefined' && Array.isArray(resources) ? resources.length : 0),
};
const safeCurriculum = typeof curriculum !== 'undefined' && Array.isArray(curriculum) ? curriculum : [];
const safeResources = typeof resources !== 'undefined' && Array.isArray(resources) ? resources : [];
const userIsEnrolled = typeof isEnrolled !== 'undefined' && isEnrolled;
const hasPending = typeof hasPendingRequest !== 'undefined' && hasPendingRequest;

// Landing CMS dynamic content
const lc = (typeof landing !== 'undefined' && landing && landing.content) ? landing.content : {};
const heroChipsList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.heroChips)) ? landing.heroChips : [];
const takeawaysList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.takeaways)) ? landing.takeaways : [];
const questionsList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.questions)) ? landing.questions : [];
const audienceForList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.audienceFor)) ? landing.audienceFor : [];
const audienceNotForList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.audienceNotFor)) ? landing.audienceNotFor : [];
const courseFaqsList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.faqs)) ? landing.faqs : (typeof faqs !== 'undefined' && Array.isArray(faqs) ? faqs : []);
%>
<link rel="stylesheet" href="/css/course-landing.css">

<div class="course-landing-page">
    <main>
        <% if (cd.backLabel) { %>
            <div class="wrap" style="padding-top:16px;">
                <a href="/courses" style="color:#5d3fd3; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px;">
                    <i class="bi bi-arrow-left"></i> <%= cd.backLabel %>
                </a>
            </div>
        <% } %>

        <!-- Semantic Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <div class="wrap">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li><a href="/courses">Courses</a></li>
                    <% if (course.category) { %>
                        <li><a href="/courses?category=<%= course.category.slug %>"><%= course.category.name %></a></li>
                    <% } %>
                    <li aria-current="page"><%= course.title %></li>
                </ol>
            </div>
        </nav>

        <!-- Hero Section -->
        <section class="hero">
            <div class="wrap hero-grid">
                <div class="hero-copy">
                    <span class="eyebrow rv">
                        <%= lc.heroEyebrow || (course.category ? course.category.name + ' • Online Certificate Course' : 'Online Certificate Course') %>
                    </span>
                    <h1 class="rv d1">
                        <% 
                            const displayTitle = lc.heroTitleOverride || course.title || '';
                            if (lc.heroAccentText) {
                                const accent = lc.heroAccentText;
                                const lowerTitle = displayTitle.toLowerCase();
                                const lowerAccent = accent.toLowerCase();
                                const idx = lowerTitle.indexOf(lowerAccent);
                                if (idx !== -1) {
                                    const before = displayTitle.slice(0, idx);
                                    const matched = displayTitle.slice(idx, idx + accent.length);
                                    const after = displayTitle.slice(idx + accent.length);
                        %>
                                    <%= before %><em><%= matched %></em><%= after %>
                        <%
                                } else {
                        %>
                                    <%= displayTitle %> <em><%= accent %></em>
                        <%
                                }
                            } else {
                                const words = displayTitle.trim().split(/\s+/);
                                let titleLead = displayTitle;
                                let titleAccent = '';
                                if (words.length >= 3) {
                                    titleLead = words.slice(0, 2).join(' ');
                                    titleAccent = words.slice(2).join(' ');
                                } else if (words.length === 2) {
                                    titleLead = words[0];
                                    titleAccent = words[1];
                                }
                        %>
                                <%= titleLead %> <% if (titleAccent) { %><em><%= titleAccent %></em><% } %>
                        <% } %>
                    </h1>

                    <% const heroDesc = lc.heroDescription || course.shortDescription || course.description || ''; %>
                    <% if (heroDesc) { %>
                        <p class="lede rv d2"><%= heroDesc %></p>
                    <% } %>

                    <% if (heroChipsList.length > 0) { %>
                        <div class="chips rv d2">
                            <% heroChipsList.forEach(function(chip) { %>
                                <span class="chip">✓ <%= chip.label %></span>
                            <% }); %>
                        </div>
                    <% } %>

                    <div class="price-row rv d3">
                        <div>
                            <div class="from"><%= lc.priceSubtitle || 'Full Access' %></div>
                            <div class="price"><%= freeCourse ? 'Free' : formattedPriceLabel %></div>
                        </div>
                        <% if (!freeCourse && course.salePrice && Number(course.salePrice) < Number(course.price)) { %>
                            <div class="mrp">₹<%= Number(course.price).toLocaleString('en-IN') %></div>
                            <div class="save-pill">Save ₹<%= (Number(course.price) - Number(course.salePrice)).toLocaleString('en-IN') %></div>
                        <% } %>
                    </div>

                    <div class="actions rv d3">
                        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'STUDENT') { %>
                            <% if (userIsEnrolled) { %>
                                <a class="btn btn-primary" href="/learn/<%= course.slug %>">Continue Learning →</a>
                            <% } else if (freeCourse) { %>
                                <form method="POST" action="/courses/<%= course.slug %>/enroll-free" class="m-0 d-inline-block">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <button type="submit" class="btn btn-primary"><%= lc.finalCtaButtonLabel || cd.freeCta || 'Enroll Free →' %></button>
                                </form>
                            <% } else if (typeof paymentsEnabled !== 'undefined' && paymentsEnabled) { %>
                                <a class="btn btn-primary" href="/checkout/<%= course.slug %>"><%= lc.finalCtaButtonLabel || ('Buy Course – ' + formattedPriceLabel) %></a>
                            <% } else if (hasPending) { %>
                                <button class="btn btn-secondary" disabled><%= cd.requestedLabel || 'Request Pending' %></button>
                            <% } else { %>
                                <form method="POST" action="/courses/<%= course.slug %>/request-enrollment" class="m-0 d-inline-block">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <button type="submit" class="btn btn-primary"><%= cd.requestCta || 'Request Enrollment →' %></button>
                                </form>
                            <% } %>
                        <% } else if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'ADMIN') { %>
                            <a class="btn btn-primary" href="/learn/<%= course.slug %>">View as Admin →</a>
                        <% } else { %>
                            <a class="btn btn-primary" href="/login?returnTo=<%= encodeURIComponent('/courses/' + course.slug) %>">
                                <%= freeCourse ? (lc.finalCtaButtonLabel || cd.loginFreeCta || 'Enroll Free →') : ((typeof paymentsEnabled !== 'undefined' && paymentsEnabled) ? 'Buy Course – ' + formattedPriceLabel : (cd.loginRequestCta || 'Sign In to Access →')) %>
                            </a>
                        <% } %>
                        <% if (lc.secondaryCtaLabel !== '') { %>
                            <a class="btn btn-secondary" href="<%= lc.secondaryCtaTarget || '#curriculum' %>"><%= lc.secondaryCtaLabel || 'Explore Curriculum' %></a>
                        <% } %>
                    </div>
                </div>

                <% if (lc.heroMediaType !== 'NONE') { %>
                    <div class="rv d2">
                        <div class="video-card">
                            <div class="portrait">
                                <% const heroMediaImg = (lc.heroMediaType === 'IMAGE' && lc.heroMediaUrl) ? lc.heroMediaUrl : (course.thumbnailUrl || cms.brand.defaultCourseImageUrl || '/assets/images/course-placeholder.svg'); %>
                                <img src="<%= heroMediaImg %>"
                                     alt="<%= course.title %>"
                                     data-fallback-src="/assets/images/course-placeholder.svg">
                                <div class="play-overlay">
                                    <a href="<%= (lc.heroMediaType === 'VIDEO' && lc.heroMediaUrl) ? lc.heroMediaUrl : '#curriculum' %>" class="play-btn" aria-label="Explore curriculum">▶</a>
                                </div>
                            </div>
                        </div>
                        <div class="mentor-strip">
                            <span><b>Institute of Cosmetology &amp; Dental Sciences</b></span>
                            <span>•</span>
                            <span><%= lc.heroMediaCaption || '100% Verified Clinical Curriculum' %></span>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Stats Bar -->
            <div class="wrap stats rv">
                <div class="stat">
                    <strong><%= courseStats.publishedLessonCount %></strong>
                    <span>video lessons</span>
                </div>
                <div class="stat">
                    <strong><%= courseStats.publishedModuleCount %></strong>
                    <span>structured modules</span>
                </div>
                <div class="stat">
                    <strong><%= courseStats.publishedTopicCount %></strong>
                    <span>clinical topics</span>
                </div>
                <div class="stat">
                    <strong><%= freeCourse ? 'Free' : (course.currency === 'INR' ? '₹' : course.currency + ' ') + effectivePrice.toLocaleString('en-IN') %></strong>
                    <span><%= lc.priceSubtitle || 'Full Access' %></span>
                </div>
            </div>
        </section>

        <!-- Course Fundamentals / Context Card -->
        <% if (lc.aboutEnabled !== false && (lc.aboutBody || course.description)) { %>
            <section class="seo-intro" aria-labelledby="course-fundamentals-heading">
                <div class="wrap">
                    <div class="context-card rv">
                        <span class="eyebrow"><%= lc.aboutEyebrow || (course.category ? course.category.name : 'Clinical Fundamentals') %></span>
                        <h2 id="course-fundamentals-heading"><%= lc.aboutHeading || 'About This Masterclass' %></h2>
                        <div style="margin-top:14px; font-size:16px; line-height:1.8; color:var(--muted); white-space:pre-line;">
                            <%= lc.aboutBody || course.description %>
                        </div>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- Learning Outcomes / Takeaways -->
        <% if (lc.takeawaysEnabled !== false && takeawaysList.length > 0) { %>
            <section>
                <div class="wrap">
                    <div class="section-head rv">
                        <span class="eyebrow"><%= lc.takeawaysEyebrow || 'Masterclass Learning Outcomes' %></span>
                        <h2><%= lc.takeawaysHeading || 'What clinicians will learn in this master class' %></h2>
                        <% if (lc.takeawaysDescription) { %>
                            <p><%= lc.takeawaysDescription %></p>
                        <% } %>
                    </div>
                    <div class="grid2">
                        <% takeawaysList.forEach(function(item, idx) { %>
                            <div class="card takeaway rv <%= idx % 2 === 1 ? 'd1' : '' %>">
                                <div class="ico"><%= item.icon || String(idx + 1).padStart(2, '0') %></div>
                                <div>
                                    <h3><%= item.title %></h3>
                                    <p><%= item.description %></p>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- Sneak Peek Dark Band (Strictly requires enabled=true) -->
        <% if (lc.sneakPeekEnabled === true && (lc.sneakPeekMediaUrl || lc.sneakPeekHeading || lc.sneakPeekDescription)) { %>
            <section class="sneak">
                <div class="wrap">
                    <div class="section-head rv">
                        <span class="eyebrow"><%= lc.sneakPeekEyebrow || 'A Sneak Peek' %></span>
                        <h2><%= lc.sneakPeekHeading || 'See the learning experience before you enroll' %></h2>
                        <% if (lc.sneakPeekDescription) { %>
                            <p><%= lc.sneakPeekDescription %></p>
                        <% } %>
                    </div>
                    <div class="youtube-shell rv">
                        <div class="youtube-lite" id="yt-preview">
                            <img src="<%= lc.sneakPeekMediaUrl || course.thumbnailUrl || cms.brand.defaultCourseImageUrl || '/assets/images/course-placeholder.svg' %>"
                                 alt="<%= course.title %> preview"
                                 loading="lazy">
                            <a href="<%= lc.sneakPeekMediaUrl || '#curriculum' %>" class="play" aria-label="Explore lessons">▶</a>
                        </div>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- Clinical Questions Section -->
        <% if (lc.questionsEnabled !== false && questionsList.length > 0) { %>
            <section>
                <div class="wrap">
                    <div class="section-head rv">
                        <span class="eyebrow"><%= lc.questionsEyebrow || 'Clinical Fundamentals' %></span>
                        <h2><%= lc.questionsHeading || 'Core clinical questions this masterclass helps you answer' %></h2>
                    </div>
                    <div class="question-grid">
                        <% questionsList.forEach(function(q, qIdx) { %>
                            <div class="qcard rv <%= qIdx % 2 === 1 ? 'd1' : '' %>">
                                <div class="qnum"><%= String(qIdx + 1).padStart(2, '0') %></div>
                                <%= q.question %>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- Curriculum Section -->
        <% if (lc.curriculumEnabled !== false) { %>
            <section id="curriculum" class="curriculum">
                <div class="wrap">
                    <div class="section-head rv">
                        <span class="eyebrow"><%= lc.curriculumEyebrow || cd.curriculumHeading || 'Course Curriculum' %></span>
                        <h2><%= lc.curriculumHeading || (courseStats.publishedModuleCount + ' structured modules for dentists') %></h2>
                        <% if (lc.curriculumIntro) { %>
                            <p><%= lc.curriculumIntro %></p>
                        <% } %>
                    </div>

                    <% if (safeCurriculum.length === 0 && (!course.lessons || course.lessons.length === 0)) { %>
                        <p class="text-muted"><%= cd.emptyLessons || 'No lessons published yet.' %></p>
                    <% } else { %>
                        <div class="modules-container">
                            <% safeCurriculum.forEach(function(mod, modIdx) { 
                                const modLessons = (mod.topics || []).reduce((acc, t) => acc.concat((t.lessons || []).filter(l => l.status === 'PUBLISHED')), []);
                                const modTopics = (mod.topics || []).filter(t => (t.lessons || []).some(l => l.status === 'PUBLISHED') || (t.resources || []).length > 0);
                                if (modLessons.length === 0 && modTopics.length === 0) return;
                                const isDefaultOpen = (lc.curriculumDefaultExpanded !== false) && modIdx === 0;
                            %>
                                <div class="module-card rv <%= isDefaultOpen ? 'is-open' : '' %>" id="mod-card-<%= mod.id %>">
                                    <button type="button" class="module-header-btn" data-toggle-module="<%= mod.id %>" aria-expanded="<%= isDefaultOpen ? 'true' : 'false' %>">
                                        <div class="module-header-left">
                                            <span class="module-pill">Module <%= modIdx + 1 %></span>
                                            <span class="module-title"><%= mod.title %></span>
                                        </div>
                                        <div class="module-header-right">
                                            <span class="module-meta">
                                                <%= modTopics.length %> Topic<%= modTopics.length === 1 ? '' : 's' %> &bull; <%= modLessons.length %> Video<%= modLessons.length === 1 ? '' : 's' %>
                                            </span>
                                            <span class="module-chevron">⌄</span>
                                        </div>
                                    </button>
                                    <div class="module-body" id="mod-body-<%= mod.id %>">
                                        <% if (mod.description) { %>
                                            <div class="module-desc"><%= mod.description %></div>
                                        <% } %>

                                        <% modTopics.forEach(function(topic, topicIdx) { 
                                            const topicPubLessons = (topic.lessons || []).filter(l => l.status === 'PUBLISHED');
                                        %>
                                            <div class="topic-box">
                                                <div class="topic-box-header">
                                                    <div>
                                                        <i class="bi bi-folder2-open me-2" style="color:#5d3fd3;"></i>Topic <%= topicIdx + 1 %>: <%= topic.title %>
                                                    </div>
                                                    <span class="lesson-badge">
                                                        <%= topicPubLessons.length %> Video<%= topicPubLessons.length === 1 ? '' : 's' %>
                                                    </span>
                                                </div>
                                                <ul class="lesson-list">
                                                    <% topicPubLessons.forEach(function(lesson) { %>
                                                        <li class="lesson-row">
                                                            <div class="lesson-title-area">
                                                                <span class="lesson-ico"><i class="bi bi-play-circle-fill"></i></span>
                                                                <span class="lesson-title"><%= lesson.title %></span>
                                                                <% if (lc.showPreviewBadge !== false && lesson.preview) { %>
                                                                    <span class="lesson-badge">Free Preview</span>
                                                                <% } %>
                                                            </div>
                                                            <div class="lesson-right">
                                                                <% if (lc.showLessonDuration !== false && lesson.duration) { %>
                                                                    <span class="lesson-dur"><%= lesson.duration %></span>
                                                                <% } %>
                                                                <% if (lesson.preview) { %>
                                                                    <a href="/learn/<%= course.slug %>/<%= lesson.slug %>" class="btn btn-sm btn-secondary" style="min-height:36px; padding:6px 16px; font-size:12.5px;">
                                                                        Watch Preview
                                                                    </a>
                                                                <% } else if (userIsEnrolled) { %>
                                                                    <a href="/learn/<%= course.slug %>/<%= lesson.slug %>" class="btn btn-sm btn-secondary" style="min-height:36px; padding:6px 16px; font-size:12.5px; color:#1d9168 !important;">
                                                                        Watch
                                                                    </a>
                                                                <% } else if (lc.showLockIcon !== false) { %>
                                                                    <span class="lesson-lock" title="Enroll to unlock this lesson">
                                                                        <i class="bi bi-lock-fill"></i>
                                                                    </span>
                                                                <% } %>
                                                            </div>
                                                        </li>
                                                    <% }); %>
                                                </ul>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </section>
        <% } %>

        <!-- Certificate Section (Critical: OFF by default, rendered ONLY if certificateSectionEnabled === true) -->
        <% if (lc.certificateSectionEnabled === true) { %>
            <section>
                <div class="wrap certificate">
                    <div class="certificate-img rv">
                        <div class="certificate-mockup">
                            <div class="certificate-mockup-title">Institute of Cosmetology &amp; Dental Sciences</div>
                            <div class="certificate-mockup-certifies">Certificate of Clinical Masterclass Completion</div>
                            <div class="certificate-mockup-course"><%= course.title %></div>
                            <div class="certificate-mockup-footer">
                                Official Verifiable Clinical Credential &bull; ICDS Academic Board
                            </div>
                        </div>
                    </div>
                    <div class="certificate-copy rv d1">
                        <span class="eyebrow"><%= lc.certificateEyebrow || 'E-Certificate' %></span>
                        <h2><%= lc.certificateHeading || ('Recognize your progress in ' + course.title) %></h2>
                        <p><%= lc.certificateBody || 'Upon completion of all video lessons and clinical evaluations, you will receive an official verifiable digital Certificate of Completion recognizing your mastery and commitment to advancing clinical patient care.' %></p>
                        <% if (lc.certificateNote) { %>
                            <p class="certificate-note"><%= lc.certificateNote %></p>
                        <% } %>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- Candidate Profile / Audience Section -->
        <% const hasAudience = (lc.audienceEnabled !== false) && (audienceForList.length > 0 || audienceNotForList.length > 0 || (typeof cd !== 'undefined' && cd && (cd.benefit1 || cd.benefit2 || cd.benefit3))); %>
        <% if (hasAudience) { %>
            <section class="audience">
                <div class="wrap">
                    <div class="section-head rv">
                        <span class="eyebrow"><%= lc.audienceEyebrow || 'Candidate Profile' %></span>
                        <h2><%= lc.audienceHeading || 'Is this online Master Class right for you?' %></h2>
                    </div>
                    <div class="grid2">
                        <% if (audienceForList.length > 0) { %>
                            <div class="card yes rv">
                                <h3><%= lc.audienceForHeading || 'Good fit for' %></h3>
                                <ul class="checklist">
                                    <% audienceForList.forEach(function(item) { %>
                                        <li><%= item.title %></li>
                                    <% }); %>
                                </ul>
                            </div>
                        <% } else if (typeof cd !== 'undefined' && cd && (cd.benefit1 || cd.benefit2 || cd.benefit3)) { %>
                            <div class="card yes rv">
                                <h3><%= lc.audienceForHeading || 'Good fit for' %></h3>
                                <ul class="checklist">
                                    <% if (cd.benefit1) { %><li><%= cd.benefit1 %></li><% } %>
                                    <% if (cd.benefit2) { %><li><%= cd.benefit2 %></li><% } %>
                                    <% if (cd.benefit3) { %><li><%= cd.benefit3 %></li><% } %>
                                </ul>
                            </div>
                        <% } %>
                        <% if (audienceNotForList.length > 0) { %>
                            <div class="card no rv d1">
                                <h3><%= lc.audienceNotForHeading || 'Probably not for' %></h3>
                                <ul class="checklist">
                                    <% audienceNotForList.forEach(function(item) { %>
                                        <li><%= item.title %></li>
                                    <% }); %>
                                </ul>
                            </div>
                        <% } %>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- Clinical Resources Section -->
        <% if (safeResources.length > 0) { %>
            <section>
                <div class="wrap">
                    <div class="section-head rv">
                        <span class="eyebrow">Clinical Documentation</span>
                        <h2>Downloadable clinical <em>protocols &amp; tools</em></h2>
                        <p>Enrolled practitioners receive verified downloadable clinical protocols, evaluation forms, and documentation tools.</p>
                    </div>
                    <div>
                        <% safeResources.forEach(function(resItem) { %>
                            <div class="resource-card rv">
                                <div class="resource-info">
                                    <div class="resource-ico"><i class="bi bi-file-earmark-pdf-fill"></i></div>
                                    <div>
                                        <div class="resource-title"><%= resItem.title %></div>
                                        <div class="resource-meta">
                                            <%= resItem.contentType %> &bull;
                                            <%= resItem.sizeBytes ? (Number(resItem.sizeBytes) / (1024 * 1024)).toFixed(2) + ' MB' : 'Official Clinical Form' %>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <% if (userIsEnrolled) { %>
                                        <a href="/learn/<%= course.slug %>/resources/<%= resItem.id %>/download" class="btn btn-sm btn-secondary" style="min-height:42px; padding:8px 20px; font-size:13px; color:#1d9168 !important;">
                                            <i class="bi bi-download me-1"></i> Download
                                        </a>
                                    <% } else { %>
                                        <span class="lesson-badge" style="font-size:12px; padding:6px 14px;">
                                            <i class="bi bi-lock-fill me-1"></i> Included Free With Enrollment
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- Instructor Section (Shown ONLY if instructor exists) -->
        <% if (course.instructor) { %>
            <section id="mentor">
                <div class="wrap mentor">
                    <div class="mentor-frame rv">
                        <img src="<%= course.instructor.photoUrl || cms.brand.defaultInstructorImageUrl || '/assets/images/instructor-placeholder.svg' %>"
                             alt="<%= course.instructor.name %>"
                             loading="lazy"
                             data-fallback-src="/assets/images/instructor-placeholder.svg">
                    </div>
                    <div class="rv d1">
                        <span class="eyebrow"><%= cd.instructorHeading || 'Course Instructor' %></span>
                        <h2><%= course.instructor.name %></h2>
                        <% if (course.instructor.title) { %>
                            <p style="font-weight:700; color:#5d3fd3; margin-top:8px;"><%= course.instructor.title %></p>
                        <% } %>
                        <p><%= course.instructor.bio || '' %></p>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- FAQ Section -->
        <% if (lc.faqEnabled !== false && courseFaqsList.length > 0) { %>
            <section>
                <div class="wrap">
                    <div class="section-head rv">
                        <span class="eyebrow"><%= lc.faqEyebrow || 'Questions & Answers' %></span>
                        <h2><%= lc.faqHeading || 'Frequently asked course questions' %></h2>
                    </div>
                    <div class="faq">
                        <% courseFaqsList.forEach(function(faq, faqIdx) { %>
                            <details class="rv" <%= faqIdx === 0 ? 'open' : '' %>>
                                <summary><%= faq.question %><span class="pm">+</span></summary>
                                <div class="faq-a">
                                    <p><%= faq.answer %></p>
                                </div>
                            </details>
                        <% }); %>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- Final CTA Banner -->
        <% if (lc.finalCtaEnabled !== false) { %>
            <section>
                <div class="wrap">
                    <div class="final-card rv">
                        <span class="eyebrow"><%= lc.finalCtaEyebrow || 'Start Learning Today' %></span>
                        <h2 style="margin-top:16px;"><%= lc.finalCtaHeading || ('Enroll in ' + course.title) %></h2>
                        <% if (lc.finalCtaBody) { %>
                            <p style="max-width:700px; margin:16px auto 0; font-size:17px;"><%= lc.finalCtaBody %></p>
                        <% } %>
                        <div class="price-row">
                            <div>
                                <div class="from"><%= lc.priceSubtitle || 'Full Access' %></div>
                                <div class="price"><%= freeCourse ? 'Free' : formattedPriceLabel %></div>
                            </div>
                        </div>
                        <div class="actions">
                            <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'STUDENT') { %>
                                <% if (userIsEnrolled) { %>
                                    <a class="btn btn-primary" href="/learn/<%= course.slug %>">Continue Learning →</a>
                                <% } else if (freeCourse) { %>
                                    <form method="POST" action="/courses/<%= course.slug %>/enroll-free" class="m-0">
                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                        <button type="submit" class="btn btn-primary"><%= lc.finalCtaButtonLabel || cd.freeCta || 'Enroll Free →' %></button>
                                    </form>
                                <% } else if (typeof paymentsEnabled !== 'undefined' && paymentsEnabled) { %>
                                    <a class="btn btn-primary" href="/checkout/<%= course.slug %>"><%= lc.finalCtaButtonLabel || ('Buy Course – ' + formattedPriceLabel) %></a>
                                <% } %>
                            <% } else { %>
                                <a class="btn btn-primary" href="/login?returnTo=<%= encodeURIComponent('/courses/' + course.slug) %>">
                                    <%= freeCourse ? (lc.finalCtaButtonLabel || cd.loginFreeCta || 'Enroll Free →') : (lc.finalCtaButtonLabel || ('Enroll Now – ' + formattedPriceLabel)) %>
                                </a>
                            <% } %>
                        </div>
                        <% if (lc.finalCtaBadgeText) { %>
                            <div>
                                <span class="plan-badge"><%= lc.finalCtaBadgeText %></span>
                            </div>
                        <% } %>
                    </div>
                </div>
            </section>
        <% } %>
    </main>

    <!-- Floating Sticky Bottom CTA Bar -->
    <% if (lc.stickyCtaEnabled !== false) { %>
        <div class="floating" id="course-floating-bar">
            <div class="floating-inner">
                <div class="floating-copy">
                    <strong><%= course.title %></strong>
                    <span><% if (lc.stickyCtaText) { %><%= lc.stickyCtaText %> &bull; <% } %><%= freeCourse ? 'Free' : formattedPriceLabel %></span>
                </div>
                <div>
                    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'STUDENT') { %>
                        <% if (userIsEnrolled) { %>
                            <a class="btn btn-primary" href="/learn/<%= course.slug %>">Continue Learning →</a>
                        <% } else if (freeCourse) { %>
                            <form method="POST" action="/courses/<%= course.slug %>/enroll-free" class="m-0">
                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                <button type="submit" class="btn btn-primary"><%= lc.stickyCtaButtonLabel || cd.freeCta || 'Enroll Free →' %></button>
                            </form>
                        <% } else if (typeof paymentsEnabled !== 'undefined' && paymentsEnabled) { %>
                            <a class="btn btn-primary" href="/checkout/<%= course.slug %>"><%= lc.stickyCtaButtonLabel || ('Buy Course – ' + formattedPriceLabel) %></a>
                        <% } %>
                    <% } else { %>
                        <a class="btn btn-primary" href="/login?returnTo=<%= encodeURIComponent('/courses/' + course.slug) %>">
                            <%= freeCourse ? (lc.stickyCtaButtonLabel || cd.loginFreeCta || 'Enroll Free →') : (lc.stickyCtaButtonLabel || ('Enroll Now – ' + formattedPriceLabel)) %>
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    <% } %>
</div>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
document.addEventListener('DOMContentLoaded', function() {
    var page = document.querySelector('.course-landing-page');
    if (page && 'IntersectionObserver' in window) {
        page.classList.add('has-io');
        var io = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    e.target.classList.add('in');
                    io.unobserve(e.target);
                }
            });
        }, { threshold: 0.05, rootMargin: '0px 0px 40px 0px' });

        document.querySelectorAll('.course-landing-page .rv').forEach(function(el) {
            io.observe(el);
        });
    }

    // Accordion toggle delegation
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-toggle-module]');
        if (btn) {
            var modId = btn.getAttribute('data-toggle-module');
            var card = document.getElementById('mod-card-' + modId);
            if (card) {
                var isOpen = card.classList.toggle('is-open');
                btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            }
        }
    });

    // Floating sticky bottom bar visibility on scroll
    var floatingBar = document.getElementById('course-floating-bar');
    var hero = document.querySelector('.hero');
    if (floatingBar && hero) {
        var checkScroll = function() {
            var rect = hero.getBoundingClientRect();
            if (rect.bottom < 120) {
                floatingBar.classList.add('is-visible');
            } else {
                floatingBar.classList.remove('is-visible');
            }
        };
        window.addEventListener('scroll', checkScroll, { passive: true });
        checkScroll();
    }
});
</script>
