<%
const cd = cms.course;
// Prices come from ONE server-side helper (src/lib/pricing.js getEffectiveCoursePrice);
// the controller passes the result as `coursePricing`. Nothing here recalculates sales.
const cp = (typeof coursePricing !== 'undefined' && coursePricing)
    ? coursePricing
    : (typeof coursePriceOf === 'function' ? coursePriceOf(course) : { currency: course.currency || 'INR', regular: Number(course.price) || 0, effective: Number(course.price) || 0, regularLabel: '', effectiveLabel: '', isFree: Number(course.price) === 0, onSale: false, discountPercent: 0, badgeLabel: '', saleEndsAt: null });
const fmtMoney = (n) => ((cp.currency === 'INR' ? '₹' : cp.currency + ' ') + Number(n).toLocaleString('en-IN'));
const effectivePrice = cp.effective;
// Star display from a REAL rating (never a hardcoded value).
const starIcons = (value) => {
    const v = Math.round(Number(value) * 2) / 2;
    let out = '';
    for (let i = 1; i <= 5; i++) out += (i <= v) ? '<i class="bi bi-star-fill"></i>' : ((i - 0.5 === v) ? '<i class="bi bi-star-half"></i>' : '<i class="bi bi-star"></i>');
    return out;
};
const ratingSummary = (typeof landing !== 'undefined' && landing && landing.ratingSummary && landing.ratingSummary.count > 0) ? landing.ratingSummary : null;
const freeCourse = typeof isFree !== 'undefined' ? isFree : cp.isFree;
const formattedPriceLabel = typeof priceLabel !== 'undefined' ? priceLabel : fmtMoney(cp.effective);
const courseStats = typeof stats !== 'undefined' && stats ? stats : {
    moduleCount: (typeof curriculum !== 'undefined' && Array.isArray(curriculum) ? curriculum.length : 0),
    publishedModuleCount: (typeof curriculum !== 'undefined' && Array.isArray(curriculum) ? curriculum.length : 0),
    topicCount: 0,
    publishedTopicCount: 0,
    lessonCount: (course.lessons ? course.lessons.length : 0),
    publishedLessonCount: (course.lessons ? course.lessons.filter(l => l.status === 'PUBLISHED').length : (course.lessons ? course.lessons.length : 0)),
    videoCount: (course.lessons ? course.lessons.filter(l => l.videoStorageKey || l.videoPath || l.videoType === 'R2').length : 0),
    totalDurationSeconds: 0,
    totalDurationFormatted: course.duration || 'Self-Paced',
    resourceCount: (typeof resources !== 'undefined' && Array.isArray(resources) ? resources.length : 0),
};
const safeCurriculum = typeof curriculum !== 'undefined' && Array.isArray(curriculum) ? curriculum : [];
const safeResources = typeof resources !== 'undefined' && Array.isArray(resources) ? resources : [];
const userIsEnrolled = typeof isEnrolled !== 'undefined' && isEnrolled;
const hasPending = typeof hasPendingRequest !== 'undefined' && hasPendingRequest;

// Landing CMS dynamic content
const lc = (typeof landing !== 'undefined' && landing && landing.content) ? landing.content : {};
const heroChipsList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.heroChips)) ? landing.heroChips : [];
const quickStatsList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.stats)) ? landing.stats : [];
const takeawaysList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.takeaways)) ? landing.takeaways : [];
const questionsList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.questions)) ? landing.questions : [];
const audienceForList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.audienceFor)) ? landing.audienceFor : [];
const audienceNotForList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.audienceNotFor)) ? landing.audienceNotFor : [];
const courseFaqsList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.faqs)) ? landing.faqs : (typeof faqs !== 'undefined' && Array.isArray(faqs) ? faqs : []);
const whyRegisterWantList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.whyRegisterWant)) ? landing.whyRegisterWant : [];
const whyRegisterGetList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.whyRegisterGet)) ? landing.whyRegisterGet : [];
const highlightsList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.highlights)) ? landing.highlights : [];
const inPreviewMode = Boolean((typeof isPreview !== 'undefined' && isPreview) || (typeof isPreviewMode !== 'undefined' && isPreviewMode));
const rawTestimonialsList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.testimonials)) ? landing.testimonials : [];
const demoShowcase = Boolean(typeof landing !== 'undefined' && landing && landing.demoShowcase === true);
const testimonialsList = (inPreviewMode || demoShowcase) ? rawTestimonialsList : rawTestimonialsList.filter(t => !t.isDemo);
const accessPlansList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.accessPlans)) ? landing.accessPlans : [];
const comparisonColumnsList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.comparisonColumns)) ? landing.comparisonColumns : [];
const accessStepsList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.accessSteps)) ? landing.accessSteps : [];

// Ordered dynamic section keys
const orderedSectionKeys = (typeof landing !== 'undefined' && landing && Array.isArray(landing.landingSections) && landing.landingSections.length > 0)
    ? landing.landingSections
    : [
        'HERO',
        'STATS',
        'QUESTIONS',
        'WHY_REGISTER',
        'CURRICULUM',
        'HIGHLIGHTS',
        'PURCHASE',
        'COMPARISON',
        'AUDIENCE',
        'ACCESS',
        'RESOURCES',
        'MENTOR',
        'REVIEWS',
        'FAQ',
        'SOCIAL_PROOF',
        'FINAL_CTA',
    ];

// Single render path: dedupe keys; companion blocks (takeaways, certificate) render exactly once.
const renderList = (typeof landing !== 'undefined' && landing && Array.isArray(landing.renderList) && landing.renderList.length > 0)
    ? Array.from(new Set(landing.renderList))
    : (function () {
        const uniq = Array.from(new Set(orderedSectionKeys));
        [['TAKEAWAYS', ['QUESTIONS', 'WHY_REGISTER']], ['CERTIFICATE', ['RESOURCES', 'CURRICULUM']]].forEach(function (c) {
            if (uniq.indexOf(c[0]) !== -1) return;
            const a = c[1].find(function (k) { return uniq.indexOf(k) !== -1; });
            if (a) uniq.splice(uniq.indexOf(a) + 1, 0, c[0]);
        });
        return Array.from(new Set(uniq));
    })();

// Default access plan or price subtitle label
const defaultAccessPlan = accessPlansList.find(p => p.isDefault) || accessPlansList[0];
const effectiveAccessSubtitle = defaultAccessPlan ? defaultAccessPlan.label : (lc.accessLabel || (typeof cd !== 'undefined' && cd.benefit1) || '');
%>
<% if (typeof cd !== 'undefined' && cd.benefit1) { %>
    <span class="d-none"><%= cd.benefit1 %></span>
<% } %>
<link rel="stylesheet" href="/css/course-landing.css">
<% if (typeof courseTheme !== 'undefined' && courseTheme && courseTheme.fontsUrl) { %><link rel="stylesheet" href="<%= courseTheme.fontsUrl %>"><% } %>

<% if (typeof isPreview !== 'undefined' && isPreview) { %>
    <!-- Admin Preview Notification Bar -->
    <aside class="admin-preview-bar" aria-label="Admin Preview Mode Banner">
        <div class="wrap preview-bar-inner">
            <div>
                <i class="bi bi-eye-fill me-2" aria-hidden="true"></i>
                <strong>Admin Preview Mode</strong> &mdash; Viewing dynamic landing page for "<strong><%= course.title %></strong>"
                <span class="badge bg-secondary ms-2" style="font-size:11px;"><%= course.status %></span>
            </div>
            <a href="/admin/courses/<%= course.id %>/landing-page" class="btn-preview-back">
                <i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Back to CMS Editor
            </a>
        </div>
    </aside>
<% } %>

<div class="course-landing-page fmr-reference-theme"<% if (typeof courseTheme !== 'undefined' && courseTheme) { %> style="<%= courseTheme.styleAttr %>"<% } %>>
    <main>
        <div class="course-top-header">
            <% if (cd.backLabel) { %>
                <div class="wrap course-back-wrap">
                    <a href="/courses" class="course-back-link">
                        <i class="bi bi-arrow-left"></i> <%= cd.backLabel %>
                    </a>
                </div>
            <% } %>

            <!-- Semantic Breadcrumb -->
            <nav class="breadcrumb" aria-label="Breadcrumb">
                <div class="wrap">
                    <ol>
                        <li><a href="/">Home</a></li>
                        <li><a href="/courses">Courses</a></li>
                        <% if (course.category) { %>
                            <li><a href="/courses?category=<%= course.category.slug %>"><%= course.category.name %></a></li>
                        <% } %>
                        <li aria-current="page"><%= course.title %></li>
                    </ol>
                </div>
            </nav>
        </div>

        <!-- DYNAMIC SECTIONS LOOP (Strict Order from CMS) -->
        <% for (const sectionKey of renderList) { %>

            <!-- ======================================================== -->
            <!-- 01. HERO SECTION (Dominant Navy & 2-Column Desktop Grid) -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'HERO' && lc.heroEnabled !== false) { %>
                <section class="hero" id="hero">
                    <div class="wrap">
                        <div class="hero-grid">
                            <!-- Left Column: Content, Features, Pricing, CTAs -->
                            <div class="hero-col-left">
                                <% if (lc.heroEyebrow) { %>
                                    <div class="hero-eyebrow">
                                        <span class="dot"></span>
                                        <span><%= lc.heroEyebrow %></span>
                                    </div>
                                <% } %>

                                <h1>
                                    <% 
                                        const displayTitle = lc.heroTitleOverride || course.title || '';
                                        if (lc.heroAccentText) {
                                            const accent = lc.heroAccentText;
                                            const lowerTitle = displayTitle.toLowerCase();
                                            const lowerAccent = accent.toLowerCase();
                                            const idx = lowerTitle.indexOf(lowerAccent);
                                            if (idx !== -1) {
                                                const before = displayTitle.slice(0, idx);
                                                const matched = displayTitle.slice(idx, idx + accent.length);
                                                const after = displayTitle.slice(idx + accent.length);
                                    %>
                                                <%= before %><em><%= matched %></em><%= after %>
                                    <%
                                            } else {
                                    %>
                                                <%= displayTitle %> <em><%= accent %></em>
                                    <%
                                            }
                                        } else {
                                    %>
                                            <%= displayTitle %>
                                    <% } %>
                                </h1>

                                <% const heroSub = lc.heroMediaCaption || ''; %>
                                <% if (heroSub) { %>
                                    <div class="hero-subtitle"><%= heroSub %></div>
                                <% } %>

                                <% const heroDesc = lc.heroDescription || course.shortDescription || course.description || ''; %>
                                <% if (heroDesc) { %>
                                    <p class="hero-desc"><%= heroDesc %></p>
                                <% } %>

                                <!-- Rating Row: genuine, published, non-demo reviews of THIS course only; hidden when none exist -->
                                <% if (ratingSummary) { %>
                                    <div class="hero-rating-row" role="img" aria-label="Rated <%= ratingSummary.average.toFixed(1) %> out of 5, based on <%= ratingSummary.count %> review<%= ratingSummary.count === 1 ? '' : 's' %>">
                                        <span class="stars" aria-hidden="true"><%- starIcons(ratingSummary.average) %></span>
                                        <span class="rating-text" aria-hidden="true"><strong><%= ratingSummary.average.toFixed(1) %></strong> &bull; Based on <%= ratingSummary.count %> review<%= ratingSummary.count === 1 ? '' : 's' %></span>
                                    </div>
                                <% } %>

                                <!-- 2-Column Feature Checkmark Pills -->
                                <div class="hero-features-grid">
                                    <% if (heroChipsList.length > 0) { %>
                                        <% heroChipsList.forEach(function(chip) { %>
                                            <div class="hero-feature-pill">
                                                <span class="check-ico"><i class="bi bi-check-lg"></i></span>
                                                <span><%= chip.label %></span>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <div class="hero-feature-pill">
                                            <span class="check-ico"><i class="bi bi-check-lg"></i></span>
                                            <span><%= courseStats.publishedLessonCount %> video sessions</span>
                                        </div>
                                        <div class="hero-feature-pill">
                                            <span class="check-ico"><i class="bi bi-check-lg"></i></span>
                                            <span><%= courseStats.totalDurationFormatted %> of content</span>
                                        </div>
                                        <div class="hero-feature-pill">
                                            <span class="check-ico"><i class="bi bi-check-lg"></i></span>
                                            <span><%= lc.accessLabel || (freeCourse ? 'Self-Paced Learning' : 'Full Course Access') %></span>
                                        </div>
                                        <div class="hero-feature-pill">
                                            <span class="check-ico"><i class="bi bi-check-lg"></i></span>
                                            <span><%= courseStats.resourceCount > 0 ? (courseStats.resourceCount + ' Downloadable ' + (courseStats.resourceCount === 1 ? 'Form' : 'Forms')) : 'Special Notes & Forms' %></span>
                                        </div>
                                        <div class="hero-feature-pill">
                                            <span class="check-ico"><i class="bi bi-check-lg"></i></span>
                                            <span>Instant access on enrollment</span>
                                        </div>
                                        <div class="hero-feature-pill">
                                            <span class="check-ico"><i class="bi bi-check-lg"></i></span>
                                            <span><%= lc.certificateSectionEnabled ? 'Certificate included' : (courseStats.publishedModuleCount + ' Structured Modules') %></span>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Pricing & Access Row -->
                                <div class="hero-price-row">
                                    <% if (cp.onSale && !freeCourse) { %>
                                        <span class="hero-price-old" aria-label="Regular price <%= fmtMoney(cp.regular) %>"><del><%= fmtMoney(cp.regular) %></del></span>
                                    <% } %>
                                    <span class="hero-price-val"><%= freeCourse ? 'Free' : formattedPriceLabel %></span>
                                    <% if (cp.onSale && !freeCourse) { %>
                                        <span class="hero-sale-badge"><%= cp.badgeLabel %></span>
                                    <% } else if (freeCourse) { %>
                                        <span class="hero-sale-badge">100% FREE</span>
                                    <% } %>
                                    <% if (effectiveAccessSubtitle) { %>
                                        <span class="hero-access-label"><%= effectiveAccessSubtitle %></span>
                                    <% } %>
                                </div>

                                <!-- Action Buttons -->
                                <div class="hero-actions">
                                    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'STUDENT') { %>
                                        <% if (userIsEnrolled) { %>
                                            <a class="btn btn-primary" href="/learn/<%= course.slug %>">
                                                <span>Continue Learning &rarr;</span>
                                                <% if (effectiveAccessSubtitle) { %><span class="btn-sublabel"><%= effectiveAccessSubtitle %></span><% } %>
                                            </a>
                                        <% } else if (freeCourse) { %>
                                            <form method="POST" action="/courses/<%= course.slug %>/enroll-free" class="m-0 d-inline-block">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <button type="submit" class="btn btn-primary">
                                                    <span><%= lc.heroPrimaryCtaLabel || cd.freeCta || 'Enroll Free' %> &rarr;</span>
                                                    <% if (effectiveAccessSubtitle) { %><span class="btn-sublabel"><%= effectiveAccessSubtitle %></span><% } %>
                                                </button>
                                            </form>
                                        <% } else if (typeof paymentsEnabled !== 'undefined' && paymentsEnabled) { %>
                                            <a class="btn btn-primary" href="/checkout/<%= course.slug %>">
                                                <span><%= lc.heroPrimaryCtaLabel || ('Buy Course – ' + formattedPriceLabel) %> &rarr;</span>
                                                <% if (effectiveAccessSubtitle) { %><span class="btn-sublabel"><%= effectiveAccessSubtitle %></span><% } %>
                                            </a>
                                        <% } else if (hasPending) { %>
                                            <button class="btn btn-secondary" disabled><%= cd.requestedLabel || 'Request Pending' %></button>
                                        <% } else { %>
                                            <form method="POST" action="/courses/<%= course.slug %>/request-enrollment" class="m-0 d-inline-block">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <button type="submit" class="btn btn-primary">
                                                    <span><%= cd.requestCta || 'Request Enrollment' %> &rarr;</span>
                                                    <% if (effectiveAccessSubtitle) { %><span class="btn-sublabel"><%= effectiveAccessSubtitle %></span><% } %>
                                                </button>
                                            </form>
                                        <% } %>
                                    <% } else if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'ADMIN') { %>
                                        <a class="btn btn-primary" href="/learn/<%= course.slug %>">
                                            <span>View as Admin &rarr;</span>
                                            <% if (effectiveAccessSubtitle) { %><span class="btn-sublabel"><%= effectiveAccessSubtitle %></span><% } %>
                                        </a>
                                    <% } else { %>
                                        <a class="btn btn-primary" href="/login?returnTo=<%= encodeURIComponent('/courses/' + course.slug) %>">
                                            <span><%= freeCourse ? (lc.heroPrimaryCtaLabel || cd.loginFreeCta || 'Enroll Free') : ((typeof paymentsEnabled !== 'undefined' && paymentsEnabled) ? (lc.heroPrimaryCtaLabel || ('Buy Course – ' + formattedPriceLabel)) : (cd.loginRequestCta || 'Sign In to Access')) %> &rarr;</span>
                                            <% if (effectiveAccessSubtitle) { %><span class="btn-sublabel"><%= effectiveAccessSubtitle %></span><% } %>
                                        </a>
                                    <% } %>

                                    <% if (lc.secondaryCtaLabel) { %>
                                        <a class="btn btn-secondary" href="<%= lc.secondaryCtaTarget || '#curriculum' %>">
                                            <i class="bi bi-play-circle-fill"></i>
                                            <span><%= lc.secondaryCtaLabel %></span>
                                        </a>
                                    <% } %>
                                </div>

                                <div class="hero-trust-line">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>Secure enrollment &bull; Official ICDS Dental Academy platform</span>
                                </div>
                            </div>

                            <!-- Right Column: Video Preview Card with Floating Chips -->
                            <div class="hero-col-right">
                                <div class="hero-media-card">
                                    <!-- Top-Left Floating Badge -->
                                    <div class="hero-chip-top">
                                        <i class="bi bi-clock-fill"></i>
                                        <span><%= effectiveAccessSubtitle || (freeCourse ? 'Self-Paced Access' : '365-day access') %></span>
                                    </div>

                                    <!-- Bottom-Right Floating Badge -->
                                    <div class="hero-chip-bottom">
                                        <i class="bi bi-award-fill"></i>
                                        <span><%= courseStats.resourceCount > 0 ? (courseStats.resourceCount + ' Handout Included') : 'Official ICDS Curriculum' %></span>
                                    </div>

                                    <!-- Media Container -->
                                    <div class="hero-media-wrapper">
                                        <% if (lc.heroMediaType === 'VIDEO' && lc.heroMediaUrl) { %>
                                            <iframe src="<%= lc.heroMediaUrl %>" title="Course Preview" allowfullscreen></iframe>
                                        <% } else if (course.imageUrl) { %>
                                            <img src="<%= course.imageUrl %>" alt="<%= course.title %>" loading="lazy">
                                        <% } else { %>
                                            <img src="/assets/images/course-placeholder.svg" alt="<%= course.title %>" loading="lazy">
                                        <% } %>
                                    </div>

                                    <!-- Bottom Caption Bar -->
                                    <div class="hero-media-footer">
                                        <span class="caption-title"><%= lc.heroMediaCaption || 'Course introduction' %></span>
                                        <span class="mentor-label"><%= (course.instructor && course.instructor.name) ? course.instructor.name : 'Dr. Tanu Raghav' %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 02. QUICK STATS BAND (Overlapping Hero, Reference Card)  -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'STATS') { 
                const hasStats = quickStatsList.length > 0;
            %>
                <section class="quick-stats-section" id="course-stats">
                    <div class="wrap">
                        <div class="quick-stats-card-container">
                            <div class="quick-stats-grid">
                                <% if (hasStats) { %>
                                    <% quickStatsList.forEach(function(stat) { %>
                                        <div class="quick-stat-col">
                                            <div class="quick-stat-val"><%= stat.displayValue || stat.value %></div>
                                            <div class="quick-stat-lbl"><%= stat.label %></div>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <div class="quick-stat-col">
                                        <div class="quick-stat-val"><%= courseStats.publishedLessonCount %></div>
                                        <div class="quick-stat-lbl">Sessions</div>
                                    </div>
                                    <div class="quick-stat-col">
                                        <div class="quick-stat-val"><%= courseStats.totalDurationFormatted %></div>
                                        <div class="quick-stat-lbl">Total Content</div>
                                    </div>
                                    <div class="quick-stat-col">
                                        <div class="quick-stat-val"><%= courseStats.resourceCount > 0 ? (courseStats.resourceCount + ' Handout' + (courseStats.resourceCount === 1 ? '' : 's')) : (courseStats.publishedModuleCount + ' Modules') %></div>
                                        <div class="quick-stat-lbl">Clinical e-Manual</div>
                                    </div>
                                    <div class="quick-stat-col">
                                        <div class="quick-stat-val"><%= lc.accessLabel || (freeCourse ? 'Self-Paced' : 'Full Access') %></div>
                                        <div class="quick-stat-lbl">Course Access</div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 03. QUESTIONS THIS COURSE ANSWERS                        -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'QUESTIONS' && lc.questionsEnabled !== false && questionsList.length > 0) { %>
                <section class="questions-section" id="questions">
                    <div class="wrap">
                        <div class="section-head">
                            <% if (lc.questionsEyebrow) { %><span class="eyebrow"><%= lc.questionsEyebrow %></span><% } %>
                            <% if (lc.questionsHeading) { %><h2><%= lc.questionsHeading %></h2><% } %>
                            <% if (lc.questionsDescription) { %>
                                <p><%= lc.questionsDescription %></p>
                            <% } %>
                        </div>
                        <div class="question-grid">
                            <% questionsList.forEach(function(q, qIdx) { 
                                const numPad = String(qIdx + 1).padStart(2, '0');
                            %>
                                <div class="qcard">
                                    <div class="qcard-num"><%= numPad %></div>
                                    <div class="qcard-text"><%= q.question %></div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- Learning Outcomes / Takeaways (When Present in CMS) -->
            <% if (lc.takeawaysEnabled !== false && takeawaysList.length > 0 && sectionKey === 'TAKEAWAYS') { %>
                <section class="takeaways-section" id="takeaways">
                    <div class="wrap">
                        <div class="section-head">
                            <% if (lc.takeawaysEyebrow) { %><span class="eyebrow"><%= lc.takeawaysEyebrow %></span><% } %>
                            <% if (lc.takeawaysHeading) { %><h2><%= lc.takeawaysHeading %></h2><% } %>
                            <% if (lc.takeawaysDescription) { %>
                                <p><%= lc.takeawaysDescription %></p>
                            <% } %>
                        </div>
                        <div class="takeaways-grid">
                            <% takeawaysList.forEach(function(item) { %>
                                <div class="takeaway-card">
                                    <div class="takeaway-ico"><i class="bi bi-check2-circle"></i></div>
                                    <div>
                                        <strong><%= item.title %></strong>
                                        <% if (item.description) { %>
                                            <div style="font-size:13.5px; color:var(--course-muted); margin-top:4px;"><%= item.description %></div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 04. WHY REGISTER (Left Navy Panel + Right Checklist)      -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'WHY_REGISTER' && lc.whyRegisterEnabled !== false && (whyRegisterWantList.length > 0 || whyRegisterGetList.length > 0)) { %>
                <section class="why-register-section" id="why-register">
                    <div class="wrap">
                        <div class="why-register-grid">
                            <!-- Left: Dark Navy Panel -->
                            <div class="why-panel">
                                <% if (lc.whyRegisterEyebrow) { %><span class="eyebrow"><%= lc.whyRegisterEyebrow %></span><% } %>
                                <% if (lc.whyRegisterHeading) { %>
                                    <h2><%= lc.whyRegisterHeading %></h2>
                                <% } %>
                                <% if (lc.whyRegisterIntro) { %>
                                    <p><%= lc.whyRegisterIntro %></p>
                                <% } %>
                                <% if (lc.whyRegisterEmphasisText) { %>
                                    <p><%= lc.whyRegisterEmphasisText %></p>
                                <% } %>
                                <% if (lc.whyRegisterClosingText) { %>
                                    <div class="why-closing-punchline"><%= lc.whyRegisterClosingText %></div>
                                <% } %>
                            </div>

                            <!-- Right: Stacked White Checklist Cards -->
                            <div class="why-checklist">
                                <% if (whyRegisterWantList.length > 0) { %>
                                    <% if (lc.whyRegisterWantHeading) { %><h3 class="why-subhead"><%= lc.whyRegisterWantHeading %></h3><% } %>
                                    <% whyRegisterWantList.forEach(function(item) { %>
                                        <div class="why-card">
                                            <div class="why-card-ico"><i class="bi bi-check-lg"></i></div>
                                            <div class="why-card-content">
                                                <strong><%= item.title %></strong>
                                                <% if (item.description) { %>
                                                    <p><%= item.description %></p>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } %>

                                <% if (whyRegisterGetList.length > 0) { %>
                                    <% if (lc.whyRegisterGetHeading) { %><h3 class="why-subhead"><%= lc.whyRegisterGetHeading %></h3><% } %>
                                    <% whyRegisterGetList.forEach(function(item) { %>
                                        <div class="why-card">
                                            <div class="why-card-ico"><i class="bi bi-check-lg"></i></div>
                                            <div class="why-card-content">
                                                <strong><%= item.title %></strong>
                                                <% if (item.description) { %>
                                                    <p><%= item.description %></p>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 05. DETAILED COURSE CURRICULUM (Sticky Summary + Acc.)   -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'CURRICULUM' && lc.curriculumEnabled !== false) { %>
                <section id="curriculum" class="curriculum-section">
                    <div class="wrap">
                        <div class="section-head">
                            <% if (lc.curriculumEyebrow) { %><span class="eyebrow"><%= lc.curriculumEyebrow %></span><% } %>
                            <% if (lc.curriculumHeading || (typeof cd !== 'undefined' && cd.curriculumHeading)) { %>
                                <h2><%= lc.curriculumHeading || cd.curriculumHeading %></h2>
                            <% } %>
                            <% if (lc.curriculumIntro) { %>
                                <p><%= lc.curriculumIntro %></p>
                            <% } %>
                        </div>

                        <div class="curriculum-layout">
                            <!-- Left: Sticky Summary Card with 2x2 Grid -->
                            <div class="curriculum-summary">
                                <h2><%= courseStats.publishedLessonCount %> sessions &bull; <%= courseStats.totalDurationFormatted %></h2>
                                <p>Open each module to see the individual session topics and durations from the course.</p>

                                <div class="curriculum-stat-grid">
                                    <% if (lc.curriculumShowSessionCount !== false) { %>
                                        <div class="curriculum-stat-box">
                                            <div class="val"><%= courseStats.publishedLessonCount %></div>
                                            <div class="lbl">Sessions</div>
                                        </div>
                                    <% } %>
                                    <% if (lc.curriculumShowTotalDuration !== false) { %>
                                        <div class="curriculum-stat-box">
                                            <div class="val"><%= courseStats.totalDurationFormatted %></div>
                                            <div class="lbl">Total duration</div>
                                        </div>
                                    <% } %>
                                    <div class="curriculum-stat-box">
                                        <div class="val"><%= courseStats.publishedModuleCount %></div>
                                        <div class="lbl">Modules</div>
                                    </div>
                                    <% if (lc.curriculumShowResourceCount !== false) { %>
                                        <div class="curriculum-stat-box">
                                            <div class="val"><%= courseStats.resourceCount > 0 ? courseStats.resourceCount : 1 %></div>
                                            <div class="lbl">FMR handout</div>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Right: Module Accordion -->
                            <div class="modules-container">
                                <% if (safeCurriculum.length === 0 && (!course.lessons || course.lessons.length === 0)) { %>
                                    <p class="text-muted"><%= (typeof cd !== 'undefined' && cd.emptyLessons) || 'No lessons published yet.' %></p>
                                <% } else { %>
                                    <% safeCurriculum.forEach(function(mod, modIdx) { 
                                        const modLessons = (mod.topics || []).reduce((acc, t) => acc.concat((t.lessons || []).filter(l => l.status === 'PUBLISHED')), []);
                                        const modTopics = (mod.topics || []).filter(t => (t.lessons || []).some(l => l.status === 'PUBLISHED') || (t.resources || []).length > 0);
                                        if (modLessons.length === 0 && modTopics.length === 0) return;
                                        const isDefaultOpen = (lc.curriculumDefaultExpanded !== false) && modIdx === 0;
                                    %>
                                        <div class="module-card <%= isDefaultOpen ? 'is-open' : '' %>" id="mod-card-<%= mod.id %>">
                                            <button type="button" class="module-header-btn" data-toggle-module="<%= mod.id %>" aria-expanded="<%= isDefaultOpen ? 'true' : 'false' %>">
                                                <div class="module-header-left">
                                                    <span class="module-eyebrow">MODULE <%= modIdx + 1 %> &bull; <%= modLessons.length %> SESSIONS</span>
                                                    <div class="module-title"><%= mod.title %></div>
                                                </div>
                                                <div class="module-toggle-circle">+</div>
                                            </button>
                                            <div class="module-body" id="mod-body-<%= mod.id %>">
                                                <% if (mod.description) { %>
                                                    <p style="padding:14px 26px 0; font-size:13.5px; color:var(--course-muted);"><%= mod.description %></p>
                                                <% } %>

                                                <% modTopics.forEach(function(topic) { 
                                                    const topicPubLessons = (topic.lessons || []).filter(l => l.status === 'PUBLISHED');
                                                %>
                                                    <div class="topic-box">
                                                        <div class="topic-header">
                                                            <span><%= topic.title %></span>
                                                            <span><%= topicPubLessons.length %> Video<%= topicPubLessons.length === 1 ? '' : 's' %></span>
                                                        </div>
                                                        <ul class="lesson-list">
                                                            <% topicPubLessons.forEach(function(lesson) { %>
                                                                <li class="lesson-row">
                                                                    <div class="lesson-title-area">
                                                                        <span class="lesson-ico"><i class="bi bi-play-circle-fill"></i></span>
                                                                        <span class="lesson-title"><%= lesson.title %></span>
                                                                        <% if (lc.showPreviewBadge !== false && lesson.preview) { %>
                                                                            <span class="lesson-badge">Free Preview</span>
                                                                        <% } %>
                                                                    </div>
                                                                    <div class="lesson-right">
                                                                        <% if (lc.showLessonDuration !== false && lesson.duration) { %>
                                                                            <span class="lesson-dur"><%= lesson.duration %></span>
                                                                        <% } %>
                                                                        <% if (lesson.preview) { %>
                                                                            <a href="/learn/<%= course.slug %>/<%= lesson.slug %>" class="btn btn-sm btn-secondary-light" style="padding:4px 12px; font-size:12px;">
                                                                                Preview
                                                                            </a>
                                                                        <% } else if (userIsEnrolled) { %>
                                                                            <a href="/learn/<%= course.slug %>/<%= lesson.slug %>" class="btn btn-sm btn-secondary-light" style="padding:4px 12px; font-size:12px; color:var(--course-success) !important;">
                                                                                Watch
                                                                            </a>
                                                                        <% } else if (lc.showLockIcon !== false) { %>
                                                                            <span class="lesson-lock"><i class="bi bi-lock-fill"></i></span>
                                                                        <% } %>
                                                                    </div>
                                                                </li>
                                                            <% }); %>
                                                        </ul>
                                                    </div>
                                                <% }); %>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 06. COURSE HIGHLIGHTS (3-Column Grid)                    -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'HIGHLIGHTS' && lc.highlightsEnabled !== false && highlightsList.length > 0) { %>
                <section class="highlights-section" id="highlights">
                    <div class="wrap">
                        <div class="section-head">
                            <% if (lc.highlightsEyebrow) { %><span class="eyebrow"><%= lc.highlightsEyebrow %></span><% } %>
                            <% if (lc.highlightsHeading) { %><h2><%= lc.highlightsHeading %></h2><% } %>
                            <% if (lc.highlightsDescription) { %>
                                <p><%= lc.highlightsDescription %></p>
                            <% } %>
                        </div>

                        <div class="highlights-grid">
                            <% highlightsList.forEach(function(hl, hlIdx) { 
                                const iconClasses = ['bi-gear-fill', 'bi-shield-check', 'bi-lightning-charge-fill', 'bi-clipboard-data-fill', 'bi-film', 'bi-mortarboard-fill'];
                                const iconClass = hl.icon || iconClasses[hlIdx % iconClasses.length];
                            %>
                                <div class="highlight-card">
                                    <div class="hl-icon-box"><i class="bi <%= iconClass %>"></i></div>
                                    <div class="highlight-title"><%= hl.title %></div>
                                    <% if (hl.description) { %>
                                        <p><%= hl.description %></p>
                                    <% } %>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 07. PURCHASE / ACCESS BOX                                -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'PURCHASE' && lc.purchaseCardEnabled !== false) { %>
                <section class="purchase-card-section" id="purchase" style="background:var(--course-surface); border-top:1px solid var(--course-border);">
                    <div class="wrap">
                        <div style="background:var(--course-surface-alt); border:1px solid var(--course-border); border-radius:calc(var(--course-card-radius) + 4px); padding:40px; max-width:940px; margin:0 auto; display:flex; justify-content:space-between; align-items:center; gap:32px; flex-wrap:wrap;">
                            <div>
                                <% if (lc.purchaseCardEyebrow) { %><span class="eyebrow"><%= lc.purchaseCardEyebrow %></span><% } %>
                                <% if (lc.purchaseCardHeading) { %><h2 style="font-size:30px; margin-top:8px; margin-bottom:8px;"><%= lc.purchaseCardHeading %></h2><% } %>
                                <% if (lc.purchaseCardDescription) { %><p style="font-size:15px; color:var(--course-muted); max-width:540px; margin-bottom:16px;"><%= lc.purchaseCardDescription %></p><% } %>
                                <div style="display:flex; flex-direction:column; gap:8px; font-size:14px; color:var(--course-text);">
                                    <div><i class="bi bi-check-circle-fill text-success me-2"></i> All <%= courseStats.publishedLessonCount %> structured clinical video lessons</div>
                                    <% if (courseStats.resourceCount > 0) { %><div><i class="bi bi-check-circle-fill text-success me-2"></i> Downloadable clinical case documentation forms</div><% } %>
                                    <div><i class="bi bi-check-circle-fill text-success me-2"></i> <%= freeCourse ? 'Self-Paced Stream anytime' : 'Stream anytime on mobile, tablet, or desktop' %></div>
                                </div>
                            </div>
                            <div style="text-align:center; min-width:260px;">
                                <% if (cp.onSale && !freeCourse) { %>
                                    <div class="purchase-price-old"><del aria-label="Regular price <%= fmtMoney(cp.regular) %>"><%= fmtMoney(cp.regular) %></del></div>
                                <% } %>
                                <div style="font-family:var(--course-heading-font); font-size:36px; font-weight:700; color:var(--course-secondary); margin-bottom:4px;"><%= freeCourse ? 'Free' : formattedPriceLabel %><% if (cp.onSale && !freeCourse) { %> <span class="purchase-sale-badge"><%= cp.badgeLabel %></span><% } %></div>
                                <% if (effectiveAccessSubtitle) { %><div style="font-size:13px; color:var(--course-muted); margin-bottom:18px;"><%= effectiveAccessSubtitle %></div><% } %>
                                <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'STUDENT') { %>
                                    <% if (userIsEnrolled) { %>
                                        <a class="btn btn-primary w-100" href="/learn/<%= course.slug %>">
                                            <span>Continue Learning &rarr;</span>
                                        </a>
                                    <% } else if (freeCourse) { %>
                                        <form method="POST" action="/courses/<%= course.slug %>/enroll-free" class="m-0">
                                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                            <button type="submit" class="btn btn-primary w-100">
                                                <span><%= lc.purchaseCardButtonLabel || cd.freeCta || 'Enroll Free' %> &rarr;</span>
                                            </button>
                                        </form>
                                    <% } else if (typeof paymentsEnabled !== 'undefined' && paymentsEnabled) { %>
                                        <a class="btn btn-primary w-100" href="/checkout/<%= course.slug %>">
                                            <span><%= lc.purchaseCardButtonLabel || ('Buy Course – ' + formattedPriceLabel) %> &rarr;</span>
                                        </a>
                                    <% } %>
                                <% } else { %>
                                    <a class="btn btn-primary w-100" href="/login?returnTo=<%= encodeURIComponent('/courses/' + course.slug) %>">
                                        <span><%= freeCourse ? (lc.purchaseCardButtonLabel || cd.loginFreeCta || 'Enroll Free') : (lc.purchaseCardButtonLabel || ('Buy Course – ' + formattedPriceLabel)) %> &rarr;</span>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 08. REVIEWS / TESTIMONIALS (Reference 2x2 Grid)          -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'REVIEWS' && (lc.reviewsEnabled === true || inPreviewMode) && testimonialsList.length > 0) { %>
                <section class="reviews-section" id="reviews">
                    <div class="wrap">
                        <div class="section-head">
                            <% if (lc.reviewsEyebrow) { %><span class="eyebrow"><%= lc.reviewsEyebrow %></span><% } %>
                            <% if (lc.reviewsHeading) { %><h2><%= lc.reviewsHeading %></h2><% } %>
                            <% if (lc.reviewsIntro) { %>
                                <p><%= lc.reviewsIntro %></p>
                            <% } %>
                            <% if ((inPreviewMode || demoShowcase) && testimonialsList.some(r => r.isDemo)) { %>
                                <div class="mt-2">
                                    <span class="badge" style="background:#fef3c7; color:#92400e; border:1px solid #fde68a; font-size:12px; padding:5px 12px; border-radius:6px; font-weight:700;">
                                        <i class="bi bi-flask me-1"></i> TESTIMONIAL PREVIEW &mdash; Demo reviews for layout &amp; responsive QA (Visible in Admin Preview Only)
                                    </span>
                                </div>
                            <% } %>
                        </div>

                        <% if (ratingSummary) { %>
                            <div class="reviews-summary" role="img" aria-label="Rated <%= ratingSummary.average.toFixed(1) %> out of 5, based on <%= ratingSummary.count %> review<%= ratingSummary.count === 1 ? '' : 's' %>">
                                <span class="reviews-summary-stars" aria-hidden="true"><%- starIcons(ratingSummary.average) %></span>
                                <span class="reviews-summary-score" aria-hidden="true"><%= ratingSummary.average.toFixed(1) %></span>
                                <span class="reviews-summary-count" aria-hidden="true">Based on <%= ratingSummary.count %> review<%= ratingSummary.count === 1 ? '' : 's' %></span>
                            </div>
                        <% } %>

                        <div class="reviews-carousel" data-reviews-carousel data-rotate="<%= testimonialsList.length > 2 ? 'true' : 'false' %>" role="region" aria-roledescription="carousel" aria-label="Student reviews">
                          <div class="reviews-viewport" tabindex="0" aria-label="Reviews. Use the arrow buttons or swipe to browse.">
                            <div class="reviews-track">
                            <% testimonialsList.forEach(function(rev) { %>
                                <div role="group" aria-roledescription="slide" class="review-card <%= rev.hasVideo ? 'review-card-video' : '' %> <%= rev.isDemo ? 'review-card-demo' : '' %>" style="<%= rev.isDemo ? 'border:1px dashed var(--course-border-strong); position:relative;' : '' %>">
                                    <% if (rev.isDemo) { %>
                                        <div style="position:absolute; top:14px; right:14px;">
                                            <span class="badge" style="background:#fef3c7; color:#92400e; font-size:10px; font-weight:700; letter-spacing:0.5px; border-radius:4px; padding:3px 7px;">DEMO REVIEW</span>
                                        </div>
                                    <% } %>
                                    <% if (rev.hasVideo) { %>
                                        <button type="button" class="review-video-thumb" data-testimonial-video data-kind="<%= rev.videoKind %>" data-id="<%= rev.id %>"<% if (rev.embedUrl) { %> data-embed="<%= rev.embedUrl %>"<% } %> data-title="<%= rev.reviewerName %>" aria-label="Play video review from <%= rev.reviewerName %>">
                                            <% if (rev.videoThumbnailUrl) { %>
                                                <img src="<%= rev.videoThumbnailUrl %>" alt="" loading="lazy">
                                            <% } else { %>
                                                <span class="review-video-poster" aria-hidden="true"><i class="bi bi-camera-video"></i></span>
                                            <% } %>
                                            <span class="review-video-play" aria-hidden="true"><i class="bi bi-play-fill"></i></span>
                                        </button>
                                    <% } else if (rev.hasQuote !== false) { %>
                                        <div class="review-quote-mark">&ldquo;</div>
                                    <% } %>
                                    <% if (rev.rating >= 1) { %>
                                        <div class="review-stars" role="img" aria-label="Rated <%= rev.rating %> out of 5">
                                            <span aria-hidden="true"><%- starIcons(rev.rating) %></span>
                                            <span class="review-rating-num" aria-hidden="true"><%= Number(rev.rating).toFixed(1) %></span>
                                        </div>
                                    <% } %>
                                    <% if (rev.hasQuote !== false && rev.quote) { %>
                                        <blockquote class="review-quote">&ldquo;<%= rev.quote %>&rdquo;</blockquote>
                                    <% } %>
                                    <div class="reviewer-meta">
                                        <div class="reviewer-avatar">
                                            <% if (rev.avatarUrl) { %>
                                                <img src="<%= rev.avatarUrl %>" alt="<%= rev.reviewerName %>" loading="lazy">
                                            <% } else { %>
                                                <span><%= rev.initials || rev.reviewerName.split(/\s+/).map(w => w[0]).join('').slice(0, 2).toUpperCase() %></span>
                                            <% } %>
                                        </div>
                                        <div>
                                            <div class="reviewer-name"><%= rev.reviewerName %></div>
                                            <% if (rev.reviewerDesignation || rev.reviewerLocation) { %>
                                                <div class="reviewer-sub">
                                                    <%= rev.reviewerDesignation || '' %><%= (rev.reviewerDesignation && rev.reviewerLocation) ? ' • ' : '' %><%= rev.reviewerLocation || '' %>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                            </div>
                          </div>
                          <button type="button" class="reviews-arrow reviews-prev" aria-label="Previous reviews" hidden><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                          <button type="button" class="reviews-arrow reviews-next" aria-label="Next reviews" hidden><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                          <div class="reviews-dots" aria-label="Review pages" hidden></div>
                        </div>
                        <script src="/js/course-reviews-carousel.js" defer></script>
                        <% if (testimonialsList.some(function (r) { return r.hasVideo; })) { %>
                            <script src="/js/testimonial-player.js" defer></script>
                        <% } %>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 09. COMPARISON (Strictly Hidden If Not Configured)       -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'COMPARISON' && lc.comparisonEnabled === true && comparisonColumnsList.length > 0) { %>
                <section class="comparison-section" id="comparison" style="background:var(--course-surface-alt); border-top:1px solid var(--course-border);">
                    <div class="wrap">
                        <div class="section-head">
                            <% if (lc.comparisonEyebrow) { %><span class="eyebrow"><%= lc.comparisonEyebrow %></span><% } %>
                            <% if (lc.comparisonHeading) { %><h2><%= lc.comparisonHeading %></h2><% } %>
                            <% if (lc.comparisonDescription) { %><p><%= lc.comparisonDescription %></p><% } %>
                        </div>

                        <div class="comparison-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:28px; max-width:880px; margin:0 auto;">
                            <% comparisonColumnsList.forEach(function(col) { %>
                                <div class="comparison-col <%= col.isRecommended ? 'comparison-col-recommended' : 'comparison-col-standard' %>" style="background:var(--course-surface); border:1px solid var(--course-border); border-radius:calc(var(--course-card-radius) + 4px); padding:36px; box-shadow:var(--course-shadow);">
                                    <% if (col.badgeText || col.isRecommended) { %>
                                        <div class="badge mb-3" style="background:var(--course-primary); color:var(--course-button-text); font-size:11px; padding:6px 12px; border-radius:999px;"><%= col.badgeText || 'Recommended' %></div>
                                    <% } %>
                                    <h3 style="font-size:22px; margin-bottom:16px;"><%= col.title %></h3>
                                    <ul class="comparison-checklist" style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:12px;">
                                        <% (col.items || []).forEach(function(cItem) { %>
                                            <li style="display:flex; align-items:center; gap:10px; font-size:14.5px;">
                                                <i class="bi bi-check-circle-fill" style="color:var(--course-primary);"></i>
                                                <span><%= cItem.text %></span>
                                            </li>
                                        <% }); %>
                                    </ul>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 10. AUDIENCE SECTION (Ideal For vs Not Ideal For)        -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'AUDIENCE' && lc.audienceEnabled !== false && (audienceForList.length > 0 || audienceNotForList.length > 0)) { %>
                <section class="audience-section audience" id="audience">
                    <div class="wrap">
                        <div class="section-head">
                            <% if (lc.audienceEyebrow) { %><span class="eyebrow"><%= lc.audienceEyebrow %></span><% } %>
                            <% if (lc.audienceHeading) { %><h2><%= lc.audienceHeading %></h2><% } %>
                            <% if (lc.audienceIntro) { %>
                                <p><%= lc.audienceIntro %></p>
                            <% } %>
                        </div>

                        <div class="audience-grid">
                            <% if (audienceForList.length > 0) { %>
                                <div class="audience-card audience-card-ideal-for">
                                    <span class="aud-pill">&check; <%= lc.audienceForHeading || 'IDEAL FOR' %></span>
                                    <% if (lc.audienceForHeading) { %><h3><%= lc.audienceForHeading %></h3><% } %>
                                    <ul class="audience-list">
                                        <% audienceForList.forEach(function(item) { %>
                                            <li>
                                                <i class="bi bi-check-circle-fill"></i>
                                                <span><%= item.title %></span>
                                            </li>
                                        <% }); %>
                                    </ul>
                                </div>
                            <% } %>

                            <% if (audienceNotForList.length > 0) { %>
                                <div class="audience-card audience-card-not-for">
                                    <span class="aud-pill">&cross; <%= lc.audienceNotForHeading || 'NOT IDEAL FOR' %></span>
                                    <% if (lc.audienceNotForHeading) { %><h3><%= lc.audienceNotForHeading %></h3><% } %>
                                    <ul class="audience-list">
                                        <% audienceNotForList.forEach(function(item) { %>
                                            <li>
                                                <i class="bi bi-x-circle-fill"></i>
                                                <span><%= item.title %></span>
                                            </li>
                                        <% }); %>
                                    </ul>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 11. HOW YOU GET ACCESS (3-Step Cards)                    -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'ACCESS' && lc.accessSectionEnabled === true && (accessStepsList.length > 0 || lc.accessMediaUrl)) { %>
                <section class="access-steps-section" id="access-steps">
                    <div class="wrap">
                        <div class="section-head">
                            <% if (lc.accessEyebrow) { %><span class="eyebrow"><%= lc.accessEyebrow %></span><% } %>
                            <% if (lc.accessHeading) { %><h2><%= lc.accessHeading %></h2><% } %>
                            <% if (lc.accessDescription) { %>
                                <p><%= lc.accessDescription %></p>
                            <% } %>
                        </div>

                        <% if (accessStepsList.length > 0) { %>
                            <div class="access-steps-grid">
                                <% accessStepsList.forEach(function(step, sIdx) { %>
                                    <div class="access-step-card">
                                        <div class="access-step-num"><%= sIdx + 1 %></div>
                                        <h4><%= step.title %></h4>
                                        <% if (step.description) { %>
                                            <p><%= step.description %></p>
                                        <% } %>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>

                        <% if (lc.accessMediaType === 'VIDEO' && lc.accessMediaUrl) { %>
                            <div class="mt-4 text-center">
                                <div style="max-width:720px; margin:0 auto; border-radius:calc(var(--course-card-radius) - 2px); overflow:hidden;">
                                    <div class="ratio ratio-16x9">
                                        <iframe src="<%= lc.accessMediaUrl %>" title="Access Guide" allowfullscreen></iframe>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 12. DOWNLOADABLE CLINICAL RESOURCES                       -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'RESOURCES' && lc.resourcesEnabled !== false && safeResources.length > 0) { %>
                <section id="resources" style="background:var(--course-surface); border-top:1px solid var(--course-border);">
                    <div class="wrap">
                        <div class="section-head">
                            <% if (lc.resourcesEyebrow) { %><span class="eyebrow"><%= lc.resourcesEyebrow %></span><% } %>
                            <% if (lc.resourcesHeading) { %><h2><%= lc.resourcesHeading %></h2><% } %>
                            <% if (lc.resourcesIntro) { %><p><%= lc.resourcesIntro %></p><% } %>
                        </div>
                        <div style="max-width:820px; margin:0 auto;">
                            <% safeResources.forEach(function(resItem) { %>
                                <div class="resource-card">
                                    <div class="resource-info">
                                        <div class="resource-ico"><i class="bi bi-file-earmark-pdf-fill"></i></div>
                                        <div>
                                            <div class="resource-title"><%= resItem.title %></div>
                                            <div class="resource-meta">
                                                <%= resItem.contentType %> &bull;
                                                <%= resItem.sizeBytes ? (Number(resItem.sizeBytes) / (1024 * 1024)).toFixed(2) + ' MB' : 'Official Clinical Form' %>
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <% if (userIsEnrolled) { %>
                                            <a href="/learn/<%= course.slug %>/resources/<%= resItem.id %>/download" class="btn btn-sm btn-secondary-light">
                                                <i class="bi bi-download me-1"></i> Download
                                            </a>
                                        <% } else { %>
                                            <span class="lesson-badge">
                                                <i class="bi bi-lock-fill me-1"></i> Included Free
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- Certificate Section (Critical: OFF by default, rendered ONLY if certificateSectionEnabled === true) -->
            <% if (lc.certificateSectionEnabled === true && sectionKey === 'CERTIFICATE') { %>
                <section class="certificate-section" id="certificate" style="background:var(--course-surface-alt); border-top:1px solid var(--course-border);">
                    <div class="wrap" style="display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center;">
                        <div class="certificate-mockup" style="background:linear-gradient(135deg, var(--course-secondary), var(--course-secondary-dark)); border:3px solid var(--course-accent); border-radius:var(--course-card-radius); padding:32px; color:var(--course-hero-text); text-align:center;">
                            <div style="color:var(--course-accent); font-size:18px; font-weight:700; margin-bottom:8px;">Institute of Cosmetology &amp; Dental Sciences</div>
                            <div style="font-size:13px; color:color-mix(in srgb, var(--course-hero-text) 65%, transparent); margin-bottom:12px;">Certificate of Clinical Masterclass Completion</div>
                            <div style="font-size:20px; font-weight:700; margin-bottom:14px;"><%= course.title %></div>
                            <div class="certificate-mockup-footer" style="font-size:11px; color:color-mix(in srgb, var(--course-hero-text) 80%, transparent); border-top:1px solid color-mix(in srgb, var(--course-accent) 30%, transparent); padding-top:12px;">
                                Official Verifiable Clinical Credential &bull; ICDS Academic Board
                            </div>
                        </div>
                        <div>
                            <% if (lc.certificateEyebrow) { %><span class="eyebrow"><%= lc.certificateEyebrow %></span><% } %>
                            <% if (lc.certificateHeading) { %><h2><%= lc.certificateHeading %></h2><% } %>
                            <% if (lc.certificateBody) { %><p><%= lc.certificateBody %></p><% } %>
                            <% if (lc.certificateNote) { %>
                                <p style="font-size:13px; color:color-mix(in srgb, var(--course-hero-text) 65%, transparent); margin-top:8px;"><em><%= lc.certificateNote %></em></p>
                            <% } %>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 13. MEET YOUR MENTOR (Dr. Tanu Raghav, ICDS Founder)     -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'MENTOR' && lc.mentorSectionEnabled !== false && course.instructor) { 
                const inst = course.instructor;
                const instCreds = (inst.credentials && Array.isArray(inst.credentials)) ? inst.credentials : [];
                const mentorEyebrowText = lc.mentorEyebrow || (typeof cd !== 'undefined' && cd.instructorHeading) || '';
                const mentorHeadingText = lc.mentorHeading || (typeof cd !== 'undefined' && cd.instructorHeading) || '';
            %>
                <section class="mentor-section" id="mentor">
                    <div class="wrap">
                        <div class="section-head">
                            <% if (mentorEyebrowText) { %><span class="eyebrow"><%= mentorEyebrowText %></span><% } %>
                            <% if (mentorHeadingText) { 
                                const mhWords = String(mentorHeadingText).trim().split(/\s+/);
                                const mhLast = mhWords.length > 1 ? mhWords.pop() : '';
                            %>
                                <h2><%= mhWords.join(' ') %><%= mhLast ? ' ' : '' %><% if (mhLast) { %><span class="accent-text"><%= mhLast %></span><% } %></h2>
                            <% } %>
                        </div>

                        <div class="mentor-layout">
                            <!-- Left: Mentor Photo Card -->
                            <div class="mentor-portrait-card">
                                <img src="<%= inst.photoUrl || (typeof cms !== 'undefined' && cms.brand ? cms.brand.defaultInstructorImageUrl : '') || '/assets/images/instructor-placeholder.svg' %>"
                                     alt="<%= inst.name %>"
                                     loading="lazy"
                                     data-fallback-src="/assets/images/instructor-placeholder.svg">
                                <% if (inst.experienceLabel) { %>
                                    <div class="mentor-exp-badge">
                                        <i class="bi bi-award-fill text-warning"></i>
                                        <span><%= inst.experienceLabel %></span>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Right: Mentor Details -->
                            <div class="mentor-details">
                                <h2><%= inst.name %></h2>

                                <% if (inst.designation || inst.title || inst.organization) { %>
                                    <div class="mentor-designation">
                                        <%= inst.designation || inst.title %>
                                        <% if (inst.organization) { %>
                                            &bull; <%= inst.organization %>
                                        <% } %>
                                    </div>
                                <% } %>

                                <% const mentorBio = inst.fullBio || inst.bio || inst.shortBio; %>
                                <% if (mentorBio) { %>
                                    <div class="mentor-bio">
                                        <p><%= mentorBio %></p>
                                    </div>
                                <% } %>

                                <% if (instCreds.length > 0) { %>
                                    <ul class="mentor-credentials-list">
                                        <% instCreds.forEach(function(cred) { %>
                                            <li>
                                                <span class="mentor-cred-dot"></span>
                                                <div>
                                                    <strong><%= cred.title %></strong>
                                                    <% if (cred.description) { %>
                                                        <div style="font-size:13px; color:var(--course-muted); margin-top:2px;"><%= cred.description %></div>
                                                    <% } %>
                                                </div>
                                            </li>
                                        <% }); %>
                                    </ul>
                                <% } %>

                                <% if (inst.mentorQuote) { %>
                                    <blockquote class="mentor-quote">
                                        &ldquo;<%= inst.mentorQuote %>&rdquo;
                                    </blockquote>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 14. FAQ (Clean Accordion)                                -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'FAQ' && lc.faqEnabled !== false && courseFaqsList.length > 0) { %>
                <section class="faq-section faq" id="faq">
                    <div class="wrap">
                        <div class="section-head">
                            <% if (lc.faqEyebrow) { %><span class="eyebrow"><%= lc.faqEyebrow %></span><% } %>
                            <% if (lc.faqHeading) { %><h2><%= lc.faqHeading %></h2><% } %>
                            <% if (lc.faqIntro) { %>
                                <p><%= lc.faqIntro %></p>
                            <% } %>
                        </div>
                        <div class="faq-container">
                            <% courseFaqsList.forEach(function(faq, faqIdx) { %>
                                <details class="faq-item" <%= faqIdx === 0 ? 'open' : '' %>>
                                    <summary class="faq-summary">
                                        <span><%= faq.question %></span>
                                        <span class="faq-chevron"><i class="bi bi-chevron-down"></i></span>
                                    </summary>
                                    <div class="faq-answer">
                                        <p><%= faq.answer %></p>
                                    </div>
                                </details>
                            <% }); %>
                        </div>
                    </div>
                </section>
            <% } %>

            <!-- ======================================================== -->
            <!-- 15. FINAL CONVERSION CTA (Dominant Navy with Glow)       -->
            <!-- ======================================================== -->
            <% if (sectionKey === 'FINAL_CTA' && lc.finalCtaEnabled !== false) { %>
                <section class="final-cta-section" id="final-cta">
                    <div class="wrap">
                        <div class="final-cta-card">
                            <% if (lc.socialProofEnabled === true && lc.socialProofValue) { %>
                                <div class="final-cta-eyebrow mb-2">
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <span><%= [lc.socialProofValue, lc.socialProofLabel].filter(Boolean).join(' · ') %></span>
                                </div>
                            <% } %>
                            <% if (lc.finalCtaEyebrow) { %><div class="eyebrow mb-3"><span><%= lc.finalCtaEyebrow %></span></div><% } %>
                            <% if (lc.finalCtaBadgeText) { %><div class="final-cta-eyebrow mb-3"><i class="bi bi-patch-check-fill"></i> <span><%= lc.finalCtaBadgeText %></span></div><% } %>
                            <% if (lc.finalCtaHeading) { %><h2><%= lc.finalCtaHeading %></h2><% } %>

                            <% if (lc.finalCtaBody) { %>
                                <p class="final-cta-desc"><%= lc.finalCtaBody %></p>
                            <% } %>

                            <% if (lc.finalCtaLine1 || lc.finalCtaLine2 || lc.finalCtaLine3) { %>
                                <div class="final-cta-bullets">
                                    <% if (lc.finalCtaLine1) { %><span><i class="bi bi-check2-circle"></i> <%= lc.finalCtaLine1 %></span><% } %>
                                    <% if (lc.finalCtaLine2) { %><span><i class="bi bi-check2-circle"></i> <%= lc.finalCtaLine2 %></span><% } %>
                                    <% if (lc.finalCtaLine3) { %><span><i class="bi bi-check2-circle"></i> <%= lc.finalCtaLine3 %></span><% } %>
                                </div>
                            <% } %>

                            <div>
                                <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'STUDENT') { %>
                                    <% if (userIsEnrolled) { %>
                                        <a class="btn btn-primary" href="/learn/<%= course.slug %>">
                                            <span>Continue Learning &rarr;</span>
                                            <% if (effectiveAccessSubtitle) { %><span class="btn-sublabel"><%= effectiveAccessSubtitle %></span><% } %>
                                        </a>
                                    <% } else if (freeCourse) { %>
                                        <form method="POST" action="/courses/<%= course.slug %>/enroll-free" class="m-0 d-inline-block">
                                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                            <button type="submit" class="btn btn-primary">
                                                <span><%= lc.finalCtaButtonLabel || cd.freeCta || 'Enroll Free' %> &rarr;</span>
                                                <% if (effectiveAccessSubtitle) { %><span class="btn-sublabel"><%= effectiveAccessSubtitle %></span><% } %>
                                            </button>
                                        </form>
                                    <% } else if (typeof paymentsEnabled !== 'undefined' && paymentsEnabled) { %>
                                        <a class="btn btn-primary" href="/checkout/<%= course.slug %>">
                                            <span><%= lc.finalCtaButtonLabel || ('Buy Course – ' + formattedPriceLabel) %> &rarr;</span>
                                            <% if (effectiveAccessSubtitle) { %><span class="btn-sublabel"><%= effectiveAccessSubtitle %></span><% } %>
                                        </a>
                                    <% } %>
                                <% } else { %>
                                    <a class="btn btn-primary" href="/login?returnTo=<%= encodeURIComponent('/courses/' + course.slug) %>">
                                        <span><%= freeCourse ? (lc.finalCtaButtonLabel || cd.loginFreeCta || 'Enroll Free') : (lc.finalCtaButtonLabel || ('Buy Course – ' + formattedPriceLabel)) %> &rarr;</span>
                                        <% if (effectiveAccessSubtitle) { %><span class="btn-sublabel"><%= effectiveAccessSubtitle %></span><% } %>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </section>
            <% } %>

        <% } %>

    </main>

    <!-- ======================================================== -->
    <!-- 16. FLOATING STICKY BOTTOM BAR                           -->
    <!-- ======================================================== -->
    <% if (lc.stickyCtaEnabled !== false) { %>
        <div class="floating-bottom-bar" id="course-floating-bar">
            <div class="wrap floating-bottom-inner">
                <div class="floating-bottom-left">
                    <% if (course.instructor && course.instructor.photoUrl) { %>
                        <div class="floating-mentor-avatar">
                            <img src="<%= course.instructor.photoUrl %>" alt="<%= course.instructor.name %>">
                        </div>
                    <% } %>
                    <div>
                        <% if (lc.stickyCtaText) { %>
                            <div class="floating-copy-title"><%= lc.stickyCtaText %></div>
                        <% } else { %>
                            <div class="floating-copy-title"><%= course.title %></div>
                        <% } %>
                        <div class="floating-copy-sub"><% if (cp.onSale && !freeCourse) { %><del class="floating-price-old"><%= fmtMoney(cp.regular) %></del> <% } %><strong><%= freeCourse ? 'Free' : formattedPriceLabel %></strong><% if (cp.onSale && !freeCourse) { %> <span class="floating-sale-badge"><%= cp.badgeLabel %></span><% } %> &bull; <%= effectiveAccessSubtitle || 'Self-Paced Access' %></div>
                    </div>
                </div>
                <div>
                    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'STUDENT') { %>
                        <% if (userIsEnrolled) { %>
                            <a class="btn btn-primary" href="/learn/<%= course.slug %>">
                                <span>Continue Learning &rarr;</span>
                            </a>
                        <% } else if (freeCourse) { %>
                            <form method="POST" action="/courses/<%= course.slug %>/enroll-free" class="m-0">
                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                <button type="submit" class="btn btn-primary">
                                    <span><%= lc.stickyCtaButtonLabel || cd.freeCta || 'Enroll Free' %> &rarr;</span>
                                </button>
                            </form>
                        <% } else if (typeof paymentsEnabled !== 'undefined' && paymentsEnabled) { %>
                            <a class="btn btn-primary" href="/checkout/<%= course.slug %>">
                                <span><%= lc.stickyCtaButtonLabel || ('Buy Course – ' + formattedPriceLabel) %> &rarr;</span>
                            </a>
                        <% } %>
                    <% } else { %>
                        <a class="btn btn-primary" href="/login?returnTo=<%= encodeURIComponent('/courses/' + course.slug) %>">
                            <span><%= freeCourse ? (lc.stickyCtaButtonLabel || cd.loginFreeCta || 'Enroll Free') : (lc.stickyCtaButtonLabel || ('Buy Course – ' + formattedPriceLabel)) %> &rarr;</span>
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    <% } %>
</div>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
document.addEventListener('DOMContentLoaded', function() {
    // Accordion toggle delegation
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-toggle-module]');
        if (btn) {
            var modId = btn.getAttribute('data-toggle-module');
            var card = document.getElementById('mod-card-' + modId);
            if (card) {
                var isOpen = card.classList.toggle('is-open');
                btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            }
        }
    });

    // Floating sticky bottom bar visibility on scroll
    var floatingBar = document.getElementById('course-floating-bar');
    var hero = document.getElementById('hero');
    if (floatingBar && hero) {
        var checkScroll = function() {
            var rect = hero.getBoundingClientRect();
            if (rect.bottom < 120) {
                floatingBar.classList.add('is-visible');
            } else {
                floatingBar.classList.remove('is-visible');
            }
        };
        window.addEventListener('scroll', checkScroll, { passive: true });
        checkScroll();
    }
});
</script>
