<section class="section-space">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="modal-content">
                    <div class="auth-form-area">
                        <h4>Forgot Password</h4>
                        <p>Enter your email and we'll generate reset instructions.</p>

                        <% if (typeof flash !== 'undefined' && flash.success) { %>
                            <div class="alert alert-success mt-3"><%= flash.success %></div>
                        <% } %>

                        <% if (errors && errors.length) { %>
                            <div class="alert alert-danger mt-3">
                                <ul class="mb-0 ps-3">
                                    <% errors.forEach(function (error) { %>
                                        <li><%= error %></li>
                                    <% }) %>
                                </ul>
                            </div>
                        <% } %>

                        <form class="mt-4" method="POST" action="/auth/forgot-password">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Email Address</label>
                                <input
                                    type="email"
                                    name="email"
                                    class="form-control form-control-custom"
                                    placeholder="you@example.com"
                                    value="<%= (values && values.email) || '' %>"
                                    required>
                            </div>

                            <button type="submit" class="auth-submit">Send Reset Instructions</button>
                        </form>

                        <p class="small mt-4 mb-0">
                            <a href="/login" style="color:#565acf;">Back to login</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
