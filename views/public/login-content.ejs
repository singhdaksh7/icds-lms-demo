<% const t = cms.login; %>
<section class="section-space">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="modal-content">
                    <div class="row g-0">

                        <div class="col-md-5 d-none d-md-block">
                            <div class="auth-brand-panel" style="<%= t.imageUrl ? "background-image: linear-gradient(165deg, rgba(86,90,207,.92), rgba(65,69,174,.94)), url('" + t.imageUrl + "');" : '' %>">
                                <h3><%= t.sideHeading %></h3>
                                <p><%= t.sideBody %></p>
                                <div class="auth-feature">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <%= t.sideFeature1 %>
                                </div>
                                <div class="auth-feature">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <%= t.sideFeature2 %>
                                </div>
                                <div class="auth-feature">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <%= t.sideFeature3 %>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="auth-form-area">
                                <h4><%= t.heading %></h4>
                                <p><%= t.description %></p>

                                <% if (errors && errors.length) { %>
                                    <div class="alert alert-danger mt-3">
                                        <ul class="mb-0 ps-3">
                                            <% errors.forEach(function (error) { %>
                                                <li><%= error %></li>
                                            <% }) %>
                                        </ul>
                                    </div>
                                <% } %>

                                <form class="mt-4" method="POST" action="/auth/login" autocomplete="on">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="returnTo" value="<%= returnTo || '' %>">

                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold"><%= t.emailLabel %></label>
                                        <input
                                            type="email"
                                            name="email"
                                            class="form-control form-control-custom"
                                            placeholder="you@example.com"
                                            value="<%= (values && values.email) || '' %>"
                                            required>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold"><%= t.passwordLabel %></label>
                                        <input
                                            type="password"
                                            name="password"
                                            class="form-control form-control-custom"
                                            placeholder="Enter password"
                                            required>
                                    </div>

                                    <div class="d-flex justify-content-end mb-4">
                                        <a href="/forgot-password" class="small text-decoration-none" style="color:#565acf;">
                                            <%= t.forgotLabel %>
                                        </a>
                                    </div>

                                    <button type="submit" class="auth-submit"><%= t.submitLabel %></button>
                                </form>

                                <p class="small mt-4 mb-0">
                                    <%= t.signupPrompt %>
                                    <a href="/signup" style="color:#565acf;"><%= t.signupLabel %></a>
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
