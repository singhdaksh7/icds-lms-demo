<section class="section-space">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">

                <h1 class="section-title" style="text-align:left;">Checkout</h1>

                <div class="modal-content p-4 mb-4">

                    <div class="d-flex gap-3 align-items-center mb-4">
                        <img
                            src="<%= course.thumbnailUrl || '/assets/images/course-placeholder.jpg' %>"
                            alt="<%= course.title %>"
                            style="width:90px;height:90px;border-radius:12px;object-fit:cover;">
                        <div>
                            <h5 class="mb-1"><%= course.title %></h5>
                            <small class="text-muted">
                                <%= course.instructor ? course.instructor.name : 'ICDS' %>
                            </small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between border-top pt-3 mb-2">
                        <span class="text-muted">Price</span>
                        <span>
                            <%= course.currency %> <%= Number(course.price).toLocaleString('en-IN') %>
                        </span>
                    </div>

                    <% if (course.salePrice && Number(course.salePrice) < Number(course.price)) { %>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Discount</span>
                            <span style="color:var(--success-color);">
                                -<%= course.currency %> <%= (Number(course.price) - Number(course.salePrice)).toLocaleString('en-IN') %>
                            </span>
                        </div>
                    <% } %>

                    <div class="d-flex justify-content-between border-top pt-3 mb-4">
                        <strong>Total Payable</strong>
                        <strong class="course-price" style="font-size:22px;">
                            <%= isFree ? 'Free' : `${course.currency} ${Number(amount).toLocaleString('en-IN')}` %>
                        </strong>
                    </div>

                    <% if (isFree) { %>

                        <form method="POST" action="/courses/<%= course.slug %>/enroll-free">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="auth-submit">Enroll Free</button>
                        </form>

                    <% } else if (!razorpayConfigured) { %>

                        <button class="auth-submit" disabled>Payments Unavailable</button>
                        <p class="small text-muted mt-2 mb-0">
                            Payments are not configured on this server yet. Please try again later.
                        </p>

                    <% } else { %>

                        <button
                            type="button"
                            id="pay-button"
                            class="auth-submit"
                            data-course-slug="<%= course.slug %>"
                            data-csrf="<%= csrfToken %>"
                            data-course-name="<%= course.title %>">
                            Pay Securely
                        </button>
                        <div id="pay-error" class="alert alert-danger mt-3" style="display:none;"></div>

                    <% } %>

                    <p class="small text-muted mt-3 mb-0">
                        <i class="bi bi-shield-lock me-1"></i>
                        Payments are processed securely by Razorpay. ICDS never sees or stores your card/UPI details.
                    </p>

                </div>

            </div>
        </div>
    </div>
</section>

<% if (!isFree && razorpayConfigured) { %>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="/js/checkout.js"></script>
<% } %>
