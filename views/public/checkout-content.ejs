<%
    const sym = course.currency === 'INR' ? '₹' : course.currency + ' ';
    const money = (n) => sym + Number(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    // One server-side helper decides the payable price (sale window aware).
    const cprice = typeof coursePriceOf === 'function' ? coursePriceOf(course) : { onSale: false, regular: Number(course.price), effective: Number(course.price) };
    const hasSale = cprice.onSale;
    const showTax = !isFree && pricing && pricing.rate > 0;
%>
<section class="section-space">
    <div class="container">
        <div class="pay-shell">

            <h1 class="pay-title">Checkout</h1>
            <p class="pay-sub">Review your order and complete the payment to start learning right away.</p>

            <div class="pay-grid">

                <div class="pay-card">
                    <h2 class="pay-card-title">Order summary</h2>

                    <div class="pay-course">
                        <img
                            src="<%= course.thumbnailUrl || cms.brand.defaultCourseImageUrl || '/assets/images/course-placeholder.svg' %>"
                            alt="<%= course.title %>"
                            data-fallback-src="/assets/images/course-placeholder.svg">
                        <div>
                            <h2><%= course.title %></h2>
                            <small><%= course.instructor ? course.instructor.name : site.name %></small>
                        </div>
                    </div>

                    <% if (!isFree) { %>
                        <div class="pay-row">
                            <span>Course price</span>
                            <span><%= money(course.price) %></span>
                        </div>

                        <% if (hasSale) { %>
                            <div class="pay-row pay-discount">
                                <span>Discount</span>
                                <span>-<%= money(cprice.regular - cprice.effective) %></span>
                            </div>
                        <% } %>

                        <% if (showTax && !pricing.inclusive) { %>
                            <div class="pay-row">
                                <span>GST (<%= pricing.rate %>%)</span>
                                <span><%= money(pricing.tax) %></span>
                            </div>
                        <% } %>
                    <% } %>

                    <div class="pay-row pay-total">
                        <span>Total payable</span>
                        <span><%= isFree ? 'Free' : money(amount) %></span>
                    </div>
                    <% if (showTax && pricing.inclusive) { %>
                        <p class="pay-gst-note">Includes GST (<%= pricing.rate %>%) of <%= money(pricing.tax) %></p>
                    <% } %>
                </div>

                <div class="pay-card">
                    <h2 class="pay-card-title">Payment</h2>

                    <ul class="pay-benefits">
                        <li><i class="bi bi-check-circle-fill"></i>Instant access after payment</li>
                        <li><i class="bi bi-check-circle-fill"></i>Learn on any device</li>
                        <li><i class="bi bi-check-circle-fill"></i>Certificate on completion</li>
                    </ul>

                    <% if (isFree) { %>

                        <form method="POST" action="/courses/<%= course.slug %>/enroll-free" class="m-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="auth-submit pay-cta">Enroll Free</button>
                        </form>

                    <% } else if (!razorpayConfigured) { %>

                        <button class="auth-submit pay-cta" disabled>Payments Unavailable</button>
                        <p class="pay-secure">Payments are not available right now. Please try again later.</p>

                    <% } else { %>

                        <button
                            type="button"
                            id="pay-button"
                            class="auth-submit pay-cta"
                            data-course-slug="<%= course.slug %>"
                            data-csrf="<%= csrfToken %>"
                            data-course-name="<%= course.title %>"
                            data-label="Pay <%= money(amount) %> Securely">
                            Pay <%= money(amount) %> Securely
                        </button>
                        <div id="pay-error" class="pay-error" role="alert"></div>

                        <div class="pay-methods" aria-label="Accepted payment methods">
                            <span class="pay-chip"><i class="bi bi-credit-card"></i>Cards</span>
                            <span class="pay-chip"><i class="bi bi-phone"></i>UPI</span>
                            <span class="pay-chip"><i class="bi bi-bank"></i>Net banking</span>
                            <span class="pay-chip"><i class="bi bi-wallet2"></i>Wallets</span>
                        </div>

                    <% } %>

                    <p class="pay-secure">
                        <i class="bi bi-shield-lock"></i>
                        Secure payment by Razorpay. We never see or store your card or UPI details.
                    </p>
                </div>

            </div>
        </div>
    </div>
</section>

<% if (!isFree && razorpayConfigured) { %>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="/js/checkout.js"></script>
<% } %>
