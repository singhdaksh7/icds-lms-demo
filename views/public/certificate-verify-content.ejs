<section class="section-space"><div class="container" style="max-width:760px"><h1 class="section-title"><%= cms.cert.verifyHeading %></h1><% if (cms.cert.verifyHelper) { %><p class="section-description"><%= cms.cert.verifyHelper %></p><% } %><% if(certificate){ %><% if (certificate.status === "REVOKED") { %><div class="alert alert-danger">This certificate is no longer valid.</div><% } else { %><div class="alert alert-success">Certificate valid</div><% } %><dl><dt>Student</dt><dd><%= certificate.user.name %></dd><dt>Course</dt><dd><%= certificate.course.title %></dd><dt>Issued</dt><dd><%= certificate.issuedAt.toLocaleDateString('en-IN') %></dd><dt>Certificate number</dt><dd><%= certificate.certificateNumber %></dd></dl><% } else { %><div class="alert alert-warning">Certificate not found.</div><% } %></div></section>
