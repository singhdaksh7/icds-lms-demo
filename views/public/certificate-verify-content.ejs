<section class="section-space"><div class="container" style="max-width:760px"><h1 class="section-title">Certificate Verification</h1><% if(certificate){ %><div class="alert alert-success">Certificate valid</div><dl><dt>Student</dt><dd><%= certificate.user.name %></dd><dt>Course</dt><dd><%= certificate.course.title %></dd><dt>Issued</dt><dd><%= certificate.issuedAt.toLocaleDateString('en-IN') %></dd><dt>Certificate number</dt><dd><%= certificate.certificateNumber %></dd></dl><% } else { %><div class="alert alert-warning">Certificate not found.</div><% } %></div></section>
