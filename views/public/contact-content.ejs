<section class="section-space"><div class="container" style="max-width:760px"><h1 class="section-title">Contact Us</h1><p class="section-description">Send our team a message and we will respond when email delivery is configured.</p><% if(errors.length){ %><div class="alert alert-danger"><%= errors.join(' ') %></div><% } %><form method="POST" action="/contact"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><input class="form-control" name="name" placeholder="Name" required value="<%= values.name || '' %>"></div><div class="mb-3"><input class="form-control" type="email" name="email" placeholder="Email" required value="<%= values.email || '' %>"></div><div class="mb-3"><input class="form-control" name="subject" placeholder="Subject" required value="<%= values.subject || '' %>"></div><div class="mb-3"><textarea class="form-control" name="message" rows="6" maxlength="5000" required><%= values.message || '' %></textarea></div><button class="auth-submit">Send Message</button></form></div></section>
