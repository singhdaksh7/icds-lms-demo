<%
    const course = order.items[0].course;
    const pending = order.status === 'PENDING';
%>
<section class="section-space">
    <div class="container">
        <div class="pay-result">
            <div class="pay-card">

                <% if (pending) { %>
                    <span class="pay-icon wait"><i class="bi bi-hourglass-split"></i></span>
                    <h1>Payment not completed</h1>
                    <p class="pay-sub">
                        We couldn't confirm your payment yet. If money was deducted, it may still be processing —
                        your course unlocks automatically once the bank confirms it. Check
                        <a href="/student/orders">My Orders</a> in a few minutes.
                    </p>
                <% } else { %>
                    <span class="pay-icon bad"><i class="bi bi-x-lg"></i></span>
                    <h1>Payment failed</h1>
                    <p class="pay-sub">Your payment could not be completed and you have not been charged for this order. You can try again.</p>
                <% } %>

                <div class="pay-receipt">
                    <div class="pay-row"><span>Course</span><span><%= course.title %></span></div>
                    <div class="pay-row"><span>Order</span><span>ICDS-<%= order.id %></span></div>
                    <div class="pay-row"><span>Status</span><span><span class="status-pill <%= pending ? 'pending' : 'failed' %>"><%= pending ? 'Pending' : order.status.charAt(0) + order.status.slice(1).toLowerCase() %></span></span></div>
                </div>

                <div class="pay-actions">
                    <a href="/checkout/<%= course.slug %>" class="auth-submit text-decoration-none">Try Again</a>
                    <div class="pay-actions-split pay-actions">
                        <a href="/courses/<%= course.slug %>" class="hero-secondary-btn">Back to course</a>
                        <a href="/contact" class="hero-secondary-btn">Contact support</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
